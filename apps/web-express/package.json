{
  "name": "suggfeed-express",
  "version": "2.0.0",
  "description": "SuggFeed \u2013 Express + Eta + TypeScript",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:brand": "node -r ts-node/register scripts/build-brand-assets.ts",
    "test": "npm run build:client && tsc -p tsconfig.tests.json && node -r ts-node/register/transpile-only --test tests/*.test.ts",
    "predev": "npm run build:client",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "dev": "node --watch --use-system-ca -r ts-node/register src/server.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:sw": "tsc -p tsconfig.sw.json",
    "build:client": "npm run build:styles && npm run build:vendor && npm run typecheck:client:strict && tsc -p tsconfig.client.json",
    "typecheck:client:strict": "tsc -p tsconfig.client.strict.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.client.json --noEmit && npm run typecheck:client:strict && tsc -p tsconfig.api.json && tsc -p tsconfig.tests.json",
    "build": "npm run build:server && npm run build:sw && npm run build:client && tsc -p tsconfig.api.json",
    "start": "node --use-system-ca dist/server.js",
    "build:vendor": "node scripts/build-vendor.cjs",
    "build:styles": "node scripts/build-styles.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "eta": "^3.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
