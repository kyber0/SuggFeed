# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
APP_ORIGIN=http://localhost:3001
# Production: https://www.suggfeed.me (also configure Supabase Auth URL settings)
# Platform operator, not a school tenant. Supply a real legal identity and monitored mailbox.
# School-specific notices/contacts require the future verified school configuration.
PLATFORM_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
# Service role key is required in production for server-side writes and administrative operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Session Security
# Generate once with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production, 32+ characters; keep stable across instances and deploys.
SESSION_SECRET=

# Server Configuration
PORT=3001
NODE_ENV=development

# Public school update attribution (never a personal staff name)
SCHOOL_OFFICE_LABEL=School administration
# Optional cleanup scheduler authorization; generate a separate random secret.
# A missing secret disables the cleanup endpoint. Never expose this in client env.
CRON_SECRET=

# Invitation emails use RESEND_API_KEY, RESEND_FROM_EMAIL, and HTTPS APP_ORIGIN.
# The From address must be verified in Resend. Invitations do not enable weekly emails.
# Weekly digest: opt-in only; remains unavailable unless ALL fields are configured.
# Schedule authenticated GET /internal/weekly-digests after Monday 00:00 Manila.
# Runs claim 10 accounts each; repeat until no jobs remain for the previous week.
WEEKLY_DIGEST_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DIGEST_UNSUBSCRIBE_SECRET=

# Sugi: reviewed FAQ is available without Gemini. Never use public-prefixed keys.
# Confirm your Gemini project's free-tier model eligibility before enabling AI.
GEMINI_API_KEY=
# A separate random secret, at least 32 characters; do not reuse an API key.
ASSISTANT_HMAC_SECRET=
ASSISTANT_AI_ENABLED=false
# Safe canonical-topic logs only. Confirm the configured retention with staff first.
ASSISTANT_LOGGING_ENABLED=false
