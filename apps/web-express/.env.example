# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
APP_ORIGIN=http://localhost:3001
# Production: https://www.suggfeed.me (also configure Supabase Auth URL settings)
# Service role key is required in production for server-side writes and administrative operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Session Security
# Generate once with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production, 32+ characters; keep stable across instances and deploys.
SESSION_SECRET=

# Server Configuration
PORT=3001
NODE_ENV=development
