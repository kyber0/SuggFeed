<% layout('layout'); const settingsUrl=it.base.replace(/members$/,it.platformDashboard?'settings':'school-settings'); %>
<% const portalShell=!it.platformDashboard; %><% if(portalShell) { %><main class="staff-workspace portal-management"><%~ include('partials/staff-sidebar',it) %><div class="staff-main portal-management-main"><% } else { %><main><% } %><div class="school-settings-page member-directory">
 <header class="school-settings-header"><div><a class="school-settings-back" href="<%= settingsUrl %>">← School settings</a><p class="school-settings-eyebrow">People & access</p><h1>School members</h1><p>Manage access to <strong><%= it.school.name %></strong>. Accounts and submitted ideas are preserved.</p></div><a class="platform-button platform-button--primary" href="<%= it.base.replace(/members$/,'invitations') %>">Invite members</a></header><% if(portalShell) { %><%~ include('partials/staff-section-tabs',it) %><% } %>
 <% if(it.platformDashboard) { %><nav class="member-section-nav" aria-label="People & access sections"><a href="<%= it.base %>" aria-current="page">Members</a><a href="<%= it.base.replace(/members$/,'student-access') %>">Student joining & requests</a><a href="<%= it.base.replace(/members$/,'invitations') %>">Invitations</a><a href="<%= it.platformDashboard ? '/platform/schools' : it.base.replace(/members$/,'staff') %>"><%= it.platformDashboard ? 'Platform dashboard' : 'Staff roles' %></a></nav><% } %>
 <% if(it.saved) { %><p class="platform-feedback" role="status">School access updated. Other school memberships and account sign-in remain unchanged.</p><% } %>
 <% if(it.school.status!=='active') { %><p class="school-settings-notice">Member records are available to review. Access changes become available after the school is active.</p><% } %>
 <section class="platform-panel"><div class="platform-panel-heading"><div><h2>Member directory</h2><p>Open a member to manage access. Administrators are protected.</p></div></div>
 <form class="platform-filters" method="get" action="<%= it.base %>" role="search"><div><label for="member-search">Name or email</label><input id="member-search" name="q" type="search" maxlength="100" value="<%= it.q %>" placeholder="Search school members" /></div><button class="platform-button" type="submit">Search members</button></form>
 <ul class="member-directory-list">
 <% for(const member of it.members) { const state=member.status==='active'?'active':member.access_state==='active'?'removed':member.access_state; %>
 <li class="member-directory-row"><div class="member-directory-identity"><span class="member-avatar" aria-hidden="true"><%= (member.display_name||member.email||'M').slice(0,1).toUpperCase() %></span><div><strong><%= member.display_name||'School member' %></strong><span><%= member.email||'No email available' %></span></div></div><div class="member-directory-meta"><span class="platform-badge"><%= member.role %></span><span class="platform-badge platform-badge--<%= state==='active'?'active':state==='suspended'?'pending':'closed' %>"><%= state %></span></div>
 <% if(it.school.status==='active'&&['student','moderator'].includes(member.role)) { %><details class="member-actions"><summary>Manage access</summary><div><% if(state!=='active') { %><a href="<%= it.base %>/<%= member.user_id %>?action=restore">Restore access</a><% } %><% for(const [value,label] of [['suspended','Suspend'],['banned','Ban'],['removed','Remove from school']]) { if(state===value)continue; %><a href="<%= it.base %>/<%= member.user_id %>?action=<%= value %>"><%= label %></a><% } %></div></details><% } else { %><span class="platform-help"><%= member.role==='admin'?'Protected administrator':'School inactive' %></span><% } %></li>
 <% } %></ul>
 <% if(!it.members.length) { %><%~ include('partials/empty-state',{icon:'users',heading:it.q?'No members match this search':'No school members to display',description:it.q?'Try another name or email address.':'Accepted invitations and approved students appear here.',actions:it.q?[{href:it.base,label:'Clear search',secondary:true}]:[]}) %><% } %>
 <nav class="platform-pagination platform-pagination--panel" aria-label="Member pages"><% if(it.page>0) { %><a class="platform-button" href="<%= it.base %>?q=<%= encodeURIComponent(it.q) %>&page=<%= it.page-1 %>">Previous</a><% } %><span>Page <%= it.page+1 %></span><% if(it.next) { %><a class="platform-button" href="<%= it.base %>?q=<%= encodeURIComponent(it.q) %>&page=<%= it.page+1 %>">Next members</a><% } %></nav>
 </section>
 <p class="platform-help">Suspension lasts until restored. A ban or removal also prevents automatic rejoining. These controls do not delete a person’s SuggFeed account.</p>
</div><% if(portalShell) { %></div><% } %></main>
