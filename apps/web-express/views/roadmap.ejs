<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <meta name="description" content="See which ideas are in progress and what's been resolved on SuggFeed." />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>(function(){var t=localStorage.getItem('sf-theme')||'system';document.documentElement.setAttribute('data-theme',t==='dark'?'dark':t==='light'?'light':window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');})()</script>
</head>
<body>
<%- include('partials/header') %>
<%- include('partials/toast') %>
<%- include('partials/auth-modal') %>

<main class="sf-main">
  <section style="padding:32px 0 64px">
    <div style="max-width:1200px;margin:0 auto;padding:0 20px">
      <div style="margin-bottom:32px">
        <p class="sf-section-eyebrow">PROGRESS TRACKER</p>
        <h1 class="sf-section-title">Roadmap</h1>
        <p style="font-size:14px;color:var(--muted)">Track how community ideas are progressing.</p>
      </div>

      <!-- Kanban board -->
      <div class="roadmap-board" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start">

        <!-- Approved column -->
        <div class="roadmap-col">
          <div class="roadmap-col-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div style="display:flex;align-items:center;gap:10px">
              <span class="roadmap-col-dot" style="width:10px;height:10px;border-radius:50%;background:#3b82f6;display:inline-block"></span>
              <h2 style="font-size:14px;font-weight:700;color:var(--ink);margin:0">Approved</h2>
            </div>
            <span class="roadmap-col-count" style="font-size:12px;font-weight:600;background:var(--surface-2);border-radius:20px;padding:2px 10px">
              <%= columns.approved.length %>
            </span>
          </div>
          <div class="roadmap-col-body" style="display:flex;flex-direction:column;gap:12px">
            <% if (columns.approved.length === 0) { %>
              <p style="text-align:center;color:var(--muted);font-size:13px;padding:24px 0">No ideas here yet.</p>
            <% } %>
            <% columns.approved.forEach(function(item) { %>
              <%- include('partials/roadmap-card', { item: item }) %>
            <% }) %>
          </div>
        </div>

        <!-- In Progress column -->
        <div class="roadmap-col">
          <div class="roadmap-col-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div style="display:flex;align-items:center;gap:10px">
              <span class="roadmap-col-dot" style="width:10px;height:10px;border-radius:50%;background:#f59e0b;display:inline-block"></span>
              <h2 style="font-size:14px;font-weight:700;color:var(--ink);margin:0">In Progress</h2>
            </div>
            <span class="roadmap-col-count" style="font-size:12px;font-weight:600;background:var(--surface-2);border-radius:20px;padding:2px 10px">
              <%= columns.in_progress.length %>
            </span>
          </div>
          <div class="roadmap-col-body" style="display:flex;flex-direction:column;gap:12px">
            <% if (columns.in_progress.length === 0) { %>
              <p style="text-align:center;color:var(--muted);font-size:13px;padding:24px 0">No ideas here yet.</p>
            <% } %>
            <% columns.in_progress.forEach(function(item) { %>
              <%- include('partials/roadmap-card', { item: item }) %>
            <% }) %>
          </div>
        </div>

        <!-- Resolved column -->
        <div class="roadmap-col">
          <div class="roadmap-col-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div style="display:flex;align-items:center;gap:10px">
              <span class="roadmap-col-dot" style="width:10px;height:10px;border-radius:50%;background:#22c55e;display:inline-block"></span>
              <h2 style="font-size:14px;font-weight:700;color:var(--ink);margin:0">Resolved</h2>
            </div>
            <span class="roadmap-col-count" style="font-size:12px;font-weight:600;background:var(--surface-2);border-radius:20px;padding:2px 10px">
              <%= columns.resolved.length %>
            </span>
          </div>
          <div class="roadmap-col-body" style="display:flex;flex-direction:column;gap:12px">
            <% if (columns.resolved.length === 0) { %>
              <p style="text-align:center;color:var(--muted);font-size:13px;padding:24px 0">No ideas here yet.</p>
            <% } %>
            <% columns.resolved.forEach(function(item) { %>
              <%- include('partials/roadmap-card', { item: item }) %>
            <% }) %>
          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<script>
window.SUPABASE_URL = '<%- supabaseUrl %>';
window.SUPABASE_ANON_KEY = '<%- supabaseAnonKey %>';
window._supabase = window.supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);

window._supabase.auth.onAuthStateChange(async (event, session) => {
  if (event === 'SIGNED_IN' && session) {
    await fetch('/auth/session', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ access_token: session.access_token, refresh_token: session.refresh_token, user: session.user }) });
    window.location.reload();
  }
  if (event === 'SIGNED_OUT') { await fetch('/auth/signout', { method: 'POST' }); window.location.reload(); }
});

document.getElementById('theme-btn')?.addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  localStorage.setItem('sf-theme', next);
  document.documentElement.setAttribute('data-theme', next);
});
</script>
