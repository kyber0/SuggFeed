<% const brief=it.studentBrief; %><section data-sf-reveal="fade" class="student-home-brief" aria-labelledby="student-next-title"><header><div><p class="student-eyebrow">YOUR SCHOOL SPACE</p><h2 id="student-next-title">Your campus, at a glance</h2><p>Private activity stays with your account in <%= it.schoolName || 'this school' %>.</p></div><a class="student-text-link" href="/profile">My activity →</a></header><div class="student-next-actions"><a href="/inbox?view=needs-reply"><span class="student-action-symbol" aria-hidden="true"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><use href="#ws-message"/></svg></span><div><strong><%= brief?.needsReply==null?'Check private questions':brief.needsReply?'Your reply is needed':'Private school questions' %></strong><span><%= brief?.needsReply==null?'Open your inbox to check for requests.':brief.needsReply?brief.needsReply+' open requests for your account’s ideas':'No reply needed right now.' %></span></div></a><a href="/notifications"><span class="student-action-symbol" aria-hidden="true"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><use href="#ws-bell"/></svg></span><div><strong>School updates</strong><span>Progress from ideas you follow.</span></div></a></div><section class="student-recent-ideas"><h3>Your recent ideas</h3><% if(brief?.itemsUnavailable) { %><p role="status">Your recent ideas could not load. <a href="/profile">Open My ideas to retry.</a></p><% } else if(brief?.items?.length) { %><div><% for(const item of brief.items) {const state=it.studentIdeaState(item,it.schoolCustomization?.labels); %><a href="/submission/<%= item.id %>"><span class="student-state" data-tone="<%= state.tone %>"><%= state.label %></span><strong><%= item.title %></strong><span aria-hidden="true">→</span></a><% } %></div><% } else { %><p>You haven’t submitted an identified idea here yet. Share feedback below, or <a href="/?track=1#action-hub">track an anonymous submission with your private code</a>.</p><% } %></section></section>