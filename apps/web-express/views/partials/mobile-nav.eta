<!-- Mobile Tab Bar (Bottom Navigation) -->
<nav class="mobile-tab-bar" aria-label="Mobile navigation">
  <a href="/" class="mobile-tab<%= it.currentPath === '/' ? ' mobile-tab--active' : '' %>" aria-current="<%= it.currentPath === '/' ? 'page' : 'false' %>">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="<%= it.currentPath === '/' ? '2.5' : '1.8' %>"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>Home</span>
  </a>

  <a href="/feed" class="mobile-tab<%= it.currentPath === '/feed' || it.currentPath === '/roadmap' ? ' mobile-tab--active' : '' %>" aria-current="<%= it.currentPath === '/feed' || it.currentPath === '/roadmap' ? 'page' : 'false' %>">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="<%= it.currentPath === '/feed' || it.currentPath === '/roadmap' ? '2.5' : '1.8' %>"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span>Ideas</span>
  </a>

  <a href="/profile" class="mobile-tab<%= ['/profile','/notifications','/inbox'].includes(it.currentPath) ? ' mobile-tab--active' : '' %>" aria-current="<%= ['/profile','/notifications','/inbox'].includes(it.currentPath) ? 'page' : 'false' %>">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="<%= ['/profile','/notifications','/inbox'].includes(it.currentPath) ? '2.5' : '1.8' %>"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    <span>My activity</span>
  </a>

</nav>
