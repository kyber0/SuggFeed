<header class="site-header">
  <a class="brand" href="/">Sugg<span>Feed</span></a>
  <nav>
    <a href="/" class="nav-link-hide-mobile<%= currentPath === '/' ? ' active' : '' %>">Home</a>
    <a href="/feed" class="nav-link-hide-mobile<%= currentPath === '/feed' ? ' active' : '' %>">Community ideas</a>
    <a href="/roadmap" class="nav-link-hide-mobile<%= currentPath === '/roadmap' ? ' active' : '' %>">Roadmap</a>
    <% if (user && (locals.role === 'admin' || locals.role === 'moderator')) { %>
      <a href="/admin" class="nav-link-hide-mobile<%= currentPath === '/admin' ? ' active' : '' %>">Staff portal</a>
    <% } %>

    <% if (user) { %>
      <!-- Signed-in: avatar chip with dropdown -->
      <div style="position:relative" id="avatar-wrap">
        <button class="avatar-chip" id="avatar-btn" aria-haspopup="true" aria-expanded="false">
          <div class="avatar-circle">
            <% if (user.avatar_url) { %>
              <img src="<%= user.avatar_url %>" alt="<%= (user.full_name || user.email || 'U')[0].toUpperCase() %>"
                style="width:100%;height:100%;border-radius:50%;object-fit:cover" referrerpolicy="no-referrer" />
            <% } else { %>
              <%= (user.full_name || user.email || 'U')[0].toUpperCase() %>
            <% } %>
          </div>
          <span><%= (user.full_name || user.email || 'Account').split(' ')[0] %></span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
            stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu" id="avatar-dropdown" style="display:none">
          <div class="dropdown-user-header">
            <div class="dropdown-user-name"><%= user.full_name || 'Account' %></div>
            <div class="dropdown-user-email"><%= user.email %></div>
          </div>
          <div class="divider"></div>
          <a href="/profile" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;padding:8px 12px">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
            </svg>
            My Profile &amp; Ideas
          </a>
          <% if (locals.role === 'admin' || locals.role === 'moderator') { %>
          <a href="/admin" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;padding:8px 12px;font-weight:600">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Staff Portal
          </a>
          <% } %>
          <div class="divider"></div>
          <button class="danger" id="signout-btn" style="display:flex;align-items:center;gap:8px">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Sign out
          </button>
        </div>
      </div>
    <% } else { %>
      <!-- Signed-out: Profile + Sign in -->
      <a href="/profile" class="btn-ghost<%= currentPath === '/profile' ? ' active' : '' %>"
        style="display:flex;align-items:center;gap:5px;text-decoration:none">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="profile-label">Profile</span>
      </a>
      <button class="btn-primary-sm" id="open-signin-btn">Sign in</button>
    <% } %>

    <div style="width:1px;height:24px;background:var(--line-2);margin:0 4px"></div>
    <!-- Theme toggle -->
    <button class="theme-toggle" id="theme-btn" title="Toggle theme" aria-label="Toggle theme">
      <svg class="theme-icon theme-icon--sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="theme-icon theme-icon--moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </nav>
</header>

<script>
(function() {
  // Avatar dropdown toggle
  const btn = document.getElementById('avatar-btn');
  const drop = document.getElementById('avatar-dropdown');
  if (btn && drop) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const open = drop.style.display !== 'none';
      drop.style.display = open ? 'none' : 'block';
      btn.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('mousedown', function(e) {
      if (!document.getElementById('avatar-wrap')?.contains(e.target)) {
        drop.style.display = 'none';
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Sign-out
  const signoutBtn = document.getElementById('signout-btn');
  if (signoutBtn) {
    signoutBtn.addEventListener('click', async function() {
      await window._supabase?.auth.signOut();
      await fetch('/auth/signout', { method: 'POST' });
      window.location.href = '/';
    });
  }

  // Open sign-in modal
  const openSignin = document.getElementById('open-signin-btn');
  if (openSignin) {
    openSignin.addEventListener('click', function() {
      if (typeof window.openAuthModal === 'function') {
        window.openAuthModal('signin');
      } else {
        const modal = document.getElementById('auth-modal');
        if (modal) {
          modal.style.display = 'flex';
          modal.removeAttribute('hidden');
        }
      }
    });
  }
})();
</script>
