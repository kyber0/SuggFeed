<% const r=it.review;const fields=[['privacy_notice','Privacy notice'],['terms_notice','Participation terms'],['age_policy','Age policy'],['privacy_contact','Privacy contact'],['school_contact','Institutional contact'],['publication_policy','Publication'],['retention_days','Retention days']];const describe=v=>Array.isArray(v)?v.map(x=>typeof x==='object'?x.label||'Question':x).join(', '):v===undefined||v===null||v===''?'Not set':String(v); %>
<article class="pv-review-detail pv-card" id="platform-review-detail">
<% if(!r){ %><%~ include('empty-state',{compact:true,icon:'inbox',heading:'Select a review',description:'Choose an item from the queue to inspect its current saved version.'}) %>
<% }else if(r.unavailable){ %><h2>Review unavailable</h2><p>Your queue is still available. Reload to retry this item.</p>
<% }else if(r.missing){ %><h2>Review not found</h2><p>This record may no longer be available. Choose another item.</p>
<% }else{ %>
<header class="pv-review-heading"><div><p class="platform-eyebrow"><%= it.reviewTypes.find(x=>x[0]===it.reviewType)?.[1] %></p><h2><%= r.name %></h2><p>/s/<%= r.slug %> <%= r.type==='applications'?'': '· '+(r.type==='forms'?'Revision '+r.revision:r.settings?'Version '+r.settings.version:'No submitted policy') %></p></div><a class="platform-text-link" href="<%= it.url({section:'reviews',reviewType:it.reviewType,page:it.page,q:it.q}) %>">Back to queue</a></header>
<% if(it.reviewError){ %><p class="pv-notice pv-error" role="alert"><%= it.reviewError %></p><% } %>
<% if(!r.pending){ %><p class="pv-notice"><%= r.type==='policies'&&!r.live?.approved_at?'No complete policy has been submitted for review. Ask the school administrator to save its notices and contacts.':r.type==='forms'?'This draft has no pending form review request.':'This item is no longer pending. A second decision cannot be submitted here.' %></p><% } %>
<% if(r.type==='applications'){ %><dl class="platform-facts"><div><dt>Representative</dt><dd><%= r.contact_name %></dd></div><div><dt>Institutional contact</dt><dd><%= r.contact_email %></dd></div><div><dt>Submitted</dt><dd><%= new Date(r.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %></dd></div></dl><h3>Authority statement</h3><p class="pv-preserve"><%= r.authority_statement %></p><p class="pv-notice">Approval creates a pending workspace. Policies, administrator access and activation checks still apply.</p><% if(!it.businessReady){ %><p class="pv-notice">Service setup must be complete before approval. <a href="<%= it.url({section:'setup'}) %>">View setup</a></p><% } %>
<% }else if(r.type==='policies'&&r.settings){ %><p class="pv-meta"><%= r.live?.approved_at?'Approved v'+r.live.version+' remains live until this replacement is approved.':'This school has no approved policy version.' %></p><div class="pv-policy-diff"><% for(const [key,label] of fields){const before=r.live?.approved_at?r.live[key]:undefined,after=r.settings[key],changed=before!==after; %><details <%= ['privacy_contact','school_contact','publication_policy','retention_days'].includes(key)?'open':'' %>><summary><%= label %><span><%= changed?'Changed / new':'Unchanged' %></span></summary><dl class="pv-comparison"><div><dt>Currently approved</dt><dd><%= describe(before) %></dd></div><div><dt>Submitted v<%= r.settings.version %></dt><dd><%= describe(after) %></dd></div></dl></details><% } %></div>
<% }else if(r.type==='forms'&&r.form){ %><p class="pv-notice">Review collection against <%= r.live?.approved_at?'approved policy v'+r.live.version:'an approved school policy (not yet available)' %>. This decision does not certify legal compliance.</p><dl class="pv-comparison"><div><dt>Published image collection</dt><dd><%= r.publishedForm?.attachments||'Not configured' %></dd></div><div><dt>Submitted image collection</dt><dd><%= r.form.attachments %></dd></div></dl><h3>Instructions and example</h3><p class="pv-preserve"><%= r.form.instructions||'No custom instructions.' %></p><p class="pv-preserve"><%= r.form.example||'No custom example.' %></p><h3>Submitted questions</h3><% if(!r.form.questions.length){ %><p>No additional questions.</p><% } %><ol class="pv-question-list"><% for(const q of r.form.questions){const previous=r.publishedForm?.questions?.find(old=>old.id===q.id); %><li><strong><%= q.label %></strong><span><%= q.type %> · <%= q.required?'Required':'Optional' %> · <%= previous?'Existing question':'New collection' %></span><% if(q.help){ %><p><%= q.help %></p><% } %><% if(q.options.length){ %><p>Choices: <%= q.options.join(', ') %></p><% } %><% if(previous){ %><details><summary>Compare published question</summary><p><%= previous.label %> · <%= previous.type %> · <%= previous.required?'Required':'Optional' %></p><p><%= previous.help %></p><p><%= previous.options?.join(', ') %></p></details><% } %></li><% } %></ol><% const removed=(r.publishedForm?.questions||[]).filter(old=>!r.form.questions.some(q=>q.id===old.id));if(removed.length){ %><h3>Removed from future forms</h3><ul><% for(const q of removed){ %><li><%= q.label %></li><% } %></ul><p>Historical answers and wording remain available.</p><% } %>
<% } %>
<% if(r.pending){ %><form class="pv-review-form" method="post" action="/platform/reviews/<%= r.type %>/<%= r.id %>"><input type="hidden" name="returnTo" value="<%= it.currentUrl %>"/><input type="hidden" name="version" value="<%= r.type==='forms'?r.revision:r.settings?.version||'' %>"/><label for="platform-review-reference">Completed verification and review reference</label><textarea class="workspace-input" id="platform-review-reference" name="reference" required minlength="10" maxlength="2000" rows="3"><%= it.reference||'' %></textarea><p class="pv-meta">Record actual evidence. The saved version and your permission are checked again on submission.</p><div class="pv-actions"><button class="platform-button platform-button--primary" type="submit" name="decision" value="approved" <%= (r.type==='applications'&&!it.businessReady||r.type==='forms'&&!r.live?.approved_at)?'disabled':'' %>><%= r.type==='applications'?'Approve pending workspace':r.type==='policies'?'Approve this policy version':'Approve collection changes' %></button><% if(r.type==='applications'){ %><button class="platform-button" type="submit" name="decision" value="rejected">Reject application</button><% } %></div></form><% } %>
<% } %><% if(it.reference&&(!r||r.unavailable||r.missing||!r.pending)){ %><details class="pv-recovery" open><summary>Your review reference is preserved</summary><label for="platform-reference-recovery">Copy this reference before leaving</label><textarea class="workspace-input" id="platform-reference-recovery" rows="4" readonly><%= it.reference %></textarea><p class="pv-meta">No new review decision was submitted by this recovery view.</p></details><% } %></article>
