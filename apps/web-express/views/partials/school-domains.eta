<section class="school-settings-card" id="school-domains" data-workspace-panel aria-labelledby="school-domains-title">
 <header><span class="school-settings-step" aria-hidden="true"><svg class="workspace-svg"><use href="#ws-mail"/></svg></span><div><h2 id="school-domains-title">Student joining by school email</h2><p>Let students join with a verified school email instead of individual invitations.</p></div></header>
 <div class="school-settings-card-body">
  <% if(it.domainNotice) { %><p class="school-settings-feedback" role="status"><%= it.domainNotice %></p><% } %>
  <ol class="domain-steps"><li>Add your exact student email domain.</li><li>Publish the DNS TXT record to prove your school controls it.</li><li>Verify, then enable student joining.</li></ol>
  <p>For <strong>student@my.cspc.edu.ph</strong>, enter <strong>my.cspc.edu.ph</strong>. Subdomains do not match automatically. Keep the verification record published while joining is enabled. Gmail and other personal email providers can use an approved email list, an access request or an invitation instead of domain joining.</p>
  <form class="care-form domain-add" method="post" action="<%= it.domainAction %>"><label for="school-email-domain">School email domain <span>Required</span></label><input class="workspace-input" id="school-email-domain" name="domain" type="text" required maxlength="243" autocapitalize="none" spellcheck="false" placeholder="my.cspc.edu.ph" aria-describedby="domain-help"/><small id="domain-help">School administrators need access to the domain’s DNS settings. This does not change your email delivery records.</small><button class="workspace-button" type="submit">Add domain</button></form>
  <% if(!it.domains?.length) { %><%~ include('./empty-state',{compact:true,icon:'mail',heading:'Connect your school’s email domain',description:'Once verified and enabled, matching students will see a Join your school button after signing in.'}) %><% } %>
  <% for(const item of it.domains || []) { %><article class="domain-card"><div class="domain-card-heading"><h3><%= item.domain %></h3><span class="platform-badge <%= item.join_enabled?'platform-badge--active':'platform-badge--pending' %>"><%= item.join_enabled?'Joining enabled':item.verified_at?'Verified · joining disabled':'Verification needed' %></span></div>
   <p>DNS record type: <strong>TXT</strong></p><label for="domain-host-<%= item.id %>">Full DNS host</label><input id="domain-host-<%= item.id %>" class="workspace-input" readonly value="_suggfeed.<%= item.domain %>"/><label for="domain-value-<%= item.id %>">TXT value</label><textarea id="domain-value-<%= item.id %>" class="workspace-input" readonly rows="3">suggfeed-verification=<%= item.verification_token %></textarea><p class="staff-footnote">If your DNS provider adds the zone name automatically, enter only the host portion within that zone. Do not replace your MX, SPF, or DKIM records.</p>
   <form method="post" action="<%= it.domainAction %>/<%= item.id %>" class="domain-actions"><button class="workspace-button" type="submit" name="action" value="verify"><%= item.verified_at?'Recheck DNS':'Verify DNS' %></button><% if(item.join_enabled) { %><button class="workspace-button" type="submit" name="action" value="disable">Disable joining</button><% } else if(item.verified_at) { %><button class="workspace-button workspace-button--primary" type="submit" name="action" value="enable" <%= it.school.status!=='active' || !it.savedSettings?.approved_at?'disabled':'' %>>Enable student joining</button><% } %><button class="workspace-button" type="submit" name="action" value="remove">Remove domain</button></form>
   <% if(it.school.status!=='active' || !it.savedSettings?.approved_at) { %><p class="staff-footnote">Joining can be enabled after school activation and review of its current policies.</p><% } %>
  </article><% } %>
  <p class="staff-footnote">Joining grants student access only. Existing roles and revoked memberships are preserved. Staff access is managed through invitations and school administration.</p>
 </div>
</section>
