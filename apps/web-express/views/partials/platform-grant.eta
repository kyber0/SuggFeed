<section class="pv-card"><h2>Studio access</h2><% if(it.editorUnavailable){ %><p>Editor state is unavailable. Reload before making changes.</p><% }else{ %><p><span class="platform-badge"><%= it.editor?.editing_enabled?'Enabled for school admins':'Editing paused' %></span></p><p>Enabling applies to all active admins in this school. Pausing stops editing; the published appearance stays available. This does not activate the school or grant membership.</p><% if(it.grant){ %><p class="pv-meta">Last changed <%= new Date(it.grant.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %> by <%= it.grant.profiles?.display_name||'a recorded operator' %>.</p><% }else{ %><p class="pv-meta"><%= it.grantUnavailable?'Grant history unavailable.':'No grant change recorded.' %></p><% } %><% if(it.school.status!=='closed'){ %><form method="post" action="/platform/schools/<%= it.school.id %>/editor-grant"><input type="hidden" name="returnTo" value="<%= it.currentUrl %>"/><input type="hidden" name="enabled" value="<%= it.editor?.editing_enabled?'false':'true' %>"/><button type="submit" class="platform-button"><%= it.editor?.editing_enabled?'Pause editing':'Enable editing' %></button></form><% } %><% } %></section>
