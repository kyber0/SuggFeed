<%
const a=it.overviewAnalytics;
const icon=name=>'<svg class="workspace-svg" aria-hidden="true"><use href="#ws-'+name+'"></use></svg>';
const range=it.overviewRange||'30d';const period=range==='7d'?'7':range==='90d'?'90':'30';
const stages=[['pending','Needs review','/admin/reviews?status=pending#review-workspace'],['approved','Planned','/admin/work?presentation=board#board-lane-approved'],['in_progress','In progress','/admin/work?presentation=board#board-lane-in_progress'],['resolved','Completed','/admin/work?presentation=board#board-lane-resolved'],['rejected','Declined','/admin/reviews?status=rejected#review-workspace']];
%>
<section id="overview-workspace" data-workspace-panel data-overview-root class="admin-overview" aria-labelledby="overview-heading">
 <header class="overview-heading"><div><p class="workspace-kicker">SCHOOL PULSE</p><h2 id="overview-heading">A clearer view of your community</h2><p>See what students are sharing and where your team can make a difference.</p></div><a class="workspace-button" href="/admin/analytics?range=<%= range %>"><%~ icon('chart') %> Detailed analytics</a></header>
 <nav class="overview-periods" aria-label="Overview reporting period"><span>Reporting period</span><div><% for(const [value,label] of [['7d','7 days'],['30d','30 days'],['90d','90 days']]) { %><a href="/admin?overviewRange=<%= value %>#overview-workspace" <%= range===value?'aria-current="page"':'' %>><%= label %></a><% } %></div></nav>
 <% if(!a) { %><%~ include('empty-state',{icon:'chart',heading:'Analytics is temporarily unavailable',description:'You can still review submissions and manage your school. Reload this overview to try again.',actions:[{href:'/admin?overviewRange='+range+'#overview-workspace',label:'Reload overview'},{href:'/admin/reviews',label:'Open review queue',secondary:true}]}) %><% } else {
 const k=a.kpis,comparison=a.comparisonCount>0;
 const metrics=[['Ideas received',k.totalSubmissions.value,'Submitted in the last '+period+' days','inbox',comparison?k.totalSubmissions.delta:null],['Student support',k.totalVotes.value,'Current votes on these ideas','care',null],['Completed ideas',a.statusCounts.resolved,'Among ideas received in this period','check',null],['Awaiting review',it.counts.pending,'Across the whole school · current queue','clock',null]];
 const timeline=a.timeline||[];const peak=Math.max(0,...timeline.map(point=>point.submissions));
 const graph=(metric)=>{const ceiling=Math.max(1,...timeline.map(point=>point[metric]));const points=timeline.map((point,index)=>[32+(timeline.length>1?index/(timeline.length-1):0)*736,196-point[metric]/ceiling*160]);return {ceiling,points,line:points.map((point,index)=>(index?'L':'M')+point.join(',')).join(' '),area:points.length?'M32,196 '+points.map(point=>'L'+point.join(',')).join(' ')+' L'+points[points.length-1][0]+',196 Z':''};};
 %>
 <div class="overview-metrics"><% for(const [name,value,hint,graphic,change] of metrics) { %><article class="overview-metric" data-overview-entrance><div class="overview-metric-top"><span><%= name %></span><span class="overview-metric-icon"><%~ icon(graphic) %></span></div><div class="overview-metric-value"><strong><%= Number(value||0).toLocaleString('en-PH') %></strong><% if(change!==null) { %><span class="overview-delta"><%= change>0?'+':'' %><%= change %>%<span class="visually-hidden"> compared with the previous equal period</span></span><% } %></div><p><%= hint %></p></article><% } %></div>
 <div class="overview-chart-grid">
 <section class="overview-panel overview-trend" data-overview-entrance aria-labelledby="overview-trend-title">
  <header class="overview-panel-heading"><div><h3 id="overview-trend-title">Community activity</h3><p>Ideas by submission date · last <%= period %> days</p></div><div class="overview-chart-switch" data-overview-interactive hidden aria-label="Activity measure"><button type="button" data-overview-metric="submissions" aria-pressed="true">Ideas</button><button type="button" data-overview-metric="votes" aria-pressed="false">Support</button></div></header>
  <% if(k.totalSubmissions.value===0) { %><div class="overview-chart-empty"><span class="overview-metric-icon"><%~ icon('chart') %></span><strong>Your next idea starts the story</strong><p>No ideas were received in this period. Choose another period or invite your community to participate.</p></div><% } else { %>
  <div class="overview-chart-summary"><strong data-overview-chart-total><%= k.totalSubmissions.value.toLocaleString('en-PH') %></strong><span data-overview-chart-caption>ideas received</span><span class="overview-chart-note">Peak: <%= peak %> ideas in one day</span></div>
  <div class="overview-chart" data-overview-chart><svg viewBox="0 0 800 232" role="img" aria-labelledby="overview-graph-label" preserveAspectRatio="none"><title id="overview-graph-label">Daily idea submissions over the last <%= period %> days. Exact daily values are available below.</title>
  <% for(const y of [36,76,116,156,196]) { %><line class="overview-grid-line" x1="32" x2="768" y1="<%= y %>" y2="<%= y %>"/><% } %>
  <% for(const metric of ['submissions','votes']) { const g=graph(metric); %><g data-overview-series="<%= metric %>" <%= metric==='votes'?'hidden':'' %>><text x="10" y="27" class="overview-axis"><%= g.ceiling %></text><text x="10" y="201" class="overview-axis">0</text><path class="overview-area" d="<%= g.area %>"/><path class="overview-line" d="<%= g.line %>" vector-effect="non-scaling-stroke"/></g><% } %>
  <line data-overview-guide class="overview-guide" x1="768" x2="768" y1="30" y2="196" hidden/><circle data-overview-dot class="overview-dot" cx="768" cy="196" r="5" hidden/>
  </svg></div>
  <div class="overview-chart-labels"><span><%= timeline[0]?.date %></span><span><%= timeline[Math.floor(timeline.length/2)]?.date %></span><span><%= timeline[timeline.length-1]?.date %></span></div>
  <div class="overview-scrubber" data-overview-interactive hidden><label class="visually-hidden" for="overview-day">Explore daily activity. Use arrow keys to change the day.</label><input id="overview-day" data-overview-day type="range" min="0" max="<%= Math.max(0,timeline.length-1) %>" value="<%= Math.max(0,timeline.length-1) %>"/><output for="overview-day" data-overview-readout></output></div>
  <details class="overview-data-table"><summary>View daily values</summary><div tabindex="0" role="region" aria-label="Daily activity data"><table><caption>Ideas by submission date and their current support totals</caption><thead><tr><th scope="col">Date</th><th scope="col">Ideas</th><th scope="col">Support</th></tr></thead><tbody><% for(const point of timeline) { %><tr><th scope="row"><%= point.date %></th><td><%= point.submissions %></td><td><%= point.votes %></td></tr><% } %></tbody></table></div></details>
  <% } %>
 </section>
 <section class="overview-panel" data-overview-entrance aria-labelledby="overview-pipeline-title"><header class="overview-panel-heading"><div><h3 id="overview-pipeline-title">From ideas to action</h3><p>Current status across all school ideas</p></div><span class="overview-total"><%= it.counts.all.toLocaleString('en-PH') %> total</span></header>
 <div class="overview-pipeline-bar" aria-hidden="true"><% for(const [status] of stages) { %><span class="overview-stage overview-stage--<%= status %>" style="flex-grow:<%= it.counts[status]||0 %>"></span><% } %></div>
 <div class="overview-stage-list"><% for(const [status,label,href] of stages) { %><a href="<%= href %>" class="overview-stage-row"><span class="overview-stage-dot overview-stage--<%= status %>" aria-hidden="true"></span><span><%= label %></span><strong><%= (it.counts[status]||0).toLocaleString('en-PH') %></strong><span class="overview-stage-percent"><%= it.counts.all?Math.round((it.counts[status]||0)/it.counts.all*100):0 %>%</span><%~ icon('arrow') %></a><% } %></div>
 <a class="overview-panel-link" href="/admin/work?presentation=board">Open manage work <%~ icon('arrow') %></a></section>
 </div>
 <section class="overview-panel overview-categories" data-overview-entrance aria-labelledby="overview-category-title"><header class="overview-panel-heading"><div><h3 id="overview-category-title">What your community cares about</h3><p>Categories ranked by idea volume in this period</p></div><a class="overview-panel-link" href="/admin/analytics?range=<%= range %>">All categories <%~ icon('arrow') %></a></header>
 <% if(!a.categories.length) { %><p class="overview-no-categories">Category insights appear when your school receives ideas.</p><% } else { %><div class="overview-category-grid"><% for(const category of a.categories.slice(0,5)) { %><a class="overview-category" href="/admin/analytics?range=<%= range %>&category=<%= encodeURIComponent(category.name) %>"><div><strong><%= category.name %></strong><span><%= category.count %> idea<%= category.count===1?'':'s' %> · <%= category.pct %>%</span></div><span class="overview-category-track" aria-hidden="true"><span style="transform:scaleX(<%= category.count/Math.max(1,a.categories[0].count) %>)"></span></span></a><% } %></div><% } %>
 </section>
 <p class="overview-scope">Period charts use the latest <%= a.snapshotCount %> available records (maximum <%= a.recordLimit %>); older records may be excluded. Philippine time. Support means current votes on ideas submitted in the period, not votes cast during the period. <%= comparison?'Idea volume is compared with the previous equal period.':'No prior-period comparison is available in this snapshot.' %></p>
 <script type="application/json" id="overview-chart-data"><%~ JSON.stringify({timeline,totals:{submissions:k.totalSubmissions.value,votes:k.totalVotes.value},period}).replace(/</g,'\\u003c') %></script>
 <% } %>
</section>
