<style>
.auth-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(10, 20, 40, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: am-fade-in 200ms ease both;
}
.auth-modal-backdrop[hidden] {
  display: none !important;
}
.auth-modal-card {
  position: relative;
  background: var(--surface, #ffffff);
  border: 1px solid var(--line, #d9e2ec);
  border-radius: 20px;
  width: 100%;
  max-width: 440px;
  max-height: 92dvh;
  overflow-y: auto;
  padding: 32px 28px 28px;
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.25), 0 4px 20px rgba(0, 0, 0, 0.1);
  color: var(--ink, #102a43);
  box-sizing: border-box;
}
[data-theme="dark"] .auth-modal-card {
  background: #0f172a;
  border-color: rgba(255, 255, 255, 0.1);
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
  color: #f1f5f9;
}
.auth-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: var(--surface-hover, rgba(0,0,0,0.05));
  color: var(--muted, #627d98);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 140ms ease;
}
.auth-modal-close:hover {
  background: var(--line, rgba(0,0,0,0.1));
  color: var(--ink, #102a43);
}
.auth-tabs {
  display: flex;
  border-bottom: 2px solid var(--line, #d9e2ec);
  margin-bottom: 24px;
}
.auth-tab {
  flex: 1;
  background: none;
  border: none;
  cursor: pointer;
  padding: 10px 12px 12px;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  color: var(--muted, #627d98);
  position: relative;
  transition: color 150ms ease;
}
.auth-tab.active {
  color: var(--navy, #0b3857);
}
[data-theme="dark"] .auth-tab.active {
  color: #38bdf8;
}
.auth-tab.active::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: currentColor;
  border-radius: 2px 2px 0 0;
}
.auth-title {
  font-size: 22px;
  font-weight: 800;
  margin: 0 0 6px;
  letter-spacing: -0.02em;
}
.auth-subtitle {
  font-size: 13.5px;
  color: var(--muted, #627d98);
  margin: 0 0 20px;
}
.auth-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
  text-align: left;
}
.auth-field label {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--ink-2, #243b53);
}
[data-theme="dark"] .auth-field label {
  color: #cbd5e1;
}
.auth-field input, .auth-field textarea, .auth-field select {
  width: 100%;
  padding: 10px 14px;
  border-radius: 10px;
  border: 1.5px solid var(--line, #d9e2ec);
  background: var(--surface-hover, #f8fafc);
  color: inherit;
  font: inherit;
  font-size: 14px;
  transition: all 150ms ease;
  box-sizing: border-box;
}
[data-theme="dark"] .auth-field input,
[data-theme="dark"] .auth-field textarea,
[data-theme="dark"] .auth-field select {
  background: #1e293b;
  border-color: rgba(255, 255, 255, 0.12);
  color: #f1f5f9;
}
.auth-field input:focus, .auth-field textarea:focus, .auth-field select:focus {
  outline: none;
  border-color: #38bdf8;
  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
}
.auth-submit-btn {
  width: 100%;
  height: 44px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--navy, #0b3857) 0%, #1a5a8a 100%);
  color: #ffffff;
  font: inherit;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 150ms ease, transform 150ms ease;
  margin-top: 6px;
}
.auth-submit-btn:hover {
  opacity: 0.92;
  transform: translateY(-1px);
}
.auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 18px 0;
  color: var(--muted, #627d98);
  font-size: 12px;
}
.auth-divider::before, .auth-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--line, #d9e2ec);
}
.auth-google-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: #ffffff;
  border: 1.5px solid #dadce0;
  border-radius: 12px;
  padding: 10px 16px;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  color: #3c4043;
  cursor: pointer;
  transition: all 150ms ease;
}
.auth-google-btn:hover {
  border-color: #a8c7fa;
  box-shadow: 0 2px 8px rgba(66, 133, 244, 0.15);
}
.auth-link-btn {
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  font-size: 12.5px;
  color: var(--navy, #0b3857);
  cursor: pointer;
  text-decoration: underline;
}
[data-theme="dark"] .auth-link-btn {
  color: #38bdf8;
}
.auth-error-banner {
  margin-top: 14px;
  padding: 10px 14px;
  border-radius: 10px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
  font-size: 13px;
}
</style>

<!-- Auth Modal -->
<div id="auth-modal" class="auth-modal-backdrop" hidden style="display: none;">
  <div class="auth-modal-card" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
    <button class="auth-modal-close" id="auth-modal-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Tabs -->
    <div class="auth-tabs" role="tablist">
      <button class="auth-tab active" id="tab-signin" role="tab" aria-selected="true">Sign in</button>
      <button class="auth-tab" id="tab-signup" role="tab" aria-selected="false">Sign up</button>
    </div>

    <!-- Sign In Panel -->
    <div id="panel-signin" class="auth-panel">
      <h2 id="auth-modal-title" class="auth-title">Welcome back</h2>
      <p class="auth-subtitle">Sign in to vote, comment and track your ideas.</p>
      <form id="signin-form" novalidate>
        <div class="auth-field">
          <label for="signin-email">Email</label>
          <input type="email" id="signin-email" autocomplete="email" placeholder="you@school.edu" required />
        </div>
        <div class="auth-field">
          <label for="signin-password">Password</label>
          <input type="password" id="signin-password" autocomplete="current-password" placeholder="••••••••" required />
        </div>
        <div class="auth-field-row" style="margin-bottom:12px;text-align:right">
          <button type="button" class="auth-link-btn" id="forgot-link">Forgot password?</button>
        </div>
        <button type="submit" class="auth-submit-btn" id="signin-submit">Sign in</button>
      </form>
      <div class="auth-divider"><span>or</span></div>
      <button class="auth-google-btn" id="google-signin-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </button>
    </div>

    <!-- Sign Up Panel -->
    <div id="panel-signup" class="auth-panel" hidden style="display: none;">
      <h2 class="auth-title">Create an account</h2>
      <p class="auth-subtitle">Join SuggFeed and start sharing ideas.</p>
      <form id="signup-form" novalidate>
        <div class="auth-field">
          <label for="signup-name">Display name</label>
          <input type="text" id="signup-name" autocomplete="name" placeholder="Your name" />
        </div>
        <div class="auth-field">
          <label for="signup-email">Email</label>
          <input type="email" id="signup-email" autocomplete="email" placeholder="you@school.edu" required />
        </div>
        <div class="auth-field">
          <label for="signup-password">Password</label>
          <input type="password" id="signup-password" autocomplete="new-password" placeholder="At least 8 characters" required />
        </div>
        <button type="submit" class="auth-submit-btn" id="signup-submit">Create account</button>
      </form>
    </div>

    <!-- Forgot Password Panel -->
    <div id="panel-forgot" class="auth-panel" hidden style="display: none;">
      <h2 class="auth-title">Reset password</h2>
      <p class="auth-subtitle">We'll email you a reset link.</p>
      <form id="forgot-form" novalidate>
        <div class="auth-field">
          <label for="forgot-email">Email</label>
          <input type="email" id="forgot-email" autocomplete="email" placeholder="you@school.edu" required />
        </div>
        <button type="submit" class="auth-submit-btn">Send reset link</button>
      </form>
      <div style="margin-top:14px;text-align:center">
        <button class="auth-link-btn" id="back-to-signin">← Back to sign in</button>
      </div>
    </div>

    <!-- Error/info banner -->
    <div id="auth-error" class="auth-error-banner" hidden style="display: none;"></div>
  </div>
</div>

<script>
(function() {
  const modal = document.getElementById('auth-modal');
  if (!modal) return;

  function showPanel(id) {
    ['panel-signin','panel-signup','panel-forgot'].forEach(p => {
      const el = document.getElementById(p);
      if (el) { el.setAttribute('hidden', ''); el.style.display = 'none'; }
    });
    const target = document.getElementById(id);
    if (target) { target.removeAttribute('hidden'); target.style.display = 'block'; }
  }
  function showError(msg) {
    const el = document.getElementById('auth-error');
    if (!el) return;
    el.textContent = msg;
    el.removeAttribute('hidden');
    el.style.display = 'block';
    setTimeout(() => { el.setAttribute('hidden', ''); el.style.display = 'none'; }, 6000);
  }
  function setLoading(btn, loading) {
    btn.disabled = loading;
    btn.dataset.orig = btn.dataset.orig || btn.textContent;
    btn.textContent = loading ? 'Loading…' : btn.dataset.orig;
  }

  // Tab switching
  document.getElementById('tab-signin')?.addEventListener('click', () => {
    document.getElementById('tab-signin').classList.add('active');
    document.getElementById('tab-signup').classList.remove('active');
    showPanel('panel-signin');
  });
  document.getElementById('tab-signup')?.addEventListener('click', () => {
    document.getElementById('tab-signup').classList.add('active');
    document.getElementById('tab-signin').classList.remove('active');
    showPanel('panel-signup');
  });
  document.getElementById('forgot-link')?.addEventListener('click', () => showPanel('panel-forgot'));
  document.getElementById('back-to-signin')?.addEventListener('click', () => showPanel('panel-signin'));

  // Close
  function closeModal() {
    modal.style.display = 'none';
    modal.setAttribute('hidden', '');
  }
  document.getElementById('auth-modal-close')?.addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  // Sign in
  document.getElementById('signin-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('signin-email').value;
    const password = document.getElementById('signin-password').value;
    const btn = document.getElementById('signin-submit');
    setLoading(btn, true);
    const { error } = await window._supabase.auth.signInWithPassword({ email, password });
    if (error) { showError(error.message); setLoading(btn, false); }
    // on success, onAuthStateChange fires → session saved → reload
  });

  // Sign up
  document.getElementById('signup-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('signup-name').value;
    const email = document.getElementById('signup-email').value;
    const password = document.getElementById('signup-password').value;
    const btn = document.getElementById('signup-submit');
    setLoading(btn, true);
    const { error } = await window._supabase.auth.signUp({
      email, password,
      options: { data: { full_name: name } }
    });
    if (error) { showError(error.message); setLoading(btn, false); }
    else { showError('Check your email to confirm your account!'); }
  });

  // Forgot password
  document.getElementById('forgot-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('forgot-email').value;
    const { error } = await window._supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + '/auth/callback'
    });
    if (error) showError(error.message);
    else showError('Password reset email sent!');
  });

  // Google
  document.getElementById('google-signin-btn')?.addEventListener('click', async () => {
    await window._supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.origin + '/auth/callback' }
    });
  });

  // Expose opener globally
  window.openAuthModal = function(tab = 'signin') {
    modal.style.display = 'flex';
    modal.removeAttribute('hidden');
    if (tab === 'signup') {
      document.getElementById('tab-signup').click();
    } else {
      document.getElementById('tab-signin').click();
    }
  };
})();
</script>
