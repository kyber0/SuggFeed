<% const item=it.item,admin=it.isAssignmentAdmin,staff=it.state?.staff||[],teams=it.state?.teams||[];const date=value=>value&&Number.isFinite(Date.parse(value))?new Date(value).toLocaleString('en-PH',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Manila'}):'Not set';const href=item.queueHref||(item.item_kind==='report'?'/admin/safety':(item.status==='pending'||item.status==='rejected'?'/admin/reviews':'/admin/board')+'?idea='+item.item_id+'&workView='+encodeURIComponent(it.view||'mine')+'&workPage='+String(it.list?.page||1));const deadline=item.acknowledged_at?item.due_at:item.ack_due_at||item.due_at;const needsAck=(item.assignee_id===it.user.id||item.can_acknowledge)&&!item.acknowledged_at; %>
<article class="portal-work-item assignment-card"><div class="portal-work-summary"><div><p class="workspace-kicker"><%= item.urgent?'URGENT · ':'' %><%= item.item_kind==='report'?'ADMIN-ONLY SAFETY REPORT':item.status==='pending'?'REVIEW IDEA':'DELIVERY WORK' %></p><h3><a href="<%= href %>"><%= item.title %></a></h3><p><%= item.assignee_name||item.team_name||'Needs an owner' %><span aria-hidden="true"> · </span><%= item.acknowledged_at?'Acknowledged':needsAck?'Awaiting your acknowledgement':'Not yet acknowledged' %></p><% if(deadline&&Number.isFinite(Date.parse(deadline))) { %><p class="portal-work-deadline" data-overdue="<%= Date.parse(deadline)<Date.now() %>"><%= item.acknowledged_at?'Delivery due':'Next deadline' %> <time datetime="<%= deadline %>"><%= date(deadline) %> PHT</time><%= Date.parse(deadline)<Date.now()?' · Overdue':'' %></p><% } %></div><div class="portal-work-primary"><% if(needsAck) { %><form method="post" action="/admin/assignments/action" data-assignment-form="acknowledge"><input type="hidden" name="id" value="<%= item.item_id %>"><input type="hidden" name="kind" value="<%= item.item_kind %>"><button class="workspace-button workspace-button--primary" type="submit">Acknowledge</button></form><% } else { %><a class="workspace-button workspace-button--primary" href="<%= href %>"><%= item.item_kind==='report'?'Review safety':item.status==='pending'?'Review idea':'Update progress' %> →</a><% } %></div></div>
<details class="portal-work-details"><summary>Ownership, deadlines &amp; history<% if(item.due_at) { %><span>Due <%= date(item.due_at) %></span><% } %></summary><dl class="assignment-facts"><div><dt>Team</dt><dd><%= item.team_name||'Individual assignment' %></dd></div><div><dt>Acknowledge by</dt><dd><%= date(item.ack_due_at) %></dd></div><div><dt>Delivery deadline</dt><dd><%= date(item.due_at) %></dd></div><div><dt>Routing reason</dt><dd><%= item.assignment_reason||'Not recorded' %></dd></div></dl><a class="workspace-text-link" href="<%= href %>">Open item →</a>
<% if(admin&&!item.assignee_id) { %><form method="post" action="/admin/assignments/action" data-assignment-form="retry"><input type="hidden" name="version" value="<%= item.assignment_version %>"><input type="hidden" name="id" value="<%= item.item_id %>"><input type="hidden" name="kind" value="<%= item.item_kind %>"><button class="workspace-button" type="submit">Retry routing</button></form><% } %>
<% if(admin) { %><details><summary>Reassign with a reason</summary><form method="post" action="/admin/assignments/action" data-assignment-form="assign" class="assignment-form"><input type="hidden" name="id" value="<%= item.item_id %>"/><input type="hidden" name="kind" value="<%= item.item_kind %>"/><input type="hidden" name="version" value="<%= item.assignment_version %>"/><label>Person<select class="workspace-input" name="person"><option value="">Team ownership only</option><% for(const p of staff.filter(p=>!item.restricted&&!item.urgent||p.role==='admin')) { %><option value="<%= p.user_id %>" <%= item.assignee_id===p.user_id?'selected':'' %>><%= p.display_name||'Staff member' %></option><% } %></select></label><label>Team<select class="workspace-input" name="team"><option value="">Individual ownership only</option><% for(const team of teams.filter(t=>t.active)) { %><option value="<%= team.id %>" <%= item.assignment_team_id===team.id?'selected':'' %>><%= team.name %></option><% } %></select></label><label class="assignment-wide">Reason<textarea class="workspace-input" name="note" required minlength="3" maxlength="500" rows="2"></textarea></label><button class="workspace-button" type="submit">Save reassignment</button></form></details><% } %><details data-assignment-history data-kind="<%= item.item_kind %>" data-id="<%= item.item_id %>"><summary>Assignment history</summary><ol class="assignment-history"></ol></details></details></article>
