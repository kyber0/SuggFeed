<% const lane=it.lane,today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Manila',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()); %>
<section class="staff-flow-lane" id="board-lane-<%= lane.status %>" data-drop-stage="<%= lane.status %>" aria-labelledby="board-title-<%= lane.status %>">
 <header class="staff-lane-heading"><h2 id="board-title-<%= lane.status %>" tabindex="-1"><%= lane.label %><span class="staff-lane-count" aria-label="<%= lane.count %> matching submissions"><%= lane.count.toLocaleString() %></span></h2><p><%= lane.count ? lane.from+'–'+lane.to+' of '+lane.count.toLocaleString() : 'No matching submissions' %></p></header>
 <div class="staff-lane-cards" role="region" tabindex="0" aria-label="<%= lane.label %> cards">
  <% for(const item of lane.items) { %>
  <article class="staff-flow-card" data-board-id="<%= item.id %>" draggable="true">
   <div class="staff-card-top"><label class="staff-card-select"><input type="checkbox" data-bulk-id="<%= item.id %>" aria-label="Select <%= item.title %>"/></label><span class="staff-card-category" title="<%= item.categories?.name || 'Other' %>"><%= item.categories?.name || 'Other' %></span><% if(['high','urgent'].includes(item.priority)) { %><span class="staff-card-priority" data-priority="<%= item.priority %>"><%= item.priority %></span><% } %></div>
   <h3><a href="/admin/work?presentation=board&idea=<%= item.id %>" data-review="<%= item.id %>" aria-haspopup="dialog" title="<%= item.title %>"><%= item.title %></a></h3>
   <% const target=typeof item.target_date==='string'&&/^\d{4}-\d{2}-\d{2}/.test(item.target_date)?item.target_date.slice(0,10):'',past=target&&target<today&&item.status!=='resolved';const percent=Number(item.progress_percent); %>
   <div class="staff-card-schedule" data-overdue="<%= !!past %>"><% if(target) { %><time datetime="<%= target %>"><%= past?'Past target · ':'Target · ' %><%= new Date(target+'T00:00:00Z').toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}) %></time><% } else { %><span>No target date</span><% } %><% if(item.is_blocked) { %><strong>Blocked</strong><% } %></div>
   <% if(item.status==='in_progress'&&item.progress_percent!=null&&Number.isFinite(percent)) { %><div class="staff-card-progress"><progress max="100" value="<%= Math.min(100,Math.max(0,percent)) %>" aria-label="Work progress"></progress><span><%= Math.round(Math.min(100,Math.max(0,percent))) %>%</span></div><% } %>
   <div class="staff-card-bottom"><% if(it.canAssign&&item.status!=='resolved'&&Number.isInteger(item.assignment_version??0)) { %><button class="staff-card-assignee" type="button" data-board-assign="<%= item.id %>" aria-label="<%= item.assignee_id?'Reassign':'Assign' %> owner for <%= item.title %>"><%= item.assignee_name||item.team_name||'Assign owner' %></button><% } else { %><span class="staff-card-assignee" title="<%= item.assignee_name || item.team_name || 'Needs an owner' %>"><%= item.assignee_name || item.team_name || 'Needs an owner' %></span><% } %><details class="staff-card-move"><summary>Move <span aria-hidden="true">⌄</span></summary><label><span>Move <%= item.title %> to</span><select class="workspace-input" data-stage-select="<%= item.id %>" aria-label="Move <%= item.title %> to"><% for(const [status,label] of [['approved','Planned'],['in_progress','In progress'],['resolved','Completed']]) { %><option value="<%= status %>" <%= item.status===status?'selected':'' %>><%= label %></option><% } %></select></label></details></div>
  </article>
  <% } %>
  <% if(lane.hasNext&&(lane.windowSize||6)<it.windowLimit) { %><a class="staff-lane-load-more" href="<%= it.urlFor(lane.status,lane.nextPage||lane.page+1) %>" data-board-lazy="<%= lane.status %>">Load more <%= lane.label.toLowerCase() %> ideas</a><% } %>
  <% if(!lane.items.length) { %><div class="staff-lane-empty"><%~ include('./empty-state',{compact:true,icon:lane.count?'refresh':'board',heading:lane.count?'This page has changed':it.filtered?'No matching '+lane.label.toLowerCase()+' ideas':'No '+lane.label.toLowerCase()+' ideas yet',description:lane.count?'Refresh the board to see the latest cards.':it.filtered?'Remove a filter or adjust your search to see more work.':'Approved ideas appear here when they reach this stage. Use Move on a card to review a stage change.'}) %></div><% } %>
 </div>
 <nav class="staff-lane-pagination" aria-label="<%= lane.label %> pages">
  <% if(lane.hasPrevious) { %><a href="<%= it.urlFor(lane.status,lane.page-1) %>" data-board-page="<%= lane.status %>" aria-label="Previous <%= lane.label %> page" title="Previous page">‹</a><% } else { %><span aria-disabled="true" aria-label="No previous <%= lane.label %> page">‹</span><% } %>
  <form action="/admin/work?presentation=board#board-lane-<%= lane.status %>" method="get" data-board-jump="<%= lane.status %>">
   <% for(const [name,value] of it.pageFields(lane.status)) { %><input type="hidden" name="<%= name %>" value="<%= value %>"/><% } %>
   <label class="visually-hidden" for="board-page-<%= lane.status %>">Page for <%= lane.label %></label><input class="staff-page-input" type="number" name="<%= lane.status %>Page" id="board-page-<%= lane.status %>" min="1" max="<%= lane.pageCount %>" value="<%= lane.page %>" required inputmode="numeric"/><span class="staff-page-total">/ <%= lane.pageCount.toLocaleString() %></span><button type="submit" aria-label="Go to <%= lane.label %> page">Go</button>
  </form>
  <% if(lane.hasNext) { %><a href="<%= it.urlFor(lane.status,lane.nextPage||lane.page+1) %>" data-board-page="<%= lane.status %>" aria-label="Next <%= lane.label %> page" title="Next page">›</a><% } else { %><span aria-disabled="true" aria-label="No next <%= lane.label %> page">›</span><% } %>
 </nav>
</section>
