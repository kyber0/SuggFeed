<% if(it.assistantKnowledge && it.renderMode!=='studio') { %><a href="/help" class="sugi-launcher" data-sugi-launch aria-label="Ask Sugi · SuggFeed help" aria-haspopup="dialog" aria-controls="sugi-widget"><img src="/branding/sugi/mark-160.webp" srcset="/branding/sugi/mark-320.webp 2x" width="44" height="44" alt="" decoding="async"/><span class="sugi-launcher-label">Ask Sugi</span></a><dialog class="sugi-widget" id="sugi-widget" aria-labelledby="sugi-widget-title"><header class="sugi-widget-header"><div><img src="/branding/sugi/mark-160.webp" width="36" height="36" alt=""/><span><strong id="sugi-widget-title">Sugi</strong><small>SuggFeed Help</small></span></div><div class="sugi-widget-actions"><button type="button" class="workspace-button" data-sugi-reset>Clear</button><button type="button" class="workspace-button" data-sugi-close aria-label="Close Sugi">×</button></div></header><div class="sugi-widget-body"><%~ include('assistant-chat',{knowledge:it.assistantKnowledge,maxInput:300,contact:'',widget:true}) %></div><footer><a href="/help">Full help &amp; school contacts →</a></footer></dialog><script type="application/json" id="sugi-knowledge"><%~ JSON.stringify(it.assistantKnowledge).replace(/</g,'\u003c') %></script><% } %>