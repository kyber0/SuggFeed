<% if(it.assistantKnowledge && it.renderMode!=='studio') { %>
<a href="/help" class="sugi-launcher" data-sugi-launch aria-label="Ask Sugi · SuggFeed help" aria-haspopup="dialog" aria-controls="sugi-widget"><img src="/branding/sugi/mark-160.webp" srcset="/branding/sugi/mark-320.webp 2x" width="44" height="44" alt="" decoding="async"/><span class="sugi-launcher-label">Ask Sugi</span></a>
<dialog class="sugi-widget" id="sugi-widget" aria-labelledby="sugi-widget-title"><header class="sugi-widget-header"><a class="sugi-chat-identity" href="/help" aria-label="Open full Sugi help"><img src="/branding/sugi/mark-160.webp" width="44" height="44" alt=""/><span><strong id="sugi-widget-title">Sugi</strong><small>Your assistant · Full help ↗</small></span></a><div class="sugi-widget-actions"><button type="button" class="sugi-chat-clear" data-sugi-reset>Clear</button><button type="button" class="sugi-close" data-sugi-close aria-label="Close Sugi" title="Close chat"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></header><div class="sugi-widget-body"><%~ include('assistant-chat',{knowledge:it.assistantKnowledge,maxInput:300,contact:'',widget:true,schoolName:it.schoolName||it.school?.name,schoolBase:it.schoolBase}) %></div></dialog>
<script type="application/json" id="sugi-knowledge"><%~ JSON.stringify(it.assistantKnowledge).replace(/</g,'\u003c') %></script><% } %>
