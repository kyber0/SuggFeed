<div class="comment-item" data-comment-id="<%= comment.id %>" style="<%= depth > 0 ? 'margin-left:' + (depth * 24) + 'px;border-left:2px solid var(--line);padding-left:12px' : '' %>">
  <div class="comment-header" style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
    <div class="avatar-circle" style="width:28px;height:28px;font-size:12px;flex-shrink:0">
      <%= (comment.display_name || 'A')[0].toUpperCase() %>
    </div>
    <div>
      <strong style="font-size:13px;color:var(--ink)"><%= comment.display_name || 'Anonymous' %></strong>
      <% if (comment.is_pinned) { %>
        <span style="font-size:11px;color:var(--accent);margin-left:6px;font-weight:600">📌 Pinned</span>
      <% } %>
      <time style="font-size:12px;color:var(--muted);margin-left:8px">
        <%= new Date(comment.created_at).toLocaleString('en',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %>
      </time>
    </div>
  </div>
  <p style="font-size:14px;color:var(--ink);margin:0 0 8px;line-height:1.6"><%= comment.body %></p>
  <button class="auth-link-btn" style="font-size:12px;color:var(--muted)"
    onclick="toggleReplyForm('<%= comment.id %>', '<%= ideaId %>')">Reply</button>
  <div id="reply-form-<%= comment.id %>" hidden style="margin-top:10px">
    <textarea id="reply-body-<%= comment.id %>" rows="2" placeholder="Write a reply…"
      style="width:100%;resize:vertical;font-size:13px;padding:8px;border-radius:6px;border:1px solid var(--line);background:var(--surface-2);color:var(--ink)"></textarea>
    <button class="auth-submit-btn" style="max-width:120px;margin-top:8px;padding:7px 14px;font-size:13px"
      onclick="submitReply('<%= comment.id %>', '<%= ideaId %>')">Post reply</button>
  </div>
  <!-- Nested replies -->
  <% if (comment.replies && comment.replies.length > 0) { %>
    <div style="margin-top:10px">
      <% comment.replies.forEach(function(reply) { %>
        <%- include('comment-item', { comment: reply, depth: depth + 1, ideaId: ideaId }) %>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
function toggleReplyForm(commentId, ideaId) {
  const form = document.getElementById('reply-form-' + commentId);
  if (form) { form.hidden ? form.removeAttribute('hidden') : form.setAttribute('hidden', ''); }
}
async function submitReply(parentId, ideaId) {
  const body = document.getElementById('reply-body-' + parentId)?.value.trim();
  if (!body) return;
  try {
    const res = await fetch('/api/comment', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ submission_id: ideaId, body, parent_id: parentId }) });
    const data = await res.json();
    if (data.ok) {
      showToast('Reply posted!', 'success');
      document.getElementById('reply-form-' + parentId).setAttribute('hidden', '');
    } else showToast(data.error || 'Failed', 'error');
  } catch { showToast('Network error', 'error'); }
}
</script>
