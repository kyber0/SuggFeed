<% const p=it.configuration || it.schoolCustomization; const school=it.school || {name:it.schoolName,slug:''};const prefix=it.schoolBase || '/s/'+school.slug;const asset=id=>it.preview?it.base+'/assets/'+id:prefix+'/branding/'+id; %>
<section class="school-welcome school-palette-<%= p.palette %>" aria-labelledby="school-welcome-title">
 <% if(p.cover) { %><img class="school-welcome-cover" src="<%= asset(p.cover) %>" alt="" width="1600" height="600" /><% } %>
 <div class="school-welcome-content"><div class="school-welcome-identity"><% if(p.logo) { %><img src="<%= asset(p.logo) %>" alt="<%= school.name %> logo" width="64" height="64" /><% } else { %><span class="school-monogram" aria-hidden="true"><%= school.name?.slice(0,1).toUpperCase() || 'S' %></span><% } %><div><p class="eyebrow">Your school, on SuggFeed</p><strong><%= p.displayName || school.name %></strong><% if(p.displayName && p.displayName!==school.name) { %><small><%= school.name %></small><% } %></div></div>
 <h1 id="school-welcome-title"><%= p.welcome.headline || 'Share ideas. Improve your school.' %></h1><p class="school-welcome-intro"><%= p.welcome.intro || 'Share campus feedback and follow the changes that matter to your community.' %></p>
 <% if(p.welcome.message) { %><p class="school-welcome-message"><%= p.welcome.message %></p><% } %>
 <div class="school-welcome-actions"><% if(it.preview) { %><button class="workspace-button" type="button" disabled>Browse ideas</button><button class="workspace-button" type="button" disabled>Submit an idea</button><% if(p.features.roadmap) { %><button class="workspace-button" type="button" disabled>View progress</button><% } %><% } else { %><a class="workspace-button" href="<%= prefix %>/feed">Browse ideas</a><button class="workspace-button" type="button" data-sf-click="action-49">Submit an idea</button><% if(p.features.roadmap) { %><a class="workspace-button" href="<%= prefix %>/roadmap">View progress</a><% } %><% } %></div>
 <% if(p.welcome.help) { %><p class="school-welcome-help"><%= p.welcome.help %></p><% } %>
 <% if(p.welcome.links.length) { %><nav class="school-welcome-links" aria-label="Official school links"><% for(const link of p.welcome.links) { %><% if(it.preview) { %><span><%= link.label %></span><% } else { %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %> ↗</a><% } %><% } %></nav><% } %>
 </div>
</section>
