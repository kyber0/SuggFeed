<% const a=it.overview;const days=it.overviewDays||30;const icon=name=>'<svg class="workspace-svg" aria-hidden="true"><use href="#ws-'+name+'"></use></svg>'; %>
<nav class="overview-periods" aria-label="Platform reporting period"><span>Platform insights · all schools</span><div><% for(const period of [7,30,90]) { %><a href="/platform/schools?overviewDays=<%= period %>#overview" <%= days===period?'aria-current="page"':'' %>><%= period %> days</a><% } %></div></nav>
<% if(!a) { %><%~ include('empty-state',{icon:'chart',heading:'Platform insights are temporarily unavailable',description:'School management is still available. Reload to retry the aggregate analytics.',actions:[{href:'/platform/schools?overviewDays='+days+'#overview',label:'Reload insights'},{href:'#schools',label:'Manage schools',secondary:true}]}) %><% } else {
const timeline=a.timeline.map(point=>({...point,date:new Date(point.key+'T04:00:00Z').toLocaleDateString('en-PH',{month:'short',day:'numeric',timeZone:'Asia/Manila'}),fullDate:new Date(point.key+'T04:00:00Z').toLocaleDateString('en-PH',{dateStyle:'long',timeZone:'Asia/Manila'})}));
const total=timeline.reduce((sum,point)=>sum+point.submissions,0),ceiling=Math.max(1,...timeline.map(point=>point.submissions));const points=timeline.map((point,index)=>[32+index/Math.max(1,timeline.length-1)*736,196-point.submissions/ceiling*160]);const line=points.map((point,index)=>(index?'L':'M')+point.join(',')).join(' ');const area='M32,196 '+points.map(point=>'L'+point.join(',')).join(' ')+' L768,196 Z';
%>
<div class="overview-metrics"><% for(const [name,value,hint,graphic] of [['School workspaces',a.schools.all,'All registered school workspaces','building'],['Active schools',a.schools.active,a.schools.pending+' awaiting setup or activation','check'],['Active memberships',a.memberships,'Active memberships in active schools','users'],['Ideas received',total,'Submitted across all schools in '+days+' days','inbox']]) { %><article class="overview-metric" data-overview-entrance><div class="overview-metric-top"><span><%= name %></span><span class="overview-metric-icon"><%~ icon(graphic) %></span></div><div class="overview-metric-value"><strong><%= Number(value).toLocaleString('en-PH') %></strong></div><p><%= hint %></p></article><% } %></div>
<div class="overview-chart-grid">
<section class="overview-panel overview-trend" data-overview-entrance aria-labelledby="platform-activity-title"><header class="overview-panel-heading"><div><h2 id="platform-activity-title">Community activity</h2><p>Daily ideas received across all schools</p></div><span class="overview-total">Last <%= days %> days</span></header><div class="overview-chart-summary"><strong><%= total.toLocaleString('en-PH') %></strong><span>ideas received</span><% if(a.previous_total>0) { const change=Math.round((total-a.previous_total)/a.previous_total*100); %><span class="overview-delta"><%= change>0?'+':'' %><%= change %>% vs previous period</span><% } %></div>
<% if(total===0) { %><p class="platform-help">No ideas were received in this period. The timeline will update as schools start participating.</p><% } %>
<div class="overview-chart" data-overview-chart><svg viewBox="0 0 800 232" role="img" aria-labelledby="overview-graph-label" preserveAspectRatio="none"><title id="overview-graph-label">Daily ideas received across all schools in the last <%= days %> days. Exact values are available in the table.</title><% for(const y of [36,76,116,156,196]) { %><line class="overview-grid-line" x1="32" x2="768" y1="<%= y %>" y2="<%= y %>"/><% } %><text x="10" y="27" class="overview-axis"><%= ceiling %></text><text x="10" y="201" class="overview-axis">0</text><path class="overview-area" d="<%= area %>"/><path class="overview-line" d="<%= line %>" vector-effect="non-scaling-stroke"/><line data-overview-guide class="overview-guide" x1="768" x2="768" y1="30" y2="196" hidden/><circle data-overview-dot class="overview-dot" cx="768" cy="196" r="5" hidden/></svg></div>
<div class="overview-chart-labels"><span><%= timeline[0]?.date %></span><span><%= timeline[Math.floor(timeline.length/2)]?.date %></span><span><%= timeline[timeline.length-1]?.date %></span></div><div class="overview-scrubber" data-overview-interactive hidden><label class="visually-hidden" for="overview-day">Explore platform activity by day. Use arrow keys to change the day.</label><input id="overview-day" data-overview-day type="range" min="0" max="<%= timeline.length-1 %>" value="<%= timeline.length-1 %>"/><output for="overview-day" data-overview-readout></output></div>
<details class="overview-data-table"><summary>View daily values</summary><div tabindex="0" role="region" aria-label="Daily platform activity"><table><caption>Ideas received across all schools</caption><thead><tr><th scope="col">Date</th><th scope="col">Ideas</th></tr></thead><tbody><% for(const point of timeline) { %><tr><th scope="row"><%= point.date %></th><td><%= point.submissions %></td></tr><% } %></tbody></table></div></details></section>
<section class="overview-panel" data-overview-entrance aria-labelledby="platform-health-title"><header class="overview-panel-heading"><div><h2 id="platform-health-title">School workspace health</h2><p>Current status across the platform</p></div></header><div class="overview-stage-list"><% for(const [key,label,tone] of [['active','Active','resolved'],['pending','Pending setup','pending'],['suspended','Suspended','rejected'],['closed','Closed','rejected']]) { %><a class="overview-stage-row" href="/platform/schools?status=<%= key %>#schools"><span class="overview-stage-dot overview-stage--<%= tone %>" aria-hidden="true"></span><span><%= label %></span><strong><%= a.schools[key] %></strong><%~ icon('arrow') %></a><% } %></div><div class="platform-insight-totals"><div><span>Ideas across all schools</span><strong><%= a.ideas.all %></strong></div><div><span>Completed ideas</span><strong><%= a.ideas.resolved %></strong></div><div><span>Ideas awaiting school review</span><strong><%= a.ideas.pending %></strong></div></div><a class="overview-panel-link" href="#applications">Review school applications <%~ icon('arrow') %></a></section>
</div>
<p class="overview-scope">Platform totals include all school records, including fictional demo data. Memberships are counted per school, not as unique people. Activity uses Philippine calendar days; today is partial. These aggregates do not expose student identities or idea content.</p>
<script id="overview-chart-data" type="application/json"><%~ JSON.stringify({timeline,totals:{submissions:total},period:String(days),includeSupport:false}).replace(/</g,'\\u003c') %></script>
<% } %>
