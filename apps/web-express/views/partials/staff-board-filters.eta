<% const filters=it.filters,presentation=it.presentation; %>
 <form class="staff-board-toolbar" action="/admin/work" method="get" role="search" id="staff-board-filters">
  <input type="hidden" name="presentation" value="<%= presentation %>"><% if(it.calendar) { %><input type="hidden" name="month" value="<%= it.calendar.month %>"><% } %><label class="staff-board-search"><span>Search work</span><input class="workspace-input" type="search" name="search" value="<%= filters.search %>" maxlength="120" placeholder="Search suggestions…" aria-label="Search the work board"/></label>
  <label>Ownership<select class="workspace-input" name="assignment"><% for(const [value,label] of [['all',it.user?.role==='admin'?'All school work':'My authorized work'],['mine','Assigned directly to me'],['team','My team’s work'],['unassigned','No individual owner']]) { %><option value="<%= value %>" <%= filters.assignment===value?'selected':'' %>><%= label %></option><% } %></select></label>
  <% if(presentation!=='calendar') { %><details class="staff-board-more-filters"><summary>Display</summary><div><label>Order<select class="workspace-input" name="sort"><option value="oldest" <%= filters.sort==='oldest'?'selected':'' %>>Oldest first</option><option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Newest first</option></select></label>
  <label>Cards per stage<select class="workspace-input" name="pageSize"><% for(const size of [6,12,24]) { %><option value="<%= size %>" <%= filters.pageSize===size?'selected':'' %>><%= size %></option><% } %></select></label>
  </div></details><% } else { %><input type="hidden" name="sort" value="<%= filters.sort %>"><input type="hidden" name="pageSize" value="<%= filters.pageSize %>"><% } %>
 <details class="staff-board-more-filters"><summary>Filters<%= filters.assignment!=='all'||filters.priority!=='all'||filters.overdue?' · active':'' %></summary><div><label>Priority<select class="workspace-input" name="priority"><% for(const value of ['all','low','normal','high','urgent']) { %><option value="<%= value %>" <%= filters.priority===value?'selected':'' %>><%= value==='all'?'Any priority':value %></option><% } %></select></label><label class="staff-overdue-filter"><input type="checkbox" name="overdue" value="true" <%= filters.overdue?'checked':'' %>/> Past target date</label></div></details>
 <button class="workspace-button" id="staff-board-apply" type="submit">Apply</button>
  <% if(filters.search || filters.sort!=='oldest' || filters.pageSize!==6||filters.assignment!=='all'||filters.priority!=='all'||filters.overdue) { %><a class="workspace-text-link" href="/admin/work?presentation=<%= presentation %><%= it.calendar?'&month='+it.calendar.month:'' %>" data-board-reset>Reset</a><% } %>
 </form>
<% const chips=[...(filters.search?[['search','Search: '+filters.search]]:[]),...(filters.assignment!=='all'?[['assignment',filters.assignment==='mine'?'Assigned directly to me':filters.assignment==='team'?'My team’s work':'No individual owner']]:[]),...(filters.priority!=='all'?[['priority','Priority: '+filters.priority]]:[]),...(filters.overdue?[['overdue','Past delivery target']]:[])];const without=key=>{const query=new URLSearchParams(it.urlFor('',1).split('?')[1]);query.delete(key);for(const name of [...query.keys()])if(name.endsWith('Page'))query.delete(name);return '/admin/work?'+query.toString();}; %>
<% if(chips.length) { %><nav class="staff-board-chips" aria-label="Active delivery filters"><% for(const [key,label] of chips) { %><a href="<%= without(key) %>" data-board-filter-link aria-label="Remove filter: <%= label %>"><span><%= label %></span><span aria-hidden="true">×</span></a><% } %></nav><% } %>
