<% const reviewCount=it.counts?it.counts.applications+it.counts.policies+it.counts.forms:null;const navIcon=name=>'<svg class="workspace-svg" aria-hidden="true"><use href="#ws-'+name+'"/></svg>'; %>
<main class="platform-dashboard platform-v2" data-platform-workspace data-review-selected="<%= it.section==='reviews'&&it.item?'true':'false' %>">
 <aside class="platform-sidebar" aria-label="Platform navigation"><div class="platform-workspace"><span class="platform-icon"><%~ navIcon('crown') %></span><div><strong>SuggFeed</strong><span>Super admin workspace</span></div></div><p class="pv-nav-caption">Workspace</p><nav class="platform-nav" aria-label="Super admin sections"><% for(const [id,label,icon] of it.sections){ %><% if(id==='activity'){ %><p class="pv-nav-caption">Administration</p><% } %><a href="<%= it.url({section:id}) %>" class="<%= it.section===id?'is-current':'' %>" <%= it.section===id?'aria-current="page"':'' %>><%~ navIcon(icon) %><span class="platform-nav-label"><%= label %></span><% if(id==='reviews'&&reviewCount!==null&&reviewCount>0){ %><span class="platform-nav-count"><%= reviewCount %></span><% } %></a><% } %></nav><div class="platform-sidebar-footer"><span class="platform-role">Platform operator</span><p>School membership and platform authority remain separate.</p></div></aside>
 <div class="platform-content"><details class="pv-mobile-nav"><summary><%= it.sections.find(s=>s[0]===it.section)?.[1]||'Platform' %><span aria-hidden="true">⌄</span></summary><nav aria-label="Platform sections"><% for(const [id,label] of it.sections){ %><a href="<%= it.url({section:id}) %>" <%= it.section===id?'aria-current="page"':'' %>><%= label %></a><% } %></nav></details>
 <% if(it.saved){ %><p class="platform-feedback" role="status">Change saved. The current state is shown below.</p><% } %>
 <% if(!it.counts){ %><p class="pv-notice" role="status">Pending totals are unavailable. You can still open each section and retry.</p><% } %>
