<% const menuIcon=name=>'<svg class="workspace-svg" aria-hidden="true" focusable="false"><use href="#ws-'+name+'"></use></svg>'; %>
<header class="site-header">
  <a class="brand" href="/" aria-label="SuggFeed home"><img class="sf-brand-logo" src="/branding/sf-monogram.png" width="54" height="36" alt="" /><span class="sf-wordmark">Sugg<span>Feed</span></span></a>
  <nav aria-label="Primary navigation">
    <a href="/" aria-current="<%= it.currentPath === '/' ? 'page' : 'false' %>" class="nav-link-hide-mobile<%= it.currentPath === '/' ? ' active' : '' %>">Home</a>
    <a href="/feed" aria-current="<%= it.currentPath === '/feed' ? 'page' : 'false' %>" class="nav-link-hide-mobile<%= it.currentPath === '/feed' ? ' active' : '' %>">Community ideas</a>
    <a href="/roadmap" aria-current="<%= it.currentPath === '/roadmap' ? 'page' : 'false' %>" class="nav-link-hide-mobile<%= it.currentPath === '/roadmap' ? ' active' : '' %>">Roadmap</a>
    <a href="/admin" aria-current="<%= it.currentPath.startsWith('/admin') ? 'page' : 'false' %>" class="nav-link-hide-mobile<%= it.currentPath.startsWith('/admin') ? ' active' : '' %>">Staff portal</a>

    <% if (it.user) { %>
      <!-- Authenticated: avatar chip with dropdown -->
      <div class="header-user-menu">
        <button class="avatar-chip" id="header-avatar-btn" aria-label="Open account menu" aria-controls="header-dropdown" aria-haspopup="true" aria-expanded="false">
          <% if (it.user.avatar_url) { %>
            <img src="<%= it.user.avatar_url %>" alt="<%= it.user.full_name?.[0]?.toUpperCase() ?? 'U' %>"
              class="avatar-circle" referrerpolicy="no-referrer" />
          <% } else { %>
            <div class="avatar-circle"><%= it.user.full_name?.[0]?.toUpperCase() ?? it.user.email?.[0]?.toUpperCase() ?? 'U' %></div>
          <% } %>
          <span><%= (it.user.full_name ?? it.user.email ?? 'Account').split(' ')[0] %></span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="dropdown-menu" id="header-dropdown" hidden>
          <div class="dropdown-user-header">
            <div class="dropdown-user-name"><%= it.user.full_name ?? 'Account' %></div>
            <% if(it.user.email) { %><div class="dropdown-user-email"><%= it.user.email %></div><% } %>
          </div>
          <div class="divider"></div>
          <a href="/profile" class="dropdown-link">
            <%~ menuIcon('user') %>
            My Profile &amp; Ideas
          </a>
          <a href="/notifications" class="dropdown-link"><%~ menuIcon('bell') %> School updates</a>
          <a href="/feed?scope=following" class="dropdown-link"><%~ menuIcon('bookmark') %> Following</a>
          <a href="/inbox" class="dropdown-link"><%~ menuIcon('message') %> Private school messages</a>
          <a href="/admin" class="dropdown-link dropdown-link--staff">
            <%~ menuIcon('shield') %>
            Staff Portal
          </a>
          <div class="divider"></div>
          <form action="/auth/signout" method="POST" class="dropdown-form">
            <button type="submit" class="danger dropdown-signout-btn">
              <%~ menuIcon('signout') %>
              Sign out
            </button>
          </form>
        </div>
      </div>
    <% } else { %>
      <!-- Anonymous: Profile link + Sign in -->
      <a href="/profile" aria-label="Your profile" class="btn-ghost header-profile-link<%= it.currentPath === '/profile' ? ' active' : '' %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="profile-label">Profile</span>
      </a>
      <button class="btn-primary-sm" id="header-signin-btn" type="button" data-sf-click="action-94">
        Sign in
      </button>
    <% } %>

    <div class="header-divider"></div>

    <!-- Theme toggle -->
    <button class="btn-ghost theme-toggle-btn" data-sf-click="action-95" aria-label="Toggle theme" title="Toggle theme">
      <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
  </nav>
</header>

<script defer src="/js/header.js?v=20261012-system"></script>
