<% const count=it.total||0,start=count&&it.page*20<count?it.page*20+1:0; %><nav class="platform-pagination pv-pagination" aria-label="<%= it.label||'Result pages' %>"><span><%= start %>–<%= start?Math.min((it.page+1)*20,count):0 %> of <%= count %></span><% if(it.page>0&&!start){ %><a class="platform-button" href="<%= it.pageHref(0) %>">First page</a><% } %><% if(it.page>0){ %><a class="platform-button" href="<%= it.pageHref(it.page-1) %>">Previous</a><% } %><% if((it.page+1)*20<count){ %><a class="platform-button" href="<%= it.pageHref(it.page+1) %>">Next</a><% } %></nav>
