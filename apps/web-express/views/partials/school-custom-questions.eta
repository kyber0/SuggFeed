<% const form=it.configuration?.form || it.schoolCustomization?.form; %>
<% if(form) { %><section class="school-custom-questions" aria-labelledby="school-questions-title">
 <% if(form.instructions || form.example || form.questions.length || form.attachments!=='off') { %><h3 id="school-questions-title">School submission details</h3><p class="staff-footnote">These answers and supporting images are private to you and authorized school staff. Your idea title, description and category may become public after review.</p><% } %>
 <% if(form.instructions) { %><p class="school-form-text"><%= form.instructions %></p><% } %><% if(form.example) { %><details><summary>See a helpful example</summary><p class="school-form-text"><%= form.example %></p></details><% } %>
 <div data-school-question-fields><% for(const q of form.questions) { %><label class="school-question"><span><%= q.label %><%= q.required?' *':'' %></span><% if(q.type==='choice') { %><select class="workspace-input" data-school-question="<%= q.id %>" <%= q.required?'required':'' %> <%= it.preview?'disabled':'' %>><option value="">Choose an answer</option><% for(const option of q.options) { %><option value="<%= option %>"><%= option %></option><% } %></select><% } else { %><textarea class="workspace-input" data-school-question="<%= q.id %>" rows="<%= q.type==='long'?4:2 %>" maxlength="<%= q.type==='long'?1000:200 %>" <%= q.required?'required':'' %> <%= it.preview?'disabled':'' %>></textarea><% } %><% if(q.help) { %><small><%= q.help %></small><% } %></label><% } %></div>
 <div data-school-attachment-fields><% if(form.attachments!=='off') { %><label class="school-question">Supporting images <%= form.attachments==='required'?'(at least one required)':'(optional)' %><input type="file" data-submission-images accept="image/png,image/jpeg,image/webp" multiple <%= it.preview?'disabled':'' %> /><small>Up to three images, 5 MB each. Private to you and authorized school staff. Do not include sensitive information.</small></label><ul data-submission-upload-list></ul><p data-submission-upload-status role="status" aria-live="polite"></p><% } %></div><div data-school-preserved-answers></div>
</section><% } %>
