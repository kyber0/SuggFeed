<% const section=it.section||'comments'; %>
 <% if(it.user?.role==='admin') { %><section class="care-card comment-review-workspace" id="care-comments" <%= section!=='comments'?'hidden':'' %>>
 <header class="comment-review-heading"><div><p class="workspace-kicker">DISCUSSION SAFETY</p><h2>Comment review</h2><p>Read the context, then decide. Held text stays private until approved.</p></div></header>
 <nav class="comment-review-tabs" aria-label="Comment review status"><% for(const [key,label] of [['needs-review','Needs review'],['reported','Reported'],['resolved','Resolved']]) { %><a href="/admin/safety?section=comments&amp;commentView=<%= key %>" aria-current="<%= it.commentQueue?.view===key?'page':'false' %>"><%= label %><span><%= it.commentQueue?.counts?.[key] || 0 %></span></a><% } %></nav>
 <% for(const comment of it.commentQueue?.items || []) { const reasonLabels={dictionary:'Language check',reports:'Member reports',detector_unavailable:'Detection unavailable',legacy_check:'Verification needed',clear:'Member reports'}; %>
 <article class="care-row comment-review-item"><header><div><strong><%= comment.display_name || 'Student' %></strong><span class="workspace-tag"><%= reasonLabels[comment.moderation_reason] || 'Needs review' %></span></div><small>Text revision <%= comment.text_revision %> · <%= comment.moderation_status %></small></header>
 <a class="comment-review-idea" href="/admin/reviews?idea=<%= comment.submission_id %>" data-review="<%= comment.submission_id %>" aria-haspopup="dialog"><%= comment.idea_title || 'Open idea context' %> →</a>
 <% if(comment.parent_body) { %><details class="comment-review-context"><summary>In reply to</summary><blockquote><%= comment.parent_body %></blockquote></details><% } %>
 <blockquote class="comment-review-text"><%= comment.body %></blockquote>
 <details class="comment-review-context"><summary><%= comment.open_report_count %> open reports · Context &amp; history</summary>
 <p>Detector: <%= comment.detector_version %>. Rule groups: <%= (comment.moderation_rules||[]).join(', ') || 'No dictionary match recorded' %>.</p>
 <% if(comment.moderation_reason==='detector_unavailable') { %><p>The detector could not finish. This does not mean the comment contains profanity.</p><% } %>
 <% for(const report of comment.reports || []) { %><p><strong>Report · text revision <%= report.comment_revision %></strong> · <%= report.resolution || 'Open' %></p><blockquote><%= report.reason %></blockquote><% } %>
 <% for(const revision of comment.revisions || []) { %><details><summary>Text revision <%= revision.revision %></summary><p><%= revision.body || 'Text erased by administrator' %></p></details><% } %>
 <% for(const decision of comment.decisions || []) { %><p><strong><%= decision.action.replace('comment_','') %></strong> · <%= decision.reason %></p><% } %>
 <p class="staff-footnote">Showing up to 30 reports, 10 text revisions and 10 recent decisions. Earlier audit records remain retained.</p></details>
 <% if(comment.moderation_status!=='deleted') { %><details class="comment-review-decision"><summary><%= it.commentQueue?.view==='resolved'?'Reconsider decision':'Review this comment' %></summary><form class="care-form" data-care-action="comment-review"><input type="hidden" name="id" value="<%= comment.id %>"><input type="hidden" name="version" value="<%= comment.version %>"><input type="hidden" name="textRevision" value="<%= comment.text_revision %>"><label>Decision<select class="workspace-input" name="decision" required><option value="">Choose a decision</option><option value="approve">Approve — show comment</option><option value="hide">Keep hidden — resolve review</option><option value="delete">Delete text — preserve replies</option></select></label><label>Explanation to the author<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required rows="2" placeholder="Explain your decision respectfully. Do not identify reporters."></textarea></label><p class="staff-footnote">Your explanation is shown privately to the author and reporters.</p><button class="workspace-button workspace-button--primary" type="submit">Save decision</button></form></details>
 <% } else { %><p class="comment-review-resolution"><strong>Resolved</strong> · <%= comment.review_reason || 'Decision retained in the audit history.' %></p><% } %></article>
 <% } %>
 <% if(!it.commentQueue?.items.length) { %><%~ include('./empty-state',{compact:true,icon:'shield',heading:it.commentQueue?.view==='resolved'?'No resolved reviews yet':'No comments need attention',description:'New review work appears here. Completed decisions are kept in Resolved.'}) %><% } %></section><% } %>
