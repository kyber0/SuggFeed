<% const presentation=it.presentation||'tasks';const taskView=['mine','triage','all','overdue'].includes(it.view)?it.view:'mine';const labels=[['tasks','Tasks','inbox'],['board','Board','board'],['list','List','list'],['calendar','Calendar','clock']]; %>
<header class="workspace-heading staff-work-heading"><div><p class="workspace-kicker">STAFF WORKSPACE</p><h1>Work</h1><p>One place for your assignments and approved ideas in progress.</p></div><% if(it.user?.role==='admin') { %><a class="workspace-button" href="/admin/routing">Routing &amp; teams</a><% } %></header>
<nav class="staff-work-views" aria-label="Work presentation"><% for(const [value,label,glyph] of labels) { let href='/admin/work';if(value==='tasks'){href+='?view='+encodeURIComponent(taskView);}else if(it.urlFor){const query=new URLSearchParams(it.urlFor('',1).split('?')[1]);query.set('presentation',value);query.delete('calendarPage');href+='?'+query.toString();}else{href+='?presentation='+value;} %><a href="<%= href %>" aria-current="<%= presentation===value?'page':'false' %>"><svg class="workspace-svg" aria-hidden="true"><use href="#ws-<%= glyph %>"></use></svg><span><%= label %></span></a><% } %></nav>
<p class="staff-work-context"><span class="staff-work-context-dot" aria-hidden="true"></span><%= presentation==='tasks'?'Tasks include your individual and team assignments, acknowledgements and assigned reviews.': 'Approved ideas only. Review decisions stay in Review ideas; use Tasks for acknowledgements and assigned reviews.' %></p>
