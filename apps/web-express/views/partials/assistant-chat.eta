<section class="sugi-card" aria-labelledby="sugi-chat-title" data-sugi><% if(!it.widget) { %><div class="sugi-card-heading"><div><h2 id="sugi-chat-title">How can I help?</h2><p>App guidance and reviewed school information.</p></div><button type="button" class="workspace-button" data-sugi-reset>Clear</button></div><% } %><div class="sugi-conversation-scroll"><% if(it.widget) { %><p class="sugi-widget-privacy">General help only. Don’t share private details.</p><% } %><p class="sugi-notice">Please don’t enter names, emails, passwords, tracking codes or private case details. Sugi cannot access your records or take actions for you.</p><div class="sugi-chips" aria-label="Common questions"><% for(const entry of it.knowledge.entries.slice(0,4)) { %><button type="button" data-sugi-question="<%= entry.questions.en %>"><%= entry.questions.en %></button><% } %></div><ol class="sugi-messages" data-sugi-messages aria-label="Help conversation"></ol><% if(it.widget) { %><details class="sugi-widget-faq"><summary>Browse reviewed FAQs</summary><% for(const e of it.knowledge.entries) { %><details data-sugi-faq="<%= e.id %>"><summary><%= e.questions.en %></summary><p><%= e.answers.en %></p></details><% } %></details><% } %></div><form data-sugi-form method="post" action="/api/assistant/ask"><label for="sugi-question">Your help question</label><textarea id="sugi-question" name="question" maxlength="<%= it.maxInput %>" rows="2" required placeholder="For example, how do I track my idea?" aria-describedby="sugi-counter sugi-status"></textarea><div class="sugi-compose-actions"><span id="sugi-counter" data-sugi-counter>0 / <%= it.maxInput %></span><button class="workspace-button" type="submit">Ask Sugi <span aria-hidden="true">→</span></button></div></form><p id="sugi-status" data-sugi-status role="status" aria-live="polite">Answers use reviewed FAQs. For official matters, contact your school office.</p><noscript><p>The FAQ below works without JavaScript.</p></noscript><% if(!it.widget) { %><div class="sugi-contact"><% if(it.contact) { %><h3>School contact</h3><p><%= it.contact %></p><a class="workspace-button" href="/privacy">School contact details</a><% } else { %><p>No monitored school office contact is available here. Ask your school administrator for the correct channel.</p><a href="<%= it.schoolBase?'/privacy':'/schools' %>"><%= it.schoolBase?'School notices':'Find your school' %></a><% } %></div><% } %></section>