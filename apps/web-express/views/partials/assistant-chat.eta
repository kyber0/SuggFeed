<section class="sugi-card sugi-chat" aria-label="Chat with Sugi" data-sugi>
<% if(!it.widget) { %><header class="sugi-chat-header"><div class="sugi-chat-identity"><img src="/branding/sugi/mark-160.webp" width="40" height="40" alt=""/><div><h2 id="sugi-chat-title">Sugi</h2><p>Your SuggFeed assistant</p></div></div><button type="button" class="sugi-chat-clear" data-sugi-reset>Clear</button></header><% } %>
<div class="sugi-conversation-scroll" data-sf-native-scroll>
 <div class="sugi-chat-welcome"><img src="/branding/sugi/mark-160.webp" width="64" height="64" alt=""/><h3>A little help, whenever you need it.</h3><p>Ask about SuggFeed or your school. I’ll find the approved information and link you to the source.</p></div>
 <p class="sugi-chat-context"><span aria-hidden="true">◇</span> <%= (it.schoolName||it.school?.name)?'SuggFeed + '+(it.schoolName||it.school?.name):'SuggFeed app help · Open a school workspace for school information' %></p>
 <details class="sugi-chat-privacy"><summary>Privacy &amp; sources</summary><p>Your question and relevant approved sources may be processed by Gemini when AI is enabled. Don’t share names, emails, passwords, tracking codes or private case details. Sugi cannot access your records or take actions for you.</p><a href="/profile/help?view=sources">Browse approved sources &amp; FAQs</a><% if(!it.widget&&it.contact) { %><p>School contact: <%= it.contact %></p><a href="/privacy">School contact details</a><% } %></details>
 <div class="sugi-chips" aria-label="Conversation starters"><% for(const entry of it.knowledge.entries.slice(0,4)) { %><button type="button" data-sugi-question="<%= entry.questions.en %>"><%= entry.questions.en %><span aria-hidden="true">↗</span></button><% } %></div>
 <ol class="sugi-messages" data-sugi-messages role="log" aria-live="polite" aria-relevant="additions text" aria-label="Help conversation"></ol>
</div>
<div class="sugi-chat-bottom">
 <form class="sugi-composer" data-sugi-form method="post" action="/help/ask"><label class="sugi-sr-only" for="sugi-question">Your help question</label><textarea id="sugi-question" name="question" maxlength="<%= it.maxInput %>" rows="1" required enterkeyhint="send" placeholder="Message Sugi…" aria-describedby="sugi-counter sugi-status"></textarea><button class="sugi-send" type="submit" aria-label="Send message" title="Send message" disabled><svg class="sugi-send-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 3-7 18-4-7-7-4L21 3Z"/><path d="m10 14 11-11"/></svg><span class="sugi-sr-only">Send</span></button></form>
 <div class="sugi-composer-meta"><span>Text only <span class="sugi-enter-hint">· Enter to send</span></span><span id="sugi-counter" data-sugi-counter>0 / <%= it.maxInput %></span></div>
 <p id="sugi-status" data-sugi-status role="status" aria-live="polite">AI can make mistakes. Check the linked sources.</p>

 <noscript><p>The FAQ on the full Help page works without JavaScript.</p></noscript>
</div></section>
