<dialog class="feed-filter-dialog" id="feed-filter-dialog" aria-labelledby="feed-filter-title"><form method="dialog" class="feed-filter-form" id="feed-filter-form"><header><div><p class="student-eyebrow">MAKE IT RELEVANT</p><h2 id="feed-filter-title">Filter ideas</h2></div><button type="button" data-feed-filters-close aria-label="Close filters">×</button></header><fieldset><legend>School topic</legend><% for(const cat of ['All',...(it.categories||[])]){const value=cat==='All'?'All':it.schoolCategories?.find(c=>c.name===cat)?.id||cat; %><label><input type="radio" name="category" value="<%= value %>" <%= (it.category||'All')===value?'checked':'' %>/><span><%= cat==='All'?'All topics':cat %></span></label><% } %></fieldset><footer><button type="button" class="workspace-button" data-feed-filters-reset>Reset topic</button><button type="submit" class="workspace-button workspace-button-primary">Apply filters</button></footer></form></dialog>
