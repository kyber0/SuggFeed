<% const titles={created:'Workspace created',status_changed:'School status changed',customization_rollout:'Studio access changed',customization_reviewed:'Form review recorded',customization_published:'Appearance published'}; %>
<% if(!it.activity){ %><p class="pv-notice">Activity is unavailable. Refresh to retry; no empty-history claim is being made.</p><% }else if(!it.activity.items.length){ %><%~ include('empty-state',{compact:true,icon:'list',heading:'No recorded activity in this view',description:'Try another filter or return to the first page.'}) %><% }else{ %><ol class="pv-activity"><% for(const event of it.activity.items){ %><li><span class="pv-event-dot" aria-hidden="true"></span><div><strong><%= titles[event.action]||event.action %></strong><p><a href="/platform/schools/<%= event.school_id %>?tab=activity"><%= event.school_name %></a> · <%= event.actor_name||'Recorded actor' %></p><% if(Object.keys(event.detail||{}).length){ %><details><summary>Event details</summary><dl class="pv-event-details"><% for(const [key,value] of Object.entries(event.detail)){ %><div><dt><%= key.replace(/_/g,' ') %></dt><dd><%= typeof value==='boolean'?(value?'Enabled':'Paused'):String(value) %></dd></div><% } %></dl></details><% } %></div><time datetime="<%= event.created_at %>"><%= new Date(event.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila',dateStyle:'medium',timeStyle:'short'}) %></time></li><% } %></ol><% } %>
