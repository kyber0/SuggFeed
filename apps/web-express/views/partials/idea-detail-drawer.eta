<!-- ── Global Idea Detail Slide-Over Drawer (Identical to apps/web) ── -->
<div id="idea-drawer-overlay" class="panel-overlay" data-sf-click="action-96" aria-hidden="true" hidden></div>

<aside
  id="idea-detail-drawer"
  class="detail-panel detail-panel-split"
  role="dialog"
  aria-modal="true"
  aria-label="Idea Details"
  hidden
>
  <!-- Mobile drag handle -->
  <div class="mobile-drag-handle" id="drawer-drag-handle" aria-hidden="true"></div>

  <!-- ── Header ── -->
  <div class="detail-panel-header">
    <div class="detail-panel-badges">
      <span class="detail-category-badge" id="drawer-cat-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r=".5" fill="currentColor"/></svg>
        <span id="drawer-cat-name">Category</span>
      </span>

      <span class="detail-status-pill" id="drawer-status-pill">
        <span class="status-dot" id="drawer-status-dot"></span>
        <span id="drawer-status-label">Status</span>
      </span>
    </div>

    <div class="detail-header-actions">
      <!-- Direct Link / Open Standalone -->
      <a
        id="drawer-permalink"
        href="#"
        class="panel-action-btn"
        title="Open full page"
        aria-label="Open full page"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>

      <!-- Share button -->
      <button
        type="button"
        class="panel-action-btn"
        id="drawer-share-btn"
        data-sf-click="action-97"
        aria-label="Share idea"
        title="Copy link"
      >
        <svg id="drawer-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>

      <!-- Close button -->
      <button
        type="button"
        class="panel-action-btn panel-close-btn"
        data-sf-click="action-98"
        aria-label="Close"
        title="Close (Esc)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- ── Mobile Tab Navigation (FB-style comments sheet toggle) ── -->
  <div class="detail-mobile-tabs" role="tablist" aria-label="Proposal sections">
    <button
      type="button"
      role="tab"
      id="drawer-mob-tab-details"
      aria-selected="true"
      class="detail-mobile-tab active"
      data-sf-click="action-99"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      <span>Proposal Details</span>
    </button>
    <button
      type="button"
      role="tab"
      id="drawer-mob-tab-comments"
      aria-selected="false"
      class="detail-mobile-tab"
      data-sf-click="action-100"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Comments (<span id="drawer-mob-comment-count">0</span>)</span>
    </button>
  </div>

  <!-- Loading State Skeleton -->
  <div id="drawer-skeleton" style="padding: 24px; display: none;">
    <div style="height: 20px; width: 40%; background: var(--surface-hover); border-radius: 4px; margin-bottom: 16px; animation: pulse 1.2s infinite ease-in-out;"></div>
    <div style="height: 32px; width: 85%; background: var(--surface-hover); border-radius: 6px; margin-bottom: 20px; animation: pulse 1.2s infinite ease-in-out;"></div>
    <div style="height: 60px; width: 100%; background: var(--surface-hover); border-radius: 8px; margin-bottom: 20px; animation: pulse 1.2s infinite ease-in-out;"></div>
    <div style="height: 120px; width: 100%; background: var(--surface-hover); border-radius: 8px; animation: pulse 1.2s infinite ease-in-out;"></div>
  </div>

  <!-- ── Two-column body ── -->
  <div class="detail-panel-columns" id="drawer-columns" data-mobile-tab="details">
    <!-- ── LEFT COLUMN: Proposal Details & Stepper (50%) ── -->
    <div class="detail-col detail-col-left" id="drawer-left-col">
      <!-- Author & Date strip -->
      <div class="detail-author-row">
        <div class="detail-author-profile">
          <div class="detail-author-avatar" id="drawer-author-avatar">A</div>
          <span class="detail-author-name" id="drawer-author-name">Anonymous Student</span>
        </div>
        <span class="detail-date-badge" id="drawer-date-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span id="drawer-date-text">Date</span>
        </span>
      </div>

      <!-- Title -->
      <h2 class="detail-panel-title" id="drawer-title">Proposal Title</h2>

      <!-- Status callout banner -->
      <div class="detail-status-banner" id="drawer-status-banner">
        <div id="drawer-banner-icon-wrap" style="flex-shrink:0; margin-top:2px;"></div>
        <div class="detail-status-banner-content">
          <span class="detail-status-banner-title" id="drawer-banner-title">Proposal Status</span>
          <span class="detail-status-banner-desc" id="drawer-banner-desc">Status explanation.</span>
        </div>
      </div>

      <!-- Status Stepper (Lifecycle Timeline) -->
      <div class="status-stepper" id="drawer-stepper">
        <div class="step" id="drawer-step-pending">
          <div class="step-dot" id="drawer-dot-pending">1</div>
          <div class="step-label">Submitted</div>
        </div>
        <div class="step" id="drawer-step-approved">
          <div class="step-dot" id="drawer-dot-approved">2</div>
          <div class="step-label">Approved</div>
        </div>
        <div class="step" id="drawer-step-in_progress">
          <div class="step-dot" id="drawer-dot-in_progress">3</div>
          <div class="step-label">In Progress</div>
        </div>
        <div class="step" id="drawer-step-resolved">
          <div class="step-dot" id="drawer-dot-resolved">4</div>
          <div class="step-label">Resolved</div>
        </div>
      </div>

      <!-- Interactive Community Support Card -->
      <div class="detail-support-card">
        <button
          type="button"
          class="detail-support-btn"
          id="drawer-vote-btn"
          data-sf-click="action-101"
          aria-label="Support this idea"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="drawer-vote-icon"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
          <span class="detail-support-count" id="drawer-vote-count">0</span>
          <span id="drawer-vote-label">Support this idea</span>
        </button>

        <div class="detail-support-info">
          <span class="detail-support-info-strong">
            <span id="drawer-vote-summary">0</span> students support
          </span>
          <span>Prioritizing campus budget &amp; resources</span>
        </div>
      </div>

      <!-- Proposal Description Section -->
      <div class="detail-description-section">
        <div class="detail-section-header">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Proposal Description</span>
        </div>
        <div class="detail-description-box">
          <p class="detail-description-text" id="drawer-description"></p>
        </div>
      </div>

      <!-- Mobile jump to comments CTA -->
      <div class="mobile-jump-comments-bar">
        <button
          type="button"
          class="mobile-jump-comments-btn"
          data-sf-click="action-102"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Join Discussion (<span id="drawer-jump-comment-count">0</span> comments) →</span>
        </button>
      </div>
    </div>

    <!-- Column divider -->
    <div class="detail-col-divider"></div>

    <!-- ── RIGHT COLUMN: Threaded Discussion & Composer (50%) ── -->
    <div class="detail-col detail-col-right" id="drawer-right-col">
      <!-- Mobile context preview (FB-style: idea preview above scrollable comments) -->
      <div class="mobile-comments-context-header">
        <div class="mobile-context-info">
          <span class="mobile-context-tag" id="drawer-context-tag">Category</span>
          <p class="mobile-context-title" id="drawer-context-title">Title</p>
        </div>
        <button
          type="button"
          class="mobile-context-view-btn"
          data-sf-click="action-103"
        >
          View Proposal
        </button>
      </div>

      <!-- Scrollable comments tree -->
      <div class="detail-comments-scrollable" id="drawer-comments-scrollable">
        <div class="comments-section-header">
          <h3 class="comments-section-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Discussion (<span id="drawer-comments-header-count">0</span>)
          </h3>
        </div>

        <div class="comment-thread-scroll" id="drawer-comments-list">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Pending review notice if discussion locked -->
      <div id="drawer-pending-notice" class="comment-pending-notice" style="margin: 16px 20px; padding: 14px 16px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.22); border-radius: var(--radius-card); display: none; align-items: center; gap: 10px; font-size: 13px; color: #d97706; font-weight: 500;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Discussion and comments will open once this proposal is approved by campus staff.</span>
      </div>

      <!-- Comment composer form -->
      <form
        id="drawer-comment-composer"
        class="comment-composer-form"
        data-sf-submit="action-104"
      >
        <div class="comment-input-card">
          <!-- Replying Banner -->
          <div id="drawer-replying-banner" class="replying-banner" hidden>
            <div class="replying-banner-text">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/></svg>
              <span>Replying to <strong id="drawer-replying-author">@Student</strong></span>
            </div>
            <button type="button" class="replying-cancel-btn" data-sf-click="action-105" aria-label="Cancel reply">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

          <div class="comment-input-main">
            <textarea
              id="drawer-comment-input"
              class="comment-textarea-compact"
              rows="1"
              placeholder="Add a constructive thought…"
              maxlength="500"
              data-sf-input="action-106"
              data-sf-focusin="expand-comment"
              required
            ></textarea>
          </div>

          <!-- Bottom Bar (hidden until focused) -->
          <div class="comment-composer-bottom-bar" id="drawer-composer-bottom-bar">
            <div class="comment-composer-status">
              <span class="comment-char-tag" id="drawer-char-count">0/500</span>
            </div>
            <div class="comment-composer-buttons">
              <button
                type="button"
                class="btn-comment-cancel"
                data-sf-click="action-107"
              >Cancel</button>
              <button
                type="submit"
                class="btn-comment-post"
                id="drawer-comment-submit-btn"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                <span>Post</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</aside>

<script src="/js/idea-detail-drawer.js?v=20261010-ts"></script>
