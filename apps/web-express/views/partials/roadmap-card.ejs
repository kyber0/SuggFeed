<a href="/idea/<%= item.id %>" class="roadmap-card sp-section-card"
  style="display:block;text-decoration:none;padding:14px 16px;border-radius:12px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow-sm);transition:all var(--t-fast)">
  <div class="card-badges" style="margin-bottom:8px">
    <% if (item.categories?.name) { %>
      <span class="tag"><%= item.categories.name %></span>
    <% } %>
    <span class="vote-btn" style="padding:2px 8px;font-size:11px;margin-left:auto;pointer-events:none">
      ▲ <%= item.vote_count || 0 %>
    </span>
  </div>
  <p style="font-size:14px;font-weight:600;color:var(--ink);margin:0 0 6px;line-height:1.4">
    <%= item.title %>
  </p>
  <% if (item.description) { %>
    <p class="idea-card-desc" style="font-size:12px;color:var(--muted);margin:0;line-height:1.5">
      <%= item.description.substring(0,100) %><%= item.description.length > 100 ? '…' : '' %>
    </p>
  <% } %>
</a>
