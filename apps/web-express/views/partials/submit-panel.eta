<!-- Submit Idea Panel / Drawer -->
<div id="submit-panel-overlay" class="panel-overlay sip-overlay" hidden data-sf-click="action-109"></div>

<aside id="submit-panel" class="detail-panel sip-panel" role="dialog" aria-modal="true" aria-label="Share feedback" hidden>
  <!-- Mobile drag handle -->
  <div class="mobile-drag-handle" aria-hidden="true" data-sf-click="action-110"></div>

  <!-- Header -->
  <div class="sip-header">
    <div class="sip-header-left">
      <div class="sip-brand-dot" aria-hidden="true">
        <span class="sip-brand-pulse"></span>
      </div>
      <div>
        <h2 class="sip-header-title">Share your idea</h2>
        <div class="sip-header-sub sip-online">
          <span class="sip-status-indicator"></span>
          Community Review
        </div>
      </div>
    </div>
    <button type="button" class="panel-close-btn sip-close-btn" data-sf-click="action-111" aria-label="Close submit panel">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Stepper Bar -->
  <div class="sip-stepper-wrap">
    <div class="sip-stepper" role="tablist" id="sip-stepper" aria-label="Submission steps">
      <!-- Step 1 -->
      <button type="button" class="sip-step-item sip-step-item--active" id="step-btn-1" data-sf-click="action-112">
        <span class="sip-step-dot" id="step-dot-1">
          <span class="sip-step-num">1</span>
          <svg class="sip-step-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="sip-step-label">Category</span>
      </button>

      <div class="sip-step-track">
        <div class="sip-step-track-fill" id="step-track-fill-1"></div>
      </div>

      <!-- Step 2 -->
      <button type="button" class="sip-step-item" id="step-btn-2" data-sf-click="action-113">
        <span class="sip-step-dot" id="step-dot-2">
          <span class="sip-step-num">2</span>
          <svg class="sip-step-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="sip-step-label">Details</span>
      </button>

      <div class="sip-step-track">
        <div class="sip-step-track-fill" id="step-track-fill-2"></div>
      </div>

      <!-- Step 3 -->
      <button type="button" class="sip-step-item" id="step-btn-3" data-sf-click="action-114">
        <span class="sip-step-dot" id="step-dot-3">
          <span class="sip-step-num">3</span>
          <svg class="sip-step-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="sip-step-label">Review</span>
      </button>
    </div>
  </div>

  <form id="submit-idea-form" data-sf-submit="action-115" class="sip-form">
    <!-- Step 1: Category Selection -->
    <div id="sip-step-1" class="sip-step-content sip-step-body" role="tabpanel" aria-labelledby="step-btn-1">
      <div class="sip-step-intro">
        <h3 class="sip-section-title">Choose a category</h3>
        <p class="sip-section-sub">Select the area that best describes your idea or concern.</p>
      </div>

      <div class="sip-cat-grid" role="radiogroup" aria-label="Feedback category">
        <!-- Facilities -->
        <label class="sip-cat-card" id="cat-card-Facilities">
          <input type="radio" name="sip-category" value="Facilities" class="sip-cat-radio" required data-sf-change="action-116" />
          <div class="sip-cat-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
              <path d="M9 22v-4h6v4"/>
              <path d="M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01"/>
            </svg>
          </div>
          <div class="sip-cat-card-content">
            <div class="sip-cat-card-header">
              <span class="sip-cat-card-title">Facilities</span>
              <span class="sip-cat-check-dot"></span>
            </div>
            <div class="sip-cat-card-sub">Buildings, classrooms, restrooms, air conditioning, campus amenities</div>
          </div>
        </label>

        <!-- Learning -->
        <label class="sip-cat-card" id="cat-card-Learning">
          <input type="radio" name="sip-category" value="Learning" class="sip-cat-radio" data-sf-change="action-117" />
          <div class="sip-cat-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div class="sip-cat-card-content">
            <div class="sip-cat-card-header">
              <span class="sip-cat-card-title">Learning</span>
              <span class="sip-cat-check-dot"></span>
            </div>
            <div class="sip-cat-card-sub">Courses, academic resources, study halls, library, curriculum</div>
          </div>
        </label>

        <!-- Safety -->
        <label class="sip-cat-card" id="cat-card-Safety">
          <input type="radio" name="sip-category" value="Safety" class="sip-cat-radio" data-sf-change="action-118" />
          <div class="sip-cat-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div class="sip-cat-card-content">
            <div class="sip-cat-card-header">
              <span class="sip-cat-card-title">Safety</span>
              <span class="sip-cat-check-dot"></span>
            </div>
            <div class="sip-cat-card-sub">Campus security, night lighting, health, walkways, emergency readiness</div>
          </div>
        </label>

        <!-- Student life -->
        <label class="sip-cat-card" id="cat-card-Student-life">
          <input type="radio" name="sip-category" value="Student life" class="sip-cat-radio" data-sf-change="action-119" />
          <div class="sip-cat-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="sip-cat-card-content">
            <div class="sip-cat-card-header">
              <span class="sip-cat-card-title">Student life</span>
              <span class="sip-cat-check-dot"></span>
            </div>
            <div class="sip-cat-card-sub">Clubs, campus events, dining, mental health, community activities</div>
          </div>
        </label>

        <!-- Other -->
        <label class="sip-cat-card" id="cat-card-Other">
          <input type="radio" name="sip-category" value="Other" class="sip-cat-radio" data-sf-change="action-120" />
          <div class="sip-cat-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <div class="sip-cat-card-content">
            <div class="sip-cat-card-header">
              <span class="sip-cat-card-title">Other</span>
              <span class="sip-cat-check-dot"></span>
            </div>
            <div class="sip-cat-card-sub">General feedback, campus digital tools, administration, novel proposals</div>
          </div>
        </label>
      </div>
    </div>

    <!-- Step 2: Details -->
    <div id="sip-step-2" class="sip-step-content sip-step-body" role="tabpanel" aria-labelledby="step-btn-2" hidden>
      <div class="sip-step-intro">
        <h3 class="sip-section-title">Idea details</h3>
        <p class="sip-section-sub">Be clear and descriptive so peers and administrators can evaluate it.</p>
      </div>

      <!-- Title Field -->
      <div class="sip-field">
        <div class="sip-field-label-row">
          <label for="sip-title" class="sip-label">
            Title <span class="sip-required">*</span>
          </label>
          <div class="sip-char-wrap">
            <span id="sip-title-req" class="sip-validation-badge">Min 8 chars</span>
            <span id="sip-title-count" class="sip-char-counter">0 / 100</span>
          </div>
        </div>
        <div class="sip-input-container">
          <input
            type="text"
            id="sip-title"
            class="form-input sip-input-full"
            placeholder="Brief, specific summary (e.g. Add water refill stations in Library)"
            maxlength="100"
            autocomplete="off"
            data-sf-input="action-121"
          />
        </div>
      </div>

      <!-- Description Field -->
      <div class="sip-field">
        <div class="sip-field-label-row">
          <label for="sip-description" class="sip-label">
            Description <span class="sip-required">*</span>
          </label>
          <div class="sip-char-wrap">
            <span id="sip-desc-req" class="sip-validation-badge">Min 20 chars</span>
            <span id="sip-desc-count" class="sip-char-counter">0 / 1500</span>
          </div>
        </div>
        <div class="sip-input-container">
          <textarea
            id="sip-description"
            class="form-input sip-input-full sip-textarea"
            rows="5"
            placeholder="Describe what needs improvement, why it matters, and any suggested solutions or next steps."
            maxlength="1500"
            data-sf-input="action-122"
          ></textarea>
        </div>
      </div>

      <!-- Anonymous Submission Toggle -->
      <div class="sip-anon-card">
        <label class="sip-toggle-row" for="sip-anon">
          <div class="sip-toggle-info">
            <div class="sip-toggle-title-wrap">
              <span class="sip-toggle-title">Submit anonymously</span>
              <span id="sip-anon-status-pill" class="sip-badge-anon-state">Identity Hidden</span>
            </div>
            <div class="sip-toggle-sub">
              Your account will not be attached to this submission. Service logs may still record connection details; see the privacy notice.
            </div>
          </div>
          <div class="sip-switch">
            <input type="checkbox" id="sip-anon" checked class="sip-switch-input" data-sf-change="action-123" />
            <span class="sip-switch-slider"></span>
          </div>
        </label>
      </div>
    </div>

    <!-- Step 3: Review -->
    <div id="sip-step-3" class="sip-step-content sip-step-body" role="tabpanel" aria-labelledby="step-btn-3" hidden>
      <div class="sip-step-intro">
        <h3 class="sip-section-title">Review your submission</h3>
        <p class="sip-section-sub">Confirm details before publishing to the community queue.</p>
      </div>

      <!-- Live Preview Card -->
      <div class="sip-review-preview">
        <div class="sip-preview-header">
          <span class="sip-preview-kicker">Live Preview</span>
          <button type="button" class="sip-edit-link" data-sf-click="action-124">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
            </svg>
            Edit
          </button>
        </div>
        <div class="sip-review-card">
          <div class="sip-review-tags">
            <span id="rev-category" class="sip-tag-cat">Category</span>
            <span id="rev-anon-badge" class="sip-tag-anon">Anonymous</span>
          </div>
          <h4 id="rev-title" class="sip-review-title">Title</h4>
          <p id="rev-desc" class="sip-review-desc">Description</p>
        </div>
      </div>

      <!-- Tracking Notice Card -->
      <div class="sip-info-box">
        <div class="sip-info-icon-wrap" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <div class="sip-info-text">
          <strong>Private tracking code included:</strong> You will receive a unique code on the next screen to check administrative updates and moderation notes anonymously.
        </div>
      </div>

      <!-- Guidelines Consent Checkbox -->
      <label class="sip-consent-card" id="sip-consent-wrapper">
        <div class="sip-custom-checkbox">
          <input type="checkbox" id="sip-consent" required class="sip-consent-check" data-sf-change="action-125" />
          <span class="sip-checkbox-box">
            <svg class="sip-check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
        </div>
        <span class="sip-consent-text">
          I confirm that this idea is constructive and free from hate speech, harassment, spam, or confidential personal information.
        </span>
      </label>
    </div>

    <!-- Success View -->
    <div id="sip-success" class="sip-step-content sip-success-view" hidden>
      <div class="sip-success-header">
        <div class="sip-success-icon-wrap">
          <div class="sip-success-ripple"></div>
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h3 class="sip-success-title">Idea submitted successfully</h3>
        <p class="sip-success-sub">
          Your suggestion has been submitted for review. Keep your tracking code to check its status.
        </p>
      </div>

      <!-- Inline Tracking Code Box (No toast, inline copyable UI) -->
      <div class="sip-tracking-card">
        <div class="sip-tracking-card-header">
          <div class="sip-tracking-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Private Tracking Code
          </div>
          <span class="sip-tracking-copy-hint">Click code or button to copy</span>
        </div>

        <div class="sip-tracking-code-container" data-sf-click="action-126" role="button" tabindex="0" title="Click to copy tracking code" data-sf-keydown="action-127">
          <code id="sip-success-code" class="sip-tracking-code">—</code>
          <button type="button" class="sip-copy-btn" id="sip-copy-btn" data-sf-click="action-128" aria-label="Copy tracking code">
            <svg id="sip-copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span id="sip-copy-label">Copy</span>
          </button>
        </div>

        <!-- Inline feedback message (NO toast) -->
        <div id="sip-copy-confirm" class="sip-copy-confirm" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Tracking code copied to clipboard!
        </div>

        <div class="sip-tracking-footer-tip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          Keep this code safe. Use it in “Track submission” to check for updates without signing in.
        </div>
      </div>

      <div class="sip-success-actions">
        <button type="button" class="sip-btn-done" data-sf-click="action-129">
          Done
        </button>
      </div>
    </div>

    <!-- Footer Action Buttons -->
    <div id="sip-footer" class="sip-footer">
      <div class="sip-footer-left">
        <button type="button" id="sip-prev-btn" class="sip-btn-back sip-btn-back--hidden" data-sf-click="action-130" aria-label="Go to previous step">
          <svg class="sip-btn-back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          <span>Back</span>
        </button>
        <span id="sip-step-hint" class="sip-step-hint">Step 1 of 3</span>
      </div>

      <div class="sip-footer-right">
        <button type="button" id="sip-next-btn" class="sip-btn-action" data-sf-click="action-131">
          <span id="sip-next-text" class="sip-btn-action-text">Continue</span>
          <span id="sip-next-icon-wrap" class="sip-btn-action-icon">
            <svg class="sip-icon-continue" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
            <svg class="sip-icon-submit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            <svg class="sip-icon-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </form>
</aside>

<script src="/js/submit-panel.js?v=20261010-ts"></script>
