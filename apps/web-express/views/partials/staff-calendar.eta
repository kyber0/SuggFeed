<% const c=it.calendar,first=new Date(Date.UTC(c.year,c.monthNumber-1,1)),days=new Date(Date.UTC(c.year,c.monthNumber,0)).getUTCDate(),offset=(first.getUTCDay()+6)%7;const monthHref=delta=>{const query=new URLSearchParams(it.urlFor('',1).split('?')[1]);query.set('presentation','calendar');query.set('month',new Date(Date.UTC(c.year,c.monthNumber-1+delta,1)).toISOString().slice(0,7));query.delete('calendarPage');return '/admin/work?'+query.toString();};const pageHref=page=>{const q=new URLSearchParams(it.urlFor('',1).split('?')[1]);q.set('calendarPage',String(page));return '/admin/work?'+q.toString();}; %>
<section class="portal-calendar" aria-label="School target-date calendar"><header><div><h2><%= first.toLocaleDateString('en-PH',{month:'long',year:'numeric',timeZone:'UTC'}) %></h2><p><%= c.total %> matching ideas with target dates · page <%= c.page %> of <%= c.pages %>. Actual work dates stay in progress history.</p></div><nav aria-label="Calendar month"><% if(c.year>2000||c.monthNumber>1) { %><a class="workspace-button" href="<%= monthHref(-1) %>">← Previous</a><% } %><% if(c.year<2100||c.monthNumber<12) { %><a class="workspace-button" href="<%= monthHref(1) %>">Next →</a><% } %></nav></header><form class="portal-calendar-month" action="/admin/work" method="get"><% for(const [key,value] of new URLSearchParams(it.urlFor('',1).split('?')[1])){if(!['month','calendarPage'].includes(key)){ %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }} %><label>Jump to month<input class="workspace-input" type="month" name="month" value="<%= c.month %>" min="2000-01" max="2100-12" required></label><button class="workspace-button" type="submit">Go</button></form>
<div class="portal-calendar-grid"><% for(const day of ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']) { %><span class="portal-calendar-weekday"><%= day %></span><% } %><% for(let empty=0;empty<offset;empty++) { %><div class="portal-calendar-spacer" aria-hidden="true"></div><% } %><% for(let day=1;day<=days;day++){const date=c.month+'-'+String(day).padStart(2,'0'),items=c.items.filter(item=>String(item.target_date).slice(0,10)===date); %><section class="portal-calendar-day" aria-label="<%= date %>" <%= !items.length?'data-empty':'' %>><h3><time datetime="<%= date %>"><%= day %></time></h3><% for(const item of items) { %><a href="/admin/work?presentation=board&idea=<%= item.id %>" data-review="<%= item.id %>" aria-haspopup="dialog"><span><%= ({approved:'Planned',in_progress:'In progress',resolved:'Completed'})[item.status] %></span><strong><%= item.title %></strong><small><%= item.assignee_name || 'Unassigned' %></small></a><% } %></section><% } %></div>
<% if(!c.total) { %><p class="portal-quiet-state">No matching school target dates this month. Choose another month or view unscheduled work in List.</p><% } %><nav class="assignment-pagination" aria-label="Scheduled idea pages"><% if(c.page>1) { %><a class="workspace-button" href="<%= pageHref(c.page-1) %>">Previous 100</a><% } %><span>Up to 100 scheduled ideas per page. All days remain visible.</span><% if(c.page<c.pages) { %><a class="workspace-button" href="<%= pageHref(c.page+1) %>">Next 100</a><% } %></nav></section>
