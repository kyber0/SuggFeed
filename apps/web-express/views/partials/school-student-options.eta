<% const access=it.studentAccess || {confirmed:false,roster:[],discover:[],requests:[]}; %>
<% if(it.studentNotice) { %><p class="school-directory-notice" role="status"><%= it.studentNotice %></p><% } %>
<% if(access.roster.length) { %><section class="school-directory-section" aria-labelledby="roster-match-title"><p class="eyebrow">Your email is approved</p><h2 id="roster-match-title">Join with your approved email</h2><p>No invitation or additional administrator approval is needed.</p><% for(const school of access.roster) { %><article class="school-join-card"><div><h3><%= school.name %></h3><p>Your confirmed email matches this school’s approved list.</p><p>Read the school’s <a href="/s/<%= school.slug %>/privacy">privacy notice</a> and <a href="/s/<%= school.slug %>/terms">terms</a>.</p></div><form action="/schools/roster-join" method="post"><input type="hidden" name="schoolId" value="<%= school.id %>"/><input type="hidden" name="acknowledged" value="yes"/><button class="sf-empty-action" type="submit">Agree and join school</button></form></article><% } %></section><% } %>
<section class="school-directory-section" id="student-joining" aria-labelledby="find-student-school-title"><p class="eyebrow">Personal email welcome</p><h2 id="find-student-school-title">Find your school</h2><p>Using Gmail or another personal email? Search for a school that accepts access requests.</p>
 <% if(!access.confirmed) { %><p class="school-directory-notice">Confirm your account email before requesting student access.</p><% } else { %>
 <form class="student-school-search" method="get" action="/schools#student-joining" role="search"><div><label for="student-school-search">School name</label><input id="student-school-search" name="find" type="search" minlength="2" maxlength="100" required value="<%= it.find || '' %>" placeholder="Enter at least two letters"/></div><button class="sf-empty-action" type="submit">Find schools</button></form>
 <% if(it.find && !access.discover.length) { %><p class="student-search-help" role="status">No new access-request matches. Check your existing memberships, approved-email matches and request status, or ask the school administrator whether access requests are enabled.</p><% } %>
 <% for(const school of access.discover) { %><article class="school-join-card"><div><h3><%= school.name %></h3><p>School approval required. Its administrators will see your confirmed email to review your request.</p><p>Read the <a href="/s/<%= school.slug %>/privacy">school privacy notice</a> and <a href="/s/<%= school.slug %>/terms">terms</a> before requesting access.</p></div><form action="/schools/access-requests" method="post"><input type="hidden" name="schoolId" value="<%= school.id %>"/><input type="hidden" name="acknowledged" value="yes"/><button class="sf-empty-action" type="submit">Agree and request access</button></form></article><% } %>
 <% } %>
</section>
<% if(access.requests.length) { %><section class="school-directory-section" id="student-requests" aria-labelledby="student-request-status-title"><h2 id="student-request-status-title">Your access requests</h2><ul class="school-directory-memberships"><% for(const request of access.requests) { %><li><div><strong><%= request.name %></strong><p><%= request.status==='pending'?'Request received — your school will review it. You do not need to request again.':request.status==='approved'?'Access approved — check your memberships above':'Request declined — contact the school if you need help' %></p><p>Requested with <%= request.email %></p><p><a href="/s/<%= request.slug %>/privacy">School privacy & contact information</a></p></div><span class="platform-badge platform-badge--<%= request.status==='approved'?'active':request.status==='rejected'?'closed':'pending' %>"><%= request.status==='rejected'?'Declined':request.status==='approved'?'Approved':'Pending' %></span></li><% } %></ul><p class="staff-footnote">Showing your 20 most recent requests. You can have up to five pending requests. Approval grants student access only.</p></section><% } %>
