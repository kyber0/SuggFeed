<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page Not Found — SuggFeed</title>
  <link rel="icon" href="/favicon.ico" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <script>(function(){var t=localStorage.getItem('sf-theme')||'system';document.documentElement.setAttribute('data-theme',t==='dark'?'dark':t==='light'?'light':window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');})()</script>
</head>
<body>
<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:20px;text-align:center;padding:32px">
  <div style="font-size:72px;font-weight:800;color:var(--line)">404</div>
  <h1 style="font-size:22px;font-weight:700;color:var(--ink);margin:0">Page not found</h1>
  <p style="color:var(--muted);font-size:15px;max-width:380px">
    We couldn't find what you were looking for. It may have been moved or removed.
  </p>
  <a href="/" class="btn-primary-sm" style="padding:12px 24px;font-size:15px;border-radius:10px">Go home</a>
</div>
