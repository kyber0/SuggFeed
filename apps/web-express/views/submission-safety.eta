<% layout('layout') %>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main community-care-page safety-main">
<header class="workspace-heading"><div><p class="workspace-kicker">SCHOOL ADMINISTRATION</p><h1>Safety review</h1><p>Private review of flagged and reported submissions. Existing progress stages remain separate.</p></div></header>
<%~ include('partials/staff-safety-tabs',it) %>
<section <%= it.section!=='queue'?'hidden':'' %>><p><a class="workspace-button" href="<%= it.queue.all?'/admin/safety':'/admin/safety?view=all' %>"><%= it.queue.all?'Show items needing safety review':'Browse all submissions' %></a></p><p class="staff-footnote">Reviewing safety does not publish an item. Approve its normal workflow separately after review.</p>
<% for(const item of it.queue.items) { %><article class="care-card"><header><h2><%= item.title %></h2><span class="workspace-tag"><%= item.is_urgent?'Urgent · human review required':item.safety_state %></span></header><p><%= item.report_count %> open reports · <%= item.status %></p><details><summary>Read submission</summary><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= item.description %></p></details><p><a href="/admin/form-responses/<%= item.id %>">Review private school answers &amp; images →</a></p><details><summary>Review actions</summary><form class="care-form" data-safety-review action="/admin/safety/review" method="post"><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="version" value="<%= item.safety_version %>"><label>Decision<select name="action" class="workspace-input" data-portal-safety-action required><option value="">Choose a decision</option><option value="approve">Clear for ordinary staff review</option><option value="hide">Keep private</option><option value="delete">Delete submission text</option><option value="category">Change category only</option><option value="urgent">Change urgent flag only</option></select></label><label data-portal-safety-category>Category<select name="category" class="workspace-input"><% for(const c of it.categories.filter(c=>c.active)) { %><option value="<%= c.id %>" <%= c.id===item.category_id?'selected':'' %>><%= c.name %></option><% } %></select></label><label data-portal-safety-urgent><input type="checkbox" name="urgent" <%= item.is_urgent?'checked':'' %>> Urgent flag</label><label>Private review reason<textarea name="reason" class="workspace-input" minlength="10" maxlength="500" rows="2" required></textarea></label><p>Delete removes the title and description while preserving tracking, votes, replies and the audit record.</p><p data-safety-message role="status" aria-live="polite"></p><button type="submit" class="workspace-button">Save review</button></form></details></article><% } %>
<% if(!it.queue.items.length) { %><%~ include('partials/empty-state',{icon:'shield',heading:'No submissions need safety review',description:'Flagged and reported submissions appear here. Urgent items are placed first.'}) %><% } %>
<nav class="care-pagination" aria-label="Safety queue pages"><% if(it.queue.page>1) { %><a href="/admin/safety?page=<%= it.queue.page-1 %><%= it.queue.all?'&view=all':'' %>">Previous</a><% } %><span>Page <%= it.queue.page %> · <%= it.queue.total %> matching items</span><% if(it.queue.page*25<it.queue.total) { %><a href="/admin/safety?page=<%= it.queue.page+1 %><%= it.queue.all?'&view=all':'' %>">Next</a><% } %></nav>
</section><section class="care-card" <%= it.section!=='alerts'?'hidden':'' %>><h2>Private alerts</h2><% for(const notice of it.notices.items.filter(n=>n.kind==='urgent')) { %><article class="care-row"><strong>Urgent submission requires human review</strong><p><%= new Date(notice.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %> · <%= notice.read_at?'Read':'Unread' %></p><a href="/admin/safety">Open protected queue</a><% if(!notice.read_at) { %><button type="button" class="workspace-button" data-safety-read="<%= notice.id %>">Mark read</button><% } %></article><% } %><% if(!it.notices.items.some(n=>n.kind==='urgent')) { %><p>No urgent alerts have been sent to this account.</p><% } %></section>
<section class="care-card" <%= it.section!=='contacts'?'hidden':'' %>><h2>Escalation contacts</h2><p><strong>Configure a school-approved escalation process.</strong> Select responsible administrators below. This does not establish an emergency response service.</p><p>By default, all active school administrators receive in-app alerts. Selecting people below restricts future alerts to those administrators. An empty selection uses all administrators. Email delivery is disabled by default until the operator finalizes the process.</p><form method="post" action="/admin/safety/contacts" class="care-form"><% for(const member of it.members.filter(m=>m.role==='admin')) { %><label><input type="checkbox" name="ids" value="<%= member.id %>" <%= it.contacts.user_ids.includes(member.id)?'checked':'' %>> <%= member.display_name || 'School administrator' %></label><% } %><button class="workspace-button" type="submit">Save recipients</button></form></section>

<% if(it.section==='analytics') { const a=it.analytics; %><section aria-label="Safety analytics"><header class="workspace-heading"><div><h2>Submission overview</h2><p>Live school totals. Private safety information is shown only to administrators.</p></div></header><div class="safety-metrics"><article class="care-card"><h3>Unresolved</h3><strong><%= a.unresolved %></strong><p>Not completed or rejected; excludes deleted submissions.</p></article><article class="care-card"><h3>Urgent awaiting review</h3><strong><%= a.urgent %></strong><a href="/admin/safety">Review queue →</a></article></div><div class="safety-metrics"><article class="care-card"><h3>By progress stage</h3><dl class="safety-counts"><% for(const row of a.status) { %><div><dt><%= row.status %></dt><dd><%= row.count %></dd></div><% } %></dl><% if(!a.status.length) { %><p>No submissions yet.</p><% } %></article><article class="care-card"><h3>By category</h3><dl class="safety-counts"><% for(const row of a.category) { %><div><dt><%= row.name %></dt><dd><%= row.count %></dd></div><% } %></dl></article></div><article class="care-card"><h3>New submissions · last 30 days</h3><p>Database dates use UTC. Includes privately held submissions.</p><div class="safety-daily"><% const max=Math.max(1,...a.daily.map(d=>Number(d.count)));for(const row of a.daily) { %><div title="<%= String(row.day).slice(0,10) %>: <%= row.count %> submissions"><span class="safety-bar" style="--safety-bar:<%= Number(row.count)/max %>"></span><span class="safety-sr-only"><%= row.day %>: <%= row.count %></span></div><% } %></div><details><summary>Read daily totals</summary><dl class="safety-counts"><% for(const row of a.daily) { %><div><dt><%= String(row.day).slice(0,10) %></dt><dd><%= row.count %></dd></div><% } %></dl></details></article><article class="care-card"><h3>Most supported public ideas</h3><ol><% for(const row of a.top) { %><li><a href="/idea/<%= row.id %>"><%= row.title %></a> · <%= row.vote_count %> votes</li><% } %></ol><% if(!a.top.length) { %><p>No public ideas yet.</p><% } %></article></section><% } %>
<% if(it.section==='audit') { %><section class="care-card"><h2>Append-only audit history</h2><p>Administrative decisions and previous values. Submission text and reporter identities are not copied into these records.</p><% for(const row of it.audit.items) { %><article class="care-row"><h3><%= row.action %></h3><p><%= new Date(row.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %></p><dl><dt>Actor</dt><dd><%= row.actor_id || 'System' %></dd><dt>Target</dt><dd><%= row.target_table %> · <%= row.target_id %></dd></dl><details><summary>Change details</summary><pre class="safety-audit-data"><%= JSON.stringify(row.metadata,null,2) %></pre></details></article><% } %><% if(!it.audit.items.length) { %><p>No administrative actions recorded yet.</p><% } %><nav class="care-pagination" aria-label="Audit pages"><% if(it.audit.page>1) { %><a href="/admin/safety?section=audit&page=<%= it.audit.page-1 %>">Previous</a><% } %><span>Page <%= it.audit.page %> · <%= it.audit.total %> records</span><% if(it.audit.page*25<it.audit.total) { %><a href="/admin/safety?section=audit&page=<%= it.audit.page+1 %>">Next</a><% } %></nav></section><% } %>
</div></main>
