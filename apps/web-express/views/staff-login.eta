<% layout('layout') %>

<main class="admin-shell admin-login">
  <section class="login-card staff-login-card" aria-labelledby="staff-login-title">
    <p class="eyebrow">SUGGFEED STAFF PORTAL</p>
    <h1 id="staff-login-title">Sign in to continue</h1>
    <p class="staff-login-copy">Use your school staff account. Only accounts with a staff, moderator, or admin role can open the portal.</p>
    <form id="staff-login-form" novalidate>
      <div class="field">
        <label for="staff-email">School email</label>
        <input id="staff-email" name="email" type="email" autocomplete="username" required />
      </div>
      <div class="field">
        <label for="staff-password">Password</label>
        <input id="staff-password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <p id="staff-login-message" class="staff-login-message" role="status" aria-live="polite"></p>
      <button id="staff-login-submit" type="submit" class="btn-primary btn-full staff-login-submit">Sign in to staff portal</button>
    </form>
    <p class="staff-login-back"><a href="/">← Back to community</a></p>
  </section>
</main>

<script src="/js/staff-login.js?v=20261010-ts"></script>
