<% layout('layout') %>
<% const careIcon=name=>'<svg class="workspace-svg" aria-hidden="true" focusable="false"><use href="#ws-'+name+'"></use></svg>'; %>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main community-care-page">
 <header class="workspace-heading"><div><p class="workspace-kicker">COMMUNITY / CARE</p><h1>Keep the conversation moving</h1><p>Private follow-ups, human-reviewed reports, and accountable duplicate decisions.</p></div><a class="workspace-button" href="/admin">Review queue</a></header>
 <p id="care-message" role="status" aria-live="polite"></p><p class="staff-footnote"><%= it.coverage %> Refresh this page after saving to review the latest queue.</p>
 <nav class="care-section-nav" aria-label="Community care sections">
  <a href="#care-reminders"><%~ careIcon('clock') %> Stale work · <%= it.alerts.length %> shown</a>
  <a href="#care-reports"><%~ careIcon('shield') %> Reports · <%= it.reports.length %> shown</a>
  <a href="#care-clarification"><%~ careIcon('message') %> Clarification · <%= it.requests.length %> shown</a>
  <a href="#care-merges"><%~ careIcon('merge') %> Merge duplicates</a>
 </nav>
 <section class="care-card" id="care-reminders"><h2>Needs attention</h2><p>No public update for 30 days, or continuously blocked for more than 14 days. Votes and internal edits do not reset these reminders. No statuses are changed automatically.</p>
  <% for(const alert of it.alerts) { %><article class="care-row"><a href="/admin?idea=<%= alert.id %>" data-review="<%= alert.id %>" data-review-section="progress" aria-haspopup="dialog"><%= alert.title %></a><span><%= alert.reason %></span></article><% } %>
  <% if(!it.alerts.length) { %><p>No 30-day reminders in this window.</p><% } %>
 </section>
 <section class="care-card" id="care-reports"><h2>Content reports <span class="workspace-tag"><%= it.reports.length %> shown</span></h2><p>Inspect the context before removing content. Reports alone never hide an idea.</p>
  <% for(const report of it.reports) { %><article class="care-row" data-care-row="report-<%= report.id %>"><h3><%= report.submission?.title || 'Reported comment' %></h3><blockquote><%= report.comment?.body || 'Suggestion report' %></blockquote><p>Reporter’s reason: <%= report.reason %></p><% const parentId=report.submission_id || report.comment?.submission_id; if(parentId) { %><a class="workspace-text-link" href="/admin?idea=<%= parentId %>" data-review="<%= parentId %>" aria-haspopup="dialog">Open submission →</a><% } else { %><p class="staff-footnote">Parent submission unavailable.</p><% } %>
   <form class="care-form" data-care-action="resolve"><input type="hidden" name="id" value="<%= report.id %>"/><label>Decision<select class="workspace-input" name="resolution"><option value="dismissed">Dismiss — keep content</option><option value="removed">Remove from public view</option></select></label><label>Reason shown privately to reporter<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required></textarea></label><button class="workspace-button" type="submit">Review decision</button></form>
  </article><% } %><% if(!it.reports.length) { %><p>No open reports.</p><% } %>
 </section>
 <section class="care-card" id="care-clarification"><h2>Private clarification</h2><p>These messages never appear in the feed, public history or notifications. Anonymous submitters use their tracking code; identified owners use their account.</p>
  <form class="care-form" data-care-action="request"><label>Submission ID<input class="workspace-input" name="submissionId" value="<%= it.submissionId || '' %>" required placeholder="Choose Request private clarification in the review queue"/></label><label>Question to the submitter<textarea class="workspace-input" name="body" minlength="10" maxlength="2000" required placeholder="Which part of the library needs more seating? Please avoid personal details."></textarea></label><button class="workspace-button" type="submit">Send private request</button></form>
  <% for(const request of it.requests) { %><article class="care-row" data-care-row="request-<%= request.id %>"><h3><%= request.submission?.title || 'Submission' %></h3><a class="workspace-text-link" href="/admin?idea=<%= request.submission_id %>" data-review="<%= request.submission_id %>" aria-haspopup="dialog">Open submission →</a><p><%= request.prompt %></p><blockquote><%= request.reply || 'Awaiting a private reply' %></blockquote><small><%= new Date(request.created_at).toLocaleDateString('en-PH') %><%= !request.reply && Date.now()-new Date(request.created_at).getTime()>7*86400000 ? ' · Unanswered for more than 7 days' : '' %></small><form data-care-action="close"><input type="hidden" name="id" value="<%= request.id %>"/><button class="workspace-button" type="submit">Close request</button></form></article><% } %>
 </section>
 <section class="care-card" id="care-merges"><h2>Merge duplicate public ideas</h2><p>The original tracking record and votes are retained. Followers move to the destination; votes are not added together. A public merge reason becomes part of the destination’s history. Only independent public ideas can be merged.</p>
  <form class="care-form" data-care-action="merge"><label>Original idea ID<input class="workspace-input" name="submissionId" required/></label><label>Destination idea ID<input class="workspace-input" name="targetId" required/></label><label>Public reason<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required placeholder="These suggestions describe the same improvement. Updates will continue on the destination idea."></textarea></label><button class="workspace-button" type="submit">Preview merge</button></form>
 </section>
</div><%~ include('partials/staff-review',{...it,staffMembers:it.members}) %></main>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script src="/js/staff-progress.js?v=20261012-evidence"></script>
<script src="/js/staff-review.js?v=20261012-shared-review"></script>
<script src="/js/staff-tools.js?v=20261012-shared-review"></script>
<section class="staff-mobile-notice"><h1>Staff workspace</h1><p>Use a desktop or larger screen to review community care.</p><a class="workspace-button" href="/roadmap">Explore the roadmap</a></section>
