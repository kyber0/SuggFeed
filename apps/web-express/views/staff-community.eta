<% layout('layout') %>
<% const section=it.section==='reports'?'clarifications':it.section || 'clarifications'; const counts=it.counts || {reports:it.reports.length,clarifications:it.requests.length,attention:it.alerts.length}; const pages=it.pages || {reports:1,clarifications:1,attention:1}; counts.comments=it.commentQueue?.count || 0;pages.comments=it.commentQueue?.page || 1; const careUrl=(view,page=1)=>'/admin/community?'+new URLSearchParams({section:view,[view+'Page']:String(page),...(it.submissionId?{idea:it.submissionId}:{})}).toString(); const careIcon=name=>'<svg class="workspace-svg" aria-hidden="true" focusable="false"><use href="#ws-'+name+'"></use></svg>'; %>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main community-care-page">
 <header class="workspace-heading"><div><p class="workspace-kicker">COMMUNITY / CARE</p><h1>Follow-ups</h1><p>Private follow-ups, human-reviewed reports, and accountable duplicate decisions.</p></div><a class="workspace-button" href="/admin/reviews">Review ideas</a></header>
 <p id="care-message" role="status" aria-live="polite"></p><p class="staff-footnote"><%= it.coverage %></p>
 <nav class="care-section-nav" aria-label="Follow-up views">
  <% for(const [key,label,glyph] of [['clarifications','Clarifications','message'],['attention','Needs attention','clock'],...(it.user?.role==='admin'?[['comments','Comment review','message']]:[])]) { %><a href="<%= careUrl(key) %>" aria-current="<%= section===key?'page':'false' %>"><%~ careIcon(glyph) %> <%= label %> · <%= counts[key] %></a><% } %>
 </nav>
 <nav class="care-pagination" aria-label="Follow-up pages"><% if(pages[section]>1) { %><a href="<%= careUrl(section,pages[section]-1) %>">Previous</a><% } %><span>Page <%= pages[section] %> of <%= Math.max(1,Math.ceil(counts[section]/25)) %> · <%= counts[section] %> matching records</span><% if(pages[section]*25<counts[section]) { %><a href="<%= careUrl(section,pages[section]+1) %>">Next</a><% } %></nav>
 <% if(it.user?.role==='admin') { %><section class="care-card" id="care-comments" <%= section!=='comments'?'hidden':'' %>><h2>Comment review</h2><p>Flagged comments are private. Review the full context before approving, hiding or deleting the text. Deleting preserves replies and the moderation record.</p>
 <% for(const comment of it.commentQueue?.items || []) { %><article class="care-row"><h3><%= comment.display_name || 'Student' %> · <%= comment.moderation_status %></h3><blockquote><%= comment.body %></blockquote><p><%= comment.open_report_count %> open reports</p><a class="workspace-text-link" href="/admin/reviews?idea=<%= comment.submission_id %>" data-review="<%= comment.submission_id %>" aria-haspopup="dialog">Open submission →</a><form class="care-form" data-care-action="comment-review"><input type="hidden" name="id" value="<%= comment.id %>"><input type="hidden" name="version" value="<%= comment.version %>"><label>Decision<select class="workspace-input" name="decision"><option value="approve">Approve — show comment</option><option value="hide">Hide — keep private</option><option value="delete">Delete comment text</option></select></label><label>Review reason<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required></textarea></label><button class="workspace-button" type="submit">Review decision</button></form></article><% } %>
 <% if(!it.commentQueue?.items.length) { %><%~ include('partials/empty-state',{compact:true,icon:'shield',heading:'No comments need review',description:'Flagged and reported comments appear here for administrator review.'}) %><% } %></section><% } %>
 <section class="care-card" id="care-reminders" <%= section!=='attention'?'hidden':'' %>><h2>Needs attention</h2><p>No public update for 30 days, or continuously blocked for more than 14 days. Votes and internal edits do not reset these reminders. No statuses are changed automatically.</p>
  <% for(const alert of it.alerts) { %><article class="care-row"><a href="/admin/reviews?idea=<%= alert.id %>" data-review="<%= alert.id %>" data-review-section="progress" aria-haspopup="dialog"><%= alert.title %></a><span><%= alert.reason %></span></article><% } %>
  <% if(!it.alerts.length) { %><%~ include('partials/empty-state',{compact:true,icon:'check',heading:'No work needs a reminder',description:'Overdue public updates and long-running blockers will appear here for follow-up.'}) %><% } %>
 </section>
 <% if(it.user?.role==='admin') { %><p><a class="workspace-button" href="/admin/safety">Review submission reports →</a></p><% } %>
 <section class="care-card" id="care-clarification" <%= section!=='clarifications'?'hidden':'' %>><h2>Private clarification</h2><p>These messages never appear in the feed, public history or notifications. Anonymous submitters use their tracking code; identified owners use their account.</p>
  <form class="care-form" data-care-action="request"><%~ include('partials/submission-picker',{name:'submissionId',id:'clarification-submission',value:it.submissionId || '',label:'Suggestion for this private question'}) %><label>Question to the submitter<textarea class="workspace-input" name="body" minlength="10" maxlength="2000" required placeholder="Which part of the library needs more seating? Please avoid personal details."></textarea></label><button class="workspace-button" type="submit">Send private request</button></form>
  <% if(!it.requests.length) { %><%~ include('partials/empty-state',{compact:true,icon:'message',heading:'No private questions yet',description:'Use the form above when you need more detail from a submitter. Open requests and replies will appear here.'}) %><% } %><% for(const request of it.requests) { %><article class="care-row" data-care-row="request-<%= request.id %>"><h3><%= request.submission?.title || 'Submission' %></h3><a class="workspace-text-link" href="/admin/reviews?idea=<%= request.submission_id %>" data-review="<%= request.submission_id %>" aria-haspopup="dialog">Open submission →</a><p><%= request.prompt %></p><blockquote><%= request.reply || 'Awaiting a private reply' %></blockquote><small><%= new Date(request.created_at).toLocaleDateString('en-PH') %><%= !request.reply && Date.now()-new Date(request.created_at).getTime()>7*86400000 ? ' · Unanswered for more than 7 days' : '' %></small><form data-care-action="close"><input type="hidden" name="id" value="<%= request.id %>"/><button class="workspace-button" type="submit">Close request</button></form></article><% } %>
 </section>
 <section class="care-card" id="care-merges" <%= !it.mergeSelected || !it.submissionId?'hidden':'' %>><h2>Merge duplicate public ideas</h2><p>The original tracking record and votes are retained. Followers move to the destination; votes are not added together. A public merge reason becomes part of the destination’s history. Only independent public ideas can be merged.</p>
  <form class="care-form" data-care-action="merge"><input type="hidden" name="submissionId" value="<%= it.submissionId || '' %>"/><p>Selected source: <%= (it.submissionId || '').slice(0,8) %> — review the source in the preview before confirming.</p><%~ include('partials/submission-picker',{name:'targetId',id:'merge-destination',value:'',label:'Destination public idea',publicOnly:true}) %><label>Public reason<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required placeholder="These suggestions describe the same improvement. Updates will continue on the destination idea."></textarea></label><button class="workspace-button" type="submit">Preview merge</button></form>
 </section>
</div><%~ include('partials/staff-detail',{...it,staffMembers:it.members}) %></main>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/staff-progress.js?v=20261025-staff-flow"></script>
<script defer src="/js/staff-review.js?v=20261025-assignment"></script>
<script defer src="/js/staff-tools.js?v=20261025-staff-flow"></script>
<section class="staff-mobile-notice"><h1>Staff workspace</h1><p>Use a desktop or larger screen to review community care.</p><a class="workspace-button" href="/roadmap">Explore the roadmap</a></section>
