<% layout('layout') %>
<% const section=it.section==='reports'?'clarifications':it.section || 'clarifications'; const counts=it.counts || {reports:it.reports.length,clarifications:it.requests.length,attention:it.alerts.length}; const pages=it.pages || {reports:1,clarifications:1,attention:1}; counts.comments=it.commentQueue?.count || 0;pages.comments=it.commentQueue?.page || 1; const careUrl=(view,page=1)=>'/admin/community?'+new URLSearchParams({section:view,[view+'Page']:String(page),...(it.submissionId?{idea:it.submissionId}:{}),...(view==='comments'?{commentView:it.commentQueue?.view||'needs-review'}:{})}).toString(); const careIcon=name=>'<svg class="workspace-svg" aria-hidden="true" focusable="false"><use href="#ws-'+name+'"></use></svg>'; %>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main community-care-page">
 <header class="workspace-heading"><div><p class="workspace-kicker">COMMUNITY / CARE</p><h1>Follow-ups</h1><p>Private follow-ups, human-reviewed reports, and accountable duplicate decisions.</p></div><a class="workspace-button" href="/admin/reviews">Review ideas</a></header>
 <p id="care-message" role="status" aria-live="polite"></p><p class="staff-footnote"><%= it.coverage %></p>
 <nav class="care-section-nav" aria-label="Follow-up views">
  <% for(const [key,label,glyph] of [['clarifications','Clarifications','message'],['attention','Needs attention','clock'],...(it.user?.role==='admin'?[['comments','Comment review','message']]:[])]) { %><a href="<%= careUrl(key) %>" aria-current="<%= section===key?'page':'false' %>"><%~ careIcon(glyph) %> <%= label %> · <%= key==='comments'?(it.commentQueue?.activeCount || 0):counts[key] %></a><% } %>
 </nav>
 <nav class="care-pagination" aria-label="Follow-up pages"><% if(pages[section]>1) { %><a href="<%= careUrl(section,pages[section]-1) %>">Previous</a><% } %><span>Page <%= pages[section] %> of <%= Math.max(1,Math.ceil(counts[section]/25)) %> · <%= counts[section] %> matching records</span><% if(pages[section]*25<counts[section]) { %><a href="<%= careUrl(section,pages[section]+1) %>">Next</a><% } %></nav>
 <% if(it.user?.role==='admin') { %><section class="care-card comment-review-workspace" id="care-comments" <%= section!=='comments'?'hidden':'' %>>
 <header class="comment-review-heading"><div><p class="workspace-kicker">DISCUSSION SAFETY</p><h2>Comment review</h2><p>Read the context, then decide. Held text stays private until approved.</p></div></header>
 <nav class="comment-review-tabs" aria-label="Comment review status"><% for(const [key,label] of [['needs-review','Needs review'],['reported','Reported'],['resolved','Resolved']]) { %><a href="/admin/community?section=comments&amp;commentView=<%= key %>" aria-current="<%= it.commentQueue?.view===key?'page':'false' %>"><%= label %><span><%= it.commentQueue?.counts?.[key] || 0 %></span></a><% } %></nav>
 <% for(const comment of it.commentQueue?.items || []) { const reasonLabels={dictionary:'Language check',reports:'Member reports',detector_unavailable:'Detection unavailable',legacy_check:'Verification needed',clear:'Member reports'}; %>
 <article class="care-row comment-review-item"><header><div><strong><%= comment.display_name || 'Student' %></strong><span class="workspace-tag"><%= reasonLabels[comment.moderation_reason] || 'Needs review' %></span></div><small>Text revision <%= comment.text_revision %> · <%= comment.moderation_status %></small></header>
 <a class="comment-review-idea" href="/admin/reviews?idea=<%= comment.submission_id %>" data-review="<%= comment.submission_id %>" aria-haspopup="dialog"><%= comment.idea_title || 'Open idea context' %> →</a>
 <% if(comment.parent_body) { %><details class="comment-review-context"><summary>In reply to</summary><blockquote><%= comment.parent_body %></blockquote></details><% } %>
 <blockquote class="comment-review-text"><%= comment.body %></blockquote>
 <details class="comment-review-context"><summary><%= comment.open_report_count %> open reports · Context &amp; history</summary>
 <p>Detector: <%= comment.detector_version %>. Rule groups: <%= (comment.moderation_rules||[]).join(', ') || 'No dictionary match recorded' %>.</p>
 <% if(comment.moderation_reason==='detector_unavailable') { %><p>The detector could not finish. This does not mean the comment contains profanity.</p><% } %>
 <% for(const report of comment.reports || []) { %><p><strong>Report · text revision <%= report.comment_revision %></strong> · <%= report.resolution || 'Open' %></p><blockquote><%= report.reason %></blockquote><% } %>
 <% for(const revision of comment.revisions || []) { %><details><summary>Text revision <%= revision.revision %></summary><p><%= revision.body || 'Text erased by administrator' %></p></details><% } %>
 <% for(const decision of comment.decisions || []) { %><p><strong><%= decision.action.replace('comment_','') %></strong> · <%= decision.reason %></p><% } %>
 <p class="staff-footnote">Showing up to 30 reports, 10 text revisions and 10 recent decisions. Earlier audit records remain retained.</p></details>
 <% if(comment.moderation_status!=='deleted') { %><details class="comment-review-decision"><summary><%= it.commentQueue?.view==='resolved'?'Reconsider decision':'Review this comment' %></summary><form class="care-form" data-care-action="comment-review"><input type="hidden" name="id" value="<%= comment.id %>"><input type="hidden" name="version" value="<%= comment.version %>"><input type="hidden" name="textRevision" value="<%= comment.text_revision %>"><label>Decision<select class="workspace-input" name="decision" required><option value="">Choose a decision</option><option value="approve">Approve — show comment</option><option value="hide">Keep hidden — resolve review</option><option value="delete">Delete text — preserve replies</option></select></label><label>Explanation to the author<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required rows="2" placeholder="Explain your decision respectfully. Do not identify reporters."></textarea></label><p class="staff-footnote">Your explanation is shown privately to the author and reporters.</p><button class="workspace-button workspace-button--primary" type="submit">Save decision</button></form></details>
 <% } else { %><p class="comment-review-resolution"><strong>Resolved</strong> · <%= comment.review_reason || 'Decision retained in the audit history.' %></p><% } %></article>
 <% } %>
 <% if(!it.commentQueue?.items.length) { %><%~ include('partials/empty-state',{compact:true,icon:'shield',heading:it.commentQueue?.view==='resolved'?'No resolved reviews yet':'No comments need attention',description:'New review work appears here. Completed decisions are kept in Resolved.'}) %><% } %></section><% } %>
 <section class="care-card" id="care-reminders" <%= section!=='attention'?'hidden':'' %>><h2>Needs attention</h2><p>No public update for 30 days, or continuously blocked for more than 14 days. Votes and internal edits do not reset these reminders. No statuses are changed automatically.</p>
  <% for(const alert of it.alerts) { %><article class="care-row"><a href="/admin/reviews?idea=<%= alert.id %>" data-review="<%= alert.id %>" data-review-section="progress" aria-haspopup="dialog"><%= alert.title %></a><span><%= alert.reason %></span></article><% } %>
  <% if(!it.alerts.length) { %><%~ include('partials/empty-state',{compact:true,icon:'check',heading:'No work needs a reminder',description:'Overdue public updates and long-running blockers will appear here for follow-up.'}) %><% } %>
 </section>
 <% if(it.user?.role==='admin') { %><p><a class="workspace-button" href="/admin/safety">Review submission reports →</a></p><% } %>
 <section class="care-card" id="care-clarification" <%= section!=='clarifications'?'hidden':'' %>><h2>Private clarification</h2><p>These messages never appear in the feed, public history or notifications. Anonymous submitters use their tracking code; identified owners use their account.</p>
  <form class="care-form" data-care-action="request"><%~ include('partials/submission-picker',{name:'submissionId',id:'clarification-submission',value:it.submissionId || '',label:'Suggestion for this private question'}) %><label>Question to the submitter<textarea class="workspace-input" name="body" minlength="10" maxlength="2000" required placeholder="Which part of the library needs more seating? Please avoid personal details."></textarea></label><button class="workspace-button" type="submit">Send private request</button></form>
  <% if(!it.requests.length) { %><%~ include('partials/empty-state',{compact:true,icon:'message',heading:'No private questions yet',description:'Use the form above when you need more detail from a submitter. Open requests and replies will appear here.'}) %><% } %><% for(const request of it.requests) { %><article class="care-row" data-care-row="request-<%= request.id %>"><h3><%= request.submission?.title || 'Submission' %></h3><a class="workspace-text-link" href="/admin/reviews?idea=<%= request.submission_id %>" data-review="<%= request.submission_id %>" aria-haspopup="dialog">Open submission →</a><p><%= request.prompt %></p><blockquote><%= request.reply || 'Awaiting a private reply' %></blockquote><small><%= new Date(request.created_at).toLocaleDateString('en-PH') %><%= !request.reply && Date.now()-new Date(request.created_at).getTime()>7*86400000 ? ' · Unanswered for more than 7 days' : '' %></small><form data-care-action="close"><input type="hidden" name="id" value="<%= request.id %>"/><button class="workspace-button" type="submit">Close request</button></form></article><% } %>
 </section>
 <section class="care-card" id="care-merges" <%= !it.mergeSelected || !it.submissionId?'hidden':'' %>><h2>Merge duplicate public ideas</h2><p>The original tracking record and votes are retained. Followers move to the destination; votes are not added together. A public merge reason becomes part of the destination’s history. Only independent public ideas can be merged.</p>
  <form class="care-form" data-care-action="merge"><input type="hidden" name="submissionId" value="<%= it.submissionId || '' %>"/><p>Selected source: <%= (it.submissionId || '').slice(0,8) %> — review the source in the preview before confirming.</p><%~ include('partials/submission-picker',{name:'targetId',id:'merge-destination',value:'',label:'Destination public idea',publicOnly:true}) %><label>Public reason<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required placeholder="These suggestions describe the same improvement. Updates will continue on the destination idea."></textarea></label><button class="workspace-button" type="submit">Preview merge</button></form>
 </section>
</div><%~ include('partials/staff-detail',{...it,staffMembers:it.members}) %></main>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/staff-progress.js?v=20261025-detail-polish"></script>
<script defer src="/js/staff-review.js?v=20261025-detail-polish"></script>
<script defer src="/js/staff-tools.js?v=20261025-staff-flow"></script>
<section class="staff-mobile-notice"><h1>Staff workspace</h1><p>Use a desktop or larger screen to review community care.</p><a class="workspace-button" href="/roadmap">Explore the roadmap</a></section>
