<% layout('layout') %>
<% const section=it.section || 'reports'; const counts=it.counts || {reports:it.reports.length,clarifications:it.requests.length,attention:it.alerts.length}; const pages=it.pages || {reports:1,clarifications:1,attention:1}; const careUrl=(view,page=1)=>'/admin/community?'+new URLSearchParams({section:view,[view+'Page']:String(page),...(it.submissionId?{idea:it.submissionId}:{})}).toString(); const careIcon=name=>'<svg class="workspace-svg" aria-hidden="true" focusable="false"><use href="#ws-'+name+'"></use></svg>'; %>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main community-care-page">
 <header class="workspace-heading"><div><p class="workspace-kicker">COMMUNITY / CARE</p><h1>Follow-ups</h1><p>Private follow-ups, human-reviewed reports, and accountable duplicate decisions.</p></div><a class="workspace-button" href="/admin">Review queue</a></header>
 <p id="care-message" role="status" aria-live="polite"></p><p class="staff-footnote"><%= it.coverage %></p>
 <nav class="care-section-nav" aria-label="Follow-up views">
  <% for(const [key,label,glyph] of [['reports','Reports','shield'],['clarifications','Clarifications','message'],['attention','Needs attention','clock']]) { %><a href="<%= careUrl(key) %>" aria-current="<%= section===key?'page':'false' %>"><%~ careIcon(glyph) %> <%= label %> · <%= counts[key] %></a><% } %>
 </nav>
 <nav class="care-pagination" aria-label="Follow-up pages"><% if(pages[section]>1) { %><a href="<%= careUrl(section,pages[section]-1) %>">Previous</a><% } %><span>Page <%= pages[section] %> of <%= Math.max(1,Math.ceil(counts[section]/25)) %> · <%= counts[section] %> matching records</span><% if(pages[section]*25<counts[section]) { %><a href="<%= careUrl(section,pages[section]+1) %>">Next</a><% } %></nav>
 <section class="care-card" id="care-reminders" <%= section!=='attention'?'hidden':'' %>><h2>Needs attention</h2><p>No public update for 30 days, or continuously blocked for more than 14 days. Votes and internal edits do not reset these reminders. No statuses are changed automatically.</p>
  <% for(const alert of it.alerts) { %><article class="care-row"><a href="/admin?idea=<%= alert.id %>" data-review="<%= alert.id %>" data-review-section="progress" aria-haspopup="dialog"><%= alert.title %></a><span><%= alert.reason %></span></article><% } %>
  <% if(!it.alerts.length) { %><p>No 30-day reminders in this window.</p><% } %>
 </section>
 <section class="care-card" id="care-reports" <%= section!=='reports'?'hidden':'' %>><h2>Content reports <span class="workspace-tag"><%= it.reports.length %> shown</span></h2><p>Inspect the context before removing content. Reports alone never hide an idea.</p>
  <% for(const report of it.reports) { %><article class="care-row" data-care-row="report-<%= report.id %>"><h3><%= report.submission?.title || 'Reported comment' %></h3><blockquote><%= report.comment?.body || 'Suggestion report' %></blockquote><p>Reporter’s reason: <%= report.reason %></p><% const parentId=report.submission_id || report.comment?.submission_id; if(parentId) { %><a class="workspace-text-link" href="/admin?idea=<%= parentId %>" data-review="<%= parentId %>" aria-haspopup="dialog">Open submission →</a><% } else { %><p class="staff-footnote">Parent submission unavailable.</p><% } %>
   <form class="care-form" data-care-action="resolve"><input type="hidden" name="id" value="<%= report.id %>"/><label>Decision<select class="workspace-input" name="resolution"><option value="dismissed">Dismiss — keep content</option><% if(report.comment_id || it.user?.role==='admin') { %><option value="removed">Remove from public view</option><% } %></select></label><label>Reason shown privately to reporter<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required></textarea></label><button class="workspace-button" type="submit">Review decision</button></form>
  </article><% } %><% if(!it.reports.length) { %><p>No open reports.</p><% } %>
 </section>
 <section class="care-card" id="care-clarification" <%= section!=='clarifications'?'hidden':'' %>><h2>Private clarification</h2><p>These messages never appear in the feed, public history or notifications. Anonymous submitters use their tracking code; identified owners use their account.</p>
  <form class="care-form" data-care-action="request"><%~ include('partials/submission-picker',{name:'submissionId',id:'clarification-submission',value:it.submissionId || '',label:'Suggestion for this private question'}) %><label>Question to the submitter<textarea class="workspace-input" name="body" minlength="10" maxlength="2000" required placeholder="Which part of the library needs more seating? Please avoid personal details."></textarea></label><button class="workspace-button" type="submit">Send private request</button></form>
  <% for(const request of it.requests) { %><article class="care-row" data-care-row="request-<%= request.id %>"><h3><%= request.submission?.title || 'Submission' %></h3><a class="workspace-text-link" href="/admin?idea=<%= request.submission_id %>" data-review="<%= request.submission_id %>" aria-haspopup="dialog">Open submission →</a><p><%= request.prompt %></p><blockquote><%= request.reply || 'Awaiting a private reply' %></blockquote><small><%= new Date(request.created_at).toLocaleDateString('en-PH') %><%= !request.reply && Date.now()-new Date(request.created_at).getTime()>7*86400000 ? ' · Unanswered for more than 7 days' : '' %></small><form data-care-action="close"><input type="hidden" name="id" value="<%= request.id %>"/><button class="workspace-button" type="submit">Close request</button></form></article><% } %>
 </section>
 <section class="care-card" id="care-merges" <%= !it.mergeSelected || !it.submissionId?'hidden':'' %>><h2>Merge duplicate public ideas</h2><p>The original tracking record and votes are retained. Followers move to the destination; votes are not added together. A public merge reason becomes part of the destination’s history. Only independent public ideas can be merged.</p>
  <form class="care-form" data-care-action="merge"><input type="hidden" name="submissionId" value="<%= it.submissionId || '' %>"/><p>Selected source: <%= (it.submissionId || '').slice(0,8) %> — review the source in the preview before confirming.</p><%~ include('partials/submission-picker',{name:'targetId',id:'merge-destination',value:'',label:'Destination public idea',publicOnly:true}) %><label>Public reason<textarea class="workspace-input" name="body" minlength="10" maxlength="500" required placeholder="These suggestions describe the same improvement. Updates will continue on the destination idea."></textarea></label><button class="workspace-button" type="submit">Preview merge</button></form>
 </section>
</div><%~ include('partials/staff-review',{...it,staffMembers:it.members}) %></main>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/staff-progress.js?v=20261013-custom-dialogs"></script>
<script defer src="/js/staff-review.js?v=20261014-staff-interactions"></script>
<script defer src="/js/staff-tools.js?v=20261014-open-workspace"></script>
<section class="staff-mobile-notice"><h1>Staff workspace</h1><p>Use a desktop or larger screen to review community care.</p><a class="workspace-button" href="/roadmap">Explore the roadmap</a></section>
