<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>[hidden] { display: none !important; }</style>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>(function(){var t=localStorage.getItem('sf-theme')||'system';document.documentElement.setAttribute('data-theme',t==='dark'?'dark':t==='light'?'light':window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');})()</script>
</head>
<body>
<%- include('partials/header') %>
<%- include('partials/toast') %>
<%- include('partials/auth-modal') %>

<main class="sf-main">
  <div style="max-width:800px;margin:0 auto;padding:24px 16px 64px">

    <!-- Back -->
    <a href="/feed" style="display:inline-flex;align-items:center;gap:6px;font-size:14px;color:var(--muted);text-decoration:none;margin-bottom:24px">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Back to ideas
    </a>

    <!-- Idea header -->
    <div class="sp-section-card" style="margin-bottom:24px">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px">
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <% if (idea.categories?.name) { %>
            <span class="idea-tag"><%= idea.categories.name %></span>
          <% } %>
          <span class="idea-status idea-status--<%= idea.status %>"><%= readableStatus(idea.status) %></span>
          <% if (idea.attachments?.length > 0) { %>
            <span style="font-size:12px;color:var(--muted)">📎 <%= idea.attachments.length %> attachment<%= idea.attachments.length > 1 ? 's' : '' %></span>
          <% } %>
        </div>
        <time style="font-size:13px;color:var(--muted)" datetime="<%= idea.created_at %>">
          <%= new Date(idea.created_at).toLocaleDateString('en',{month:'long',day:'numeric',year:'numeric'}) %>
        </time>
      </div>

      <h1 style="font-size:22px;font-weight:700;color:var(--ink);margin:0 0 12px"><%= idea.title %></h1>
      <% if (idea.description) { %>
        <p style="font-size:15px;color:var(--muted);line-height:1.65;margin:0 0 20px"><%= idea.description %></p>
      <% } %>

      <!-- Vote bar -->
      <div style="display:flex;align-items:center;gap:16px">
        <button class="vote-btn" data-id="<%= idea.id %>" id="main-vote-btn"
          onclick="handleVote(this)" aria-label="Support this idea"
          style="padding:8px 18px;font-size:14px;gap:8px">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
          Support
          <span class="vote-count" style="font-weight:700"><%= idea.vote_count %></span>
        </button>
        <span style="font-size:14px;color:var(--muted)">
          <%= idea.comment_count || comments.length %> comment<%= (idea.comment_count || comments.length) !== 1 ? 's' : '' %>
        </span>
        <% if (idea.author?.display_name) { %>
          <span style="font-size:13px;color:var(--muted)">by <%= idea.author.display_name %></span>
        <% } %>
      </div>
    </div>

    <!-- Comments section -->
    <div class="sp-section-card">
      <h2 style="font-size:16px;font-weight:700;margin:0 0 20px;color:var(--ink)">
        Comments (<%= comments.length %>)
      </h2>

      <!-- Comment form -->
      <form id="comment-form" style="margin-bottom:24px">
        <div class="auth-field" style="margin-bottom:10px">
          <% if (!user) { %>
            <label for="comment-name">Your name <span style="color:var(--muted);font-weight:400">(optional)</span></label>
            <input type="text" id="comment-name" placeholder="Anonymous" maxlength="50" />
          <% } %>
        </div>
        <div class="auth-field" style="margin-bottom:10px">
          <label for="comment-body">Leave a comment</label>
          <textarea id="comment-body" rows="3" placeholder="Share your thoughts…" required
            style="resize:vertical"></textarea>
        </div>
        <button type="submit" class="auth-submit-btn" style="max-width:160px" id="comment-submit-btn">
          Post comment
        </button>
      </form>

      <!-- Existing comments -->
      <div id="comments-list">
        <% if (comments.length === 0) { %>
          <p style="text-align:center;color:var(--muted);padding:32px 0;font-size:14px">
            No comments yet. Be the first to reply!
          </p>
        <% } %>
        <% comments.forEach(function(c) { %>
          <%- include('partials/comment-item', { comment: c, depth: 0, ideaId: idea.id }) %>
        <% }) %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
window.SUPABASE_URL = '<%- supabaseUrl %>';
window.SUPABASE_ANON_KEY = '<%- supabaseAnonKey %>';
window._supabase = window.supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);

window._supabase.auth.onAuthStateChange(async (event, session) => {
  if (event === 'SIGNED_IN' && session) {
    await fetch('/auth/session', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ access_token: session.access_token, refresh_token: session.refresh_token, user: session.user }) });
    window.location.reload();
  }
  if (event === 'SIGNED_OUT') { await fetch('/auth/signout', { method: 'POST' }); window.location.reload(); }
});

// Voting
const _voted = new Set(JSON.parse(localStorage.getItem('sf-voted') || '[]'));
const ideaId = '<%= idea.id %>';
if (_voted.has(ideaId)) document.getElementById('main-vote-btn')?.classList.add('voted');

function handleVote(btn) {
  const id = btn.dataset.id;
  const voted = _voted.has(id);
  const devId = localStorage.getItem('sf-device-id') || crypto.randomUUID();
  localStorage.setItem('sf-device-id', devId);
  fetch(`/api/vote/${id}`, { method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ action: voted?'remove':'up', deviceId: devId }) })
    .then(r => r.json()).then(d => {
      if (d.ok) {
        if (voted) { _voted.delete(id); btn.classList.remove('voted'); }
        else { _voted.add(id); btn.classList.add('voted'); }
        localStorage.setItem('sf-voted', JSON.stringify([..._voted]));
        btn.querySelector('.vote-count').textContent = d.vote_count;
      }
    });
}

// Post comment
document.getElementById('comment-form')?.addEventListener('submit', async e => {
  e.preventDefault();
  const body = document.getElementById('comment-body')?.value.trim();
  if (!body) return;
  const btn = document.getElementById('comment-submit-btn');
  btn.disabled = true; btn.textContent = 'Posting…';
  try {
    const res = await fetch('/api/comment', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        submission_id: ideaId,
        body,
        display_name: document.getElementById('comment-name')?.value || null,
      })
    });
    const data = await res.json();
    if (data.ok) {
      document.getElementById('comment-body').value = '';
      showToast('Comment posted!', 'success');
      // Append comment to DOM without full reload
      const c = data.comment;
      const el = document.createElement('div');
      el.className = 'comment-item';
      el.innerHTML = `
        <div class="comment-header">
          <strong>${c.display_name || 'Anonymous'}</strong>
          <time>${new Date(c.created_at).toLocaleString()}</time>
        </div>
        <p class="comment-body">${c.body}</p>`;
      document.getElementById('comments-list').appendChild(el);
    } else {
      showToast(data.error || 'Failed to post', 'error');
    }
  } catch { showToast('Network error', 'error'); }
  finally { btn.disabled = false; btn.textContent = 'Post comment'; }
});

// Real-time: new comments
window._supabase?.channel(`idea-${ideaId}`)
  .on('postgres_changes', { event:'INSERT', schema:'public', table:'comments',
    filter:`submission_id=eq.${ideaId}` }, payload => {
    // Only append if not already added by us
    const c = payload.new;
    const already = document.querySelector(`[data-comment-id="${c.id}"]`);
    if (!already) {
      const el = document.createElement('div');
      el.className = 'comment-item';
      el.dataset.commentId = c.id;
      el.innerHTML = `
        <div class="comment-header">
          <strong>${c.display_name || 'Anonymous'}</strong>
          <time>${new Date(c.created_at).toLocaleString()}</time>
        </div>
        <p class="comment-body">${c.body}</p>`;
      document.getElementById('comments-list').appendChild(el);
    }
  }).subscribe();

// Theme toggle
document.getElementById('theme-btn')?.addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  localStorage.setItem('sf-theme', next);
  document.documentElement.setAttribute('data-theme', next);
});
</script>
