<% layout('layout') %>
<% const stages = [
  { key: 'approved', label: 'Planned', caption: 'Approved ideas, ready for the next step.', empty: 'Newly approved ideas will appear here.' },
  { key: 'in_progress', label: 'In progress', caption: 'Ideas the school is working on.', empty: 'Ideas will move here when work begins.' },
  { key: 'resolved', label: 'Completed', caption: 'Community feedback put into action.', empty: 'Completed improvements will appear here.' }
]; %>
<main class="campus-roadmap">
  <header class="workspace-heading roadmap-heading"><div><p class="workspace-kicker">YOUR VOICE, IN ACTION</p><h1>A better campus,<br />one idea at a time<span class="workspace-title-dot">.</span></h1><p>Follow the ideas moving our community forward.</p></div><div class="roadmap-heading-aside"><span class="roadmap-orbit" aria-hidden="true">↗</span><span><strong><%= it.items.length %></strong> public ideas on the roadmap</span><a class="workspace-text-link" href="/feed">Explore the community feed →</a></div></header>
  <div class="roadmap-summary" aria-label="Roadmap overview"><% for (const stage of stages) { %><div><span class="workspace-status" data-status="<%= stage.key %>"><%= stage.label %></span><strong><%= it.items.filter(i => i.status === stage.key).length %></strong></div><% } %></div>
  <section class="roadmap-workspace" aria-label="Campus improvement board">
    <div class="roadmap-controls">
      <label class="workspace-search"><span aria-hidden="true">⌕</span><input class="workspace-search-input" id="roadmap-search" type="search" placeholder="Find an idea…" aria-label="Search roadmap titles and descriptions" /></label>
      <label class="roadmap-category-label"><span class="sr-only">Category</span><select class="workspace-input" id="roadmap-category"><option value="all">All categories</option><% for (const category of it.categories) { %><option value="<%= category %>"><%= category %></option><% } %></select></label>
      <div class="roadmap-view-switch" role="group" aria-label="Roadmap layout"><button type="button" data-roadmap-view="board" aria-pressed="true">▥ Board</button><button type="button" data-roadmap-view="list" aria-pressed="false">☰ List</button></div>
    </div>
    <div class="roadmap-results"><p id="roadmap-result-count" role="status" aria-live="polite"><%= it.items.length %> ideas</p><button class="workspace-text-link" id="roadmap-clear" type="button" hidden>Clear filters</button><span>Approval does not guarantee a delivery date.</span></div>
    <div class="roadmap-stage-switch" role="group" aria-label="Choose a stage on mobile"><% for (const [index, stage] of stages.entries()) { %><button type="button" data-stage="<%= stage.key %>" aria-pressed="<%= index === 0 %>"><%= stage.label %> <span data-mobile-count="<%= stage.key %>"><%= it.items.filter(i => i.status === stage.key).length %></span></button><% } %></div>
    <div class="roadmap-board" id="campus-roadmap-board" data-view="board">
      <% for (const [index, stage] of stages.entries()) { %>
        <section class="roadmap-lane<%= index === 0 ? ' is-mobile-active' : '' %>" data-lane="<%= stage.key %>" aria-labelledby="lane-<%= stage.key %>">
          <header class="roadmap-lane-heading"><div><h2 id="lane-<%= stage.key %>"><span class="roadmap-stage-dot" data-status="<%= stage.key %>" aria-hidden="true"></span><%= stage.label %></h2><span data-lane-count="<%= stage.key %>"><%= it.items.filter(i => i.status === stage.key).length %></span></div><p><%= stage.caption %></p></header>
          <div class="roadmap-lane-cards">
            <% for (const item of it.items.filter(i => i.status === stage.key)) { %>
              <article class="roadmap-idea" data-roadmap-id="<%= item.id %>">
                <span class="workspace-tag"><%= item.category %></span>
                <h3><button type="button" data-roadmap-open="<%= item.id %>" aria-haspopup="dialog"><%= item.title %></button></h3>
                <p><%= item.description %></p>
                <footer><span>↑ <%= item.votes %> <span class="roadmap-vote-label">votes</span><span class="roadmap-comment-count"> · <%= item.comments %> comments</span></span><span aria-hidden="true" class="roadmap-card-arrow">↗</span></footer>
              </article>
            <% } %>
            <div class="roadmap-lane-empty" data-lane-empty="<%= stage.key %>" <%= it.items.some(i => i.status === stage.key) ? 'hidden' : '' %>><span aria-hidden="true">◌</span><h3>Nothing here yet</h3><p><%= stage.empty %></p></div>
          </div>
        </section>
      <% } %>
    </div>
    <% if (it.items.length >= 100) { %><p class="staff-footnote">Showing the 100 most-supported ideas. Visit the community feed to browse more.</p><% } %>
  </section>
  <footer class="roadmap-footer"><div><strong>Your next idea could start here.</strong><p>See a way to improve campus life? Share it with your community.</p></div><button type="button" class="workspace-button workspace-button--primary" data-sf-click="action-49">Share an idea <span aria-hidden="true">↗</span></button></footer>
  <dialog class="workspace-dialog" id="roadmap-dialog" aria-labelledby="roadmap-detail-title">
    <header class="workspace-dialog-header"><span class="workspace-kicker">CAMPUS ROADMAP</span><button type="button" class="workspace-icon-button" id="roadmap-close" aria-label="Close idea details">×</button></header>
    <div class="workspace-dialog-body"><span class="workspace-status" id="roadmap-detail-status"></span><h2 id="roadmap-detail-title"></h2><p id="roadmap-detail-meta" class="workspace-detail-meta"></p><h3 class="workspace-field-label">About this idea</h3><p class="workspace-description" id="roadmap-detail-description"></p><div class="roadmap-detail-progress"><h3 class="workspace-field-label">Current stage</h3><ol><% for (const stage of stages) { %><li data-progress-stage="<%= stage.key %>"><span aria-hidden="true"></span><%= stage.label %></li><% } %></ol><p id="roadmap-detail-hint"></p></div><a class="workspace-button workspace-button--primary" id="roadmap-detail-link" href="/feed">Open idea & discussion →</a></div>
  </dialog>
</main>
<script id="sf-roadmap-data" type="application/json"><%~ JSON.stringify(it.items).replace(/</g, '\\u003c') %></script>
<script src="/js/roadmap.js?v=20261010-workspace"></script>
