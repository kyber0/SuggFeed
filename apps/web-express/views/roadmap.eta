<% layout('layout') %>

<main class="rm-page">
  <!-- ── Toolbar & Filter Strip ── -->
  <div class="rm-toolbar">
    <div class="rm-toolbar-top">
      <div class="rm-toolbar-title-wrap">
        <h1 class="rm-toolbar-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="rm-title-icon"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
          Product Roadmap
        </h1>
        <span class="rm-toolbar-badge">Community Roadmap</span>
        <% if (it.user?.role === 'admin' || it.user?.role === 'staff') { %>
          <span class="rm-role-badge rm-role-badge--staff" title="Staff &amp; Admin permissions enabled">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Staff Editor
          </span>
        <% } else { %>
          <span class="rm-role-badge rm-role-badge--readonly" title="Phase changes are restricted to staff and administrators">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Read-only
          </span>
        <% } %>
      </div>

      <div class="rm-toolbar-actions">
        <!-- View Switcher: Board vs Timeline -->
        <div class="rm-view-switch" role="group" aria-label="View mode">
          <button
            type="button"
            id="rm-btn-board"
            class="rm-view-btn rm-view-btn--active"
            data-sf-click="action-142"
            aria-pressed="true"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
            <span>Board</span>
          </button>
          <button
            type="button"
            id="rm-btn-timeline"
            class="rm-view-btn"
            data-sf-click="action-143"
            aria-pressed="false"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Timeline</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="rm-filter-bar">
      <div class="rm-search-box">
        <svg class="rm-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="text"
          id="rm-search-input"
          class="rm-search-input"
          placeholder="Filter by keyword or title..."
          aria-label="Search roadmap ideas"
          data-sf-input="action-144"
        />
      </div>

      <select
        id="rm-owner-filter"
        class="rm-filter-select"
        data-sf-change="action-145"
        aria-label="Filter by Owner"
      >
        <option value="all">All Owners</option>
        <% for (const o of it.owners) { %>
          <option value="<%= o.name %>"><%= o.name %></option>
        <% } %>
      </select>

      <select
        id="rm-tag-filter"
        class="rm-filter-select"
        data-sf-change="action-146"
        aria-label="Filter by Tag"
      >
        <option value="all">All Tags</option>
        <% for (const t of it.tags) { %>
          <option value="<%= t %>"><%= t %></option>
        <% } %>
      </select>

      <select
        id="rm-quarter-filter"
        class="rm-filter-select"
        data-sf-change="action-147"
        aria-label="Filter by Quarter"
      >
        <option value="all">All Quarters</option>
        <% for (const q of it.quarters) { %>
          <option value="<%= q %>"><%= q %></option>
        <% } %>
      </select>

      <button
        type="button"
        id="rm-filter-reset"
        class="rm-filter-reset"
        data-sf-click="action-148"
        class="rm-filter-reset-hidden"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        <span>Reset</span>
      </button>
    </div>
  </div>

  <!-- ── Mobile Sticky Tab Bar (< 768px) ── -->
  <div class="rm-mobile-nav" role="tablist" aria-label="Roadmap stages">
    <button
      type="button"
      role="tab"
      id="rm-tab-now"
      aria-selected="true"
      class="rm-mobile-tab-btn rm-mobile-tab-btn--now rm-mobile-tab-btn--active"
      data-sf-click="action-149"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      <span>Now</span>
      <span class="rm-mobile-tab-count"><%= it.columns.now.length %></span>
    </button>
    <button
      type="button"
      role="tab"
      id="rm-tab-next"
      aria-selected="false"
      class="rm-mobile-tab-btn rm-mobile-tab-btn--next"
      data-sf-click="action-150"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
      <span>Next</span>
      <span class="rm-mobile-tab-count"><%= it.columns.next.length %></span>
    </button>
    <button
      type="button"
      role="tab"
      id="rm-tab-later"
      aria-selected="false"
      class="rm-mobile-tab-btn rm-mobile-tab-btn--later"
      data-sf-click="action-151"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
      <span>Later</span>
      <span class="rm-mobile-tab-count"><%= it.columns.later.length %></span>
    </button>
  </div>

  <!-- ── Board Shell (Desktop locked scroll, Tablet snap-scroll, Mobile single-col) ── -->
  <div class="rm-board-shell">
    <!-- Board View -->
    <div class="rm-board" id="rm-board-view">
      <!-- ── Column 1: Now ── -->
      <div class="rm-column rm-column--mobile-active" id="col-now">
        <div class="rm-col-head">
          <div class="rm-col-head-left">
            <span class="rm-col-dot rm-col-dot--now" aria-hidden="true"></span>
            <h2 class="rm-col-name">Now</h2>
            <span class="rm-col-badge"><%= it.columns.now.length %></span>
          </div>
        </div>

        <div class="rm-col-content" role="list" aria-label="Now column">
          <% if (it.columns.now.length === 0) { %>
            <div class="rm-col-empty">
              <p>Nothing in flight right now</p>
            </div>
          <% } else { %>
            <% for (const item of it.columns.now) { %>
              <div
                class="rm-card rm-card--now"
                role="listitem"
                tabindex="0"
                data-id="<%= item.id %>"
                data-title="<%= (item.title || '').toLowerCase() %>"
                data-desc="<%= (item.description || '').toLowerCase() %>"
                data-owner="<%= item.owner?.name || '' %>"
                data-tag="<%= (item.tags || []).join(' ').toLowerCase() %>"
                data-quarter="<%= item.quarter || '' %>"
                data-sf-click="action-152" data-sf-click-arg-0="<%= item.id %>"
                data-sf-keydown="action-153" data-sf-keydown-arg-0="<%= item.id %>"
              >
                <div class="rm-card-top-row">
                  <div class="rm-card-status-title">
                    <span class="rm-card-status-dot rm-card-status-dot--now" title="Status: Now"></span>
                    <h3 class="rm-card-title"><%= item.title %></h3>
                  </div>
                  <span class="rm-card-effort">Effort: <%= item.effort %></span>
                </div>

                <% if (item.description) { %>
                  <p class="rm-card-desc"><%= item.description %></p>
                <% } %>

                <div class="rm-card-bottom-row">
                  <div class="rm-card-owner" title="Assigned: <%= item.owner?.name %>">
                    <span class="rm-card-avatar"><%= (item.owner?.name || 'CO').slice(0, 2).toUpperCase() %></span>
                    <span class="rm-card-quarter"><%= item.quarter %></span>
                  </div>

                  <div class="rm-card-tags">
                    <% for (const t of (item.tags || [])) { %>
                      <span class="rm-card-tag">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r=".5" fill="currentColor"/></svg>
                        <%= t %>
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- ── Column 2: Next ── -->
      <div class="rm-column" id="col-next">
        <div class="rm-col-head">
          <div class="rm-col-head-left">
            <span class="rm-col-dot rm-col-dot--next" aria-hidden="true"></span>
            <h2 class="rm-col-name">Next</h2>
            <span class="rm-col-badge"><%= it.columns.next.length %></span>
          </div>
        </div>

        <div class="rm-col-content" role="list" aria-label="Next column">
          <% if (it.columns.next.length === 0) { %>
            <div class="rm-col-empty">
              <p>No items queued for next cycle</p>
            </div>
          <% } else { %>
            <% for (const item of it.columns.next) { %>
              <div
                class="rm-card rm-card--next"
                role="listitem"
                tabindex="0"
                data-id="<%= item.id %>"
                data-title="<%= (item.title || '').toLowerCase() %>"
                data-desc="<%= (item.description || '').toLowerCase() %>"
                data-owner="<%= item.owner?.name || '' %>"
                data-tag="<%= (item.tags || []).join(' ').toLowerCase() %>"
                data-quarter="<%= item.quarter || '' %>"
                data-sf-click="action-154" data-sf-click-arg-0="<%= item.id %>"
                data-sf-keydown="action-155" data-sf-keydown-arg-0="<%= item.id %>"
              >
                <div class="rm-card-top-row">
                  <div class="rm-card-status-title">
                    <span class="rm-card-status-dot rm-card-status-dot--next" title="Status: Next"></span>
                    <h3 class="rm-card-title"><%= item.title %></h3>
                  </div>
                  <span class="rm-card-effort">Effort: <%= item.effort %></span>
                </div>

                <% if (item.description) { %>
                  <p class="rm-card-desc"><%= item.description %></p>
                <% } %>

                <div class="rm-card-bottom-row">
                  <div class="rm-card-owner" title="Assigned: <%= item.owner?.name %>">
                    <span class="rm-card-avatar"><%= (item.owner?.name || 'CO').slice(0, 2).toUpperCase() %></span>
                    <span class="rm-card-quarter"><%= item.quarter %></span>
                  </div>

                  <div class="rm-card-tags">
                    <% for (const t of (item.tags || [])) { %>
                      <span class="rm-card-tag">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r=".5" fill="currentColor"/></svg>
                        <%= t %>
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- ── Column 3: Later ── -->
      <div class="rm-column" id="col-later">
        <div class="rm-col-head">
          <div class="rm-col-head-left">
            <span class="rm-col-dot rm-col-dot--later" aria-hidden="true"></span>
            <h2 class="rm-col-name">Later</h2>
            <span class="rm-col-badge"><%= it.columns.later.length %></span>
          </div>
        </div>

        <div class="rm-col-content" role="list" aria-label="Later column">
          <% if (it.columns.later.length === 0) { %>
            <div class="rm-col-empty">
              <p>No backlog items yet</p>
            </div>
          <% } else { %>
            <% for (const item of it.columns.later) { %>
              <div
                class="rm-card rm-card--later"
                role="listitem"
                tabindex="0"
                data-id="<%= item.id %>"
                data-title="<%= (item.title || '').toLowerCase() %>"
                data-desc="<%= (item.description || '').toLowerCase() %>"
                data-owner="<%= item.owner?.name || '' %>"
                data-tag="<%= (item.tags || []).join(' ').toLowerCase() %>"
                data-quarter="<%= item.quarter || '' %>"
                data-sf-click="action-156" data-sf-click-arg-0="<%= item.id %>"
                data-sf-keydown="action-157" data-sf-keydown-arg-0="<%= item.id %>"
              >
                <div class="rm-card-top-row">
                  <div class="rm-card-status-title">
                    <span class="rm-card-status-dot rm-card-status-dot--later" title="Status: Later"></span>
                    <h3 class="rm-card-title"><%= item.title %></h3>
                  </div>
                  <span class="rm-card-effort">Effort: <%= item.effort %></span>
                </div>

                <% if (item.description) { %>
                  <p class="rm-card-desc"><%= item.description %></p>
                <% } %>

                <div class="rm-card-bottom-row">
                  <div class="rm-card-owner" title="Assigned: <%= item.owner?.name %>">
                    <span class="rm-card-avatar"><%= (item.owner?.name || 'CO').slice(0, 2).toUpperCase() %></span>
                    <span class="rm-card-quarter"><%= item.quarter %></span>
                  </div>

                  <div class="rm-card-tags">
                    <% for (const t of (item.tags || [])) { %>
                      <span class="rm-card-tag">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><circle cx="7" cy="7" r=".5" fill="currentColor"/></svg>
                        <%= t %>
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Timeline View -->
    <div class="rm-timeline-view" id="rm-timeline-view" hidden>
      <% for (const q of it.quarters) { %>
        <% const qItems = it.items.filter(i => i.quarter === q); %>
        <% if (qItems.length > 0) { %>
          <section class="rm-timeline-quarter">
            <div class="rm-timeline-quarter-header">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <h2 class="rm-timeline-quarter-title"><%= q %></h2>
              <span class="rm-timeline-quarter-badge"><%= qItems.length %></span>
            </div>

            <div class="rm-timeline-grid">
              <% for (const item of qItems) { %>
                <div
                  class="rm-card rm-card--<%= item.status %>"
                  role="listitem"
                  tabindex="0"
                  data-id="<%= item.id %>"
                  data-title="<%= (item.title || '').toLowerCase() %>"
                  data-desc="<%= (item.description || '').toLowerCase() %>"
                  data-owner="<%= item.owner?.name || '' %>"
                  data-tag="<%= (item.tags || []).join(' ').toLowerCase() %>"
                  data-quarter="<%= item.quarter || '' %>"
                  data-sf-click="action-158" data-sf-click-arg-0="<%= item.id %>"
                >
                  <div class="rm-card-top-row">
                    <div class="rm-card-status-title">
                      <span class="rm-card-status-dot rm-card-status-dot--<%= item.status %>"></span>
                      <h3 class="rm-card-title"><%= item.title %></h3>
                    </div>
                    <span class="rm-card-effort">Effort: <%= item.effort %></span>
                  </div>
                  <% if (item.description) { %>
                    <p class="rm-card-desc"><%= item.description %></p>
                  <% } %>
                  <div class="rm-card-bottom-row">
                    <div class="rm-card-owner">
                      <span class="rm-card-avatar"><%= (item.owner?.name || 'CO').slice(0, 2).toUpperCase() %></span>
                      <span class="rm-card-quarter"><%= item.quarter %></span>
                    </div>
                    <div class="rm-card-tags">
                      <% for (const t of (item.tags || [])) { %>
                        <span class="rm-card-tag"><%= t %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>
          </section>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- ── Detail Panel Drawer (Desktop/Tablet Side Drawer; Mobile Bottom Sheet) ── -->
  <div
    class="rm-drawer-overlay"
    id="rm-drawer-overlay"
    hidden
    data-sf-click="action-159"
  >
    <div class="rm-drawer" role="dialog" aria-modal="true" aria-label="Roadmap Item Details">
      <!-- Drawer Header -->
      <div class="rm-drawer-head">
        <div class="rm-drawer-head-status">
          <span class="rm-card-status-dot rm-card-status-dot--now" id="drawer-dot"></span>
          <span id="drawer-status-label" class="rm-drawer-status-label">Now</span>
        </div>
        <button type="button" class="rm-drawer-close" data-sf-click="action-160" aria-label="Close drawer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Drawer Content -->
      <div class="rm-drawer-body">
        <!-- Title -->
        <div>
          <label class="rm-drawer-field-label">Title</label>
          <div id="drawer-title" class="rm-drawer-title"></div>
        </div>

        <!-- Status Phase -->
        <div>
          <label class="rm-drawer-field-label">Phase / Status</label>
          <div class="rm-drawer-status-seg">
            <span class="rm-drawer-status-btn active" id="drawer-pill-status">In Development</span>
          </div>
        </div>

        <!-- Effort -->
        <div>
          <label class="rm-drawer-field-label">Effort Estimation</label>
          <div class="rm-drawer-effort-box">
            Effort: <span id="drawer-effort" class="rm-drawer-effort-val">M</span>
          </div>
        </div>

        <!-- Owner -->
        <div>
          <label class="rm-drawer-field-label">Assigned Team / Owner</label>
          <div class="rm-drawer-owner-row">
            <div id="drawer-avatar" class="rm-card-avatar rm-drawer-avatar">CO</div>
            <div>
              <div id="drawer-owner-name" class="rm-drawer-owner-name">Campus Ops</div>
              <div id="drawer-owner-role" class="rm-drawer-owner-role">Facilities &amp; Grounds</div>
            </div>
          </div>
        </div>

        <!-- Target Quarter -->
        <div>
          <label class="rm-drawer-field-label">Target Quarter</label>
          <div id="drawer-quarter" class="rm-drawer-quarter">Q3 2026</div>
        </div>

        <!-- Tags -->
        <div>
          <label class="rm-drawer-field-label">Tags</label>
          <div id="drawer-tags" class="rm-drawer-tags"></div>
        </div>

        <!-- Description -->
        <div>
          <label class="rm-drawer-field-label">Description</label>
          <div id="drawer-desc" class="rm-drawer-desc"></div>
        </div>

        <!-- Original Submission Link -->
        <div class="rm-drawer-link-row">
          <a
            id="drawer-idea-link"
            href="#"
            class="rm-drawer-link"
            data-sf-click="action-161"
          >
            <span>Open original proposal discussion</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<script id="sf-roadmap-data" type="application/json"><%~ JSON.stringify(it.items).replace(/</g, '\\u003c') %></script>
<script src="/js/roadmap.js?v=20261010-ts"></script>
