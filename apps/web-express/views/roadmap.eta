<% layout('layout') %>
<%
 const stages = [
  { key: 'approved', label: 'Planned', caption: 'Approved ideas ready for the next step.', empty: 'Newly approved ideas will appear here.' },
  { key: 'in_progress', label: 'In progress', caption: 'Improvements the school is working on.', empty: 'Ideas will move here when work begins.' },
  { key: 'resolved', label: 'Completed', caption: 'Community feedback put into action.', empty: 'Completed improvements will appear here.' }
 ];
 const filters = it.filters || { search: '', category: 'all', stage: 'all', view: 'board', page: 1 };
 const counts = it.counts || Object.fromEntries(stages.map(s => [s.key, (it.items || []).filter(i => i.status === s.key).length]));
 const totalCount = it.totalCount ?? (it.items ? it.items.length : 0);
 const matchingCount = it.matchingCount ?? (it.items ? it.items.length : 0);
 const pageCount = it.pageCount || 1;
 const urlFor = (changes = {}) => '/roadmap?' + new URLSearchParams({ ...filters, page: String(filters.page), ...changes }).toString();
 const icon = name => '<svg class="workspace-svg" aria-hidden="true"><use href="#ws-' + name + '"></use></svg>';
 const filtered = !!filters.search || filters.category !== 'all' || filters.stage !== 'all';
 const recentlyCompleted = it.recentlyCompleted || [];
 const treeData = it.treeData || [];
 const timelineData = it.timelineData || [];
 const workTimeline = it.workTimeline;
 const formatManilaDate = it.formatManilaDate || ((d) => d ? new Date(d).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric' }) : '');
 const completionLabel = item => item.resolved_at ? 'Completed ' + (item.resolved_at_estimated ? 'around ' : '') + formatManilaDate(item.resolved_at) : 'Completion date not recorded';
 const otherViews=[['tree','By category','list','Browse improvements grouped by topic.'],['timeline','Work calendar','calendar','Explore recorded work dates, not deadlines.'],['done','Completed outcomes','check','Read completed work and published outcomes.']];
 const activeView=otherViews.find(([view])=>view===filters.view);
%>
<main class="campus-roadmap">
 <header class="workspace-heading roadmap-heading">
  <div>
   <span class="workspace-kicker">Campus Roadmap</span>
   <h1>Roadmap<span class="workspace-title-dot">.</span></h1>
   <p class="roadmap-subtitle">Track community suggestions from planned to completion.</p>
  </div>
  <div class="roadmap-summary-pills" role="region" aria-label="Roadmap stages">
   <% for (const stage of stages) { %>
    <a href="<%= urlFor({ stage: filters.stage === stage.key ? 'all' : stage.key, view: filters.view === 'done' ? 'board' : filters.view, page: '1' }) %>"
       class="roadmap-pill <%= filters.stage === stage.key ? 'is-active' : '' %>"
       data-status="<%= stage.key %>"
       data-roadmap-state-link
       aria-current="<%= filters.stage === stage.key ? 'page' : 'false' %>">
     <span class="roadmap-stage-dot <%= stage.key === 'in_progress' ? 'roadmap-pulse-dot' : '' %>" data-status="<%= stage.key %>" aria-hidden="true"></span>
     <span class="roadmap-pill-label"><%= stage.label %></span>
     <strong class="roadmap-pill-count"><%= counts[stage.key] || 0 %></strong>
    </a>
   <% } %>
  </div>
 </header>

 <section class="roadmap-workspace" aria-label="Campus improvement board">
  <nav class="roadmap-view-switch roadmap-view-navigation" aria-label="Roadmap views">
   <a href="<%= urlFor({view:'board',page:'1'}) %>" data-roadmap-view="board" aria-current="<%= filters.view==='board'?'page':'false' %>"><%~ icon('board') %> Status board</a>
   <details class="roadmap-other-views" data-active="<%= !!activeView %>"><summary aria-controls="roadmap-other-views-list" aria-label="<%= activeView?'Other views: '+activeView[1]:'Other views' %>"><%~ icon(activeView?activeView[2]:'list') %><span><%= activeView?activeView[1]:'Other views' %></span><span class="roadmap-views-chevron"><%~ icon('chevron-down') %></span></summary><div id="roadmap-other-views-list" class="roadmap-view-menu">
    <p class="roadmap-view-menu-label">Explore another view</p>
    <% for(const [view,name,glyph,description] of otherViews) { %>
     <a href="<%= urlFor({view,stage:view==='done'?'resolved':filters.view==='done'?'all':filters.stage,page:'1'}) %>" data-roadmap-view="<%= view %>" aria-current="<%= filters.view===view?'page':'false' %>"><span class="roadmap-view-menu-icon"><%~ icon(glyph) %></span><span class="roadmap-view-menu-copy"><strong><%= name %></strong><small><%= description %></small></span><% if(filters.view===view) { %><span class="roadmap-view-current" aria-label="Current view"><%~ icon('check') %></span><% } %></a>
    <% } %>
   </div></details>
  </nav>
  <form class="roadmap-controls" action="/roadmap" method="get" role="search">
   <input type="hidden" name="stage" value="<%= filters.stage %>"/>
   <input type="hidden" name="view" id="roadmap-view-input" value="<%= filters.view %>"/>
   <label class="workspace-search">
    <%~ icon('search') %>
    <input class="workspace-search-input" id="roadmap-search" name="search" type="search" maxlength="120" value="<%= filters.search %>" placeholder="Search ideas…" aria-label="Search roadmap titles and descriptions"/>
   </label>
   <label class="roadmap-category-label">
    <span class="sr-only">Category</span>
    <select class="workspace-input" id="roadmap-category" name="category">
     <option value="all">All categories</option>
     <% for (const category of (it.categories || [])) { %>
      <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
     <% } %>
    </select>
   </label>
   <button type="submit" class="workspace-button">Filter</button>

  </form>

  <div class="roadmap-results">
   <p role="status"><%= (it.items || []).length %> shown · <%= filters.stage === 'all' ? matchingCount : (counts[filters.stage] || 0) %> matching ideas<%= filtered ? ' across all pages' : '' %></p>
   <% if (filtered) { %>
    <div class="roadmap-active-filters" aria-label="Active filters"><% if(filters.search) { %><span>Search: <%= filters.search %></span><% } %><% if(filters.category!=='all') { %><span>Category: <%= filters.category %></span><% } %><% if(filters.stage!=='all') { %><span>Stage: <%= stages.find(s=>s.key===filters.stage)?.label || filters.stage %></span><% } %></div>
    <a class="workspace-text-link" id="roadmap-clear" data-roadmap-state-link href="<%= urlFor({ search: '', category: 'all', stage:filters.view==='done'?'resolved':'all', page: '1' }) %>">Reset filters</a>
   <% } %>
   <% if (filters.stage !== 'all' && filters.view !== 'done') { %>
    <a class="workspace-text-link" href="<%= urlFor({ stage: 'all', page: '1' }) %>">Show all stages</a>
   <% } %>
  </div>
  <p id="roadmap-vote-status" class="workspace-detail-meta" role="status"></p>

  <% if (recentlyCompleted && recentlyCompleted.length > 0 && filters.view === 'board' && filters.stage === 'all' && !filtered) { %>
   <section class="roadmap-recent-strip" aria-labelledby="recent-strip-heading">
    <div class="roadmap-recent-strip-heading">
     <span class="roadmap-recent-strip-pill">Recent outcome</span>
     <h2 id="recent-strip-heading">Recently completed campus improvements</h2>
    </div>
    <div class="roadmap-recent-strip-cards">
     <% for (const recent of recentlyCompleted) { %>
      <article class="roadmap-recent-card" data-roadmap-id="<%= recent.id %>">
       <div class="roadmap-recent-card-top">
        <span class="workspace-tag"><%= recent.category %></span>
        <span class="roadmap-card-date roadmap-card-date--completed"><%= completionLabel(recent) %></span>
       </div>
       <h3 class="roadmap-recent-card-title"><button type="button" data-roadmap-open="<%= recent.id %>" aria-haspopup="dialog"><%= recent.title %></button></h3>
       <footer class="roadmap-recent-card-footer">
        <button type="button" class="roadmap-card-vote-btn roadmap-card-vote-btn--compact" data-vote-id="<%= recent.id %>" aria-label="Support idea, <%= recent.votes %> votes" title="Support this idea">
         <span class="roadmap-card-vote-icon" aria-hidden="true">↑</span>
         <span class="roadmap-card-vote-count"><%= recent.votes %></span>
        </button>
        <span class="workspace-status" data-status="resolved">Completed</span>
       </footer>
      </article>
     <% } %>
    </div>
   </section>
  <% } %>

  <div class="roadmap-board" id="campus-roadmap-board" data-view="<%= filters.view %>" data-stage="<%= filters.stage %>">
   <% if (filters.view === 'timeline' && workTimeline) { %>
    <section class="roadmap-work-timeline" aria-labelledby="work-timeline-title">
     <header class="work-timeline-heading">
      <div class="timeline-controls"><label>Calendar scale <select id="timeline-zoom" class="workspace-input"><option value="month">Month detail</option><option value="week">Week detail</option><option value="term">Term overview</option></select></label><button type="button" class="workspace-button" data-timeline-pan="-1" aria-label="Scroll calendar earlier">←</button><button type="button" class="workspace-button" data-timeline-pan="1" aria-label="Scroll calendar later">→</button></div>
      <div><h2 id="work-timeline-title">Work calendar</h2><p id="work-timeline-help">Cards mark recorded starts. Rails run to completion or today—not a promised deadline. Percentages are school estimates. Records without verified dates appear separately below.</p></div>
      <button type="button" class="workspace-button work-timeline-today-date" id="timeline-jump-today" aria-controls="work-calendar-scroll">Today · <%= workTimeline.todayLabel %></button>
     </header>
     <% if (workTimeline.rows.length) { %>
      <div class="work-timeline-scroll" id="work-calendar-scroll" data-today-left="<%= workTimeline.todayLeft %>" tabindex="0" role="region" aria-label="Work calendar; scroll horizontally to explore months" aria-describedby="work-timeline-help">
       <div class="work-timeline-chart" data-timeline-days="<%= workTimeline.totalDays %>" style="--chart-width:<%= workTimeline.minWidth %>px;--week-width:<%= workTimeline.weekWidth %>%;--today-left:<%= workTimeline.todayLeft %>%">
        <div class="work-timeline-months" aria-hidden="true">
         <% for (const month of workTimeline.months) { %><span style="left:<%= month.left %>%;width:<%= month.width %>%"><%= month.label %></span><% } %>
        </div>
        <div class="work-timeline-rows">
         <span class="work-timeline-today" aria-hidden="true"><span>Today</span></span>
         <% for (const row of workTimeline.rows) { const item = row.item; %>
          <article class="work-timeline-row" data-status="<%= item.is_blocked ? 'blocked' : item.status %>" style="--work-left:<%= row.left %>%;--work-width:<%= row.width %>%">
           <span class="work-timeline-rail" aria-hidden="true"></span>
           <button type="button" class="work-timeline-card" data-roadmap-open="<%= item.id %>" aria-haspopup="dialog" aria-label="<%= item.title %>. <%= item.status === 'resolved' ? 'Completed' : item.is_blocked ? 'Blocked' : 'In progress' %>. <%= row.dateLabel %>. <%= item.progress_percent === null ? 'Progress not estimated' : item.progress_percent + ' percent complete, school estimate' %>">
            <span class="work-timeline-card-top"><span class="workspace-tag"><%= item.category %></span><span class="work-timeline-card-percent"><%= item.progress_percent === null ? 'Not estimated' : item.progress_percent + '%' %><span class="work-timeline-status-dot" aria-hidden="true"></span></span></span>
            <strong><%= item.title %></strong>
            <span class="work-timeline-card-dates"><%= row.clipped ? '← ' : '' %><%= row.dateLabel %></span>
            <% if (item.is_blocked) { %><span class="work-timeline-card-state">Work blocked</span><% } %>
           </button>
          </article>
         <% } %>
        </div>
       </div>
      </div>
      <p class="work-timeline-scroll-hint">Scroll across the calendar · Select an idea for school updates and evidence.</p>
     <% } else { %>
      <div class="roadmap-lane-empty"><h3>No work dates recorded yet</h3><p>When the school posts a Started update, its recorded work will appear on this calendar.</p></div>
     <% } %>
     <% if (workTimeline.undated.length) { %>
      <section class="work-timeline-unscheduled" aria-labelledby="work-unscheduled-title">
       <h3 id="work-unscheduled-title">Not scheduled or outside this window</h3>
       <ul><% for (const { item, reason } of workTimeline.undated) { %><li><button type="button" data-roadmap-open="<%= item.id %>" aria-haspopup="dialog"><%= item.title %></button><span><%= reason %></span></li><% } %></ul>
      </section>
     <% } %>
    </section>
   <% } %>
   <!-- Board Layout -->
   <% if (filters.view === 'board') { %>
   <% for (const stage of stages.filter(s => filters.stage === 'all' || filters.stage === s.key)) { const laneItems = (it.items || []).filter(i => i.status === stage.key); %>
    <section class="roadmap-lane" data-lane="<%= stage.key %>" aria-labelledby="lane-<%= stage.key %>">
     <header class="roadmap-lane-heading">
      <div class="roadmap-lane-title-group">
       <h2 id="lane-<%= stage.key %>"><span class="roadmap-stage-dot <%= stage.key === 'in_progress' ? 'roadmap-pulse-dot' : '' %>" data-status="<%= stage.key %>" aria-hidden="true"></span><%= stage.label %></h2>
       <span class="roadmap-lane-count"><%= counts[stage.key] || 0 %></span>
      </div>
     </header>
     <div class="roadmap-lane-cards">
      <% for (const item of laneItems) { %>
       <article class="roadmap-idea" data-roadmap-id="<%= item.id %>">
        <div class="roadmap-card-top">
         <span class="workspace-tag"><%= item.category %></span>
         <% if (item.is_blocked) { %>
          <span class="roadmap-card-blocked-pill" title="Work is waiting on external dependencies">Blocked</span>
         <% } %>
         <% if (stage.key === 'resolved') { %>
          <span class="roadmap-card-date roadmap-card-date--completed"><%= completionLabel(item) %></span>
         <% } else { %>
          <span class="roadmap-card-date"><%= item.last_public_update ? 'Public update '+formatManilaDate(item.last_public_update) : 'No public work update' %></span>
         <% } %>
        </div>
        <h3 class="roadmap-card-title"><button type="button" data-roadmap-open="<%= item.id %>" aria-haspopup="dialog"><%= item.title %></button></h3>
        <p class="roadmap-card-desc"><%= item.description %></p>
        <% if (item.progress_percent !== null && (item.status === 'in_progress' || item.status === 'resolved')) { %>
         <div class="roadmap-card-progress" role="progressbar" aria-valuenow="<%= item.progress_percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= item.progress_percent %>% complete">
          <div class="roadmap-card-progress-track">
           <div class="roadmap-card-progress-bar" style="width:<%= item.progress_percent %>%"></div>
          </div>
          <span class="roadmap-card-progress-label"><%= item.progress_percent %>%</span>
         </div>
        <% } %>
        <footer class="roadmap-card-footer">
         <button type="button" class="roadmap-card-vote-btn" data-vote-id="<%= item.id %>" aria-label="Support idea, <%= item.votes %> votes" title="Support this idea">
          <span class="roadmap-card-vote-icon" aria-hidden="true">↑</span>
          <span class="roadmap-card-vote-count"><%= item.votes %></span>
          <span class="sr-only">votes</span>
         </button>
         <% if (item.comments) { %><span class="roadmap-card-comments"> · <%= item.comments %> comments</span><% } %>
        </footer>
       </article>
      <% } %>
      <% if (!laneItems.length) { %>
       <div class="roadmap-lane-empty">
        <span aria-hidden="true">◌</span>
        <h3><%= (counts[stage.key] || 0) > 0 ? 'No more ideas in this stage on this page' : filtered ? 'No matching ideas' : 'Nothing here yet' %></h3>
        <p><%= (counts[stage.key] || 0) > 0 ? 'Explore this stage from the first page.' : filtered ? 'Try a different category or search phrase.' : stage.empty %></p>
        <% if ((counts[stage.key] || 0) > 0) { %>
         <a class="workspace-text-link" data-roadmap-state-link href="<%= urlFor({ stage: stage.key, page: '1' }) %>">Explore <%= stage.label.toLowerCase() %> →</a>
        <% } %>
       </div>
      <% } %>
     </div>
    </section>
   <% } %>
   <% } %>

   <!-- Tree Layout (Category branches & progress) -->
   <% if (filters.view === 'tree') { %>
   <div class="roadmap-view-tree-container" aria-label="Category branches">
    <% if (!treeData.length) { %>
     <div class="roadmap-lane-empty">
      <span aria-hidden="true">◌</span>
      <h3><%= filtered ? 'No matching ideas' : 'Nothing here yet' %></h3>
      <p><%= filtered ? 'Try a different category or search phrase.' : 'Newly approved ideas will appear here.' %></p>
     </div>
    <% } else { %>
     <% for (const [branchIndex, branch] of treeData.entries()) { %>
      <section class="roadmap-tree-branch" data-branch="<%= branch.name %>">
       <button type="button" class="roadmap-tree-header" aria-expanded="true" aria-controls="roadmap-branch-<%= branchIndex %>" aria-labelledby="roadmap-branch-title-<%= branchIndex %> roadmap-branch-count-<%= branchIndex %>">
        <span class="roadmap-tree-header-info">
         <span class="roadmap-tree-title" id="roadmap-branch-title-<%= branchIndex %>"><%= branch.name %></span>
         <span class="roadmap-tree-counts" id="roadmap-branch-count-<%= branchIndex %>"><%= branch.completed %> of <%= branch.total %> ideas completed</span>
        </span>
        <span class="roadmap-tree-progress-wrap" aria-hidden="true">
         <span class="roadmap-tree-bar">
          <span class="roadmap-tree-bar-resolved" style="width:<%= branch.pctCompleted %>%" title="Completed: <%= branch.pctCompleted %>%"></span>
          <span class="roadmap-tree-bar-in-progress" style="width:<%= branch.pctInProgress %>%" title="In progress: <%= branch.pctInProgress %>%"></span>
          <span class="roadmap-tree-bar-approved" style="width:<%= branch.pctPlanned %>%" title="Planned: <%= branch.pctPlanned %>%"></span>
         </span>
         <span class="roadmap-tree-pct"><%= branch.pctCompleted %>%</span>
        </span>
        <span class="roadmap-tree-toggle">
         <span class="roadmap-tree-chevron" aria-hidden="true">▼</span>
        </span>
       </button>
       <div class="roadmap-tree-leaves" id="roadmap-branch-<%= branchIndex %>">
        <% for (const leaf of branch.leaves) { %>
         <article class="roadmap-tree-leaf" data-roadmap-id="<%= leaf.id %>">
          <span class="roadmap-stage-dot <%= leaf.status === 'in_progress' ? 'roadmap-pulse-dot' : '' %>" data-status="<%= leaf.status %>" aria-hidden="true"></span>
          <div class="roadmap-tree-leaf-title">
           <h4><button type="button" data-roadmap-open="<%= leaf.id %>" aria-haspopup="dialog"><%= leaf.title %></button></h4>
          </div>
          <% if (leaf.is_blocked) { %>
           <span class="roadmap-card-blocked-pill" title="Work is waiting on external dependencies">Blocked</span>
          <% } %>
          <% if (leaf.progress_percent !== null && (leaf.status === 'in_progress' || leaf.status === 'resolved')) { %>
           <span class="roadmap-tree-leaf-progress" title="<%= leaf.progress_percent %>% complete">
            <span class="roadmap-tree-leaf-progress-bar" style="width:<%= leaf.progress_percent %>%"></span>
            <span class="roadmap-tree-leaf-progress-text"><%= leaf.progress_percent %>%</span>
           </span>
          <% } %>
          <span class="workspace-status" data-status="<%= leaf.status %>"><%= leaf.status === 'resolved' ? 'Completed' : leaf.status === 'in_progress' ? 'In progress' : 'Planned' %></span>
          <button type="button" class="roadmap-card-vote-btn roadmap-card-vote-btn--compact" data-vote-id="<%= leaf.id %>" aria-label="Support idea, <%= leaf.votes %> votes" title="Support this idea">
           <span class="roadmap-card-vote-icon" aria-hidden="true">↑</span>
           <span class="roadmap-card-vote-count"><%= leaf.votes %></span>
          </button>
          <span class="roadmap-tree-leaf-date"><%= leaf.status === 'resolved' ? completionLabel(leaf) : leaf.last_public_update ? 'Public update '+formatManilaDate(leaf.last_public_update) : 'No public work update' %></span>
         </article>
        <% } %>
        <footer class="roadmap-tree-branch-footer">
         <a class="workspace-text-link" data-roadmap-state-link href="<%= urlFor({ category: branch.name, page: '1' }) %>">View all in <%= branch.name %> →</a>
        </footer>
       </div>
      </section>
     <% } %>
    <% } %>
   </div>
   <% } %>

   <!-- Completed outcomes, not an estimated work schedule -->
   <% if (filters.view === 'done') { %>
   <div class="roadmap-view-timeline-container" aria-label="Completed campus improvements">
    <% if (!timelineData.length) { %>
     <div class="roadmap-lane-empty">
      <span aria-hidden="true">◌</span>
      <h3><%= filtered ? 'No completed ideas match your filters' : 'Nothing here yet' %></h3>
      <p><%= filtered ? 'Try clearing your filters to see past improvements.' : 'Completed community improvements will appear here.' %></p>
     </div>
    <% } else { %>
     <% for (const monthGroup of timelineData) { %>
      <section class="roadmap-timeline-month" aria-labelledby="month-<%= monthGroup.monthKey %>">
       <div class="roadmap-timeline-month-header">
        <span class="roadmap-timeline-month-dot" aria-hidden="true"></span>
        <h3 id="month-<%= monthGroup.monthKey %>" class="roadmap-timeline-month-title"><%= monthGroup.label %></h3>
        <span class="roadmap-timeline-month-count"><%= monthGroup.items.length %> shown on this page</span>
       </div>
       <div class="roadmap-timeline-cards">
        <% for (const item of monthGroup.items) { %>
         <article class="roadmap-timeline-card" data-roadmap-id="<%= item.id %>">
          <div class="roadmap-timeline-you-said">
           <div class="roadmap-timeline-tag-row">
            <span class="roadmap-timeline-side-label">You said</span>
            <span class="workspace-tag"><%= item.category %></span>
           </div>
           <h4><button type="button" data-roadmap-open="<%= item.id %>" aria-haspopup="dialog"><%= item.title %></button></h4>
           <p><%= item.description %></p>
           <div class="roadmap-timeline-meta">
            <span>↑ <%= item.votes %> votes</span> · <time datetime="<%= item.created_at %>">Suggested <%= formatManilaDate(item.created_at) %></time>
           </div>
          </div>
          <div class="roadmap-timeline-we-did">
           <div class="roadmap-timeline-tag-row">
            <span class="roadmap-timeline-side-label roadmap-timeline-side-label--school">We did</span>
            <span class="workspace-status" data-status="resolved">Completed</span>
           </div>
           <p class="roadmap-timeline-response"><%= item.outcome || 'Marked completed; an outcome summary has not been posted.' %></p>
           <span class="roadmap-timeline-completed-date"><%= completionLabel(item) %></span>
          </div>
         </article>
        <% } %>
       </div>
      </section>
     <% } %>
    <% } %>
   </div>
   <% } %>
  </div>

  <nav class="roadmap-pagination" aria-label="Roadmap pages">
   <span>Page <%= filters.page %> of <%= pageCount %><span class="roadmap-page-hint"> · <%= filters.view === 'done' ? 'Up to 20 completed ideas per page' : filters.view === 'timeline' ? 'Up to 20 recently updated ideas per page' : filters.view === 'tree' ? 'Up to 8 ideas per category' : 'Up to 8 ideas per stage' %></span></span>
   <div>
    <% if (filters.page > 1) { %>
     <a class="workspace-button" data-roadmap-state-link href="<%= urlFor({ page: String(filters.page - 1) }) %>">← Previous</a>
    <% } %>
    <% if (filters.page < pageCount) { %>
     <a class="workspace-button" data-roadmap-state-link href="<%= urlFor({ page: String(filters.page + 1) }) %>">Next →</a>
    <% } %>
   </div>
  </nav>
 </section>

 <footer class="roadmap-footer">
  <div>
   <strong>Your next idea could start here.</strong>
   <p>See a way to improve campus life? Share it with your community.</p>
  </div>
  <a class="workspace-button workspace-button--primary" href="/feed?action=share">Share an idea <%~ icon('arrow') %></a>
 </footer>

 <dialog class="workspace-dialog" id="roadmap-dialog" aria-labelledby="roadmap-detail-title">
  <header class="workspace-dialog-header">
   <div class="roadmap-drawer-heading"><span class="workspace-kicker">CAMPUS ROADMAP</span><span>Idea &amp; progress</span></div>
   <button type="button" class="workspace-icon-button" id="roadmap-close" aria-label="Close idea details">×</button>
  </header>
  <div class="workspace-dialog-body">
   <div class="roadmap-detail-tags"><span class="workspace-status" id="roadmap-detail-status"></span><span id="roadmap-detail-category"></span></div>
   <h2 id="roadmap-detail-title"></h2>
   <p id="roadmap-detail-meta" class="workspace-detail-meta"></p>
   <p id="roadmap-detail-error" class="workspace-message" role="status"></p>
   <button type="button" class="workspace-button" id="roadmap-detail-retry" hidden>Try again</button>
   <div id="roadmap-detail-content">
    <div class="roadmap-detail-overview">
    <div id="roadmap-detail-blocked-alert" class="roadmap-detail-blocked-alert" hidden>
     <strong>⚠️ Work is currently paused</strong>
     <p id="roadmap-detail-blocked-reason">The school is waiting on external dependencies.</p>
    </div>
    <div id="roadmap-detail-progress-wrap" class="roadmap-detail-progress-bar-wrap" hidden>
     <div class="roadmap-detail-progress-bar-header">
     <span class="workspace-field-label">School estimate</span>
      <strong id="roadmap-detail-progress-text">0%</strong>
     </div>
     <div class="roadmap-detail-bar" role="progressbar" aria-label="School-estimated work completion" aria-valuemin="0" aria-valuemax="100" id="roadmap-detail-bar-el">
      <div class="roadmap-detail-bar-fill" id="roadmap-detail-bar-fill" style="width:0%"></div>
     </div>
    </div>
    <h3 class="workspace-field-label" id="roadmap-about-title">About this idea</h3>
    <p class="workspace-description" id="roadmap-detail-description"></p>
    <section class="roadmap-school-update" aria-labelledby="roadmap-update-title">
     <h3 id="roadmap-update-title">Idea and school decision</h3>
     <p id="roadmap-detail-response"></p>
    </section>
    <div class="roadmap-detail-progress">
     <h3 class="workspace-field-label">Current stage</h3>
     <ol>
      <% for (const stage of stages) { %>
       <li data-progress-stage="<%= stage.key %>"><span aria-hidden="true"></span><%= stage.label %></li>
      <% } %>
     </ol>
     <p id="roadmap-detail-hint"></p>
     <p id="roadmap-detail-estimate" class="workspace-detail-meta"></p>
    </div>
    </div>
    <section class="roadmap-public-history" aria-labelledby="roadmap-history-title">
     <h3 id="roadmap-history-title">Work updates and evidence</h3>
     <p id="roadmap-history-status" role="status"></p>
     <ol id="roadmap-history-list" class="roadmap-history-list"></ol>
    </section>
   </div>
  </div>
  <footer class="roadmap-drawer-footer" id="roadmap-detail-footer" hidden>
    <div class="roadmap-detail-actions">
     <a class="workspace-button workspace-button--primary" id="roadmap-detail-link" href="/feed">Join the discussion <span aria-hidden="true">→</span></a>
     <button type="button" class="roadmap-card-vote-btn roadmap-detail-vote-btn" id="roadmap-detail-vote" data-vote-id="" aria-label="Support this idea">
      <span class="roadmap-card-vote-icon" aria-hidden="true">↑</span>
      <span class="roadmap-vote-label">Support</span>
      <span class="roadmap-card-vote-count" id="roadmap-detail-votes">0</span>
     </button>
     <button type="button" class="workspace-button" id="roadmap-follow" data-follow-idea="" aria-pressed="false">Follow this idea</button>
    </div>
    <p class="workspace-detail-meta">Follow for <a href="/notifications">in-app updates</a>. No email or push alerts.</p>
  </footer>
 </dialog>
</main>
<script id="sf-roadmap-data" type="application/json"><%~ JSON.stringify(it.items || []).replace(/</g, '\\u003c') %></script>
<script src="/js/roadmap.js?v=20261012-drawer"></script>
<script src="/js/roadmap-views.js?v=20261012-view-menu"></script>
