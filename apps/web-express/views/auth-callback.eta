<% layout('layout') %>

<main class="sf-main auth-callback-container account-flow" aria-labelledby="auth-callback-title">
 <section class="account-flow-card">
  <header class="account-flow-header">
   <span class="account-flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><use href="#ws-shield"/></svg></span>
   <p class="account-flow-eyebrow">Your SuggFeed account</p>
  <h1 class="auth-callback-title" id="auth-callback-title" data-return-to="<%= it.returnTo || '' %>">Signing you in…</h1>
  <p class="auth-callback-sub" id="auth-callback-message" role="status" aria-live="polite">Completing your sign-in, please wait a moment.</p>
  </header>
  <div class="auth-callback-spinner-wrap">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
  </div>
  <form id="auth-code-form" class="auth-reset-form am-form" novalidate hidden>
    <div class="am-field"><label class="am-label" for="auth-code-email">Account email address</label><input class="am-input" id="auth-code-email" type="email" autocomplete="email" required maxlength="254" /></div>
    <div class="am-field"><label class="am-label" for="auth-recovery-code">Password reset code</label><input class="am-input account-code-input" id="auth-recovery-code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" minlength="6" maxlength="10" required aria-describedby="auth-code-help" /></div>
    <p class="account-field-hint" id="auth-code-help">Enter the code from your password reset email. Codes expire and can only be used once.</p>
    <p id="auth-code-feedback" class="auth-reset-feedback" role="alert"></p>
    <button type="submit" class="am-btn-primary" id="auth-code-submit">Verify reset code</button>
    <button type="button" class="am-btn-ghost" id="auth-code-resend">Request a new reset email</button>
  </form>
  <form id="auth-reset-form" class="auth-reset-form am-form" novalidate hidden>
    <div class="am-field"><label class="am-label" for="auth-reset-password">New password</label><input class="am-input" id="auth-reset-password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="auth-reset-help" /></div>
    <div class="am-field"><label class="am-label" for="auth-reset-confirm">Confirm new password</label><input class="am-input" id="auth-reset-confirm" type="password" autocomplete="new-password" minlength="8" required /></div>
    <p class="account-field-hint" id="auth-reset-help">Use at least 8 characters. Your password manager can suggest and save a strong password.</p>
    <p id="auth-reset-feedback" class="auth-reset-feedback" role="alert"></p>
    <button type="submit" class="am-btn-primary" id="auth-reset-submit">Update password</button>
    <button type="button" class="am-btn-ghost" id="auth-reset-cancel">Cancel reset and sign out</button>
  </form>
  <a class="am-btn-primary" id="auth-callback-retry" href="/schools" hidden>Return to sign in</a>
  <footer class="account-flow-footer"><p>Keep reset codes and passwords private. SuggFeed will never ask you to share them.</p></footer>
 </section>
</main>

<script defer src="/js/auth-callback.js?v=20261018-account-ui"></script>
