<% layout('layout') %>

<main class="sf-main auth-callback-container">
  <div class="auth-callback-spinner-wrap">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
  </div>
  <h1 class="auth-callback-title">Authenticating…</h1>
  <p class="auth-callback-sub">Completing your sign-in, please wait a moment.</p>
</main>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      if (window._sb) {
        const { data: { session }, error } = await window._sb.auth.getSession();
        if (error) throw error;
        if (session) {
          await fetch('/auth/session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              access_token: session.access_token,
              refresh_token: session.refresh_token,
            }),
          });
          window.location.href = '/profile';
          return;
        }
      }
      setTimeout(() => { window.location.href = '/'; }, 2000);
    } catch (err) {
      console.error(err);
      window.location.href = '/?error=auth_failed';
    }
  });
</script>
