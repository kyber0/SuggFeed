<% layout('layout') %>

<main class="sf-main auth-callback-container">
  <div class="auth-callback-spinner-wrap">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
  </div>
  <h1 class="auth-callback-title" id="auth-callback-title">Signing you in…</h1>
  <p class="auth-callback-sub" id="auth-callback-message" role="status" aria-live="polite">Completing your sign-in, please wait a moment.</p>
  <form id="auth-reset-form" class="auth-reset-form am-form" novalidate hidden>
    <div class="am-field"><label class="am-label" for="auth-reset-password">New password</label><input class="am-input" id="auth-reset-password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="auth-reset-help" /></div>
    <div class="am-field"><label class="am-label" for="auth-reset-confirm">Confirm new password</label><input class="am-input" id="auth-reset-confirm" type="password" autocomplete="new-password" minlength="8" required /></div>
    <p id="auth-reset-help">Use at least 8 characters. Your password manager can suggest and save a strong password.</p>
    <p id="auth-reset-feedback" class="auth-reset-feedback" role="alert"></p>
    <button type="submit" class="am-btn-primary" id="auth-reset-submit">Update password</button>
    <button type="button" class="am-btn-ghost" id="auth-reset-cancel">Cancel reset and sign out</button>
  </form>
  <a class="btn-primary" id="auth-callback-retry" href="/" hidden>Return home and try again</a>
</main>

<script src="/js/auth-callback.js?v=20261013-recovery"></script>
