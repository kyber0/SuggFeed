<% layout('layout'); const choices=it.submitted || it.data; %>
<% const portalShell=!it.platformDashboard; %><% if(portalShell) { %><main class="staff-workspace portal-management"><%~ include('partials/staff-sidebar',it) %><div class="staff-main portal-management-main"><% } else { %><main><% } %><div class="student-access-page sf-page-container">
 <header class="student-access-header"><div><a class="platform-text-link" href="<%= it.settingsUrl %>">← School settings</a><p class="platform-eyebrow">People & access</p><h1>Student joining</h1><p>Choose how students join <strong><%= it.school.name %></strong>, including those using Gmail or another personal email.</p></div><a class="platform-button" href="<%= it.settingsUrl %>#school-enrollment">Manage approved email list</a></header><% if(portalShell) { %><%~ include('partials/staff-section-tabs',it) %><% } %>
 <% if(it.message) { %><div class="invites-feedback invites-feedback--error" role="alert"><p><%= it.message %></p></div><% } %>
 <% if(it.saved) { %><p class="school-settings-feedback" role="status"><%= it.saved==='review'?'The selected requests were reviewed. Approved applicants receive student access.':'Student joining settings saved.' %></p><% } %>
 <% if(it.school.status!=='active') { %><p class="school-settings-notice">Joining and approvals become available after school activation. You can prepare these settings now.</p><% } %>
 <section class="student-access-panel" aria-labelledby="joining-settings-title"><header><div><p class="platform-eyebrow">Joining options</p><h2 id="joining-settings-title">Two ways to welcome students</h2><p>These options grant student access only. Staff permissions still require administrator approval.</p></div></header>
  <form class="student-joining-form" method="post" action="<%= it.base %>/settings">
   <input type="hidden" name="version" value="<%= choices.version %>"/>
   <label class="student-joining-choice"><input type="checkbox" name="requests_enabled" data-sf-switch role="switch" value="yes" <%= choices.requests_enabled?'checked':'' %>/><span><strong>Let students request access</strong><span>Students with confirmed email accounts can find this school by name and request to join. Review requests individually or approve up to 50 at once. Turning this off stops new requests; pending requests stay available for review.</span></span></label>
   <label class="student-joining-choice"><input type="checkbox" name="roster_join_enabled" data-sf-switch role="switch" value="yes" <%= choices.roster_join_enabled?'checked':'' %>/><span><strong>Let approved emails join instantly</strong><span>Students whose confirmed email exactly matches your approved list can join without an invitation or another approval. Personal email domains do not need DNS verification.</span></span></label>
   <div class="student-access-note"><strong><%= it.data.roster_count %> approved email<%= it.data.roster_count===1?'':'s' %> saved</strong><p><%= it.data.mode==='roster'?'Your enrollment rule requires every student to be on the roster, including applicants you approve. Add missing emails to the roster before approving those requests.':'Your current enrollment rule does not require a roster for invitations or approved access requests. Instant joining always requires a matching approved email.' %></p><a class="platform-text-link" href="<%= it.settingsUrl %>#school-enrollment">Upload or edit the approved list →</a></div>
   <label class="student-access-check"><input type="checkbox" name="acknowledged" value="yes" required/><span>I understand that access requests make the school discoverable to signed-in users, and the approved list permits matching verified accounts to join.</span></label>
   <button class="platform-button platform-button--primary" type="submit">Save joining options</button>
  </form>
 </section>
 <section class="student-access-panel" id="student-access-requests" aria-labelledby="access-requests-title"><header><div><p class="platform-eyebrow">Review queue</p><h2 id="access-requests-title">Student access requests</h2><p>Approve only students whose school eligibility you have checked.</p></div><span class="platform-count"><%= it.data.pending_count %> pending</span></header>
 <% if(!it.data.requests.length) { %><%~ include('partials/empty-state',{icon:'users',heading:it.data.pending_count?'No requests on this page':'No access requests waiting',description:it.data.requests_enabled?'New student requests will appear here. Approved email-list matches can join without entering this queue.':'Enable access requests above to let students find your school and ask to join.',actions:it.page>0?[{href:it.base+'#student-access-requests',label:'Back to first page',secondary:true}]:[]}) %><% } else { %>
 <form class="student-request-review" method="post" action="<%= it.base %>/review?page=<%= it.page %>">
  <div class="student-request-toolbar"><label class="student-access-check"><input type="checkbox" data-student-select-all/><span>Select all on this page</span></label><span data-student-selection-count role="status" aria-live="polite">Select requests to review</span></div>
  <ul class="student-request-list"><% for(const request of it.data.requests) { %><li><label class="student-request-person"><input type="checkbox" name="requests" value="<%= request.id %>" <%= it.selected.includes(request.id)?'checked':'' %>/><span><strong><%= request.email %></strong><span>Requested <time datetime="<%= request.requested_at %>"><%= new Date(request.requested_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila'}) %></time></span><% if(!request.email_current) { %><span class="student-request-warning">Account email changed or is no longer confirmed. Do not approve this request.</span><% } else if(!request.eligible) { %><span class="student-request-warning">Add this email to the required enrollment roster before approving.</span><% } else { %><span>Verified email · Ready for eligibility review</span><% } %></span></label></li><% } %></ul>
  <div class="student-request-review-actions"><label for="student-review-reference">Review reference</label><textarea id="student-review-reference" name="reference" rows="3" minlength="10" maxlength="1000" required aria-describedby="student-review-help"><%= it.reference %></textarea><p id="student-review-help">Record how eligibility was checked, or why the requests were declined. Exclude sensitive student details. Every selected request must be valid for the whole batch to save.</p><div class="sf-button-group"><button class="platform-button platform-button--primary" type="submit" name="decision" value="approved" <%= it.school.status!=='active'?'disabled':'' %>>Approve selected</button><button class="platform-button" type="submit" name="decision" value="rejected">Decline selected</button></div></div>
 </form>
 <% } %>
 <% if(it.page>0 || it.data.pending_count>(it.page+1)*50) { %><nav class="platform-pagination student-request-pagination" aria-label="Access request pages"><% if(it.page>0) { %><a class="platform-button" href="<%= it.base %>?page=<%= it.page-1 %>#student-access-requests">Previous</a><% } %><span>Page <%= it.page+1 %></span><% if(it.data.pending_count>(it.page+1)*50) { %><a class="platform-button" href="<%= it.base %>?page=<%= it.page+1 %>#student-access-requests">Next</a><% } %></nav><% } %>
 </section>
</div><% if(portalShell) { %></div><% } %></main>
