<% layout('layout'); const date=value=>new Date(value).toLocaleString('en-PH',{timeZone:'Asia/Manila',dateStyle:'medium',timeStyle:'short'}); const delivery=it.submitted?.delivery || (it.emailReady?'email':'link'); const role=it.submitted?.role || 'student'; const receipt=it.receipt; %>
<main class="invites-page">
 <header class="invites-heading"><div><a class="school-settings-back" href="<%= it.settingsUrl %>">← School settings</a><p class="school-settings-eyebrow">People & access</p><h1>Invite your community</h1><p>Add the right people to <strong><%= it.school.name %></strong>, with the right access.</p></div><span class="platform-badge platform-badge--<%= it.school.status %>"><%= it.school.status %></span></header>
 <% if(it.errorMessage) { %><div class="invites-feedback invites-feedback--error" role="alert"><strong>Invitation not created</strong><p><%= it.errorMessage %></p></div><% } %>
 <% if(it.revoked) { %><div class="invites-feedback" role="status"><strong>Invitation revoked</strong><p>The old link can no longer be used. Existing school memberships are unchanged.</p></div><% } %>
 <% if(receipt) { const sent=receipt.delivery==='sent'; %><section class="invites-feedback <%= ['failed','uncertain','sending'].includes(receipt.delivery)?'invites-feedback--warning':'' %>" aria-labelledby="invite-result-title"><h2 id="invite-result-title"><%= sent?'Invitation email sent':receipt.delivery==='link'?'Your invitation link is ready':receipt.delivery==='failed'?'Invitation created, email not sent':'Invitation created, email delivery unconfirmed' %></h2><p><strong><%= receipt.email || 'Invited member' %></strong> · <%= it.roles[receipt.role]?.label || 'Member' %></p><p><%= sent?'The email service accepted this invitation for delivery. Ask the recipient to check their inbox and spam folder.':receipt.delivery==='link'?'No email was sent. Share this private link only with the invited person.':'You can share this same link directly. Check the recipient’s inbox before creating another invitation.' %></p><% if(receipt.warning) { %><p><%= receipt.warning %></p><% } %><label for="invitation-url">One-time invitation link</label><div class="invites-copy"><input id="invitation-url" data-invitation-url value="/schools/invitations/<%= receipt.token %>" readonly /><button class="school-settings-secondary" type="button" data-invitation-copy>Copy link</button></div><p class="invites-small">Keep this link private. It is shown here once. <%= receipt.expires?'Expires '+date(receipt.expires)+' (Philippine time).':'Check Recent invitations for its expiry.' %></p><p class="invites-small" data-invitation-copy-status role="status"></p></section><% } %>
 <div class="invites-layout">
  <section class="invites-card" aria-labelledby="new-invite-title"><header><h2 id="new-invite-title">New invitation</h2><p>Access starts only after the recipient accepts.</p></header>
   <% if(!it.ready) { %><p class="school-settings-notice">Invitations are paused until this school is active and its current policies are reviewed. <a href="<%= it.settingsUrl %>">Review school settings</a>.</p><% } %>
   <form action="<%= it.action %>" method="post" data-invitation-form><fieldset <%= it.ready?'':'disabled' %>><legend class="school-settings-visually-hidden">Invitation details</legend>
    <div class="school-settings-field"><label for="invite-email">Recipient’s email</label><input id="invite-email" type="email" name="email" maxlength="254" autocomplete="off" spellcheck="false" placeholder="name@example.com" value="<%= it.submitted?.email || '' %>" required aria-describedby="invite-email-help" /><p id="invite-email-help" class="school-settings-help">They’ll need to sign in or create an account with this exact email.</p></div>
    <fieldset class="invites-options"><legend>Choose their role</legend><% for(const [value,details] of Object.entries(it.roles)) { %><label class="invites-choice"><input type="radio" name="role" value="<%= value %>" <%= value===role?'checked':'' %> required /><span><strong><%= details.label %></strong><small><%= details.description %></small><% if(value==='admin') { %><em>Full school administration access</em><% } %></span></label><% } %></fieldset>
    <fieldset class="invites-options invites-method"><legend>How would you like to invite them?</legend><label class="invites-choice"><input type="radio" name="delivery" value="email" <%= delivery==='email'&&it.emailReady?'checked':'' %> <%= it.emailReady?'':'disabled' %> /><span><strong>Send an email</strong><small><%= it.emailReady?'A branded invitation with a secure accept link.':'Email delivery is not set up yet. Use a private link below.' %></small></span></label><label class="invites-choice"><input type="radio" name="delivery" value="link" <%= delivery==='link'||!it.emailReady?'checked':'' %> /><span><strong>Copy a link</strong><small>Share it yourself. No email will be sent.</small></span></label></fieldset>
    <div class="invites-submit"><button class="school-settings-primary" type="submit" data-invitation-submit><%= delivery==='email'&&it.emailReady?'Send invitation':'Create invitation link' %></button><p class="invites-small">One person · One use · Expires after 48 hours</p></div>
   </fieldset></form>
  </section>
  <aside class="invites-guide"><details class="invites-card" open data-invitation-guide><summary>How invitations work</summary><ol><li><strong>You invite</strong><p>Choose the email, role, and delivery method.</p></li><li><strong>They confirm</strong><p>The recipient signs in with the invited email and reviews their access.</p></li><li><strong>They join</strong><p>Acceptance opens the right school workspace for their role.</p></li></ol><p class="invites-small">Sent the wrong role or email? Revoke the invitation below, then create a replacement.</p></details><% if(it.school.slug==='demo') { %><p class="school-settings-notice"><strong>Fictional demo</strong><br>Use invented school content. Gmail addresses do not receive access automatically.</p><% } %></aside>
 </div>
 <section class="invites-card invites-history" aria-labelledby="invite-history-title"><header><div><h2 id="invite-history-title">Recent invitations</h2><p>The latest 50 invitations for this school. Revoking a link does not remove an existing member.</p></div><span class="platform-badge"><%= it.invitations.length %> recent</span></header>
  <% if(!it.invitations.length) { %><%~ include('partials/empty-state',{icon:'user-plus',heading:'Your community starts here',description:it.ready?'Invite your first student, moderator, or administrator using the form above. Invitations and their delivery status will appear here.':'Invitations will appear here once school activation is complete and you can invite members.'}) %><% } else { %><ul class="invites-list"><% for(const invitation of it.invitations) { const state=invitation.revoked_at?'Revoked':invitation.accepted_at?'Accepted':new Date(invitation.expires_at)<=new Date()?'Expired':'Pending';const method={link:'Private link',sending:'Email delivery unconfirmed',sent:'Email sent',failed:'Email not sent',uncertain:'Email delivery unconfirmed'}[invitation.delivery_state] || 'Private link'; %><li class="invites-row"><div class="invites-person"><strong><%= invitation.email %></strong><span><%= it.roles[invitation.role]?.label || 'Member' %> · <%= method %></span></div><div class="invites-row-state"><span class="platform-badge <%= state==='Accepted'?'platform-badge--active':state==='Pending'?'platform-badge--pending':'' %>"><%= state %></span><small><%= state==='Accepted'?'Joined '+date(invitation.accepted_at):'Expires '+date(invitation.expires_at) %></small></div><% if(state==='Pending' && it.ready) { %><form action="<%= it.action %>/<%= invitation.id %>/revoke" method="post" data-invitation-form><button class="invites-revoke" type="submit" aria-label="Revoke invitation for <%= invitation.email %>">Revoke</button></form><% } %></li><% } %></ul><% } %>
 </section>
</main>
<script defer src="/js/invitations.js?v=20261018-invitations"></script>
