<% layout('layout'); const active=it.school.status==='active'; const persisted=it.savedSettings !== undefined ? it.savedSettings : it.settings; %>
<main class="school-settings-page">
  <header class="school-settings-header"><div><a class="school-settings-back" href="<%= it.platformDashboard ? "/platform/schools" : "/schools" %>">← <%= it.platformDashboard ? "Platform dashboard" : "Your schools" %></a><p class="school-settings-eyebrow">School administration</p><h1>School settings</h1><p>Manage policies, access, and contacts for <strong><%= it.school.name %></strong>.</p></div><span class="platform-badge platform-badge--<%= it.school.status %>"><%= it.school.status %></span></header>
  <% if(it.errorMessage) { %><div class="school-settings-feedback" role="alert"><%= it.errorMessage %></div><% } %>
  <% if(it.school.slug==='demo') { %><p class="school-settings-notice"><strong>Demo workspace</strong> — use fictional information only. Example contact addresses do not receive messages. Replace sample policies and contacts before real use.</p><% } %>
  <% if(it.pendingPolicy) { %><p class="school-settings-notice"><strong>Policy draft version <%= it.pendingPolicy.version %> awaits review.</strong> <%= persisted?.approved_at?'The approved policy and community access remain active until the replacement is reviewed.':'The workspace opens after its first policy review and activation.' %></p><% } %>
  <% if(it.saved) { %><div class="school-settings-feedback" role="status">Settings saved. Updated notices require platform review. Previously approved notices remain active.</div><% } %>
  <div class="school-settings-layout">
    <aside class="school-settings-sidebar"><nav data-section-navigation aria-label="School settings sections"><a href="<%= it.settingsAction.replace(/(?:school-settings|settings)$/,'customization') %>">Appearance & customization</a><a href="#school-policies">Policies & eligibility</a><a href="#school-contacts">School contacts</a><a href="#school-access">Visibility & retention</a><a href="#school-domains">Email domains</a><a href="#school-enrollment">Student enrollment</a><a href="<%= it.invitationAction %>">Member invitations</a></nav><section class="school-settings-summary"><h2>Policy status</h2><dl><div><dt>Current version</dt><dd><%= persisted?.version || 1 %></dd></div><div><dt>Platform review</dt><dd><%= persisted?.approved_at ? 'Approved' : 'Pending' %></dd></div></dl><p>Saving creates a new version and requires a new review. The currently approved policy remains active during review; this does not activate the workspace or establish legal approval.</p></section></aside>
    <div class="school-settings-content">
      <section class="school-settings-card school-setup-overview" aria-labelledby="school-setup-title"><header><div><p class="school-settings-eyebrow">Workspace setup</p><h2 id="school-setup-title"><%= active ? 'Manage your school' : 'Get your school ready' %></h2><p><%= active ? 'Keep policies current and manage access for your community.' : 'Complete your school details, then a platform administrator reviews readiness before activation.' %></p></div></header><ol class="school-setup-steps">
        <li><strong>1. Policies, contacts & access</strong><span><%= persisted?.privacy_notice && persisted?.privacy_contact ? 'Saved — review the details below' : 'Your next step — complete the form below' %></span><a href="#school-policies">Review settings</a></li>
        <li><strong>2. Platform review</strong><span><%= persisted?.approved_at ? 'Current policy version reviewed' : persisted?.privacy_notice && persisted?.privacy_contact ? 'Awaiting review of the saved policy version' : 'Complete and save school settings first' %></span><% if (it.platformDashboard) { %><a href="/platform/schools#policy-<%= it.school.id %>">Open policy review</a><% } %></li>
        <li><strong>3. Workspace activation</strong><span><%= active ? 'Active' : 'Platform administrator completes service and access checks' %></span><% if (it.platformDashboard && !active) { %><a href="/platform/schools#school-<%= it.school.id %>">View activation requirements</a><% } %></li>
        <li><strong>4. Invite members</strong><span><%= active ? 'Ready — open Member invitations' : 'Available after activation' %></span><a href="<%= it.invitationAction %>">Member invitations</a></li>
      </ol></section>

      <form data-preserve-form data-unsaved="<%= it.errorMessage?'true':'false' %>" class="school-settings-form" action="<%= it.settingsAction %>" method="post"><input type="hidden" name="version" value="<%= it.settings.version %>" />
        <section class="school-settings-card" id="school-policies" aria-labelledby="policies-heading"><header><span class="school-settings-step" aria-hidden="true">01</span><div><h2 id="policies-heading">Policies & eligibility</h2><p>Explain how your school uses SuggFeed and who can participate.</p></div></header><div class="school-settings-card-body">
        <% for(const [key,label,hint,min,max,rows] of [['privacy_notice','School privacy notice','Describe purposes, lawful grounds, disclosures, provider duties, and student rights.',20,20000,8],['terms_notice','School terms','Set participation rules, responsibilities, and acceptable use.',20,20000,8],['age_policy','Age eligibility and guardian requirements','Explain age eligibility and when guardian involvement is required.',10,4000,5]]) { %><div class="school-settings-field"><label for="<%= key %>"><%= label %> <span>Required</span></label><p id="<%= key %>-hint"><%= hint %></p><textarea id="<%= key %>" name="<%= key %>" rows="<%= rows %>" required minlength="<%= min %>" maxlength="<%= max %>" aria-describedby="<%= key %>-hint"><%= it.settings[key] || '' %></textarea></div><% } %>
        </div></section>
        <section class="school-settings-card" id="school-contacts" aria-labelledby="contacts-heading"><header><span class="school-settings-step" aria-hidden="true">02</span><div><h2 id="contacts-heading">School contacts</h2><p>Use monitored institutional mailboxes that students can reach.</p></div></header><div class="school-settings-card-body school-settings-columns">
        <% for(const [key,label,hint] of [['privacy_contact','Privacy / DPO email','For privacy questions and data rights requests.'],['school_contact','Institutional contact email','For questions about the school workspace.']]) { %><div class="school-settings-field"><label for="<%= key %>"><%= label %> <span>Required</span></label><p id="<%= key %>-hint"><%= hint %></p><input type="email" id="<%= key %>" name="<%= key %>" value="<%= it.settings[key] || '' %>" required maxlength="254" aria-describedby="<%= key %>-hint" /></div><% } %>
        </div></section>
        <section class="school-settings-card" id="school-access" aria-labelledby="access-heading"><header><span class="school-settings-step" aria-hidden="true">03</span><div><h2 id="access-heading">Visibility & retention</h2><p>Choose who can view approved feedback and how long records are kept.</p></div></header><div class="school-settings-card-body">
          <div class="school-settings-field"><label for="publication">Publication policy</label><select id="publication" name="publication_policy" aria-describedby="publication-hint"><option value="private" <%= it.settings.publication_policy==='private'?'selected':'' %>>School members only</option><option value="public" <%= it.settings.publication_policy==='public'?'selected':'' %>>Public approved feedback</option></select><p id="publication-hint">Public mode makes approved public feedback visible to anyone.</p></div>
          <div class="school-settings-field"><label for="retention">Records retention</label><div class="school-settings-unit"><input id="retention" name="retention_days" type="number" min="1" max="3650" value="<%= it.settings.retention_days %>" required aria-describedby="retention-hint" /><span>days</span></div><p id="retention-hint">Between 1 and 3,650 days. Applicable holds and records duties still apply.</p></div>
        </div></section>
        <div class="school-settings-save"><p>Previous versions are retained. Changes need a new platform review.</p><button class="school-settings-primary" type="submit">Save new policy version</button></div>
      </form>
      <%~ include('partials/school-domains',it) %>
      <%~ include('partials/school-enrollment',it) %>
      <section class="school-settings-card" id="school-invitations" aria-labelledby="invitations-heading"><header><span class="school-settings-step" aria-hidden="true">04</span><div><h2 id="invitations-heading">People & invitations</h2><p>Invite students and staff from one place.</p></div></header><div class="school-settings-card-body"><p>Choose a role, send a branded email or share a private link, and track recent invitations.</p><a class="school-settings-primary invitation-cta" href="<%= it.invitationAction %>">Manage invitations →</a></div></section>
    </div>
  </div>
</main>
