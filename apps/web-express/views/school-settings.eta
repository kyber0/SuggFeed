<% layout('layout') %>
<main class="sf-legal-page"><div class="sf-legal-container"><nav><a href="/schools">Your schools</a></nav><h1><%= it.school.name %>: school settings</h1><% if(it.saved) { %><p role="status">Settings saved. Updated notices require platform review.</p><% } %><p>Status: <%= it.school.status %>. Policy version: <%= it.settings.version %>. Review: <%= it.settings.approved_at ? 'approved' : 'pending' %>.</p><p>Record actual school purposes, lawful grounds, eligibility, disclosures, provider duties, retention and contacts. Saving retains the previous version and requires a new platform review; it does not establish legal approval.</p>
<form action="/s/<%= it.school.slug %>/admin/school-settings" method="post"><input type="hidden" name="version" value="<%= it.settings.version %>" />
<% for(const [key,label,min,max] of [['privacy_notice','School privacy notice',20,20000],['terms_notice','School terms',20,20000],['age_policy','Age eligibility and guardian requirements',10,4000]]) { %><p><label for="<%= key %>"><%= label %></label><textarea id="<%= key %>" name="<%= key %>" rows="8" required minlength="<%= min %>" maxlength="<%= max %>"><%= it.settings[key] || '' %></textarea></p><% } %>
<% for(const [key,label] of [['privacy_contact','Privacy / DPO email'],['school_contact','Institutional contact email']]) { %><p><label for="<%= key %>"><%= label %></label><input type="email" id="<%= key %>" name="<%= key %>" value="<%= it.settings[key] || '' %>" required maxlength="254" /></p><% } %>
<p><label for="publication">Publication policy</label><select id="publication" name="publication_policy"><option value="private" <%= it.settings.publication_policy==='private'?'selected':'' %>>School members only</option><option value="public" <%= it.settings.publication_policy==='public'?'selected':'' %>>Approved public feedback visible to anyone</option></select></p><p><label for="retention">Records retention (days; applicable holds and records duties still apply)</label><input id="retention" name="retention_days" type="number" min="1" max="3650" value="<%= it.settings.retention_days %>" required /></p><button type="submit">Save new policy version</button></form>
<% if(it.invitationUrl) { %><section aria-label="Created invitation"><p role="status">Invitation created. Copy this path now; it is shown once. No email was sent.</p><p><label for="invitation-url">One-time invitation path</label><input id="invitation-url" value="<%= it.invitationUrl %>" readonly size="80" /></p></section><% } %><h2>Invite a school member</h2><p>Available for active schools. Invitations require the intended confirmed account email, expire after 48 hours and can be used once. This form sends no email.</p><form action="/s/<%= it.school.slug %>/admin/invitations" method="post"><p><label for="invite-email">Account email</label><input id="invite-email" name="email" type="email" maxlength="254" required /></p><p><label for="invite-role">School role</label><select id="invite-role" name="role"><option value="student">Student</option><option value="moderator">Moderator</option><option value="admin">Administrator</option></select></p><button type="submit">Create invitation</button></form></div></main>
