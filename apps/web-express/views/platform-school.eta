<% layout('layout');const school=it.school;const schoolHref=tab=>'/platform/schools/'+school.id+'?tab='+tab+'&returnTo='+encodeURIComponent(it.backUrl); %>
<%~ include('partials/platform-shell-start',it) %>
<a class="pv-back" href="<%= it.backUrl %>">← Back to school list</a><header class="platform-page-header pv-page-header"><div><p class="platform-eyebrow">School platform record · /s/<%= school.slug %></p><h1><%= school.name %></h1><p><span class="platform-badge platform-badge--<%= school.status %>"><%= it.statuses[school.status] %></span> <%= {pending:'Setup is incomplete. Eligible members gain access after activation.',active:'Workspace access is open to eligible members.',suspended:'Workspace access is paused; accounts and records are retained.',closed:'Workspace is closed; records are retained. Reopening is unavailable through these controls.'}[school.status] %></p></div><a class="platform-button" href="<%= it.currentUrl %>">Refresh</a></header>
<nav class="pv-tabs" aria-label="School platform details"><% for(const [tab,label] of [['summary','Summary'],['reviews','Reviews'],['access','Access'],['activity','Activity']]){ %><a href="<%= schoolHref(tab) %>" <%= it.tab===tab?'aria-current="page"':'' %>><%= label %></a><% } %></nav>
<% if(it.tab==='summary'){ %>
<section class="pv-card"><header class="pv-section-heading"><div><h2>Workspace readiness</h2><p><%= it.canActivate?'Preflight requirements are present. Final checks run when activation is requested.':'Complete the requirements below before requesting activation.' %></p></div></header><ol class="pv-readiness"><% for(const check of it.checks){ %><li><div><strong><%= check.label %></strong><p><%= check.owner %></p></div><span class="pv-check-state <%= check.pass?'is-ready':'' %>"><%= check.state %></span><% if(check.href){ %><a href="<%= check.href %>"><%= check.action %> →</a><% } %></li><% } %></ol><% if(school.status==='pending'){ %><form class="pv-actions" method="post" action="/platform/schools/<%= school.id %>/activate"><input type="hidden" name="platformReturnTo" value="<%= it.currentUrl %>"/><button type="submit" class="platform-button platform-button--primary" <%= it.canActivate?'':'disabled' %>>Request activation</button><span class="pv-meta">Activation does not skip administrator or release checks.</span></form><% }else if(school.status==='suspended'){ %><a class="platform-button" href="/platform/schools/<%= school.id %>/status?to=active&returnTo=<%= encodeURIComponent(it.currentUrl) %>">Review reactivation</a><% } %></section>
<div class="pv-two-columns"><section class="pv-card"><h2>Institutional authority</h2><% if(it.authorityUnavailable){ %><p>Application evidence is unavailable.</p><% }else if(it.application){ %><p>Application review recorded <%= new Date(it.application.reviewed_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila'}) %>.</p><details><summary>Review reference</summary><p class="pv-preserve"><%= it.application.review_reference %></p></details><% }else{ %><p>No approved application is linked to this record. A manually provisioned or fictional school must not be presented as institutionally verified on this basis.</p><% } %></section><section class="pv-card"><h2>Contacts & joining</h2><dl class="pv-event-details"><div><dt>Institutional contact</dt><dd><%= it.policyUnavailable?'Unavailable':it.policy?.school_contact||'Not configured' %></dd></div><div><dt>Privacy contact</dt><dd><%= it.policyUnavailable?'Unavailable':it.policy?.privacy_contact||'Not configured' %></dd></div><div><dt>Enabled joining domains</dt><dd><%= it.domains??'Unavailable' %></dd></div><div><dt>Enrollment rule</dt><dd><%= it.enrollment||'Unavailable / not configured' %></dd></div></dl><p class="pv-meta">Contact values are configuration, not proof of mailbox ownership. Review evidence remains authoritative. Student rosters are not exposed here.</p></section></div>
<% }else if(it.tab==='reviews'){ %><section class="pv-card"><h2>School reviews</h2><div class="pv-task-links"><a href="<%= it.url({section:'reviews',reviewType:'policies',item:school.id}) %>"><strong>Policy version</strong><span><%= it.policyUnavailable?'Unavailable':it.policyDraft?'Draft v'+it.policyDraft.version+' awaits review':it.policy?.approved_at?'Approved v'+it.policy.version:'No submitted policy' %> →</span></a><a href="<%= it.url({section:'reviews',reviewType:'forms',item:school.id}) %>"><strong>Form collection</strong><span><%= it.editorUnavailable?'Unavailable':it.editor?.review_requested_at?'Requested revision '+it.editor.revision:'No pending request' %> →</span></a></div><p>Approving a policy or form does not activate the school or grant editor access.</p></section>
<% }else if(it.tab==='access'){ %>
<%~ include('partials/platform-grant',it) %>
<section class="pv-card"><h2>School administration</h2><p>Memberships, invitations and student joining are managed by the school’s administrators. Platform authority does not grant school membership.</p><% if(it.canAdmin){ %><div class="pv-actions"><a class="platform-button" href="/platform/schools/<%= school.id %>/settings">Open school settings</a><a class="platform-text-link" href="/platform/schools/<%= school.id %>/members">Members & invitations →</a></div><p class="pv-meta">These links use your existing school-admin membership. No role is added.</p><% } %></section>
<section class="pv-card"><h2>Workspace access</h2><% if(school.status==='active'){ %><p>Suspend access temporarily while retaining accounts and records.</p><a class="platform-button" href="/platform/schools/<%= school.id %>/status?to=suspended&returnTo=<%= encodeURIComponent(it.currentUrl) %>">Suspend school</a><% }else if(school.status==='suspended'){ %><p>Reactivation checks current administrator, policy and release requirements.</p><a class="platform-button platform-button--primary" href="/platform/schools/<%= school.id %>/status?to=active&returnTo=<%= encodeURIComponent(it.currentUrl) %>">Review reactivation</a><% }else if(school.status==='pending'){ %><p>Use the readiness checklist before requesting activation.</p><a class="platform-button" href="<%= schoolHref('summary') %>">View readiness</a><% }else{ %><p>This workspace is closed. Reopening is unavailable through the existing controls.</p><% } %><% if(school.status!=='closed'){ %><details class="pv-danger"><summary>Permanent closure</summary><p>Closure retains records and accounts but cannot be reversed through these controls. Use suspension for a temporary restriction.</p><a class="platform-text-link" href="/platform/schools/<%= school.id %>/status?to=closed&returnTo=<%= encodeURIComponent(it.currentUrl) %>">Review school closure →</a></details><% } %></section>
<% }else{ %><section class="pv-card"><h2>School platform activity</h2><%~ include('partials/platform-activity',{activity:it.activity}) %></section><% if(it.activity){ %><%~ include('partials/platform-pagination',{page:it.page,total:it.activity.total,pageHref:page=>schoolHref('activity')+'&page='+page}) %><% } %><% } %>
<%~ include('partials/platform-shell-end',it) %>
