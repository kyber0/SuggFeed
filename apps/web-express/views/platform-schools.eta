<% layout('layout');
const icon = name => '<svg class="workspace-svg" aria-hidden="true" focusable="false"><use href="#ws-'+name+'"></use></svg>';
const policyFor = id => it.settings.find(policy => policy.school_id === id);
const pageUrl = (page, applications, anchor) => '/platform/schools?page='+page+'&applicationPage='+applications+(it.search ? '&q='+encodeURIComponent(it.search) : '')+(it.status ? '&status='+encodeURIComponent(it.status) : '')+'#'+anchor;
const statusLabel = {pending:'Pending setup',active:'Active',suspended:'Suspended',closed:'Closed'};
%>
<main class="platform-dashboard platform-dashboard--overview" id="platform-dashboard" data-workspace-sections>
  <aside class="platform-sidebar" aria-label="Super admin workspace">
    <div class="platform-workspace"><span class="platform-icon"><%~ icon('crown') %></span><div><strong>SuggFeed</strong><span>Super admin workspace</span></div></div>
    <nav class="platform-nav" data-section-navigation aria-label="Dashboard sections">
      <a href="#overview" class="is-current"><%~ icon('board') %><span class="platform-nav-label">Overview</span></a>
      <a href="#schools"><%~ icon('users') %><span class="platform-nav-label">Schools</span><span class="platform-nav-count"><%= it.schools.length %></span></a>
      <a href="#applications"><%~ icon('inbox') %><span class="platform-nav-label">Applications</span><span class="platform-nav-count"><%= it.applications.length %></span></a>
      <a href="#policies"><%~ icon('list') %><span class="platform-nav-label">Policy reviews</span></a>
      <a href="/platform/customization" aria-label="Editor access and form reviews"><%~ icon('board') %><span class="platform-nav-label">Editor access</span></a>
      <a href="#setup"><%~ icon('shield') %><span class="platform-nav-label">Service setup</span></a>
    </nav>
    <div class="platform-sidebar-footer"><span class="platform-role"><%~ icon('shield') %> Super admin</span><p>Platform permissions are separate from school memberships.</p><a href="/platform/schools">Platform overview <%~ icon('arrow') %></a></div>
  </aside>
  <div class="platform-content">
    <% if (it.statusSaved) { %><div class="platform-feedback" role="status">School status updated successfully.</div><% } %>
    <% if (it.saved) { %><div class="platform-feedback" role="status"><%~ icon('shield') %> Your review was saved successfully.</div><% } %>
    <section id="overview" data-workspace-panel><header class="platform-page-header">
      <div><p class="platform-eyebrow">Platform administration</p><h1>Platform overview</h1><p>Your schools, reviews, and next steps in one place.</p></div>
      <a class="platform-button platform-button--primary" href="<%= !it.businessReady ? '#setup' : it.applications.length ? '#applications' : '#schools' %>"><%~ icon('inbox') %> <%= !it.businessReady ? 'Complete service setup' : it.applications.length ? 'Review applications' : 'Manage schools' %></a>
    </header>
    <section class="platform-stats" aria-label="Current page summary">
      <article class="platform-stat"><span class="platform-stat-icon"><%~ icon('users') %></span><p>Schools listed</p><strong><%= it.schools.length %></strong><small>On this page</small></article>
      <article class="platform-stat"><span class="platform-stat-icon platform-stat-icon--success"><%~ icon('board') %></span><p>Active workspaces</p><strong><%= it.schools.filter(school=>school.status==='active').length %></strong><small>Among listed schools</small></article>
      <article class="platform-stat"><span class="platform-stat-icon platform-stat-icon--accent"><%~ icon('inbox') %></span><p>Applications to review</p><strong><%= it.applications.length %></strong><small>On this page</small></article>
      <article class="platform-stat"><span class="platform-stat-icon"><%~ icon('list') %></span><p>Policies to review</p><strong><%= it.settings.filter(policy=>!policy.approved_at).length %></strong><small>Saved drafts for listed schools</small></article>
    </section>
    <% if (!it.businessReady || !it.release?.isolation_verified) { %>
    <section class="platform-setup-banner" aria-labelledby="setup-banner-title">
      <span class="platform-icon"><%~ icon('shield') %></span><div><h2 id="setup-banner-title"><%= it.businessReady ? 'Complete school isolation verification' : 'Complete service setup before onboarding schools' %></h2><p><%= it.businessReady ? 'Record technical verification before activating new workspaces. Existing access rules remain in effect.' : 'Your service operator name and privacy contact are needed before applications and approvals can open.' %></p></div><a class="platform-text-link" href="#setup">View checklist <%~ icon('arrow') %></a>
    </section>
    <% } %>
    </section>
    <section data-workspace-panel class="platform-panel" id="schools" aria-labelledby="schools-title">
      <div class="platform-panel-heading"><div><p class="platform-eyebrow">Workspaces</p><h2 id="schools-title">School directory</h2><p>Manage school access, setup and appearance from one place.</p></div><span class="platform-count"><%= it.schools.length %> listed</span></div>
      <form class="platform-filters" method="get" action="/platform/schools#schools" role="search" aria-label="Find a school">
        <input type="hidden" name="applicationPage" value="<%= it.applicationPage %>" />
        <div><label for="school-search">School name</label><input id="school-search" type="search" name="q" maxlength="100" value="<%= it.search || '' %>" placeholder="Search schools…" /></div>
        <div><label for="school-status">Workspace status</label><select id="school-status" name="status"><option value="">All statuses</option><% for (const [value,label] of Object.entries(statusLabel)) { %><option value="<%= value %>" <%= it.status===value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
        <button class="platform-button platform-button--primary" type="submit">Find schools</button>
        <% if (it.search || it.status) { %><a class="platform-text-link" href="/platform/schools?applicationPage=<%= it.applicationPage %>#schools">Clear filters</a><% } %>
      </form>
      <% if (!it.schools.length) { %><%~ include('partials/empty-state',{icon:'users',heading:it.search || it.status?'No matching schools on this page':'No schools on this page',description:it.search || it.status?'Try another school name or clear the filters.':'Approved applications create a pending school workspace.',actions:[{href:it.page>0?pageUrl(0,it.applicationPage,'schools'):it.search || it.status?'/platform/schools#schools':'#applications',label:it.page>0?'Back to first page':it.search || it.status?'Clear filters':'View applications',secondary:true}]}) %><% } %>
      <ul class="platform-school-list">
      <% for (const school of it.schools) {
        const policy=policyFor(school.id), canEdit=it.adminSchoolIds.includes(school.id), editorEnabled=!!it.customizationStates?.find(state=>state.school_id===school.id)?.editing_enabled;
        const canRequest=(it.businessReady || school.id===it.demoSchoolId) && it.release?.isolation_verified && policy?.approved_at && ['pending','suspended'].includes(school.status);
      %>
        <li class="platform-directory-row">
          <details class="platform-school-manage" id="school-<%= school.id %>" name="platform-school">
            <summary>
              <span class="platform-school-identity"><span class="platform-school-avatar" aria-hidden="true"><%= school.name.slice(0,1).toUpperCase() %></span><span class="platform-school-name"><strong><%= school.name %></strong><span>/s/<%= school.slug %></span></span></span>
              <span class="platform-badge platform-badge--<%= school.status %>"><%= statusLabel[school.status] || school.status %></span>
              <span class="platform-manage-label">Manage school <%~ icon('chevron-down') %></span>
            </summary>
            <div class="platform-school-workspace">
              <section class="platform-readiness-group" aria-labelledby="readiness-<%= school.id %>">
                <h3 id="readiness-<%= school.id %>">Workspace readiness</h3>
                <p id="school-reason-<%= school.id %>"><%= school.status==='active' ? 'Workspace is open to eligible members.' : school.status==='closed' ? 'This workspace is closed.' : school.status==='suspended' ? 'This workspace is suspended.' : !policy ? 'School policies have not been saved.' : !policy.approved_at ? 'Review school policies before activation.' : !it.release?.isolation_verified ? 'Technical isolation verification is required.' : !it.businessReady && school.id!==it.demoSchoolId ? 'Complete service setup before activation.' : 'Ready for activation checks.' %></p>
                <dl class="platform-readiness-list">
                  <div><dt>School policies</dt><dd><%= !policy ? 'Not saved' : policy.approved_at ? 'Reviewed' : 'Needs review' %></dd></div>
                  <div><dt>Service setup</dt><dd><%= school.id===it.demoSchoolId ? 'Fictional demo' : it.businessReady ? 'Configured' : 'Incomplete' %></dd></div>
                  <div><dt>School isolation</dt><dd><%= it.release?.isolation_verified ? 'Verified' : 'Pending verification' %></dd></div>
                  <div><dt>Visual editor</dt><dd><%= editorEnabled ? 'Enabled for admins' : 'Not enabled' %></dd></div>
                </dl>
                <% if (policy) { %><a class="platform-text-link" href="#policy-<%= school.id %>">Review school policy <%~ icon('arrow') %></a><% } %>
              </section>
              <section class="platform-management-group" aria-labelledby="manage-<%= school.id %>">
                <h3 id="manage-<%= school.id %>">School management</h3>
                <% if (canEdit && school.status!=='closed') { %>
                <nav class="platform-management-links" aria-label="Manage <%= school.name %>">
                  <a href="/platform/schools/<%= school.id %>/settings"><%~ icon('list') %><span>Policies & school settings</span><%~ icon('arrow') %></a>
                  <a href="/platform/schools/<%= school.id %>/invitations"><%~ icon('user-plus') %><span>Members & invitations</span><%~ icon('arrow') %></a>
                  <a href="/platform/schools/<%= school.id %>/members"><%~ icon('users') %><span>Members & access</span><%~ icon('arrow') %></a>
                  <a href="/platform/schools/<%= school.id %>/student-access"><%~ icon('users') %><span>Student joining & requests</span><%~ icon('arrow') %></a>
                  <% if (editorEnabled) { %><a href="/platform/schools/<%= school.id %>/customization"><%~ icon('board') %><span>Customize workspace</span><%~ icon('arrow') %></a><% } %>
                </nav>
                <% } else { %><p>School settings and invitations are managed by the school’s administrators. Platform controls are available below.</p><% } %>
                <% if (school.status!=='closed') { %><form class="platform-editor-access" method="post" action="/platform/schools/<%= school.id %>/customization-rollout">
                  <input type="hidden" name="enabled" value="<%= editorEnabled ? 'false' : 'true' %>"/>
                  <div><strong>Visual editor access</strong><p><%= editorEnabled ? 'Published appearance stays available when editing is paused.' : 'Allow this school’s admins to edit their workspace.' %></p></div>
                  <button class="platform-button" type="submit"><%= editorEnabled ? 'Pause editing' : 'Enable editing' %></button>
                </form><% } %>
                <% if (school.status==='pending') { %>
                <form class="platform-activation-action" method="post" action="/platform/schools/<%= school.id %>/activate">
                  <p>Activation checks verify administrator access and school isolation.</p>
                  <button class="platform-button platform-button--primary" type="submit" aria-describedby="school-reason-<%= school.id %>" <%= canRequest ? '' : 'disabled' %>>Request activation</button>
                </form>
                <% } %>
                <% if (school.status==='suspended') { %><div class="platform-activation-action"><p>Restore access after the school meets activation requirements.</p><a class="platform-button platform-button--primary" href="/platform/schools/<%= school.id %>/status?to=active">Reactivate school</a></div><% } %>
                <% if (school.status!=='closed') { %>
                <details class="platform-lifecycle"><summary>School access & closure</summary><div>
                  <% if (school.status==='active') { %><p>Suspend access temporarily while retaining the school’s records.</p><a class="platform-button" href="/platform/schools/<%= school.id %>/status?to=suspended">Suspend school</a><% } %>
                  <p>Close the workspace without deleting accounts or school records. Closed schools cannot be reopened through these controls.</p><a class="platform-text-link platform-close-link" href="/platform/schools/<%= school.id %>/status?to=closed">Close school</a>
                </div></details>
                <% } else { %><p class="platform-closed-note">This school is closed. Accounts and records are retained; reopening is unavailable through these controls.</p><% } %>
              </section>
            </div>
          </details>
        </li>
      <% } %>
      </ul>
      <div class="platform-panel-footer"><p>Final administrator and isolation checks run when activation is requested.</p><nav class="platform-pagination" aria-label="School directory pages"><% if (it.page>0) { %><a class="platform-button" href="<%= pageUrl(it.page-1,it.applicationPage,'schools') %>">Previous</a><% } %><span>Page <%= it.page+1 %></span><% if (it.nextPage) { %><a class="platform-button" href="<%= pageUrl(it.page+1,it.applicationPage,'schools') %>">Next schools</a><% } %></nav></div>
    </section>
    <div class="platform-review-grid platform-review-grid--sections">
      <section data-workspace-panel class="platform-panel" id="applications" aria-labelledby="applications-title">
        <div class="platform-panel-heading"><div><p class="platform-eyebrow">Intake</p><h2 id="applications-title">Pending applications</h2><p>Verify institutional authority before provisioning a workspace.</p></div></div>
        <% if (!it.applications.length) { %><%~ include('partials/empty-state',{icon:'inbox',heading:it.applicationPage>0?'No applications on this page':'You’re all caught up',description:'No pending applications on this page. New school requests will appear here.',actions:it.applicationPage>0?[{href:pageUrl(it.page,0,'applications'),label:'Back to first applications',secondary:true}]:[]}) %><% } %>
        <% for (const application of it.applications) { %><article class="platform-review-card"><div class="platform-review-heading"><h3><%= application.name %></h3><span class="platform-badge platform-badge--pending">Awaiting review</span></div><p>/s/<%= application.slug %></p><details class="platform-application-review"><summary>Review application <%~ icon('chevron-down') %></summary><dl class="platform-facts"><div><dt>Representative</dt><dd><%= application.contact_name %></dd></div><div><dt>Contact</dt><dd><%= application.contact_email %></dd></div></dl><details class="platform-details"><summary>Authority statement</summary><p class="platform-preserve-text"><%= application.authority_statement %></p></details><form method="post" action="/platform/schools/<%= application.id %>/review"><label for="review-<%= application.id %>">Verification outcome and review reference</label><textarea id="review-<%= application.id %>" name="reference" rows="3" required minlength="10" maxlength="2000" placeholder="Record the actual verification and its reference."></textarea><div class="platform-form-actions"><button class="platform-button platform-button--primary" name="decision" value="approved" <%= it.businessReady ? '' : 'disabled' %>>Approve pending workspace</button><button class="platform-button platform-button--danger" name="decision" value="rejected">Reject application</button></div><% if (!it.businessReady) { %><p class="platform-help">Complete service setup before approving applications.</p><% } %></form></details></article><% } %>
        <% if (it.applicationPage>0 || it.nextApplicationPage) { %><nav class="platform-pagination platform-pagination--panel" aria-label="Application review pages"><% if (it.applicationPage>0) { %><a class="platform-button" href="<%= pageUrl(it.page,it.applicationPage-1,'applications') %>">Previous applications</a><% } %><span>Page <%= it.applicationPage+1 %></span><% if (it.nextApplicationPage) { %><a class="platform-button" href="<%= pageUrl(it.page,it.applicationPage+1,'applications') %>">Next applications</a><% } %></nav><% } %>
      </section>
      <section id="setup" data-workspace-panel class="platform-panel" aria-labelledby="setup-title">
        <div class="platform-panel-heading"><div><p class="platform-eyebrow">Before launch</p><h2 id="setup-title">Service setup</h2><p>Requirements for onboarding and activation.</p></div></div>
        <details class="platform-service-details" <%= !it.businessReady || !it.release?.isolation_verified ? 'open' : '' %>><summary><span><%= it.businessReady && it.release?.isolation_verified ? 'Setup checks complete' : 'View setup requirements' %></span><%~ icon('chevron-down') %></summary>
        <dl class="platform-checklist">
          <div><dt><span class="platform-check-dot <%= it.legal.operatorName ? 'is-complete' : '' %>" aria-hidden="true"></span>Service operator</dt><dd><%= it.legal.operatorName || 'Not configured' %></dd></div>
          <div><dt><span class="platform-check-dot <%= it.legal.privacyEmail ? 'is-complete' : '' %>" aria-hidden="true"></span>Privacy contact</dt><dd><%= it.legal.privacyEmail || 'Not configured' %></dd></div>
          <div><dt><span class="platform-check-dot is-complete" aria-hidden="true"></span>Admin verification</dt><dd>Authenticator verified for this visit</dd></div>
          <div><dt><span class="platform-check-dot <%= it.release?.isolation_verified ? 'is-complete' : '' %>" aria-hidden="true"></span>School isolation sign-off</dt><dd><%= it.release?.isolation_verified ? 'Verified — evidence recorded' : 'Technical verification pending' %></dd><% if (it.release?.verified_at) { %><dd><time datetime="<%= it.release.verified_at %>"><%= new Date(it.release.verified_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila'}) %></time></dd><% } %></div>
        </dl>
        <div class="platform-setup-note"><p>Configure your actual service operator and monitored privacy mailbox in deployment settings. School notices and contacts are managed in each school's settings.</p><a class="platform-text-link" href="/account/security?returnTo=%2Fplatform%2Fschools">Account security <%~ icon('arrow') %></a></div>
        </details>
      </section>
    </div>
    <section data-workspace-panel class="platform-panel" id="policies" aria-labelledby="policies-title">
      <div class="platform-panel-heading"><div><p class="platform-eyebrow">Governance</p><h2 id="policies-title">School policy review</h2><p>Review the saved policy version for each school on this page.</p></div><span class="platform-count"><%= it.settings.length %> saved</span></div>
      <% if (!it.settings.length) { %><%~ include('partials/empty-state',{icon:'list',heading:'No saved school policies yet',description:'A school administrator needs to save its notices, contacts, and age policy before you can record a review.',actions:[{href:'#schools',label:'Go to school directory',secondary:true}]}) %><% } %>
      <% for (const settings of it.settings) { const school=it.schools.find(s=>s.id===settings.school_id); %><details class="platform-policy" id="policy-<%= settings.school_id %>"><summary><span><strong><%= school?.name || 'School policy' %></strong><span>Version <%= settings.version %> · <%= settings.publication_policy==='public' ? 'Public workspace' : 'Private workspace' %></span></span><span class="platform-badge <%= settings.approved_at ? 'platform-badge--active' : 'platform-badge--pending' %>"><%= settings.approved_at ? 'Reviewed' : 'Review needed' %></span></summary><div class="platform-policy-body"><dl class="platform-facts"><div><dt>Institutional contact</dt><dd><%= settings.school_contact || 'Not provided' %></dd></div><div><dt>Privacy contact</dt><dd><%= settings.privacy_contact || 'Not provided' %></dd></div><div><dt>Retention</dt><dd><%= settings.retention_days %> days</dd></div></dl><h3>Privacy notice</h3><p class="platform-preserve-text"><%= settings.privacy_notice %></p><h3>Terms</h3><p class="platform-preserve-text"><%= settings.terms_notice %></p><h3>Age policy</h3><p class="platform-preserve-text"><%= settings.age_policy %></p><form method="post" action="/platform/schools/<%= settings.school_id %>/policies"><input type="hidden" name="version" value="<%= settings.version %>" /><label for="policy-reference-<%= settings.school_id %>">Policy and agreement review reference</label><textarea id="policy-reference-<%= settings.school_id %>" name="reference" rows="3" required minlength="10" maxlength="2000" placeholder="Record the completed review and agreement reference."></textarea><button class="platform-button platform-button--primary" type="submit">Record completed review</button></form></div></details><% } %>
    </section>
    <footer class="platform-footer"><p>Super admin permissions manage the platform. Each school's access rules still apply.</p><a href="/platform/schools">Platform overview</a></footer>
  </div>
</main>
