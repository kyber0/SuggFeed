<% layout('layout') %>
<main class="sf-legal-page"><div class="sf-legal-container"><h1>Platform school review</h1><% if(it.saved) { %><p role="status">Review saved.</p><% } %><p>Verify institutional authority, contacts, applicable agreements and required policies through your approved process. Record actual review references. Pending workspace provisioning cannot open the isolation release gate.</p><h2>Pending applications</h2><% if(!it.applications.length) { %><p>No pending applications.</p><% } %>
<% for(const application of it.applications) { %><section><h3><%= application.name %> (<%= application.slug %>)</h3><p>Contact: <%= application.contact_name %> (<%= application.contact_email %>)</p><p><%= application.authority_statement %></p><form method="post" action="/platform/schools/<%= application.id %>/review"><p><label for="review-<%= application.id %>">Verification outcome and review reference</label><textarea id="review-<%= application.id %>" name="reference" required minlength="10" maxlength="2000"></textarea></p><button name="decision" value="approved">Approve pending workspace</button> <button name="decision" value="rejected">Reject application</button></form></section><% } %>
<h2>School policy review</h2><% for(const settings of it.settings) { const school=it.schools.find(s=>s.id===settings.school_id); %><section><h3><%= school?.name || settings.school_id %>: version <%= settings.version %></h3><p>Institutional contact: <%= settings.school_contact %>. Privacy contact: <%= settings.privacy_contact %>. Publication: <%= settings.publication_policy %>. Retention: <%= settings.retention_days %> days.</p><h4>Privacy notice</h4><p style="white-space:pre-wrap"><%= settings.privacy_notice %></p><h4>Terms</h4><p style="white-space:pre-wrap"><%= settings.terms_notice %></p><h4>Age policy</h4><p><%= settings.age_policy %></p><p>Review: <%= settings.approved_at?'approved':'pending' %></p><form method="post" action="/platform/schools/<%= settings.school_id %>/policies"><input type="hidden" name="version" value="<%= settings.version %>" /><p><label for="policy-<%= settings.school_id %>">Policy and agreement review reference</label><textarea id="policy-<%= settings.school_id %>" name="reference" required minlength="10" maxlength="2000"></textarea></p><button type="submit">Record completed review</button></form></section><% } %>
<h2>Activation</h2><p>Activation requires an active administrator, reviewed policies and the database isolation release gate. A locked gate cannot be overridden here.</p><ul><% for(const school of it.schools) { %><li><%= school.name %>: <%= school.status %><% if(['pending','suspended'].includes(school.status)) { %><form method="post" action="/platform/schools/<%= school.id %>/activate"><button type="submit">Request activation</button></form><% } %></li><% } %></ul><nav aria-label="School review pages"><% if(it.page>0) { %><a href="/platform/schools?page=<%= it.page-1 %>">Previous review page</a><% } %> <% if(it.nextPage) { %><a href="/platform/schools?page=<%= it.page+1 %>">Next review page</a><% } %></nav></div></main>
