<% layout('layout');const sectionLabel=it.sections.find(s=>s[0]===it.section)?.[1]||'Platform';const list=it.listing;const pageHref=page=>it.url({section:it.section,reviewType:it.reviewType,page,q:it.q,status:it.status,action:it.action,demo:it.section==='schools'?(it.includeDemo?'1':'0'):undefined}); %>
<%~ include('partials/platform-shell-start',it) %>
<header class="platform-page-header pv-page-header"><div><p class="platform-eyebrow">Platform administration</p><h1><%= sectionLabel==='Overview'?'Platform overview':sectionLabel %></h1><p><%= {overview:'See what needs attention and choose your next task.',schools:'Find a school, inspect readiness and manage platform access.',reviews:'One queue at a time. Review evidence before recording a decision.','editor-access':'Control which schools can use SuggFeed Studio.',activity:'Recorded platform actions, with their actor and timestamp.',setup:'Service requirements for onboarding and activation.'}[it.section] %></p></div><a class="platform-button" href="<%= it.currentUrl %>">Refresh</a></header>
<% if(it.section==='overview'){ %>
<% if(!it.businessReady||it.releaseUnavailable||!it.release?.isolation_verified){ %><p class="pv-notice"><strong><%= !it.businessReady?'Service setup needs attention.':it.releaseUnavailable?'Platform release status is unavailable.':'Platform isolation sign-off is pending.' %></strong> <a href="<%= it.url({section:'setup'}) %>">View requirements →</a></p><% } %><section class="pv-card pv-attention"><header><div><h2>Needs attention</h2><p>All schools, including the fictional demo.</p></div><span class="pv-meta">As of <%= new Date(it.counts?.captured_at||it.capturedAt).toLocaleTimeString('en-PH',{timeZone:'Asia/Manila',hour:'2-digit',minute:'2-digit'}) %> PHT</span></header><div><% for(const [key,label,destination] of [['applications','School applications',it.url({section:'reviews',reviewType:'applications'})],['policies','Policy versions',it.url({section:'reviews',reviewType:'policies'})],['forms','Form collection reviews',it.url({section:'reviews',reviewType:'forms'})],['pending','Schools awaiting setup',it.url({section:'schools',status:'pending'})]]){ %><a class="pv-attention-row" href="<%= destination %>"><span><%= label %></span><strong><%= it.counts?it.counts[key]:'—' %></strong><span aria-hidden="true">→</span></a><% } %></div></section>
<section data-overview-root><%~ include('partials/platform-overview',{...it,overview:it.overview,overviewDays:it.overviewDays,platformV2:true}) %></section>
<section class="pv-card"><header class="pv-section-heading"><h2>Recent platform activity</h2><a href="<%= it.url({section:'activity'}) %>">View activity →</a></header><%~ include('partials/platform-activity',{activity:it.activity?{...it.activity,items:it.activity.items.slice(0,5)}:null}) %></section><script defer src="/js/admin-overview.js?v=20261025-platform-workspace"></script>
<% }else if(it.section==='schools'||it.section==='editor-access'){ %>
<form class="pv-filters" method="get" action="/platform/schools" role="search"><input type="hidden" name="section" value="<%= it.section %>"/><% if(it.section==='schools'){ %><input type="hidden" name="demo" value="<%= it.includeDemo?1:0 %>"/><% } %><label>School name<input class="workspace-input" type="search" name="q" maxlength="100" value="<%= it.q %>" placeholder="Search schools…"/></label><% if(it.section==='schools'){ %><label>Status<select class="workspace-input" name="status"><option value="">All statuses</option><% for(const [value,label] of Object.entries(it.statuses)){ %><option value="<%= value %>" <%= it.status===value?'selected':'' %>><%= label %></option><% } %></select></label><% } %><button class="platform-button" type="submit">Search</button><% if(it.q||it.status){ %><a href="<%= it.url({section:it.section}) %>">Clear filters</a><% } %></form>
<% if(it.panelError){ %><p class="pv-notice" role="status">This list is unavailable. Refresh to retry; other sections remain available.</p><% }else if(!list?.items.length){ %><%~ include('partials/empty-state',{icon:'building',heading:it.q||it.status?'No matching schools':'No schools on this page',description:'Try a different filter or return to the first page.',actions:[{label:it.page>0?'First matching page':'Reset list',href:it.url(it.page>0?{section:it.section,q:it.q,status:it.status,demo:it.includeDemo?1:0}:{section:it.section}),secondary:true}]}) %><% }else{ %>
<% if(it.section==='schools'){ %><p class="pv-meta"><%= it.includeDemo?'All schools, including the fictional demo.':'Fictional demo excluded from this directory view.' %> <a href="<%= it.url({section:'schools',q:it.q,status:it.status,demo:it.includeDemo?0:1}) %>"><%= it.includeDemo?'Exclude demo':'Include demo' %></a></p><% } %><div class="pv-directory"><div class="pv-directory-head"><span>School</span><span>Status</span><span><%= it.section==='schools'?'Next step':'Studio access' %></span><span>Updated / recorded change</span><span></span></div><% for(const school of list.items){ %><article class="pv-directory-row"><div class="pv-school-name"><span class="pv-monogram" aria-hidden="true"><%= school.name.slice(0,1).toUpperCase() %></span><div><a href="/platform/schools/<%= school.id %>?tab=<%= it.section==='editor-access'?'access':'summary' %>&returnTo=<%= encodeURIComponent(it.currentUrl) %>"><%= school.name %></a><small>/s/<%= school.slug %></small></div></div><span class="platform-badge platform-badge--<%= school.status %>"><%= it.statuses[school.status] %></span><span><%= it.section==='editor-access'?(school.editing_enabled?'Enabled for admins':'Editing paused'):school.status==='pending'?'Inspect setup requirements':school.status==='suspended'?'Review reactivation requirements':school.status==='closed'?'Records retained':'View workspace summary' %></span><span class="pv-meta"><% if(it.section==='editor-access'){ %><%= school.changed_at?new Date(school.changed_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila'}):'No grant change recorded' %><% if(school.changed_by){ %><small><%= school.changed_by %></small><% } %><% }else{ %><%= new Date(school.updated_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila'}) %><% } %></span><a class="platform-button" href="/platform/schools/<%= school.id %>?tab=<%= it.section==='editor-access'?'access':'summary' %>&returnTo=<%= encodeURIComponent(it.currentUrl) %>">Open school</a></article><% } %></div><%~ include('partials/platform-pagination',{page:it.page,total:list.total,pageHref}) %><% } %>
<% }else if(it.section==='reviews'){ %>
<nav class="pv-tabs" aria-label="Review type"><% for(const [type,label] of it.reviewTypes){ %><a href="<%= it.url({section:'reviews',reviewType:type}) %>" <%= it.reviewType===type?'aria-current="page"':'' %>><%= label %><% if(it.counts&&['applications','policies','forms'].includes(type)){ %><span><%= it.counts[type] %></span><% } %></a><% } %></nav>
<% if(it.reviewType==='sugi'){ %><section class="pv-card"><%~ include('partials/assistant-admin-panel',{assistantEndpoint:'/platform/assistant/data'}) %></section><% }else{ %>
<form class="pv-filters" method="get" action="/platform/schools" role="search"><input type="hidden" name="section" value="reviews"/><input type="hidden" name="reviewType" value="<%= it.reviewType %>"/><label>School name<input class="workspace-input" type="search" name="q" value="<%= it.q %>" maxlength="100"/></label><button class="platform-button" type="submit">Search queue</button><% if(it.q){ %><a href="<%= it.url({section:'reviews',reviewType:it.reviewType}) %>">Clear</a><% } %></form><div class="pv-review-workspace"><section class="pv-review-list" aria-label="Pending review queue"><header><h2>Pending reviews</h2><p>Oldest first · <%= list?.total??'—' %> matching</p></header><% if(it.panelError){ %><p class="pv-notice">Queue unavailable. Refresh to retry.</p><% }else if(!list?.items.length){ %><p class="pv-list-empty">No pending reviews on this page.</p><% }else{ %><nav aria-label="Review items"><% for(const item of list.items){ %><a href="<%= it.url({section:'reviews',reviewType:it.reviewType,page:it.page,q:it.q,item:item.id}) %>" <%= it.item===item.id?'aria-current="page"':'' %>><strong><%= item.name %></strong><span><%= item.version?(it.reviewType==='forms'?'Revision ':'Version ')+item.version:'Application' %></span><span class="pv-meta"><% const waitingDays=Math.max(0,Math.floor((Date.now()-new Date(item.submitted_at).getTime())/86400000)); %><%= Number.isFinite(waitingDays)?waitingDays===0?'Submitted today':waitingDays+' day'+(waitingDays===1?'':'s')+' waiting':'Submission date unavailable' %></span><time datetime="<%= item.submitted_at %>"><%= new Date(item.submitted_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila',dateStyle:'medium'}) %></time></a><% } %></nav><% } %><% if(list){ %><%~ include('partials/platform-pagination',{page:it.page,total:list.total,pageHref}) %><% } %></section><%~ include('partials/platform-review-detail',it) %></div><% } %>
<% }else if(it.section==='activity'){ %>
<form class="pv-filters" method="get" action="/platform/schools"><input type="hidden" name="section" value="activity"/><label>Action<select class="workspace-input" name="action"><% for(const [key,label] of [['','All recorded actions'],['created','Workspace created'],['status_changed','School status'],['customization_rollout','Studio grants'],['customization_reviewed','Form reviews'],['customization_published','Published appearance']]){ %><option value="<%= key %>" <%= it.action===key?'selected':'' %>><%= label %></option><% } %></select></label><button class="platform-button" type="submit">Apply filter</button></form><section class="pv-card"><p class="pv-meta">Recorded lifecycle, Studio grant, form review and publication changes. Failed attempts are not included.</p><%~ include('partials/platform-activity',{activity:it.activity}) %></section><% if(it.activity){ %><%~ include('partials/platform-pagination',{page:it.page,total:it.activity.total,pageHref}) %><% } %>
<% }else if(it.section==='setup'){ %>
<section class="pv-card"><h2>Service readiness</h2><p>Deployment configuration is shown as status only. Secrets are managed outside this dashboard.</p><dl class="pv-readiness"><div><dt>Service operator</dt><dd><%= it.legal.operatorName||'Not configured' %></dd><small>Owner: service operator</small></div><div><dt>Monitored privacy contact</dt><dd><%= it.legal.privacyEmail||'Not configured' %></dd><small>Owner: service operator · configuration is not mailbox ownership verification</small></div><div><dt>Platform isolation release gate</dt><dd><%= it.releaseUnavailable?'Unavailable':it.release?.isolation_verified?'Evidence recorded':'Technical verification pending' %></dd><small>Owner: platform technical reviewer. This is a platform gate, not proof of every school-specific requirement.</small></div><div><dt>Account assurance</dt><dd>Authenticator verified for this visit</dd><small>Permission is checked again on protected actions.</small></div></dl><p class="pv-notice">Configure genuine operator/contact details in deployment settings. Record actual technical verification through the existing release process; this page cannot bypass it.</p></section>
<% } %>
<%~ include('partials/platform-shell-end',it) %>
