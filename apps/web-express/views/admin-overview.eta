<% layout('layout');const icon=name=>'<svg class="workspace-svg" aria-hidden="true"><use href="#ws-'+name+'"></use></svg>'; %>
<main class="staff-workspace staff-overview-page"><%~ include('partials/staff-sidebar',it) %><div class="staff-main">
<header class="workspace-heading"><div><p class="workspace-kicker">SCHOOL ADMINISTRATION</p><h1>Overview</h1><p>A clear starting point for your team’s next steps.</p></div><a class="workspace-button workspace-button--primary" href="/admin/reviews">Review ideas <span aria-hidden="true">→</span></a></header>
<section class="staff-attention" aria-labelledby="attention-title"><div class="staff-section-heading"><h2 id="attention-title">Where to focus</h2><span>Current school totals</span></div><div class="staff-attention-grid">
<a href="/admin/reviews"><span class="staff-task-icon"><%~ icon('inbox') %></span><div><strong><%= it.counts.pending %></strong><h3>Awaiting a decision</h3><p>Read new ideas and decide what proceeds.</p></div><span aria-hidden="true">↗</span></a>
<a href="/admin/board"><span class="staff-task-icon"><%~ icon('board') %></span><div><strong><%= it.counts.in_progress %></strong><h3>Work in progress</h3><p>Check delivery and publish a useful update.</p></div><span aria-hidden="true">↗</span></a>
<a href="/admin/community"><span class="staff-task-icon"><%~ icon('care') %></span><div><h3>Community follow-ups</h3><p>Respond to private questions and reports.</p></div><span aria-hidden="true">↗</span></a>
</div></section>
<section class="staff-my-work" aria-labelledby="my-work-title"><h2 id="my-work-title">Assigned to you</h2><a class="workspace-button" href="/admin/reviews?assignment=mine">My reviews</a><a class="workspace-button" href="/admin/board?assignment=mine">My delivery work</a><a class="workspace-text-link" href="/admin/board?overdue=true">Past target date →</a></section>
<%~ include('partials/admin-overview',it) %>
<section class="admin-administration" id="administration-workspace" aria-labelledby="administration-title"><div class="staff-section-heading"><div><h2 id="administration-title">Manage your school</h2><p>People, access and workspace configuration.</p></div></div><div class="admin-administration-grid">
<% for(const [href,name,description,graphic] of [['/admin/members','People & access','Members, roles and access restrictions.','users'],['/admin/student-access','Student joining','Access requests and approved email lists.','user-plus'],['/admin/invitations','Invitations','Invite members and follow acceptance.','mail'],['/admin/school-settings','School settings','Policies, contacts and verified domains.','shield'],['/admin/customization','Workspace appearance','Open your school’s visual editor.','board'],['/admin/assistant','Sugi knowledge','Publish school information and review help.','care']]) { %><a class="admin-task-card" href="<%= href %>"><%~ icon(graphic) %><span><strong><%= name %></strong><small><%= description %></small></span><%~ icon('arrow') %></a><% } %>
</div></section>
</div></main><script defer src="/js/admin-overview.js?v=20261025-staff-flow"></script>
