<% layout('layout');const icon=name=>'<svg class="workspace-svg" aria-hidden="true"><use href="#ws-'+name+'"></use></svg>'; %>
<main class="staff-workspace staff-overview-page"><%~ include('partials/staff-sidebar',it) %><div class="staff-main">
<header class="workspace-heading"><div><p class="workspace-kicker">SCHOOL ADMINISTRATION</p><h1>Overview</h1><p>A clear starting point for your team’s next steps.</p></div><a class="workspace-button workspace-button--primary" href="/admin/my-work">Open my work →</a></header>
<section class="staff-attention" aria-labelledby="attention-title"><div class="staff-section-heading"><h2 id="attention-title">Where to focus</h2><span>Current school totals</span></div><div class="staff-attention-grid">
<a href="/admin/reviews"><span class="staff-task-icon"><%~ icon('inbox') %></span><div><strong><%= it.counts.pending %></strong><h3>Awaiting a decision</h3><p>Read new ideas and decide what proceeds.</p></div><span aria-hidden="true">↗</span></a>
<a href="/admin/board"><span class="staff-task-icon"><%~ icon('board') %></span><div><strong><%= it.counts.in_progress %></strong><h3>Work in progress</h3><p>Check delivery and publish a useful update.</p></div><span aria-hidden="true">↗</span></a>
<a href="/admin/board?overdue=true"><span class="staff-task-icon"><%~ icon('clock') %></span><div><strong><%= it.portalFocus?.overdue??'—' %></strong><h3>Past target date</h3><p><%= it.portalFocus?.overdue==null?'Count unavailable — open the queue to retry.':'Approved work past its school target date.' %></p></div><span aria-hidden="true">↗</span></a>
<a href="/admin/safety"><span class="staff-task-icon"><%~ icon('shield') %></span><div><strong><%= it.portalFocus?.reports??'—' %></strong><h3>Open safety reports</h3><p><%= it.portalFocus?.reports==null?'Count unavailable — open safety review.':'Unresolved reports across submissions and comments.' %></p></div><span aria-hidden="true">↗</span></a>
</div></section>
<section class="portal-next-steps" aria-label="Team shortcuts"><a href="/admin/my-work?view=triage">Triage items without an owner →</a><a href="/admin/community?followup=needs-reply">Respond to students →</a><a href="/admin/routing">Review team capacity →</a></section>
<%~ include('partials/admin-overview',it) %>
<section class="admin-administration" id="administration-workspace" aria-labelledby="administration-title"><div class="staff-section-heading"><div><h2 id="administration-title">Manage your school</h2><p>People, access and workspace configuration.</p></div></div><div class="admin-administration-grid">
<% for(const [href,name,description,graphic] of [['/admin/members','People & access','Members, roles and access restrictions.','users'],['/admin/routing','Routing & teams','Ownership, capacity and escalation rules.','users'],['/admin/school-settings','School settings','Policies, contacts and verified domains.','shield'],['/admin/customization','Workspace appearance','Open your school’s visual editor.','board'],['/admin/assistant','Sugi knowledge','Publish school information and review help.','care']]) { %><a class="admin-task-card" href="<%= href %>"><%~ icon(graphic) %><span><strong><%= name %></strong><small><%= description %></small></span><%~ icon('arrow') %></a><% } %>
</div></section>
</div></main><script defer src="/js/admin-overview.js?v=20261025-staff-flow"></script>
