<% layout('layout') %>

<main class="sf-main error-page-container">
  <div class="error-page-code">500</div>
  <h1 class="error-page-title">Server Error</h1>
  <p class="error-page-desc">
    An unexpected error occurred while processing your request. Please try again in a few moments.
  </p>
  <a href="/" class="btn-primary error-page-btn">
    Return Home
  </a>
</main>
