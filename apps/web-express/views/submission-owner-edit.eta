<% layout('layout') %><main class="platform-shell"><header class="workspace-heading"><div><p class="platform-eyebrow">YOUR SUBMISSION</p><h1>Review your submission</h1><p>Progress: <%= it.item.status %> · Safety review: <%= it.item.safety_state==='clear'?'No review hold':'Under review' %></p></div><a class="workspace-button" href="/profile">Your activity</a></header>
<section class="care-card"><% if(!it.item.editable) { %><p>Editing is unavailable because staff review has begun, the item has progressed, or access is restricted. Your school can help with further changes.</p><h2><%= it.item.title %></h2><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= it.item.description %></p><% } else { %><form class="care-form" method="post" action="/api/safety/submissions/<%= it.item.id %>/edit" data-owner-submission="<%= it.item.id %>"><input type="hidden" name="version" value="<%= it.item.version %>"><label>Title<input class="workspace-input" name="title" minlength="10" maxlength="120" value="<%= it.item.title %>" required></label><label>Description<textarea class="workspace-input" name="description" rows="5" minlength="20" maxlength="2000" required><%= it.item.description %></textarea></label><label>Category<select class="workspace-input" name="category"><% for(const c of it.categories.filter(c=>c.active)) { %><option value="<%= c.id %>" <%= c.id===it.item.category_id?'selected':'' %>><%= c.name %></option><% } %></select></label><p>Saved text is checked again. Existing school answers and images are preserved. Editing stops when staff begin their review.</p><button type="submit" class="workspace-button">Save changes</button><p role="status" data-safety-message></p></form><% } %></section></main>
