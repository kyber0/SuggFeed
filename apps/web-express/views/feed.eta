<% layout('layout')
const feed = it.feed || [];
const sort = it.sortBy || 'all';
const category = it.category || 'All';
const search = it.search || '';
const filtered = category !== 'All' || !!search;
const total = it.totalCount ?? feed.length;
const popular = ['popular', 'top'].includes(sort);
const slug = value => String(value).toLowerCase().replace(/[^a-z0-9]+/g, '-');
const feedUrl = (changes = {}) => {
  const values = { sort, category, search, ...changes };
  const params = new URLSearchParams();
  if (values.sort !== 'all') params.set('sort', values.sort);
  if (values.category !== 'All') params.set('category', values.category);
  if (values.search) params.set('search', values.search);
  if (values.page) params.set('page', String(values.page));
  return '/feed' + (params.size ? '?' + params.toString() : '');
};
%>
<div class="community-page-wrapper">
  <aside class="community-left-nav" aria-label="Community navigation">
    <div class="left-nav-inner">
      <div class="nav-brand-title"><span>YOUR CAMPUS, TOGETHER</span></div>
      <nav class="left-nav-menu" aria-label="Explore">
        <a href="/" class="nav-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 10 9-7 9 7v11H3zM9 21v-8h6v8"/></svg>Home</a>
        <a href="/feed" class="nav-item active" aria-current="page"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-list"/></svg>Community ideas</a>
        <a href="/roadmap" class="nav-item"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-board"/></svg>Roadmap</a>
        <a href="/profile" class="nav-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>My profile</a>
      </nav>
      <div class="left-nav-divider"></div>
      <h2 class="nav-section-header">BROWSE TOPICS</h2>
      <div class="left-topic-list" id="left-topics">
        <% for (const cat of ['All', ...(it.categories || [])]) { %>
          <button type="button" class="topic-item-btn<%= category === cat ? ' selected' : '' %>" data-feed-category="<%= cat %>" aria-pressed="<%= category === cat %>" data-sf-click="action-28" data-sf-click-arg-0="<%= cat %>"><span class="topic-dot topic-dot--<%= slug(cat) %>" aria-hidden="true"></span><%= cat === 'All' ? 'All topics' : cat %></button>
        <% } %>
      </div>
      <p class="feed-sidebar-note">Small ideas. Shared progress.<br>Your perspective matters here.</p>
    </div>
  </aside>

  <main class="community-feed-main" aria-labelledby="feed-heading">
    <header class="community-feed-header">
      <div class="feed-title-bar">
        <div class="feed-heading-group">
          <p class="feed-eyebrow">THE COMMUNITY BOARD</p>
          <h1 class="feed-heading" id="feed-heading">Community ideas</h1>
        </div>
        <div class="feed-title-actions"><button type="button" class="feed-create-button" data-sf-click="action-49" aria-label="Share an idea" title="Share an idea"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>Share an idea</span></button></div>
      </div>
      <p class="feed-subheading">Explore suggestions, join the discussion, and support the changes that matter to you.</p>
      <form id="feed-search-form" class="feed-search-box" action="/feed" method="get" role="search" aria-label="Search community ideas">
        <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-search"/></svg>
        <input type="hidden" name="sort" value="<%= sort %>"/>
        <input type="hidden" name="category" value="<%= category %>"/>
        <input type="search" name="search" id="feed-search" class="feed-search-input" maxlength="120" placeholder="Search ideas…" value="<%= search %>" aria-label="Search titles and descriptions" autocomplete="off"/>
        <button type="button" class="feed-search-clear-btn" id="feed-search-clear" data-sf-click="action-31" aria-label="Clear search" <%= search ? '' : 'hidden' %>>×</button>
        <button type="submit" class="feed-search-submit">Search</button>
      </form>
      <div class="sort-modes-bar">
        <div class="sort-tabs-group" role="group" aria-label="Sort ideas">
          <button type="button" class="sort-tab<%= !popular ? ' active' : '' %>" data-feed-sort="all" aria-pressed="<%= !popular %>" data-sf-click="action-32">Latest</button>
          <button type="button" class="sort-tab<%= popular ? ' active' : '' %>" data-feed-sort="popular" aria-pressed="<%= popular %>" data-sf-click="action-33">Most supported</button>
        </div>
        <button type="button" class="btn-refresh-stream" data-sf-click="action-35" aria-label="Refresh ideas" title="Refresh ideas"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-refresh"/></svg></button>
      </div>
      <div class="topic-chips-carousel" id="topic-chips-panel" role="group" aria-label="Filter ideas by topic">
        <% for (const cat of ['All', ...(it.categories || [])]) { %>
          <button type="button" class="topic-chip<%= category === cat ? ' active' : '' %>" data-feed-category="<%= cat %>" aria-pressed="<%= category === cat %>" data-sf-click="action-37" data-sf-click-arg-0="<%= cat %>"><span class="chip-dot chip-dot--<%= slug(cat) %>" aria-hidden="true"></span><%= cat === 'All' ? 'All topics' : cat %></button>
        <% } %>
      </div>
      <% if (filtered) { %>
        <div class="feed-applied-filters" aria-label="Applied filters">
          <% if (search) { %><a class="feed-filter-chip" href="<%= feedUrl({search: ''}) %>" aria-label="Remove search filter">“<%= search %>” <span aria-hidden="true">×</span></a><% } %>
          <% if (category !== 'All') { %><a class="feed-filter-chip" href="<%= feedUrl({category: 'All'}) %>" aria-label="Remove topic filter"><%= category %> <span aria-hidden="true">×</span></a><% } %>
          <a href="<%= feedUrl({search: '', category: 'All'}) %>">Clear filters</a>
        </div>
      <% } %>
      <div class="feed-results-bar">
        <p id="feed-result-summary" data-total="<%= total %>">Showing <%= feed.length %> of <%= total %> <%= filtered ? 'matching ' : '' %>idea<%= total === 1 ? '' : 's' %></p>
        <span class="feed-sort-note"><%= popular ? 'Most supported first' : sort === 'oldest' ? 'Oldest first' : 'Newest first' %></span>
      </div>
    </header>

    <div class="post-cards-stream">
      <div id="feed-posts-container" class="feed-posts-list">
        <% for (const item of feed) { %><%~ include('partials/feed-card', {item}) %><% } %>
      </div>
      <% if (!feed.length) { %>
        <section class="feed-empty-state">
          <span class="feed-empty-icon" aria-hidden="true"><svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><use href="#ws-search"/></svg></span>
          <h2><%= filtered ? 'No ideas match your search' : 'The next great idea could be yours' %></h2>
          <p><%= filtered ? 'Try a shorter phrase or another topic. You can also clear your filters to explore all ideas.' : 'Published ideas will appear here after review. Share a constructive suggestion to get the conversation started.' %></p>
          <div class="feed-empty-actions">
            <% if (filtered) { %><a class="btn-clear-filters" href="<%= feedUrl({search: '', category: 'All'}) %>">Explore all ideas</a><% } else { %><button type="button" class="btn-empty-create" data-sf-click="action-49">Share an idea</button><% } %>
          </div>
        </section>
      <% } %>
      <button type="button" id="feed-loader" class="feed-loader-container" data-sf-click="action-48" <%= it.hasMore ? '' : 'hidden' %>>
        <span class="feed-loading-spinner" aria-hidden="true"><span class="spinner-dot"></span><span class="spinner-dot"></span><span class="spinner-dot"></span></span>
        <span class="feed-loading-text">Load more ideas</span>
      </button>
      <p id="feed-load-status" class="feed-load-status" role="status" aria-live="polite"></p>
      <p id="feed-end-message" class="feed-end-notice" <%= it.hasMore || !feed.length ? 'hidden' : '' %>><span class="end-icon-badge" aria-hidden="true">✓</span>You’re all caught up<%= filtered ? ' with these results' : '' %>.</p>
      <noscript><nav class="feed-pagination" aria-label="Feed pages">
        <% if (it.page > 1) { %><a href="<%= feedUrl({page: it.page - 1}) %>">Previous page</a><% } %>
        <% if (it.hasMore) { %><a href="<%= feedUrl({page: (it.page || 1) + 1}) %>">Next page</a><% } %>
      </nav></noscript>
    </div>
  </main>

  <aside class="community-right-panel" aria-label="Community resources">
    <div class="trending-sidebar-content">
      <section class="feed-side-panel feed-roadmap-promo">
        <h2 class="feed-side-heading"><svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-board"/></svg>From ideas to action</h2>
        <p>See what’s planned, what’s in progress, and what your school has completed.</p>
        <a href="/roadmap">Explore the roadmap <span aria-hidden="true">→</span></a>
      </section>
      <% if (feed.length) { %>
        <section class="feed-side-panel">
          <h2 class="feed-side-heading">Most supported on this page</h2>
          <div class="top-posts-list">
            <% for (const [index, item] of [...feed].sort((a,b) => (b.vote_count || 0) - (a.vote_count || 0)).slice(0,3).entries()) { %>
              <a class="top-post-item" href="/idea/<%= encodeURIComponent(item.id) %>" data-sf-click="open-detail" data-idea-id="<%= item.id %>">
                <span class="top-post-rank" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                <div><span class="top-post-title"><%= item.title %></span><p><%= item.vote_count || 0 %> supporters</p></div>
              </a>
            <% } %>
          </div>
        </section>
      <% } %>
      <section class="feed-side-panel">
        <h2 class="feed-side-heading">Make your voice count</h2>
        <ol class="feed-how-list">
          <li><strong>Start with an idea</strong>Describe the issue and a change that would help.</li>
          <li><strong>Build on each other</strong>Support useful ideas and add respectful comments.</li>
          <li><strong>Follow the progress</strong>Check the roadmap for school responses and updates.</li>
        </ol>
      </section>
      <div class="feed-side-links"><a href="/privacy">Privacy policy</a><span>Be kind. Keep personal details private.</span></div>
    </div>
  </aside>
</div>
<div id="sf-feed-config" hidden data-sort="<%= sort %>" data-category="<%= category %>" data-search="<%= search %>" data-total="<%= total %>" data-page="<%= it.page || 1 %>" data-has-more="<%= it.hasMore ? 'true' : 'false' %>"></div>
<script src="/js/feed.js?v=20261011-feed"></script>
