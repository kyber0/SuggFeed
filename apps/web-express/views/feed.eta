<% layout('layout') %>

<div class="community-page-wrapper">

  <!-- ── Desktop Left Sidebar Navigation ── -->
  <aside class="community-left-nav" aria-label="Community navigation">
    <div class="left-nav-inner">
      <div class="nav-brand-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="nav-brand-icon"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        <span>Community Hub</span>
      </div>

      <nav class="left-nav-menu">
        <a href="/" class="nav-item">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Home</span>
        </a>
        <a href="/feed" class="nav-item active">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Ideas Stream</span>
          <span class="nav-pill-badge"><%= it.totalCount || (it.feed ? it.feed.length : 0) %></span>
        </a>
        <a href="/roadmap" class="nav-item">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
          <span>Roadmap</span>
        </a>
        <a href="/profile" class="nav-item">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>My Profile</span>
        </a>
      </nav>

      <div class="left-nav-divider"></div>

      <div class="nav-section-header">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="6" height="18"/><rect x="9" y="8" width="6" height="13"/><rect x="16" y="5" width="6" height="16"/></svg>
        <span>TOPICS</span>
      </div>
      <div class="left-topic-list" id="left-topics">
        <button type="button" class="topic-item-btn<%= (!it.category || it.category === 'All') ? ' selected' : '' %>" data-sf-click="action-27">
          <span class="topic-dot topic-dot--all"></span>
          <span>All Topics</span>
        </button>
        <% for (const cat of it.categories) { %>
          <button type="button" class="topic-item-btn<%= it.category === cat ? ' selected' : '' %>" data-sf-click="action-28" data-sf-click-arg-0="<%= cat %>">
            <span class="topic-dot topic-dot--<%= cat.toLowerCase().replace(/\s+/g,'-') %>"></span>
            <span><%= cat %></span>
          </button>
        <% } %>
      </div>

      <div class="left-nav-spacer"></div>

      <!-- Submit CTA -->
      <button type="button" class="btn-submit-sidebar" data-sf-click="action-29" aria-label="Share your idea">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Share an Idea</span>
      </button>
    </div>
  </aside>

  <!-- ── Main Feed Center Column ── -->
  <main class="community-feed-main" role="feed" aria-label="Community ideas feed">

    <!-- Sticky Header -->
    <div class="community-feed-header">
      <div class="feed-title-bar">
        <div class="feed-heading-group">
          <div class="feed-heading-row">
            <h1 class="feed-heading">Community Ideas</h1>
            <span class="feed-count-pill"><%= (it.totalCount || (it.feed ? it.feed.length : 0)) %> ideas</span>
          </div>
          <p class="feed-subheading">Student proposals, campus discussions &amp; feedback shaping our university.</p>
        </div>
        <!-- Mobile Filter Toggle -->
        <button type="button" class="btn-mobile-filter-toggle" id="mobile-filter-btn" aria-label="Filter topics and sort">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          <span>Filters</span>
        </button>
      </div>

      <!-- Search Box with Shortcut & Clear button -->
      <div class="feed-search-box">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="text"
          class="feed-search-input"
          id="feed-search"
          placeholder="Search ideas by title, keyword, or #topic…"
          value="<%= it.search ?? '' %>"
          aria-label="Search ideas"
          data-sf-input="action-30"
        />
        <span class="feed-search-kbd-hint" id="search-kbd-hint" title="Press / to search"><kbd>/</kbd></span>
        <button type="button" class="feed-search-clear-btn" id="feed-search-clear" data-sf-click="action-31" aria-label="Clear search" style="<%= (it.search && it.search.trim()) ? '' : 'display: none;' %>">✕</button>
      </div>

      <!-- Sort Modes Bar -->
      <div class="sort-modes-bar">
        <div class="sort-tabs-group" role="tablist" aria-label="Sort modes">
          <button type="button" role="tab" aria-selected="<%= it.sortBy === 'latest' || it.sortBy === 'all' || !it.sortBy ? 'true' : 'false' %>" class="sort-tab<%= it.sortBy === 'latest' || it.sortBy === 'all' || !it.sortBy ? ' active' : '' %>" data-sf-click="action-32">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>All Ideas</span>
          </button>
          <button type="button" role="tab" aria-selected="<%= it.sortBy === 'popular' ? 'true' : 'false' %>" class="sort-tab<%= it.sortBy === 'popular' ? ' active' : '' %>" data-sf-click="action-33">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            <span>Top Support</span>
          </button>
          <button type="button" role="tab" aria-selected="<%= (it.category && it.category !== 'All') ? 'true' : 'false' %>" id="topics-sort-tab" class="sort-tab<%= (it.category && it.category !== 'All') ? ' active' : '' %>" data-sf-click="action-34">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span id="topics-tab-label"><%= (it.category && it.category !== 'All') ? it.category : 'Topics' %></span>
          </button>
        </div>
        <button type="button" class="btn-refresh-stream" data-sf-click="action-35" title="Refresh feed" aria-label="Refresh feed">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        </button>
      </div>

      <!-- Topic Filter Chips (shown when 'Topics' active or category selected) -->
      <div class="topic-chips-carousel" id="topic-chips-panel" role="group" aria-label="Filter by category" <%= (!it.category || it.category === 'All') ? 'hidden' : '' %>>
        <button type="button" class="topic-chip<%= (!it.category || it.category === 'All') ? ' active' : '' %>" data-sf-click="action-36">
          <span class="chip-dot chip-dot--all"></span>
          <span>All</span>
        </button>
        <% for (const cat of it.categories) { %>
          <button type="button" class="topic-chip<%= it.category === cat ? ' active' : '' %>" data-sf-click="action-37" data-sf-click-arg-0="<%= cat %>">
            <span class="chip-dot chip-dot--<%= cat.toLowerCase().replace(/\s+/g,'-') %>"></span>
            <span><%= cat %></span>
          </button>
        <% } %>
      </div>
    </div>

    <!-- Post Cards Stream -->
    <div class="post-cards-stream" id="post-stream">
      <% if (!it.feed || it.feed.length === 0) { %>
        <div class="feed-empty-state">
          <div class="feed-empty-icon-wrap" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="10" stroke-dasharray="3 3"/><path d="M12 8v4M12 16h.01"/></svg>
          </div>
          <h3>No proposals found</h3>
          <p>No ideas match your current topic or search query. Try clearing your filters or be the first to share one!</p>
          <div class="feed-empty-actions">
            <a href="/feed" class="btn-clear-filters">Clear all filters</a>
            <button type="button" class="btn-empty-create" data-sf-click="action-38">Share an idea</button>
          </div>
        </div>
      <% } else { %>
        <div id="feed-posts-container" class="feed-posts-list">
        <% for (const item of it.feed) { %>
          <%
            const catName = item.category ?? (item.categories?.name ?? 'Other');
            const catColors = {
              Facilities:    { bg: 'rgba(59,130,246,0.12)', text: '#2563EB', border: 'rgba(59,130,246,0.25)', dot: '#3B82F6' },
              Learning:      { bg: 'rgba(16,185,129,0.12)', text: '#059669', border: 'rgba(16,185,129,0.25)', dot: '#10B981' },
              Safety:        { bg: 'rgba(239,68,68,0.12)',  text: '#DC2626', border: 'rgba(239,68,68,0.25)', dot: '#EF4444' },
              'Student life':{ bg: 'rgba(245,158,11,0.12)', text: '#D97706', border: 'rgba(245,158,11,0.25)', dot: '#F59E0B' },
              Other:         { bg: 'rgba(100,116,139,0.12)', text: '#64748B', border: 'rgba(100,116,139,0.25)', dot: '#94A3B8' }
            };
            const cat = catColors[catName] || catColors.Other;
            const statusConfig = {
              pending:     { color: '#F59E0B', label: 'Pending Review', dot: '#F59E0B' },
              approved:    { color: '#10B981', label: 'Approved', dot: '#10B981' },
              in_progress: { color: '#3B82F6', label: 'In Progress', dot: '#3B82F6' },
              resolved:    { color: '#0D9488', label: 'Resolved', dot: '#0D9488' }
            };
            const statusInfo = statusConfig[item.status] || statusConfig.pending;
            const isAnon = !item.author?.display_name;
            const authorName = isAnon ? 'Anonymous' : item.author.display_name;
            const authorHandle = isAnon ? '@anon' : '@' + item.author.display_name.toLowerCase().replace(/\s+/g,'');
            const voteCount = item.vote_count ?? 0;
            const commentCount = item.comment_count ?? 0;
            const timeStr = (() => {
              const d = new Date(item.created_at);
              const now = new Date();
              const diff = Math.floor((now - d) / 1000);
              if (diff < 60) return 'just now';
              if (diff < 3600) return Math.floor(diff/60) + 'm';
              if (diff < 86400) return Math.floor(diff/3600) + 'h';
              if (diff < 604800) return Math.floor(diff/86400) + 'd';
              return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
            })();
          %>
          <article
            class="post-card"
            data-idea-id="<%= item.id %>"
            data-sf-click="action-39" data-sf-click-arg-0="<%= item.id %>"
            role="article"
            aria-label="Proposal: <%= item.title %>"
            tabindex="0"
            data-sf-keydown="action-40" data-sf-keydown-arg-0="<%= item.id %>"
          >
            <!-- Post Header -->
            <div class="post-header">
              <div class="post-avatar" style="background:<%= isAnon ? 'linear-gradient(135deg,#64748B 0%,#475569 100%)' : 'linear-gradient(135deg,#0B3857 0%,#2563EB 100%)' %>">
                <%= isAnon ? '?' : authorName[0].toUpperCase() %>
              </div>
              <div class="post-author-meta">
                <div class="post-author-row">
                  <span class="post-author-name"><%= authorName %></span>
                  <span class="post-author-handle"><%= authorHandle %></span>
                  <span class="post-dot">&middot;</span>
                  <time class="post-timestamp" title="<%= new Date(item.created_at).toLocaleString() %>"><%= timeStr %></time>
                  <% if (voteCount >= 50) { %>
                    <span class="post-trending-badge" title="High campus engagement">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                      Trending
                    </span>
                  <% } %>
                </div>
                <div class="post-badges-row">
                  <span class="post-badge-category cat-<%= catName.toLowerCase().replace(/\s+/g,'-') %>" style="background-color:<%= cat.bg %>;color:<%= cat.text %>;border-color:<%= cat.border %>">
                    <span class="badge-dot" style="background-color:<%= cat.dot %>"></span>
                    <%= catName %>
                  </span>
                  <span class="post-badge-status status-<%= item.status %>" style="background-color:<%= statusInfo.color %>15;color:<%= statusInfo.color %>;border-color:<%= statusInfo.color %>35">
                    <span class="badge-dot" style="background-color:<%= statusInfo.dot %>"></span>
                    <%= statusInfo.label %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Post Content -->
            <div class="post-content">
              <h3 class="post-title"><%= item.title %></h3>
              <p class="post-body"><%= item.description %></p>
            </div>

            <!-- Attachments -->
            <% if (item.attachments && item.attachments.length > 0) { %>
              <div class="post-media-container" data-sf-click="action-41">
                <div class="post-attachment-pill" data-sf-click="action-42" data-sf-click-arg-0="<%= item.id %>">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                  <span><%= item.attachments.length %> attachment<%= item.attachments.length > 1 ? 's' : '' %></span>
                  <span class="attachment-cta">View files →</span>
                </div>
              </div>
            <% } %>

            <!-- Action Footer -->
            <div class="post-footer" data-sf-click="action-43">
              <!-- Heart/Like -->
              <button type="button" class="action-btn action-like" data-id="<%= item.id %>" data-sf-click="action-44" data-sf-click-arg-0="<%= item.id %>" aria-label="Support proposal" title="Support this proposal">
                <svg class="heart-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <span class="action-count"><%= voteCount %></span>
                <span class="action-label">Support</span>
              </button>

              <!-- Comment -->
              <button type="button" class="action-btn action-comment" data-sf-click="action-45" data-sf-click-arg-0="<%= item.id %>" aria-label="View <%= commentCount %> comments" title="Open discussion">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span class="action-count"><%= commentCount %></span>
                <span class="action-label">Comments</span>
              </button>

              <!-- Save/Bookmark -->
              <button type="button" class="action-btn action-bookmark" data-id="<%= item.id %>" data-sf-click="action-46" data-sf-click-arg-0="<%= item.id %>" aria-label="Bookmark proposal" title="Save to bookmarks">
                <svg class="bookmark-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                <span class="action-label">Save</span>
              </button>

              <!-- Share -->
              <button type="button" class="action-btn action-share" data-sf-click="action-47" data-sf-click-arg-0="<%= item.id %>" aria-label="Share proposal" title="Copy shareable link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <span class="action-label">Share</span>
              </button>
            </div>
          </article>
        <% } %>
        </div>

        <!-- Lazy loading sentinel & indicator -->
        <button type="button" id="feed-loader" class="feed-loader-container" data-sf-click="action-48" style="<%= it.hasMore ? '' : 'display: none;' %>" aria-label="Load more community ideas">
          <span class="feed-loading-spinner" aria-hidden="true">
            <span class="spinner-dot"></span>
            <span class="spinner-dot"></span>
            <span class="spinner-dot"></span>
          </span>
          <span class="feed-loading-text" aria-live="polite">Load more ideas</span>
        </button>

        <!-- End of feed -->
        <div id="feed-end-message" class="feed-end-notice" style="<%= !it.hasMore && it.feed.length > 0 ? '' : 'display: none;' %>">
          <div class="end-icon-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <span>You're all caught up! You've reviewed all proposals in this stream.</span>
        </div>
      <% } %>
    </div>
  </main>

  <!-- ── Desktop Right Panel ── -->
  <aside class="community-right-panel" aria-label="Community highlights">
    <div class="right-panel-inner">
      <!-- Campus Pulse Card -->
      <div class="pulse-card">
        <div class="pulse-header">
          <div class="pulse-title-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="pulse-icon"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            <h3>Campus Pulse</h3>
          </div>
          <span class="pulse-context-label">Community overview</span>
        </div>
        <div class="pulse-metrics-grid">
          <div class="pulse-metric">
            <span class="metric-number"><%= (it.feed || []).length %></span>
            <span class="metric-label">Ideas in this view</span>
          </div>
          <div class="pulse-metric">
            <span class="metric-number"><%= (it.totalCount || 0).toLocaleString() %></span>
            <span class="metric-label">Ideas in community</span>
          </div>
        </div>
        <p class="pulse-summary">Search by topic or keyword, then open an idea to read its discussion.</p>
      </div>

      <!-- Top Ideas Widget -->
      <% if (it.feed && it.feed.length > 0) { %>
        <div class="top-ideas-card">
          <div class="top-ideas-header">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="top-ideas-icon"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            <h4>Top Ideas in This View</h4>
          </div>
          <div class="top-ideas-list">
            <% const topIdeas = [...it.feed].sort((a,b) => (b.vote_count||0) - (a.vote_count||0)).slice(0,3); %>
            <% for (let i = 0; i < topIdeas.length; i++) { const idea = topIdeas[i]; %>
              <a href="/idea/<%= idea.id %>" class="top-idea-row" title="<%= idea.title %>">
                <span class="top-idea-rank rank-<%= i+1 %>">#<%= i+1 %></span>
                <span class="top-idea-title"><%= idea.title %></span>
                <span class="top-idea-votes">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <%= idea.vote_count ?? 0 %>
                </span>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Community Rules -->
      <div class="guidelines-card">
        <div class="guidelines-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shield-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <h3>Community Rules</h3>
        </div>
        <ul class="guidelines-list">
          <li><strong>Be constructive:</strong> Focus on realistic improvements.</li>
          <li><strong>Anonymous option:</strong> You can choose not to attach your account to a submission. Read the <a href="/privacy">privacy notice</a> for details.</li>
          <li><strong>Public feed:</strong> Submissions are reviewed before they appear in the community feed.</li>
        </ul>
        <a href="/admin" class="guidelines-admin-link">
          <span>Staff Moderation Portal</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>

      <!-- Trending Tags -->
      <div class="trending-tags-card">
        <h4>Browse Topics</h4>
        <div class="trending-tags-wrap">
          <% for (const cat of it.categories) { %>
            <a href="/feed?category=<%= cat %>" class="tag-pill">#<%= cat.toLowerCase().replace(/\s+/g,'') %></a>
          <% } %>
        </div>
      </div>

      <!-- Footer -->
      <div class="right-panel-footer">
        <span>SuggFeed Campus Platform</span>
        <span>•</span>
        <a href="/roadmap">Roadmap</a>
        <span>•</span>
        <a href="/admin">Staff</a>
      </div>
    </div>
  </aside>
</div>

<!-- Mobile FAB -->
<button type="button" class="mobile-fab-btn" data-sf-click="action-49" aria-label="Share new idea" title="Share your idea">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
</button>

<!-- Mobile Filter Sheet -->
<div id="mobile-filter-backdrop" class="mobile-filter-backdrop" hidden data-sf-click="action-50" role="dialog" aria-modal="true" aria-label="Filter ideas">
  <div class="mobile-filter-sheet" data-sf-click="action-51">
    <div class="sheet-drag-handle"></div>
    <div class="sheet-header">
      <h3>Filter &amp; Sort Ideas</h3>
      <button type="button" class="btn-icon-subtle" data-sf-click="action-52" aria-label="Close filters">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="sheet-section">
      <label>SORT MODE</label>
      <div class="sheet-pills">
        <button type="button" class="sheet-pill<%= it.sortBy === 'latest' || it.sortBy === 'all' || !it.sortBy ? ' active' : '' %>" data-sf-click="action-53">All Ideas</button>
        <button type="button" class="sheet-pill<%= it.sortBy === 'popular' ? ' active' : '' %>" data-sf-click="action-54">Top Support</button>
      </div>
    </div>
    <div class="sheet-section">
      <label>TOPICS</label>
      <div class="sheet-pills">
        <button type="button" class="sheet-pill<%= (!it.category || it.category === 'All') ? ' active' : '' %>" data-sf-click="action-55">All</button>
        <% for (const cat of it.categories) { %>
          <button type="button" class="sheet-pill<%= it.category === cat ? ' active' : '' %>" data-sf-click="action-56" data-sf-click-arg-0="<%= cat %>"><%= cat %></button>
        <% } %>
      </div>
    </div>
    <button type="button" class="btn-apply-sheet" data-sf-click="action-57">Apply Filters</button>
  </div>
</div>

<div id="sf-feed-config" hidden data-sort="<%= it.sortBy || 'all' %>" data-category="<%= it.category || 'All' %>" data-page="<%= it.page || 1 %>" data-has-more="<%= it.hasMore ? 'true' : 'false' %>"></div>
<script src="/js/feed.js?v=20261010-ts"></script>
