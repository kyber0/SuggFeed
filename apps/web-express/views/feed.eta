<% layout('layout')
const feed = it.feed || [];
const sort = it.sortBy || 'all';
const category = it.category || 'All';
const search = it.search || '';
const filtered = category !== 'All' || !!search;
const total = typeof it.totalCount==='number'?it.totalCount:null;
const popular = ['popular', 'top'].includes(sort);
const slug = value => String(value).toLowerCase().replace(/[^a-z0-9]+/g, '-');
const feedUrl = (changes = {}) => {
  const values = { sort, category, search, ...changes };
  const params = new URLSearchParams();
  if (values.sort !== 'all') params.set('sort', values.sort);
  if (values.category !== 'All') params.set('category', values.category);
  if (values.search) params.set('search', values.search);
  if (it.following) params.set('scope','following');
  if (values.page) params.set('page', String(values.page));
  return '/feed' + (params.size ? '?' + params.toString() : '');
};
%>
<div class="community-page-wrapper ideas-workspace">
  <aside data-sf-native-scroll tabindex="0" class="community-left-nav" aria-label="Community navigation">
    <div class="left-nav-inner">
      <div class="nav-brand-title"><span>YOUR CAMPUS, TOGETHER</span></div>
      <h2 class="nav-section-header">BROWSE TOPICS</h2>
      <div class="left-topic-list" id="left-topics">
        <% for (const cat of ['All', ...(it.categories || [])]) { const catValue=cat==='All'?'All':it.schoolCategories?.find(c=>c.name===cat)?.id || cat; %>
          <button type="button" class="topic-item-btn<%= category === catValue ? ' selected' : '' %>" data-feed-category="<%= catValue %>" aria-pressed="<%= category === catValue %>" data-sf-click="action-28" data-sf-click-arg-0="<%= catValue %>"><span class="topic-dot topic-dot--<%= slug(cat) %>" aria-hidden="true"></span><%= cat === 'All' ? 'All topics' : cat %></button>
        <% } %>
      </div>
      <% if(it.schoolCustomization?.features.roadmap!==false){ %><section class="feed-roadmap-promo ideas-rail-progress"><a href="/roadmap"><svg class="workspace-svg" aria-hidden="true"><use href="#ws-board"/></svg><span>Follow school progress →</span></a></section><% } %>
      <details class="feed-guidance-panel ideas-rail-guide"><summary>A constructive community</summary><p>Build on ideas respectfully. Keep personal details private.</p><a href="/profile/help">Help &amp; support →</a></details>
    </div>
  </aside>

  <main data-sf-native-scroll tabindex="0" class="community-feed-main" aria-labelledby="feed-heading">
    <header class="community-feed-header">
      <%~ include('partials/idea-navigation',it) %>
      <div class="feed-title-bar">
        <div class="feed-heading-group">
          <p class="feed-eyebrow">THE COMMUNITY BOARD</p>
          <h1 class="feed-heading" id="feed-heading"><%= it.following ? 'Ideas you follow' : 'Community ideas' %></h1>
        </div>
        <div class="feed-title-actions"><button type="button" class="feed-create-button" data-sf-click="action-49" aria-label="Share an idea" title="Share an idea"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>Share an idea</span></button></div>
      </div>
      <p class="feed-subheading">Explore suggestions and support improvements that matter to your school.</p>
      <form id="feed-search-form" class="feed-search-box" action="/feed" method="get" role="search" aria-label="Search community ideas">
        <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-search"/></svg>
        <input type="hidden" name="sort" value="<%= sort %>"/>
        <input type="hidden" name="category" value="<%= category %>"/>
        <% if(it.following) { %><input type="hidden" name="scope" value="following"/><% } %>
        <input type="search" name="search" id="feed-search" class="feed-search-input" maxlength="120" placeholder="Search ideas…" value="<%= search %>" aria-label="Search titles and descriptions" autocomplete="off"/>
        <button type="button" class="feed-search-clear-btn" id="feed-search-clear" data-sf-click="action-31" aria-label="Clear search" <%= search ? '' : 'hidden' %>>×</button>
        <button type="submit" class="feed-search-submit">Search</button>
      </form>
      <div class="sort-modes-bar"><button type="button" class="feed-filter-toggle" data-feed-filters-open aria-haspopup="dialog" aria-controls="feed-filter-dialog">Filters<%= category!=='All'?' · 1':'' %></button>
        <div class="sort-tabs-group" role="group" aria-label="Sort ideas">
          <button type="button" class="sort-tab<%= !popular ? ' active' : '' %>" data-feed-sort="all" aria-pressed="<%= !popular %>" data-sf-click="action-32">Latest</button>
          <button type="button" class="sort-tab<%= popular ? ' active' : '' %>" data-feed-sort="popular" aria-pressed="<%= popular %>" data-sf-click="action-33">Most supported</button>
        </div>
        <label class="feed-mobile-sort"><span class="sr-only">Sort ideas</span><select data-feed-sort-select><option value="all" <%= !popular?'selected':'' %>>Latest</option><option value="popular" <%= popular?'selected':'' %>>Most supported</option></select></label>
        <button type="button" class="feed-saved-toggle" data-feed-saved-open aria-haspopup="dialog" aria-controls="saved-search-dialog" title="Saved views" aria-label="Open saved views"><svg class="workspace-svg" aria-hidden="true"><use href="#ws-bookmark"/></svg><span>Saved views</span></button>
        <button type="button" class="btn-refresh-stream" data-sf-click="action-35" aria-label="Refresh ideas" title="Refresh ideas"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><use href="#ws-refresh"/></svg></button>
      </div>
      <noscript><p class="feed-mobile-native-topics">Topics: <% for(const cat of ['All',...(it.categories||[])]){const value=cat==='All'?'All':it.schoolCategories?.find(c=>c.name===cat)?.id||cat; %><a href="<%= feedUrl({category:value}) %>"><%= cat==='All'?'All topics':cat %></a> <% } %></p></noscript>
      <% if (filtered) { %>
        <div class="feed-applied-filters" aria-label="Applied filters">
          <% if (search) { %><a class="feed-filter-chip" href="<%= feedUrl({search: ''}) %>" aria-label="Remove search filter">“<%= search %>” <span aria-hidden="true">×</span></a><% } %>
          <% if (category !== 'All') { %><a class="feed-filter-chip" href="<%= feedUrl({category: 'All'}) %>" aria-label="Remove topic filter"><%= it.schoolCustomization?.categories.find(c=>c.id===category)?.name || category %> <span aria-hidden="true">×</span></a><% } %>
          <a href="<%= feedUrl({search: '', category: 'All'}) %>">Clear filters</a>
        </div>
      <% } %>
      <div class="feed-results-bar">
        <p id="feed-result-summary" data-total="<%= total ?? '' %>">Showing <%= feed.length %><% if(total!==null){ %> of <%= total %><% } %> <%= filtered ? 'matching ' : '' %>idea<%= (total ?? feed.length) === 1 ? '' : 's' %></p>
        <span class="feed-sort-note"><%= popular ? 'Most supported first' : sort === 'oldest' ? 'Oldest first' : 'Newest first' %></span>
      </div>
    </header>



    <div class="post-cards-stream">
      <div id="feed-posts-container" class="feed-posts-list">
        <% for (const item of feed) { %><%~ include('partials/feed-card', {...it,item}) %><% } %>
      </div>
      <% if (!feed.length) { %>
        <section class="feed-empty-state">
          <span class="feed-empty-icon" aria-hidden="true"><svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><use href="#ws-search"/></svg></span>
          <h2><%= it.page>1 ? 'No more ideas on this page' : filtered ? 'No ideas match your search' : it.following ? 'Your following feed is waiting' : 'The next great idea could be yours' %></h2>
          <p><%= it.page>1 ? 'The list may have changed since your last visit. Return to the first page to see the latest results.' : filtered ? 'Try a shorter phrase or another topic. You can also clear your filters to explore all ideas.' : it.following ? 'Choose Follow on a roadmap idea to keep it here. School updates and unread changes are in School updates.' : 'Published ideas will appear here after review. Share a constructive suggestion to get the conversation started.' %></p>
          <div class="feed-empty-actions"><% if(it.page>1) { %><a class="btn-clear-filters" href="<%= feedUrl({page:1}) %>">Back to first page</a><% } %>
            <% if(it.following) { %><a href="/roadmap" class="btn-clear-filters">Find ideas to follow</a><% } %>
            <% if (filtered) { %><a class="btn-clear-filters" href="<%= feedUrl({search: '', category: 'All'}) %>">Explore all ideas</a><% } else { %><button type="button" class="btn-empty-create" data-sf-click="action-49">Share an idea</button><% } %>
          </div>
        </section>
      <% } %>
      <button type="button" id="feed-loader" class="feed-loader-container" data-sf-click="action-48" <%= it.hasMore ? '' : 'hidden' %>>
        <span class="feed-loading-spinner" aria-hidden="true"><span class="spinner-dot"></span><span class="spinner-dot"></span><span class="spinner-dot"></span></span>
        <span class="feed-loading-text">Load more ideas</span>
      </button>
      <p id="feed-load-status" class="feed-load-status" role="status" aria-live="polite"></p>
      <p id="feed-end-message" class="feed-end-notice" <%= it.hasMore || !feed.length ? 'hidden' : '' %>><span class="end-icon-badge" aria-hidden="true">✓</span>You’re all caught up<%= filtered ? ' with these results' : '' %>.</p>
      <noscript><nav class="feed-pagination" aria-label="Feed pages">
        <% if (it.page > 1) { %><a href="<%= feedUrl({page: it.page - 1}) %>">Previous page</a><% } %>
        <% if (it.hasMore) { %><a href="<%= feedUrl({page: (it.page || 1) + 1}) %>">Next page</a><% } %>
      </nav></noscript>
    </div>
  </main>


</div>
<% if(it.accountState && it.user?.id===it.accountState.userId){ %>
<div id="sf-feed-account-state" hidden data-user="<%= it.accountState.userId %>" data-bookmarks="<%= JSON.stringify(it.accountState.bookmarks) %>" data-searches="<%= JSON.stringify(it.accountState.searches) %>"></div>
<% } %>
<div id="sf-feed-config" hidden data-sort="<%= sort %>" data-category="<%= category %>" data-search="<%= search %>" data-total="<%= total ?? '' %>" data-page="<%= it.page || 1 %>" data-has-more="<%= it.hasMore ? 'true' : 'false' %>" data-votes="<%= JSON.stringify(it.votedIds||[]) %>" data-vote-state="<%= it.voteStateKnown!==false %>"></div>
<%~ include('partials/feed-filter-dialog',it) %>
<dialog class="saved-search-dialog" id="saved-search-dialog" aria-labelledby="saved-dialog-title"><header class="saved-dialog-heading"><h2 id="saved-dialog-title">Your saved views</h2><button type="button" data-feed-saved-close aria-label="Close saved views">×</button></header>    <section class="saved-searches" id="saved-search-panel">
<p class="saved-search-dialog-count"><span id="saved-search-count">— / 10</span> saved views</p>
      <div class="saved-search-body">
        <div class="saved-search-current"><div><p class="saved-search-eyebrow">CURRENT VIEW</p><div id="saved-search-current-filters"></div><p id="saved-search-current-note" class="saved-search-help">Save the filters applied above, starting at page one.</p></div><button class="saved-search-primary" type="button" id="saved-search-add" aria-expanded="false" aria-controls="saved-search-form" disabled>Save this view</button></div>
        <form id="saved-search-form" class="saved-search-create" hidden><label for="saved-search-name">Give this view a name<input id="saved-search-name" class="saved-search-input" name="name" required maxlength="40" autocomplete="off" placeholder="e.g. Library improvements"/></label><div class="saved-search-form-actions"><button class="saved-search-primary" type="submit">Save search</button><button class="saved-search-action" type="button" id="saved-search-cancel">Cancel</button></div></form>
        <p id="saved-search-status" class="saved-search-status" role="status" aria-live="polite"></p><button id="saved-search-retry" type="button" class="saved-search-action" hidden>Reload searches</button>
        <ul id="saved-search-list" class="saved-search-list" aria-label="Saved searches" aria-busy="true"></ul>
        <footer class="saved-search-footer"><strong id="saved-search-storage"></strong><p id="saved-search-storage-note"></p></footer>
      </div>
    </section></dialog>
<script defer src="/js/feed.js?v=20261025-landing-ideas"></script>

<script defer src="/js/saved-searches.js?v=20261018-customization"></script>
