<!doctype html><html lang="en" data-theme="<%= it.previewTheme || 'light' %>"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Private school preview</title><link rel="stylesheet" href="/css/base.bundle.css?v=20261018-customization"/><link rel="stylesheet" href="/css/enhancements.bundle.css?v=20261018-customization"/><link rel="stylesheet" href="/css/customization.bundle.css?v=20261018-customization"/></head><body class="school-preview-content"><%~ include('partials/workspace-icons',it) %><header class="school-preview-header"><strong>Sugg<span>Feed</span></strong><small>Private preview · fictional content</small></header><main><%~ include('partials/school-welcome',it) %><section class="school-preview-sample"><h2>Community ideas</h2><div class="school-preview-categories"><% for(const c of it.configuration.categories.filter(c=>c.active)) { %><span><%= c.name %></span><% } %></div><article class="care-card"><span><%= it.configuration.labels.approved %></span><h3>A welcoming study space</h3><p>Fictional sample idea for this preview. No student information is shown.</p><% if(it.configuration.features.voting) { %><button class="workspace-button" type="button" disabled>Support · 12</button><% } %><% if(it.configuration.features.comments) { %><p>Comments are open for this school.</p><% } else { %><p>Existing comments remain readable. New comments are disabled.</p><% } %></article><section class="care-card"><h2>Sample submission form</h2><%~ include('partials/school-custom-questions',it) %><p class="staff-footnote">Preview only. No submissions, uploads or emails can be sent.</p></section></section></main></body></html>
