<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>[hidden] { display: none !important; }</style>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>(function(){var t=localStorage.getItem('sf-theme')||'system';document.documentElement.setAttribute('data-theme',t==='dark'?'dark':t==='light'?'light':window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');})()</script>
</head>
<body>
<%- include('partials/header') %>
<%- include('partials/toast') %>
<%- include('partials/auth-modal') %>

<main class="sf-main">
  <div style="max-width:600px;margin:0 auto;padding:80px 16px;text-align:center">
    <div class="avatar-circle" style="width:72px;height:72px;font-size:28px;margin:0 auto 20px">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </div>
    <h1 style="font-size:22px;font-weight:700;margin:0 0 12px;color:var(--ink)">Your Profile</h1>
    <p style="font-size:15px;color:var(--muted);margin:0 0 28px;line-height:1.6">
      Sign in to view your submitted ideas, track their progress, and manage your account.
    </p>
    <button class="btn-primary-sm" id="open-signin-btn"
      style="padding:12px 28px;font-size:15px;border-radius:10px">
      Sign in to continue
    </button>
    <p style="margin-top:16px;font-size:13px;color:var(--muted)">
      Don't have an account?
      <button class="auth-link-btn" id="open-signup-btn" style="font-size:13px">Sign up free</button>
    </p>
  </div>
</main>

<%- include('partials/footer') %>

<script>
window.SUPABASE_URL = '<%- supabaseUrl %>';
window.SUPABASE_ANON_KEY = '<%- supabaseAnonKey %>';
window._supabase = window.supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);

window._supabase.auth.onAuthStateChange(async (event, session) => {
  if (event === 'SIGNED_IN' && session) {
    await fetch('/auth/session', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ access_token: session.access_token, refresh_token: session.refresh_token, user: session.user }) });
    window.location.reload();
  }
});

document.getElementById('open-signin-btn')?.addEventListener('click', () => window.openAuthModal?.('signin'));
document.getElementById('open-signup-btn')?.addEventListener('click', () => window.openAuthModal?.('signup'));

document.getElementById('theme-btn')?.addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  localStorage.setItem('sf-theme', next);
  document.documentElement.setAttribute('data-theme', next);
});
</script>
