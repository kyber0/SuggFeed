<% layout('layout');const invitation=it.invitation;const role=it.roles?.[invitation?.role];const date=value=>new Date(value).toLocaleString('en-PH',{timeZone:'Asia/Manila',dateStyle:'medium',timeStyle:'short'});const available=invitation?.state==='pending';const enter=invitation?.can_enter;const labels={expired:'This invitation has expired',revoked:'This invitation was revoked',accepted:'This invitation has been accepted',unavailable:'This invitation is unavailable'}; %>
<main class="invitation-page"><section class="invitation-card">
 <a class="school-settings-back" href="/schools">← Your schools</a><p class="school-settings-eyebrow">You’re invited</p>
 <% if(invitation) { %><h1><%= enter?'You’re already part of the school':available?'Join your school community':labels[invitation.state] || 'School invitation' %></h1><p class="invitation-intro"><strong><%= invitation.school_name %></strong> on SuggFeed</p><div class="invitation-access"><span>Your role</span><h2><%= role?.label || 'Member' %></h2><p><%= role?.description %></p></div><% } else { %><h1>Invitation not found</h1><p>This link is incomplete or no longer available. Ask your school administrator for a new invitation.</p><% } %>
 <% if(it.errorMessage) { %><p class="invites-feedback invites-feedback--error" role="alert"><%= it.errorMessage %></p><% } %>
 <% if(enter) { %><p>Your account already has access. Continue to your school workspace.</p><a class="school-settings-primary invitation-cta" href="/s/<%= invitation.school_slug %>/<%= ['admin','moderator'].includes(invitation.role)?'admin':'' %>">Open school workspace →</a>
 <% } else if(available) { %>
  <p class="invitation-recipient">Invited email: <strong><%= invitation.recipient %></strong></p>
  <% if(!it.user) { %><p>Sign in or create an account with the invited email to accept. We’ll bring you back here.</p><div class="invitation-auth"><button type="button" class="school-settings-primary" data-sf-click="action-94">Sign in to accept</button><button type="button" class="school-settings-secondary" data-sf-click="action-135">Create an account</button></div>
  <% } else if(!invitation.email_matches) { %><div class="invites-feedback invites-feedback--warning"><strong>Use the invited email account</strong><p>You’re signed in as <%= it.user.email %>. Switch to the email that received this invitation, or confirm that account’s email first.</p></div><form action="/auth/signout" method="post" data-invitation-form><input type="hidden" name="returnTo" value="/schools/invitations/<%= it.token %>" /><button class="school-settings-primary" type="submit">Switch account</button></form>
  <% } else { %><p>Signed in as <strong><%= it.user.email %></strong>. Accept to join this school as a <%= role.label.toLowerCase() %>.</p><form action="/schools/invitations/<%= it.token %>" method="post" data-invitation-form><button class="school-settings-primary invitation-cta" type="submit">Accept invitation & join →</button></form><% } %>
  <p class="invites-small">One-time invitation. Expires <%= date(invitation.expires_at) %> (Philippine time).</p>
 <% } else if(invitation && !enter) { %><p>Ask your school administrator for a new invitation. If you’ve already joined, open <a href="/schools">Your schools</a>.</p><% } %>
 <p class="invitation-footer">Only accept invitations you were expecting. Joining one school does not give access to any other school.</p>
</section></main>
<script defer src="/js/invitations.js?v=20261018-invitations"></script>
