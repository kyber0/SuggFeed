<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Private school preview</title><link rel="stylesheet" href="/css/base.bundle.css?v=20261018-customization"/><link rel="stylesheet" href="/css/customization.bundle.css?v=20261018-customization"/></head><body><main class="school-preview-wrapper"><header><a class="workspace-button" href="<%= it.base %>">← Back to editor</a><h1>Private school preview</h1><p>Saved revision <%= it.revision %> · fictional examples · no real actions</p><label>Viewport<select class="workspace-input" id="school-preview-width"><option value="320">Small mobile · 320 px</option><option value="375" selected>Mobile · 375 px</option><option value="768">Tablet · 768 px</option><option value="1280">Desktop · 1280 px</option></select></label><label>Theme<select class="workspace-input" id="school-preview-theme"><option value="light">Light</option><option value="dark">Dark</option></select></label></header><div class="school-preview-stage"><iframe id="school-preview-frame" title="School workspace preview" src="<%= it.base %>/preview/content?revision=<%= it.revision %>" width="375" height="1000"></iframe></div></main><script defer src="/js/school-preview.js?v=20261018-customization"></script></body></html>
