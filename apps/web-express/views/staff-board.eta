<% layout('layout');
 const filters=it.filters;
 const urlFor=(stage,page)=>{
  const values=new URLSearchParams({sort:filters.sort,pageSize:String(filters.pageSize)});
  if(filters.search) values.set('search',filters.search);
  for(const lane of it.lanes) {const number=lane.status===stage?page:lane.page;if(number>1) values.set(lane.status+'Page',String(number));}
  return '/admin/board?'+values.toString()+(stage?'#board-lane-'+stage:'');
 };
 const pageFields=stage=>Array.from(new URLSearchParams(urlFor('',1).split('?')[1]).entries()).filter(([key])=>key!==stage+'Page');
 const meta={filters,totalCount:it.totalCount,lanes:it.lanes.map(({items,...lane})=>lane)};
%>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main staff-board-main">
 <header class="workspace-heading"><div><p class="workspace-kicker">WORKSPACE / DELIVERY</p><h1>Manage work</h1><p>Plan → start → publish updates → complete with evidence. Select cards to assign them together.</p></div><a class="workspace-button" href="/admin">Review submissions</a></header>
 <form class="staff-board-toolbar" action="/admin/board" method="get" role="search" id="staff-board-filters">
  <label class="staff-board-search"><span>Search work</span><input class="workspace-input" type="search" name="search" value="<%= filters.search %>" maxlength="120" placeholder="Search suggestions…" aria-label="Search the work board"/></label>
  <label>Order<select class="workspace-input" name="sort"><option value="oldest" <%= filters.sort==='oldest'?'selected':'' %>>Oldest first</option><option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Newest first</option></select></label>
  <label>Cards per stage<select class="workspace-input" name="pageSize"><% for(const size of [6,12,24]) { %><option value="<%= size %>" <%= filters.pageSize===size?'selected':'' %>><%= size %></option><% } %></select></label>
  <button class="workspace-button" type="submit">Apply</button>
  <% if(filters.search || filters.sort!=='oldest' || filters.pageSize!==6) { %><a class="workspace-text-link" href="/admin/board" data-board-reset>Reset</a><% } %>
 </form>
 <div class="staff-board-caption"><p id="staff-board-summary"><%= it.items.length %> shown · <%= it.totalCount.toLocaleString() %> matching submissions</p><p>Scroll down to see this page · stages page independently</p></div>
 <div class="staff-board-feedback"><p id="staff-tools-message" role="status" aria-live="polite"></p><button type="button" class="workspace-text-link" id="staff-board-retry" hidden>Retry loading</button></div>
 <div class="staff-bulk-controls staff-board-selection" id="staff-selection-tools" hidden>
  <strong id="staff-selection-count" role="status">0 selected · maximum 25</strong>
  <label><span class="visually-hidden">Assign selected cards to</span><select class="workspace-input" id="staff-bulk-assignee" aria-label="Assign selected cards to"><option value="">Unassigned</option><% for(const member of it.members) { %><option value="<%= member.id %>"><%= member.display_name || 'Staff member' %></option><% } %></select></label>
  <button class="workspace-button" id="staff-bulk-assign" type="button">Assign selected</button><button class="workspace-text-link" id="staff-clear-selection" type="button">Clear selection</button>
 </div>
 <p class="visually-hidden" id="staff-drag-status" role="status" aria-live="polite"></p>
 <section class="staff-flow-board" id="staff-flow-board" aria-label="Submission stages">
  <% for(const lane of it.lanes) { %><%~ include('partials/staff-board-lane',{lane,urlFor,pageFields}) %><% } %>
 </section>
 <p class="staff-board-safety">Move or drag opens an action form; nothing changes until you save. Needs review and Declined submissions are now in <a href="/admin">Review submissions</a>. Existing links and idea IDs still work.</p>
 <details class="staff-board-help"><summary>Board controls and recovery</summary><p>Use the stage menu on each card with a keyboard, or drag a card with a pointer. Scroll down to see all cards on this page. Each stage pages independently. Selection can include other pages and is kept only during this visit.</p><p>Assignments save together: if any selected version changed, none are saved. After a timeout, refresh to confirm before retrying. Published history is corrected with a new update; merges require an operator to review the audit for recovery.</p></details>
 <script id="staff-board-data" type="application/json"><%~ JSON.stringify(it.items).replace(/</g,'\\u003c') %></script>
 <script id="staff-board-meta" type="application/json"><%~ JSON.stringify(meta).replace(/</g,'\\u003c') %></script>
 <script defer src="/js/staff-tools.js?v=20261016-school-isolation"></script>
</div>
<%~ include('partials/staff-review',{...it,staffMembers:it.members}) %>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/staff-progress.js?v=20261018-empty-states"></script>
<script defer src="/js/staff-review.js?v=20261018-empty-states"></script>
</main><section class="staff-mobile-notice"><h1>Staff workspace</h1><p>Use a desktop or larger screen to manage the work board.</p><a class="workspace-button" href="/roadmap">Explore the roadmap</a></section>
