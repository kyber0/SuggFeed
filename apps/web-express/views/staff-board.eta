<% layout('layout');
 const filters=it.filters;const presentation=it.presentation||'board';
 const urlFor=(stage,page)=>{
  const values=new URLSearchParams({sort:filters.sort,pageSize:String(filters.pageSize)});
  values.set('presentation',presentation);if(it.calendar){values.set('month',it.calendar.month);values.set('calendarPage',String(it.calendar.page));}
  if(filters.search) values.set('search',filters.search);
  if(filters.assignment&&filters.assignment!=='all')values.set('assignment',filters.assignment);
  if(filters.priority&&filters.priority!=='all')values.set('priority',filters.priority);
  if(filters.overdue)values.set('overdue','true');
  for(const [status,size] of Object.entries(filters.windows||{}))values.set(status+'Loaded',String(size));
  for(const lane of it.lanes) {const number=lane.status===stage?page:lane.page;if(number>1) values.set(lane.status+'Page',String(number));}
  return '/admin/work?'+values.toString()+(stage?'#board-lane-'+stage:'');
 };
 const pageFields=stage=>Array.from(new URLSearchParams(urlFor('',1).split('?')[1]).entries()).filter(([key])=>key!==stage+'Page');
 const meta={filters:{...filters,presentation,month:it.calendar?.month,calendarPage:it.calendar?.page},totalCount:it.totalCount,lanes:it.lanes.map(({items,...lane})=>lane)};
%>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main staff-board-main">
 <%~ include('partials/staff-work-header',{...it,urlFor,presentation}) %>
 <div class="staff-board-display-bar" <%= presentation!=='board'?'hidden':'' %>><strong>Delivery board</strong><button type="button" class="workspace-button" id="staff-board-filter-toggle" aria-expanded="false" aria-controls="staff-board-controls" hidden>Show filters</button><% if(presentation==='board') { %><button type="button" class="workspace-button staff-board-maximize" id="staff-board-maximize" aria-pressed="false" aria-controls="staff-flow-board" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><span>Maximize board</span></button><% } %></div>
 <div id="staff-board-controls"><%~ include('partials/staff-board-filters',{...it,urlFor,presentation}) %></div>
 <div class="staff-board-caption"><p id="staff-board-summary"><%= it.calendar?it.calendar.items.length:it.items.length %> shown · <%= (it.calendar?it.calendar.total:it.totalCount).toLocaleString() %> matching <%= it.calendar?'scheduled ideas':'submissions' %></p><p><%= presentation==='calendar'?'Calendar uses school target dates. Unscheduled ideas remain on the Board.':'Each stage pages independently. Delivery filters carry across Board and Calendar.' %></p></div>
 <div class="staff-board-feedback"><button type="button" class="workspace-text-link" id="staff-board-refresh">Refresh work</button><p id="staff-tools-message" role="status" aria-live="polite"></p><button type="button" class="workspace-text-link" id="staff-board-retry" hidden>Retry loading</button></div>
 <div class="staff-bulk-controls staff-board-selection" id="staff-selection-tools" hidden>
  <strong id="staff-selection-count" role="status">0 selected · maximum 25</strong>
  <label hidden><span class="visually-hidden">Assign selected cards to</span><select class="workspace-input" id="staff-bulk-assignee" aria-label="Assign selected cards to"><option value="">Unassigned</option><% for(const member of it.members) { %><option value="<%= member.id %>"><%= member.display_name || 'Staff member' %></option><% } %></select></label>
  <label class="staff-group-destination">Move selected to<select class="workspace-input" id="staff-group-stage"><option value="">Choose destination</option><% for(const lane of it.lanes) { %><option value="<%= lane.status %>"><%= lane.label %> · <%= lane.count %></option><% } %></select></label><button class="workspace-button workspace-button--primary" id="staff-group-move" type="button" disabled>Review moves</button><span id="staff-selection-hint" class="staff-footnote">Choose a stage supported by every selected idea.</span>
  <button class="workspace-button" id="staff-bulk-assign" type="button" hidden>Assign selected</button><% if(it.user?.role==='admin') { %><a class="workspace-button" href="/admin/routing">Assignment routing →</a><% } %><button class="workspace-text-link" id="staff-clear-selection" type="button">Clear selection</button>
 </div>
 <p class="visually-hidden" id="staff-drag-status" role="status" aria-live="polite"></p>
 <label class="staff-mobile-stage" <%= presentation!=='board'?'hidden':'' %>>Stage<select class="workspace-input" id="staff-mobile-stage"><% for(const lane of it.lanes) { %><option value="<%= lane.status %>"><%= lane.label %> · <%= lane.count %></option><% } %></select></label>
 <section class="staff-flow-board" id="staff-flow-board" data-presentation="<%= presentation %>" <%= presentation==='calendar'?'hidden':'' %> aria-label="Submission stages">
  <% for(const lane of it.lanes) { %><%~ include('partials/staff-board-lane',{lane,urlFor,pageFields,canAssign:it.user?.role==='admin',filtered:!!(filters.search||filters.assignment!=='all'||filters.priority!=='all'||filters.overdue)}) %><% } %>
 </section>
 <div id="staff-calendar"><% if(it.calendar) { %><%~ include('partials/staff-calendar',{...it,urlFor}) %><% } %></div>
 <p class="staff-board-safety">Move opens a review form; nothing changes until you save. Needs review and Declined submissions are now in <a href="/admin/reviews">Review ideas</a>. Existing links and idea IDs still work.</p>
 <details class="staff-board-help"><summary>Board controls and recovery</summary><p>Use Move on a selected card to review the selected group with a keyboard, or drag a selected card with a pointer. Scroll within a column to load its next batch. Each column keeps up to 72 cards in the current window; use pagination to continue beyond it. Each stage pages independently. Selection can include other pages and is kept only during this visit. Drag a selected card to review moves for the selected group, one idea at a time. A destination must support every selected idea. Dragging an unselected card moves only that idea.</p><p>Assignments save together: if any selected version changed, none are saved. After a timeout, refresh to confirm before retrying. Published history is corrected with a new update; merges require an operator to review the audit for recovery.</p></details>
 <script id="staff-board-data" type="application/json"><%~ JSON.stringify(it.items).replace(/</g,'\\u003c') %></script>
 <script id="staff-board-meta" type="application/json"><%~ JSON.stringify(meta).replace(/</g,'\\u003c') %></script>
 <script defer src="/js/staff-tools.js?v=20261026-max-lazy"></script>
</div>
<% if(it.user?.role==='admin') { %><dialog id="staff-board-assignment" class="staff-board-assignment-dialog" aria-labelledby="board-assignment-title"><header><div><h2 id="board-assignment-title">Assign an owner</h2><p id="board-assignment-idea"></p></div><button class="workspace-button" type="button" data-close-board-assignment aria-label="Close assignment">×</button></header><form id="staff-board-assignment-form" class="assignment-form" method="post" action="/admin/assignments/action"><label class="assignment-wide">Staff member<select class="workspace-input" name="person" required><option value="">Choose a staff member</option><% for(const member of it.members) { %><option value="<%= member.id %>" data-role="<%= member.role %>"><%= member.display_name||'Staff member' %></option><% } %></select></label><label class="assignment-wide">Reason<textarea class="workspace-input" name="note" rows="3" minlength="3" maxlength="500" required placeholder="Why is this ownership changing?"></textarea></label><p class="staff-footnote assignment-wide">The existing team stays assigned. This changes ownership only; it does not move the idea or publish a response.</p><p id="board-assignment-message" class="assignment-wide" role="status" aria-live="polite"></p><button class="workspace-button workspace-button--primary" type="submit">Save owner</button><button class="workspace-button" type="button" data-close-board-assignment>Cancel</button></form></dialog><% } %>
<%~ include('partials/staff-work-detail',{...it,staffMembers:it.members}) %>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/staff-progress.js?v=20261025-detail-polish"></script>
<script defer src="/js/staff-review.js?v=20261026-max-lazy"></script>
</main>