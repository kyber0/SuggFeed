<% layout('layout');const p=it.data.draft;const sections=[['overview','Overview'],['appearance','Appearance'],['welcome','Welcome & links'],['categories','Feedback categories'],['form','Submission form'],['features','Community features'],['notifications','Progress & notifications'],['history','History']];const value=path=>path.split('.').reduce((v,k)=>v?.[k],p); %>
<main class="customization-page" data-customization-editor data-base="<%= it.base %>" data-revision="<%= it.data.revision %>">
 <header class="school-settings-header"><div><a class="school-settings-back" href="<%= it.base.replace(/customization$/,'')+(it.platformDashboard?'settings':'school-settings') %>">← School settings</a><p class="school-settings-eyebrow">Your school, on SuggFeed</p><h1>School customization</h1><p>Shape <strong><%= it.school.name %></strong> without changing access rules or legal policies.</p></div><span class="platform-badge">Published version <%= it.data.published_version %></span></header>
 <p id="customization-feedback" class="school-settings-feedback" role="status" aria-live="polite">Changes stay private until you publish.</p>
 <% if(!it.enabled) { %><p class="school-settings-notice">Editing is not enabled for this school or is temporarily paused. Your published workspace remains available. A platform operator manages the rollout.</p><% } %>
 <nav class="custom-related" aria-label="Related school settings"><% const settingsBase=it.base.replace(/customization$/,'')+(it.platformDashboard?'settings':'school-settings');for(const [anchor,label] of [['school-domains','Verified email domains'],['school-enrollment','Enrollment & eligibility'],['school-policies','Policies'],['school-contacts','School contacts'],['school-access','Visibility & retention']]) { %><a href="<%= settingsBase+'#'+anchor %>"><%= label %></a><% } %><a href="<%= it.base.replace(/customization$/,'invitations') %>">Member invitations</a></nav>
 <label class="custom-mobile-section">Go to section<select class="workspace-input" data-section-picker><% for(const [key,label] of sections) { %><option value="custom-<%= key %>"><%= label %></option><% } %></select></label>
 <div class="customization-layout">
  <aside class="customization-sidebar"><nav aria-label="Customization sections"><% for(const [key,label] of sections) { %><a href="#custom-<%= key %>"><%= label %></a><% } %><a href="<%= it.base.replace(/customization$/,'')+(it.platformDashboard?'settings':'school-settings') %>#school-enrollment">People, policies & contacts</a></nav><p class="staff-footnote"><%= it.data.saved_by_name ? 'Saved by '+it.data.saved_by_name+' · ' : '' %>Revision <span data-revision-label><%= it.data.revision %></span><% if(it.data.saved_at) { %> · <%= new Date(it.data.saved_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %><% } %></p></aside>
  <form class="customization-editor" id="customization-form"><fieldset <%= !it.enabled?'disabled':'' %>>
   <section class="school-settings-card" id="custom-overview"><header><div><h2>Draft → preview → publish</h2><p>Save privately, check desktop and mobile, then publish one consistent version.</p></div></header><div class="school-settings-card-body"><p>Published version <strong><%= it.data.published_version %></strong>. Saved draft revision <strong data-revision-label><%= it.data.revision %></strong>.</p><button class="workspace-button" type="submit">Save draft</button><h3>Changes from the live version</h3><ul data-change-list><% for(const change of it.changes) { %><li><%= change %></li><% } %><% if(!it.changes.length) { %><li>No changes yet.</li><% } %></ul><a class="workspace-button" data-preview-link href="<%= it.base %>/preview?revision=<%= it.data.revision %>" target="_blank" rel="noopener">Open private preview</a><p class="staff-footnote">Preview uses fictional examples. It cannot send ideas, invitations or email.</p></div></section>
   <section class="school-settings-card" id="custom-appearance"><header><div><h2>Appearance</h2><p>SuggFeed stays visible alongside your school’s identity.</p></div></header><div class="school-settings-card-body">
    <label>Short display name<input class="workspace-input" data-path="displayName" value="<%= p.displayName %>" maxlength="60" /></label><label>Accessible accent palette<select class="workspace-input" data-path="palette"><% for(const palette of it.palettes) { %><option value="<%= palette %>" <%= palette===p.palette?'selected':'' %>><%= palette %></option><% } %></select></label>
    <% for(const kind of ['logo','cover']) { %><div class="custom-asset"><h3><%= kind==='logo'?'School logo':'Optional landing-page cover' %></h3><img data-asset-preview="<%= kind %>" src="<%= p[kind]?it.base+'/assets/'+p[kind]:'' %>" alt="Current <%= kind %> preview" <%= p[kind]?'':'hidden' %> /><label>Upload <%= kind %><input type="file" accept="image/png,image/jpeg,image/webp" data-asset-upload="<%= kind %>" /></label><p class="staff-footnote">Static PNG, JPEG or WebP. Up to <%= kind==='logo'?'2':'5' %> MB. Images are optimized and metadata removed.</p><button class="workspace-button" type="button" data-asset-remove="<%= kind %>">Remove from draft</button></div><% } %>
    <p class="staff-footnote">The verified school name, shared navigation, accessibility and status colors remain consistent.</p>
   </div></section>
   <section class="school-settings-card" id="custom-welcome"><header><div><h2>Welcome & official links</h2><p>Help students understand this workspace and where to get help.</p></div></header><div class="school-settings-card-body">
    <% for(const [path,label,max,rows] of [['welcome.headline','Welcome headline',100,1],['welcome.intro','Short introduction',500,3],['welcome.message','Welcome message',1500,5],['welcome.help','Help and contact information',500,3]]) { %><label><%= label %><textarea class="workspace-input" data-path="<%= path %>" maxlength="<%= max %>" rows="<%= rows %>"><%= value(path) %></textarea></label><% } %>
    <div data-links><% for(const link of p.welcome.links) { %><div class="custom-repeat-row" data-link><label>Link label<input class="workspace-input" data-field="label" maxlength="60" value="<%= link.label %>" required /></label><label>HTTPS address<input class="workspace-input" type="url" data-field="url" maxlength="500" value="<%= link.url %>" required /></label><button class="workspace-button" type="button" data-remove>Remove link</button></div><% } %></div><button class="workspace-button" type="button" data-add="link">Add official link</button>
   </div></section>
   <section class="school-settings-card" id="custom-categories"><header><div><h2>Feedback categories</h2><p>Keep 1–20 active categories. Archive old categories without deleting ideas.</p></div></header><div class="school-settings-card-body"><div data-categories><% for(const item of p.categories) { %><%~ include('partials/customization-category',{item,icons:it.icons}) %><% } %></div><button class="workspace-button" type="button" data-add="category">Add category</button></div></section>
   <section class="school-settings-card" id="custom-form"><header><div><h2>Submission form</h2><p>Use up to eight focused questions. Do not request passwords, student IDs, grades, health details or other unnecessary sensitive information.</p></div></header><div class="school-settings-card-body">
    <% for(const [path,label] of [['form.instructions','Submission instructions'],['form.example','Helpful example']]) { %><label><%= label %><textarea class="workspace-input" data-path="<%= path %>" maxlength="1000" rows="3"><%= value(path) %></textarea></label><% } %>
    <% if(!it.uploadsReady) { %><p class="school-settings-notice">Image uploads are not available yet. Ask the service operator to finish file cleanup setup. Keep attachments off until the service is ready.</p><% } %><label>Image attachments<select class="workspace-input" data-path="form.attachments"><% for(const [key,label] of [['off','Do not accept attachments'],['optional','Optional image attachments'],['required','Require at least one image']]) { %><option value="<%= key %>" <%= p.form.attachments===key?'selected':'' %> <%= !it.uploadsReady&&key!=='off'?'disabled':'' %>><%= label %></option><% } %></select></label><p class="staff-footnote">JPEG, PNG and WebP only, up to three images of 5 MB each. Stored privately for the author and school staff.</p>
    <div data-questions><% for(const item of p.form.questions) { %><%~ include('partials/customization-question',{item}) %><% } %></div><button class="workspace-button" type="button" data-add="question">Add question</button>
    <div class="enrollment-impact"><strong>Changes that collect additional information require review.</strong><p>Save the draft, update the school privacy notice if needed, then request platform review. Existing approved policies and the live workspace remain active while drafts are reviewed.</p><button class="workspace-button" type="button" data-action="request-review">Request form review</button></div>
   </div></section>
   <section class="school-settings-card" id="custom-features"><header><div><h2>Community features</h2><p>Changes affect future actions. Existing ideas, comments, votes and anonymous tracking are preserved.</p></div></header><div class="school-settings-card-body">
    <% for(const [key,label,hint] of [['comments','Allow new comments','Existing comments stay readable and staff can still moderate.'],['voting','Allow voting','Disabling blocks new votes and removes voting-based navigation; records stay saved.'],['roadmap','Show the student roadmap','Staff workflow stays available. Existing roadmap links explain when the view is disabled.'],['sharing','Allow sharing actions','This does not prevent copying a public page URL or change the publication policy.'],['anonymous','Allow anonymous submissions','Existing anonymous ideas stay anonymous. New identified submissions require sign-in.']]) { %><label class="custom-check"><input type="checkbox" data-path="features.<%= key %>" <%= p.features[key]?'checked':'' %> /><span><strong><%= label %></strong><small><%= hint %></small></span></label><% } %>
   </div></section>
   <section class="school-settings-card" id="custom-notifications"><header><div><h2>Progress & notifications</h2><p>Customize public wording without changing workflow permissions, email senders or consent.</p></div></header><div class="school-settings-card-body">
    <% for(const [key,label] of [['approved','Planned-stage label'],['in_progress','In-progress label'],['resolved','Completed label']]) { %><label><%= label %><input class="workspace-input" data-path="labels.<%= key %>" maxlength="40" value="<%= p.labels[key] %>" required /></label><label>Public stage explanation<textarea class="workspace-input" data-path="stageDescriptions.<%= key %>" maxlength="240" rows="2"><%= p.stageDescriptions[key] %></textarea></label><% } %>
    <% for(const [key,label] of [['invitation','Invitation welcome paragraph'],['introduction','School introduction in supported emails']]) { %><label><%= label %><textarea class="workspace-input" data-path="email.<%= key %>" maxlength="1000" rows="3"><%= p.email[key] %></textarea></label><% } %>
    <label>School digest availability<select class="workspace-input" data-path="email.digest"><option value="weekly" <%= p.email.digest==='weekly'?'selected':'' %>>Weekly, for students who opted in</option><option value="off" <%= p.email.digest==='off'?'selected':'' %>>Off</option></select></label><p class="staff-footnote">Turning weekly email on does not subscribe users or override their preferences.</p>
   </div></section>
   <section class="school-settings-card" id="custom-history"><header><div><h2>Published history</h2><p>Restoration creates a draft. It never rolls back memberships, legal notices, moderation or ideas.</p></div></header><div class="school-settings-card-body"><% if(!it.data.history.length) { %><p>No published customization versions yet. Your school uses the existing defaults.</p><% } %><% for(const v of it.data.history) { %><div class="custom-history-row"><div><strong>Version <%= v.version %></strong><p><%= v.actor_name || 'School administrator' %> · <%= new Date(v.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %></p><p><%= (v.change_summary||[]).join(', ') || 'Initial school customization' %></p><% if(v.restored_from) { %><small>Restored from version <%= v.restored_from %></small><% } %></div><button type="button" class="workspace-button" data-restore="<%= v.version %>">Restore into draft</button></div><% } %></div></section>
   <div class="custom-publish"><label class="custom-check"><input type="checkbox" data-publish-confirm /><span>I reviewed the saved changes and their effect on students.</span></label><div><button class="workspace-button" type="submit">Save draft</button><button class="school-settings-primary" type="button" data-action="publish">Publish saved draft</button></div><p class="staff-footnote" data-dirty-message>Preview and publication use the saved draft.</p></div>
  </fieldset></form>
  <aside class="customization-preview"><h2>Saved mobile preview</h2><p class="staff-footnote">Fictional sample content. Save to refresh.</p><iframe title="Private mobile school preview" data-preview-frame src="<%= it.base %>/preview/content?revision=<%= it.data.revision %>" loading="lazy"></iframe></aside>
 </div>
 <template id="custom-category-template"><%~ include('partials/customization-category',{item:{id:'',name:'',slug:'',description:'',icon:'message',active:true},icons:it.icons}) %></template>
 <template id="custom-question-template"><%~ include('partials/customization-question',{item:{id:'',label:'',help:'',type:'short',required:false,options:[]}}) %></template>
 <template id="custom-link-template"><div class="custom-repeat-row" data-link><label>Link label<input class="workspace-input" data-field="label" maxlength="60" required /></label><label>HTTPS address<input class="workspace-input" data-field="url" type="url" maxlength="500" required /></label><button class="workspace-button" type="button" data-remove>Remove link</button></div></template>
 <script type="application/json" id="customization-data"><%~ JSON.stringify(p).replace(/</g,'\\u003c') %></script>
</main>
<script defer src="/js/school-customization.js?v=20261018-customization"></script>
