<!doctype html><html lang="en" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,interactive-widget=resizes-content"><title>Customize workspace — <%= it.school.name %></title><link rel="stylesheet" href="/css/base.bundle.css?v=20261022-continuous-thread"><link rel="stylesheet" href="/css/platform.bundle.css?v=20261018-enrollment"><link rel="stylesheet" href="/css/school-studio.css?v=20261025-canvas-edit"><link rel="stylesheet" href="/css/modules/animations.css?v=20261022-home-polish"><link rel="stylesheet" href="/css/modules/file-upload.css?v=20261021-upload"><link rel="stylesheet" href="/css/modules/responsive-primitives.css?v=20261021-mobile-audit"><link rel="stylesheet" href="/css/modules/interaction-feedback.css?v=20261022-compact-group"/><script defer src="/js/interaction-feedback.js?v=20261022-pending-reset"></script><link rel="stylesheet" href="/css/modules/controls.css?v=20261024-controls"/></head><body class="studio-host">
<%~ include('partials/workspace-icons',it) %>
<main class="studio" data-studio data-base="<%= it.base %>">
 <header class="studio-toolbar">
  <div class="studio-brand"><a class="studio-back" href="<%= it.base.replace(/customization$/,'')+(it.base.startsWith('/platform/')?'settings':'school-settings') %>" aria-label="Back to school settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></a><div><strong><span class="studio-wordmark">Sugg<span>Feed</span></span> <span class="studio-title">Studio</span></strong><small title="<%= it.school.name %>"><%= it.school.name %></small></div></div>
  <span class="studio-save-state" id="studio-save-state" role="status" aria-live="polite">Draft saved</span>
  <div class="studio-toolbar-actions"><div class="studio-undo-group"><button type="button" id="studio-undo" aria-label="Undo change" title="Undo · Ctrl/⌘ Z" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 0 12"/></svg></button><button type="button" id="studio-redo" aria-label="Redo change" title="Redo · Ctrl/⌘ Shift Z" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5M20 9H10a6 6 0 0 0 0 12"/></svg></button></div><div class="studio-mode-switch" role="group" aria-label="Workspace mode"><button type="button" id="studio-edit" aria-pressed="true">Edit</button><button type="button" id="studio-mode" aria-pressed="false">Preview</button></div><button type="button" id="studio-save" title="Save privately · Ctrl/⌘ S">Save now</button><button type="button" class="studio-primary" id="studio-review" aria-describedby="studio-review-help">Review changes</button></div>
 </header>
 <div class="studio-mobile-tools"><button type="button" data-open-panel="pages">Layers & pages</button><span id="studio-mobile-selection">Select a component</span><button type="button" data-open-panel="properties">Edit properties</button></div>
 <div class="studio-body">
  <aside class="studio-panel studio-pages" id="studio-pages" aria-label="Pages, layers and assets">
   <header class="studio-file-heading"><div><small>School workspace</small><h2 title="<%= it.school.name %>"><%= it.school.name %></h2></div><button type="button" data-close-panel="pages" aria-label="Collapse layers">‹</button></header>
   <div class="studio-panel-tabs" role="group" aria-label="Sidebar view"><button type="button" data-studio-tab="layers" aria-pressed="true">Layers</button><button type="button" data-studio-tab="assets" aria-pressed="false">Assets</button></div>
   <details class="studio-page-list" id="studio-page-list" open><summary><span>Pages</span><span class="studio-page-count">9</span></summary><nav aria-label="Workspace pages"><% for(const [value,label] of [['home','Home'],['feed','Ideas'],['roadmap','Roadmap'],['idea','Idea detail'],['profile','My activity'],['submit','Submit idea'],['notifications','School updates'],['inbox','Private messages'],['staff','Staff workspace']]) { %><button type="button" data-studio-page="<%= value %>" aria-current="<%= value==='home'?'page':'false' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM14 3v5h5"/></svg><span><%= label %></span><svg class="studio-page-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><% } %></nav></details>
   <div hidden><select id="studio-page" aria-label="Current preview page"><% for(const [value,label] of [['home','Home'],['feed','Ideas'],['roadmap','Roadmap'],['idea','Idea detail'],['profile','My activity'],['submit','Submit idea'],['notifications','School updates'],['inbox','Private messages'],['staff','Staff workspace']]) { %><option value="<%= value %>"><%= label %></option><% } %></select></div>
   <label class="studio-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="studio-sr-only" id="studio-search-label">Find a layer</span><input id="studio-search" class="workspace-input" type="search" placeholder="Find a layer…" autocomplete="off" spellcheck="false"></label>
   <div class="studio-layer-heading"><h3 id="studio-tree-title">Home</h3><span id="studio-layer-count"></span><button type="button" id="studio-collapse-layers" aria-label="Collapse all layers" title="Collapse all layers"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5-5 5 5M7 15l5 5 5-5"/></svg></button></div>
   <div id="studio-tree" class="studio-tree" aria-labelledby="studio-tree-title"></div>
   <div class="studio-panel-footer"><button type="button" id="studio-history"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11a9 9 0 1 1 3 8M3 5v6h6M12 7v5l3 2"/></svg>Version history</button><a href="<%= it.base.replace(/customization$/,'')+(it.base.startsWith('/platform/')?'settings':'school-settings') %>">School settings <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div>
  </aside>
  <section class="studio-canvas" aria-label="Website editing canvas"><div class="studio-canvas-heading"><button type="button" class="studio-icon-button" data-open-panel="pages" aria-label="Show pages and layers" title="Pages & layers"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3zM9 4v16"/></svg></button><div class="studio-source-switch" role="group" aria-label="Compare versions"><button type="button" data-studio-source="draft" aria-pressed="true">Draft</button><button type="button" data-studio-source="published" aria-pressed="false">Published</button></div><span id="studio-canvas-title">Home · Mobile</span><div class="studio-canvas-controls"><label><span class="studio-sr-only">Preview device</span><select id="studio-width" data-studio-segmented><option value="1440">Desktop</option><option value="768">Tablet</option><option value="375" selected>Mobile</option><option value="320">320 px</option></select></label><label class="studio-zoom-control"><span class="studio-sr-only">Preview zoom</span><select id="studio-zoom"><option value="fit">Fit</option><option value="0.5">50%</option><option value="0.75">75%</option><option value="1">100%</option></select></label><label><span class="studio-sr-only">Preview appearance</span><select id="studio-theme"><option value="light">Light</option><option value="dark">Dark</option></select></label><details class="studio-more"><summary aria-label="More preview options" title="More preview options"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" stroke-width="4"/></svg></summary><div class="studio-more-content"><label>Page state<select id="studio-variant"></select></label><label>Example content<select id="studio-scenario"><option value="populated">Populated</option><option value="empty">Empty</option><option value="disabled">Disabled features</option></select></label><button type="button" id="studio-refresh">Reload preview</button><button type="button" id="studio-chrome-theme">Dark editor appearance</button></div></details></div><button type="button" class="studio-icon-button" data-open-panel="properties" aria-label="Show properties" title="Properties"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3zM15 4v16"/></svg></button></div><div class="studio-canvas-scroll" id="studio-canvas-scroll"><div class="studio-board-space" id="studio-board-space"><div class="studio-board" id="studio-board"><iframe id="studio-frame" title="School website preview — click a component to customize" sandbox="allow-scripts allow-same-origin" referrerpolicy="same-origin"></iframe></div></div></div><div class="studio-selection-bar" id="studio-selection-bar"><span id="studio-content-context">Select a component</span><button type="button" id="studio-edit-content" hidden>Edit content</button><button type="button" id="studio-inline-cancel" hidden>Cancel</button><button type="button" class="studio-primary" id="studio-inline-done" hidden>Done</button></div><aside class="studio-content-panel" id="studio-content-panel" aria-label="Canvas content editor" hidden><header><div><small id="studio-content-source">Content · private draft</small><h2 id="studio-content-title">Edit content</h2></div><button type="button" id="studio-close-content" aria-label="Close content editor">×</button></header><form id="studio-content-form" novalidate><div id="studio-content-inspector"></div></form></aside><p class="studio-canvas-hint" id="studio-canvas-hint">Click a component on the website or select it from the component list.</p><div class="studio-frame-loading" id="studio-frame-loading" role="status">Preparing your workspace…</div></section>
  <aside class="studio-panel studio-properties" id="studio-properties" aria-label="Component properties"><header><div><small id="studio-breadcrumb">School workspace</small><h2 id="studio-selection-title">Design</h2></div><button type="button" data-close-panel="properties" aria-label="Collapse properties">›</button></header><div class="studio-inspector-context"><button type="button" id="studio-select-parent">Select parent ↑</button><p id="studio-property-scope">School-wide settings</p></div><button type="button" id="studio-validation" aria-label="Open the property that needs correction" hidden></button><form id="studio-properties-form" novalidate><div id="studio-inspector"></div></form></aside>
 </div>
 <footer class="studio-status"><p id="studio-status" role="status" aria-live="polite">Draft saved · published version <%= it.data.published_version %></p><span id="studio-review-help">Drafts save privately. Publishing is always explicit.</span><span id="studio-revision" class="studio-sr-only">Revision <%= it.data.revision %></span></footer>
 <button class="studio-sheet-backdrop" id="studio-sheet-backdrop" type="button" aria-label="Close editing panel" hidden></button>
</main>
<dialog class="studio-dialog" id="studio-review-dialog" aria-labelledby="studio-review-title"><header><h2 id="studio-review-title">Review saved changes</h2><button type="button" data-close-dialog aria-label="Close review">×</button></header><p>Publishing updates the school website. Memberships, moderation and approved policies stay under their existing controls.</p><div id="studio-review-meta"></div><div id="studio-review-blockers" role="status"></div><div id="studio-changes"></div><p>Disabling features blocks new actions; existing records remain. A changed question or image requirement may need platform review first.</p><label class="studio-check"><input type="checkbox" id="studio-publish-confirm"> I reviewed the saved changes and their effect on students.</label><div class="studio-dialog-actions"><button type="button" id="studio-request-review">Request form review</button><button type="button" class="studio-primary" id="studio-publish">Publish saved draft</button></div></dialog>
<dialog class="studio-dialog" id="studio-history-dialog" aria-labelledby="studio-history-title"><header><h2 id="studio-history-title">Published versions</h2><button type="button" data-close-dialog aria-label="Close history">×</button></header><section id="studio-version-diff" hidden><h3>Version comparison</h3><div data-version-changes></div></section><p>Restoration creates a new draft for review. It preserves ideas, members, access rules and moderation.</p><% if(!it.data.history.length) { %><p data-history-empty>No published customization versions yet.</p><% } %><% for(const version of it.data.history) { %><div class="studio-history-row"><div><strong>Version <%= version.version %></strong><p><%= version.actor_name || 'School administrator' %> · <%= new Date(version.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %></p><small><%= (version.change_summary||[]).join(', ') %></small></div><button type="button" data-studio-restore="<%= version.version %>">Restore to draft</button></div><% } %></dialog>
<dialog class="studio-dialog" id="studio-conflict-dialog" aria-labelledby="studio-conflict-title"><header><h2 id="studio-conflict-title">A newer draft is available</h2><button type="button" data-close-dialog aria-label="Close conflict">×</button></header><p>Your edits remain in this workspace. Compare them with the saved version below. Changes are never merged or overwritten automatically.</p><div id="studio-conflict-sections"></div><p>Your local edits are retained. Loading the saved draft discards local differences only after confirmation.</p><div class="studio-dialog-actions"><button type="button" id="studio-copy">Copy my unsaved configuration</button><button type="button" id="studio-load-latest">Load latest draft</button></div><textarea id="studio-copy-fallback" readonly hidden aria-label="Unsaved configuration to copy"></textarea></dialog>
<script type="application/json" id="studio-initial"><%~ JSON.stringify({schoolName:it.school.name,configuration:it.data.draft,revision:it.data.revision,published:it.data.published,publishedVersion:it.data.published_version,savedAt:it.data.saved_at,savedBy:it.data.saved_by_name,previewVariants:it.previewVariants,uploadsReady:it.uploadsReady,palettes:it.palettes,icons:it.icons,changes:it.changes}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/school-colors.js?v=20261020-studio-colors"></script><script defer src="/js/school-design.js?v=20261025-landing-ideas"></script><script defer src="/js/school-studio-content.js?v=20261025-canvas-edit"></script><script defer src="/js/school-studio-tools.js?v=20261025-canvas-edit"></script><script defer src="/js/school-studio-model.js?v=20261025-canvas-edit"></script><script defer src="/js/controls.js?v=20261024-controls"></script><script defer src="/js/school-studio-inspector.js?v=20261025-canvas-edit"></script><script defer src="/js/school-customization.js?v=20261025-canvas-edit"></script>
<script defer src="/js/file-upload.js?v=20261021-upload"></script><script defer src="/js/animations.js?v=20261022-home-polish"></script><script defer src="/js/responsive.js?v=20261021-mobile-audit"></script></body></html>
