<!doctype html><html lang="en" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,interactive-widget=resizes-content"><title>Customize workspace — <%= it.school.name %></title><link rel="stylesheet" href="/css/base.bundle.css?v=20261022-continuous-thread"><link rel="stylesheet" href="/css/platform.bundle.css?v=20261018-enrollment"><link rel="stylesheet" href="/css/school-studio.css?v=20261024-controls"><link rel="stylesheet" href="/css/modules/animations.css?v=20261022-home-polish"><link rel="stylesheet" href="/css/modules/file-upload.css?v=20261021-upload"><link rel="stylesheet" href="/css/modules/responsive-primitives.css?v=20261021-mobile-audit"><link rel="stylesheet" href="/css/modules/interaction-feedback.css?v=20261022-compact-group"/><script defer src="/js/interaction-feedback.js?v=20261022-pending-reset"></script><link rel="stylesheet" href="/css/modules/controls.css?v=20261024-controls"/></head><body class="studio-host">
<%~ include('partials/workspace-icons',it) %>
<main class="studio" data-studio data-base="<%= it.base %>">
 <header class="studio-toolbar">
  <div class="studio-brand"><a class="studio-back" href="<%= it.base.replace(/customization$/,'')+(it.base.startsWith('/platform/')?'settings':'school-settings') %>" aria-label="Back to school settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></a><div><strong><span class="studio-wordmark">Sugg<span>Feed</span></span> <span class="studio-title">Studio</span></strong><small title="<%= it.school.name %>"><%= it.school.name %></small></div></div>
  <span class="studio-save-state" id="studio-save-state">Draft saved</span>
  <div class="studio-toolbar-actions"><div class="studio-undo-group"><button type="button" id="studio-undo" aria-label="Undo change" title="Undo · Ctrl/⌘ Z" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 0 12"/></svg></button><button type="button" id="studio-redo" aria-label="Redo change" title="Redo · Ctrl/⌘ Shift Z" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5M20 9H10a6 6 0 0 0 0 12"/></svg></button></div><div class="studio-mode-switch" role="group" aria-label="Workspace mode"><button type="button" id="studio-edit" aria-pressed="true">Edit</button><button type="button" id="studio-mode" aria-pressed="false">Preview</button></div><button type="button" id="studio-save" title="Save privately · Ctrl/⌘ S">Save draft</button><button type="button" class="studio-primary" id="studio-review" aria-describedby="studio-review-help">Review &amp; publish</button></div>
 </header>
 <div class="studio-mobile-tools"><button type="button" data-open-panel="pages">Pages & components</button><span id="studio-mobile-selection">Select a component</span><button type="button" data-open-panel="properties">Edit properties</button></div>
 <div class="studio-body">
  <aside class="studio-panel studio-pages" id="studio-pages" aria-label="Pages and components"><header><h2>Components</h2><button type="button" data-close-panel="pages" aria-label="Collapse components">‹</button></header><label class="studio-page-picker">Page<select id="studio-page"><% for(const [value,label] of [['home','Home'],['feed','Ideas'],['roadmap','Progress'],['idea','Idea detail'],['profile','My activity'],['submit','Submit idea'],['notifications','School updates'],['inbox','Private messages'],['staff','Staff workspace']]) { %><option value="<%= value %>"><%= label %></option><% } %></select></label><label class="studio-search">Find a component<input id="studio-search" type="search" placeholder="Search components…"></label><div id="studio-tree" class="studio-tree"></div><div class="studio-panel-footer"><button type="button" id="studio-history">Version history</button><a href="<%= it.base.replace(/customization$/,'')+(it.base.startsWith('/platform/')?'settings':'school-settings') %>">Policies, access & contacts ↗</a></div></aside>
  <section class="studio-canvas" aria-label="Website editing canvas"><div class="studio-canvas-heading"><button type="button" class="studio-icon-button" data-open-panel="pages" aria-label="Show pages and components" title="Pages & components"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3zM9 4v16"/></svg></button><span id="studio-canvas-title">Home · Mobile</span><div class="studio-canvas-controls"><label><span class="studio-sr-only">Preview device</span><select id="studio-width" data-studio-segmented><option value="1440">Desktop</option><option value="768">Tablet</option><option value="375" selected>Mobile</option><option value="320">320 px</option></select></label><label class="studio-zoom-control"><span class="studio-sr-only">Preview zoom</span><select id="studio-zoom"><option value="fit">Fit</option><option value="0.5">50%</option><option value="0.75">75%</option><option value="1">100%</option></select></label><label><span class="studio-sr-only">Preview appearance</span><select id="studio-theme"><option value="light">Light</option><option value="dark">Dark</option></select></label><details class="studio-more"><summary aria-label="More preview options" title="More preview options"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" stroke-width="4"/></svg></summary><div class="studio-more-content"><label>Example content<select id="studio-scenario"><option value="populated">Populated</option><option value="empty">Empty</option><option value="disabled">Disabled features</option></select></label><button type="button" id="studio-refresh">Reload preview</button><button type="button" id="studio-chrome-theme">Dark editor appearance</button></div></details></div><button type="button" class="studio-icon-button" data-open-panel="properties" aria-label="Show properties" title="Properties"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3zM15 4v16"/></svg></button></div><div class="studio-canvas-scroll" id="studio-canvas-scroll"><div class="studio-board-space" id="studio-board-space"><div class="studio-board" id="studio-board"><iframe id="studio-frame" title="School website preview — click a component to customize" sandbox="allow-scripts allow-same-origin" referrerpolicy="same-origin"></iframe></div></div></div><p class="studio-canvas-hint" id="studio-canvas-hint">Click a component on the website or select it from the component list.</p><div class="studio-frame-loading" id="studio-frame-loading" role="status">Preparing your workspace…</div></section>
  <aside class="studio-panel studio-properties" id="studio-properties" aria-label="Component properties"><header><div><small id="studio-breadcrumb">School workspace</small><h2 id="studio-selection-title">Colors &amp; theme</h2></div><button type="button" data-close-panel="properties" aria-label="Collapse properties">›</button></header><form id="studio-properties-form" novalidate><div id="studio-inspector"></div></form></aside>
 </div>
 <footer class="studio-status"><p id="studio-status" role="status" aria-live="polite">Draft saved · published version <%= it.data.published_version %></p><span id="studio-review-help">Save your draft before reviewing publication.</span><span id="studio-revision" class="studio-sr-only">Revision <%= it.data.revision %></span></footer>
 <button class="studio-sheet-backdrop" id="studio-sheet-backdrop" type="button" aria-label="Close editing panel" hidden></button>
</main>
<dialog class="studio-dialog" id="studio-review-dialog" aria-labelledby="studio-review-title"><header><h2 id="studio-review-title">Review saved changes</h2><button type="button" data-close-dialog aria-label="Close review">×</button></header><p>Publishing updates the school website. Memberships, moderation and approved policies stay under their existing controls.</p><ul id="studio-changes"><% for(const change of it.changes) { %><li><%= change %></li><% } %></ul><p>Disabling features blocks new actions; existing records remain. A changed question or image requirement may need platform review first.</p><label class="studio-check"><input type="checkbox" id="studio-publish-confirm"> I reviewed the saved changes and their effect on students.</label><div class="studio-dialog-actions"><button type="button" id="studio-request-review">Request form review</button><button type="button" class="studio-primary" id="studio-publish">Publish saved draft</button></div></dialog>
<dialog class="studio-dialog" id="studio-history-dialog" aria-labelledby="studio-history-title"><header><h2 id="studio-history-title">Published versions</h2><button type="button" data-close-dialog aria-label="Close history">×</button></header><p>Restoration creates a new draft for review. It preserves ideas, members, access rules and moderation.</p><% if(!it.data.history.length) { %><p data-history-empty>No published customization versions yet.</p><% } %><% for(const version of it.data.history) { %><div class="studio-history-row"><div><strong>Version <%= version.version %></strong><p><%= version.actor_name || 'School administrator' %> · <%= new Date(version.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %></p><small><%= (version.change_summary||[]).join(', ') %></small></div><button type="button" data-studio-restore="<%= version.version %>">Restore to draft</button></div><% } %></dialog>
<dialog class="studio-dialog" id="studio-conflict-dialog" aria-labelledby="studio-conflict-title"><header><h2 id="studio-conflict-title">A newer draft is available</h2><button type="button" data-close-dialog aria-label="Close conflict">×</button></header><p>Your edits remain in this workspace. Copy them before loading the latest saved version; changes are never merged or overwritten automatically.</p><ul id="studio-conflict-sections"></ul><div class="studio-dialog-actions"><button type="button" id="studio-copy">Copy my unsaved configuration</button><button type="button" id="studio-load-latest">Load latest draft</button></div><textarea id="studio-copy-fallback" readonly hidden aria-label="Unsaved configuration to copy"></textarea></dialog>
<script type="application/json" id="studio-initial"><%~ JSON.stringify({schoolName:it.school.name,configuration:it.data.draft,revision:it.data.revision,published:it.data.published,publishedVersion:it.data.published_version,uploadsReady:it.uploadsReady,palettes:it.palettes,icons:it.icons,changes:it.changes}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/school-colors.js?v=20261020-studio-colors"></script><script defer src="/js/school-design.js?v=20261025-landing-ideas"></script><script defer src="/js/school-studio-model.js?v=20261024-controls"></script><script defer src="/js/controls.js?v=20261024-controls"></script><script defer src="/js/school-studio-inspector.js?v=20261025-landing-ideas"></script><script defer src="/js/school-customization.js?v=20261024-controls"></script>
<script defer src="/js/file-upload.js?v=20261021-upload"></script><script defer src="/js/animations.js?v=20261022-home-polish"></script><script defer src="/js/responsive.js?v=20261021-mobile-audit"></script></body></html>
