<% layout('layout') %>

<main class="sf-main">
  <!-- Hero Section -->
  <section class="sf-hero" id="top">
    <div class="sf-hero-orb sf-hero-orb-1" aria-hidden="true"></div>
    <div class="sf-hero-orb sf-hero-orb-2" aria-hidden="true"></div>
    <div class="sf-hero-orb sf-hero-orb-3" aria-hidden="true"></div>
    <div class="sf-hero-container">
      <div class="sf-hero-badge">
        <span class="sf-hero-badge-text">A clearer way to improve campus life</span>
      </div>

      <h1 class="sf-hero-title">
        Make campus better, <span class="sf-hero-title-accent">one idea at a time.</span>
      </h1>
      
      <p class="sf-hero-subtitle">
        Share a suggestion, choose whether to attach your account, and use a private tracking code to check for updates.
      </p>

      <div class="sf-hero-actions">
        <a class="sf-hero-action-primary" href="#action-hub">Share feedback</a>
        <a class="sf-hero-action-secondary" href="#feed">Browse community ideas</a>
      </div>

      <div class="sf-hero-points" aria-label="How SuggFeed works">
        <span>Choose a topic</span>
        <span>Submit anonymously or with your account</span>
        <span>Keep your code to check status</span>
      </div>
    </div>
  </section>

  <!-- Interactive Action Hub / Workspace -->
  <section class="sf-workspace-section" id="action-hub" aria-label="Share feedback or track a submission">
    <div class="sf-workspace-wrapper">
      <!-- Modern Segmented Tabs -->
      <div class="sf-segmented-tabs" role="tablist" aria-label="Action hub tabs" id="sf-segmented-tabs">
        <div class="sf-segmented-glider" id="sf-tab-glider"></div>
        <button
          type="button"
          id="tab-share"
          role="tab"
          aria-controls="panel-share"
          aria-selected="true"
          tabindex="0"
          class="sf-segmented-tab sf-segmented-tab--active"
          data-sf-click="action-58"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          Share an Idea
        </button>
        <button
          type="button"
          id="tab-track"
          role="tab"
          aria-controls="panel-track"
          aria-selected="false"
          tabindex="-1"
          class="sf-segmented-tab"
          data-sf-click="action-59"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Track Submission
        </button>
      </div>

      <!-- Main Action Card -->
      <div class="sf-action-card">
        <!-- Share Panel (Creation Prompt Trigger) -->
        <div id="panel-share" class="sf-share-panel" role="tabpanel" aria-labelledby="tab-share" tabindex="0">
          <button type="button" class="sf-prompt-trigger" data-sf-click="action-60" aria-label="Open the feedback form">
            <span class="sf-prompt-avatar" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
            </span>
            <span class="sf-prompt-placeholder">
              <span id="sf-prompt-dynamic-text" class="sf-prompt-dynamic-text" aria-hidden="true">What would you like to improve on campus?</span>
              <span class="sf-prompt-cursor" aria-hidden="true"></span>
            </span>
            <span class="sf-prompt-actions-wrap">
              <span class="sf-prompt-btn" aria-hidden="true">
                <span>Share idea</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </span>
          </button>

          <!-- Category Shortcut Chips -->
          <div class="sf-shortcuts-row">
            <span class="sf-shortcuts-label">Quick topics:</span>
            <div class="sf-shortcuts-list">
              <button type="button" class="sf-shortcut-chip" data-sf-click="action-61">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="4" y="2" width="16" height="20" rx="2"/>
                  <path d="M9 22v-4h6v4"/>
                </svg>
                Facilities
              </button>
              <button type="button" class="sf-shortcut-chip" data-sf-click="action-62">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                </svg>
                Learning
              </button>
              <button type="button" class="sf-shortcut-chip" data-sf-click="action-63">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                Safety
              </button>
              <button type="button" class="sf-shortcut-chip" data-sf-click="action-64">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                </svg>
                Student life
              </button>
              <button type="button" class="sf-shortcut-chip" data-sf-click="action-65">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                </svg>
                Other
              </button>
            </div>
          </div>
        </div>

        <!-- Track Panel -->
        <form id="panel-track" class="sf-track-panel" role="tabpanel" aria-labelledby="tab-track" tabindex="0" data-sf-submit="action-66" hidden>
          <div class="sf-track-header">
            <h2 class="sf-track-title-head">Check proposal status</h2>
            <p class="sf-track-desc-head">
              Enter your private tracking code (starts with <code>CV-</code>) to view status updates and staff replies.
            </p>
          </div>

          <div class="sf-track-input-group">
            <div class="sf-track-input-wrap">
              <svg class="sf-track-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input
                id="tracking-input"
                name="code"
                placeholder="Enter code (e.g. CV-A1B2C3D4…)"
                autocomplete="off"
                autoCapitalize="characters"
                required
                class="sf-track-input"
                aria-label="Tracking code"
                data-sf-input="action-67"
              />
              <button type="button" id="tracking-clear" class="sf-track-clear-btn" data-sf-click="action-68" aria-label="Clear code" hidden>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </div>
            <button class="sf-btn-track-submit" type="submit" id="track-submit-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              Check status
            </button>
          </div>

          <!-- Recent Codes on This Device -->
          <div id="sf-recent-codes-wrap" class="sf-recent-codes" hidden>
            <span class="sf-recent-codes-label">Saved on this device:</span>
            <div id="sf-recent-codes-list" class="sf-recent-codes-list"></div>
          </div>

          <!-- Error box -->
          <div id="track-error" class="sf-track-error-box" role="alert" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span id="track-error-msg">Tracking code not found.</span>
          </div>

          <!-- Result Card -->
          <div id="track-result" class="sf-track-result-box" role="status" aria-live="polite" hidden>
            <div class="sf-track-result-top">
              <div class="sf-track-result-pills">
                <span id="tr-category" class="sf-pill-cat">Category</span>
                <span id="tr-status" class="status-badge sf-pill-status">Status</span>
              </div>
              <span id="tr-date" class="sf-track-result-date"></span>
            </div>
            <h3 id="tr-title" class="sf-track-result-heading"></h3>
            <p id="tr-desc" class="sf-track-result-body"></p>
            <div id="tr-note-wrap" class="sf-track-note-box" hidden>
              <div class="sf-track-note-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Staff Review Note:
              </div>
              <div id="tr-note" class="sf-track-note-text"></div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Feed Section -->
  <section class="sf-feed-section" id="feed">
    <!-- Header -->
    <div class="sf-feed-header-bar">
      <div>
        <div class="sf-feed-kicker">COMMUNITY IDEAS</div>
        <h2 class="sf-feed-headline">What the campus is talking about</h2>
      </div>
      <button type="button" class="sf-btn-share-alt" data-sf-click="action-69">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Submit suggestion
      </button>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="sf-toolbar">
      <!-- Search -->
      <div class="sf-search-box">
        <svg class="sf-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          class="sf-search-input"
          type="text"
          id="home-search"
          placeholder="Search ideas by title or keyword…"
          aria-label="Search ideas"
          data-sf-input="action-70"
        />
        <div class="sf-search-kbd-hint" id="search-kbd-hint" title="Press / to search">/</div>
        <button type="button" id="search-clear-btn" class="sf-search-clear" data-sf-click="action-71" aria-label="Clear search" hidden>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Sort Dropdown -->
      <div class="sf-sort-dropdown-wrap" data-sf-click="action-72">
        <button type="button" class="sf-sort-toggle" id="home-sort-btn" data-sf-click="action-73" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="21" x2="4" y2="14"/>
            <line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/>
            <line x1="20" y1="12" x2="20" y2="3"/>
          </svg>
          <span id="home-sort-label">Most Supported</span>
          <svg id="home-sort-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sf-sort-chevron">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="sf-sort-popup" id="home-sort-menu" hidden>
          <button type="button" class="sf-sort-item sf-sort-item--active" data-sort="popular" data-sf-click="action-74">
            Most Supported
            <svg class="sf-sort-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </button>
          <button type="button" class="sf-sort-item" data-sort="newest" data-sf-click="action-75">
            Newest First
          </button>
          <button type="button" class="sf-sort-item" data-sort="oldest" data-sf-click="action-76">
            Oldest First
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="sf-category-pills" role="group" aria-label="Filter by category" id="cat-chips">
        <button type="button" class="sf-cat-pill sf-cat-pill--active" data-cat="All" aria-pressed="true" data-sf-click="action-77">
          All <span class="sf-cat-count"><%= (it.feed ? it.feed.length : 0) %></span>
        </button>
        <% for (const cat of it.categories) { 
             const catCount = (it.feed || []).filter(item => (item.category ?? (item.categories?.name ?? 'Other')) === cat).length;
        %>
          <button type="button" class="sf-cat-pill" data-cat="<%= cat %>" aria-pressed="false" data-sf-click="action-78" data-sf-click-arg-0="<%= cat %>">
            <%= cat %> <span class="sf-cat-count"><%= catCount %></span>
          </button>
        <% } %>
      </div>
    </div>

    <!-- Live Results Count -->
    <div class="sf-results-meta">
      <span id="sf-visible-count" aria-live="polite" aria-atomic="true"><%= (it.feed ? it.feed.length : 0) %> ideas shown</span>
    </div>

    <!-- Ideas Grid -->
    <div class="sf-ideas-grid" id="ideas-grid">
      <% if (!it.feed || it.feed.length === 0) { %>
        <div class="sf-empty-state-wrap">
          <div class="sf-empty-box">
            <div class="sf-empty-icon-wrap" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <h3 class="sf-empty-head">No suggestions found</h3>
            <p class="sf-empty-msg">Be the first student or faculty member to submit an idea for this category.</p>
            <button type="button" class="sf-btn-empty-action" data-sf-click="action-79">
              Submit the first idea
            </button>
          </div>
        </div>
      <% } else { %>
        <% for (const item of it.feed) { %>
          <article
            class="sf-idea-card"
            data-id="<%= item.id %>"
            data-category="<%= item.category ?? (item.categories?.name ?? 'Other') %>"
            data-title="<%= (item.title || '').toLowerCase() %>"
            data-desc="<%= (item.description || '').toLowerCase() %>"
            data-votes="<%= item.vote_count ?? 0 %>"
            data-date="<%= new Date(item.created_at).getTime() %>"
          >
            <!-- Card Meta Header -->
            <div class="sf-card-meta">
              <span class="sf-card-cat-badge">
                <%= item.category ?? (item.categories?.name ?? 'Other') %>
              </span>
              <span class="status-badge <%= (item.status || 'pending').replace('_', '-') %>">
                <span class="sf-status-dot"></span>
                <%= (item.status || 'pending').replace('_', ' ') %>
              </span>
              <span class="sf-card-date">
                <%= new Date(item.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %>
              </span>
            </div>

            <!-- Card Title & Description -->
            <h3 class="sf-card-title"><a href="/idea/<%= item.id %>"><%= item.title %></a></h3>
            <p class="sf-card-desc"><%= item.description %></p>

            <!-- Card Footer -->
            <div class="sf-card-footer">
              <button
                type="button"
                class="sf-vote-btn"
                data-sf-click="action-80" data-sf-click-arg-0="<%= item.id %>"
                aria-label="Upvote: <%= item.title %>"
              >
                <svg class="sf-vote-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="18 15 12 9 6 15"/>
                </svg>
                <span class="sf-vote-num"><%= item.vote_count ?? 0 %></span>
              </button>

              <div class="sf-card-footer-right">
                <% if (item.comment_count !== undefined && item.comment_count > 0) { %>
                  <span class="sf-comment-pill" title="<%= item.comment_count %> comments">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <%= item.comment_count %>
                  </span>
                <% } %>
                <a href="/idea/<%= item.id %>" class="sf-card-link-arrow" aria-label="View idea: <%= item.title %>">
                  View →
                </a>
              </div>
            </div>
          </article>
        <% } %>
      <% } %>
    </div>

    <div class="sf-filter-empty" id="sf-filter-empty" role="status" hidden>
      <h3>No ideas match those filters</h3>
      <p>Try another search or show all categories.</p>
      <button type="button" class="sf-filter-reset" data-sf-click="action-81">Clear filters</button>
    </div>

    <!-- Feed Footer Banner -->
    <div class="sf-feed-more-wrap">
      <a href="/feed" class="sf-feed-more-btn">
        Browse all community proposals
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Modern Footer -->
  <footer class="sf-footer">
    <div class="sf-footer-content">
      <div class="sf-footer-brand">
        <span class="sf-footer-logo-dot"></span>
        <span class="sf-footer-brand-name">SuggFeed</span>
        <span class="sf-footer-tagline">Campus feedback and suggestions</span>
      </div>
      <div class="sf-footer-links">
        <a href="/privacy" class="sf-footer-link">Privacy</a>
        <span class="sf-footer-sep">•</span>
        <a href="/terms" class="sf-footer-link">Terms</a>
        <span class="sf-footer-sep">•</span>
        <a href="/roadmap" class="sf-footer-link">Roadmap</a>
        <span class="sf-footer-sep">•</span>
        <a href="/admin" class="sf-footer-link">Staff Portal</a>
      </div>
    </div>
  </footer>
</main>

<script src="/js/home.js?v=20261010-ts"></script>
