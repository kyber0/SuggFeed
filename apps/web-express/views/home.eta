<% layout('layout'); const welcome=it.schoolCustomization?.welcome; const identity=it.schoolCustomization;const highlights=(it.feed||[]).slice(0,6);const progress=(it.feed||[]).filter(item=>['in_progress','resolved'].includes(item.status)).slice(0,3); %>
<main data-student-home="<%= it.user?'returning':'welcome' %>" class="sf-main sf-landing">
 <section class="sf-hero landing-hero" id="top" aria-labelledby="home-title">
  <% if(identity?.cover){ %><img class="school-welcome-cover" src="<%= it.schoolBase %>/branding/<%= identity.cover %>" alt="" width="1600" height="600"/><% } %>
  <div class="sf-hero-container landing-hero-grid">
   <div class="landing-welcome">
    <div class="school-welcome-identity"><% if(identity?.logo){ %><img src="<%= it.schoolBase %>/branding/<%= identity.logo %>" alt="" width="40" height="40"/><% } %><strong><%= identity?.displayName||it.schoolName||'Your campus community' %></strong></div>
    <p class="student-eyebrow">SMALL IDEAS. SHARED PROGRESS.</p>
    <h1 id="home-title" class="sf-hero-title<%= welcome?.headline?' landing-custom-headline':'' %>" data-sf-split-text="words"><% if(welcome?.headline){ %><span class="sf-hero-title-accent"><%= welcome.headline %></span><% }else{ %>Your ideas can <span class="sf-hero-title-accent">shape your campus.</span><% } %></h1>
    <p class="sf-hero-subtitle"><%= welcome?.intro||'Share what could be better, support useful suggestions, and follow your school’s progress.' %></p>
    <p class="school-welcome-message" <%= welcome?.message?'':'hidden' %>><%= welcome?.message||'' %></p>
    <div class="sf-hero-actions"><button type="button" class="sf-hero-action-primary" data-sf-magnetic data-sf-click="action-60">Share an idea <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button><a class="sf-hero-action-secondary" href="#action-hub" data-home-track>Track an idea <span aria-hidden="true">→</span></a></div>
    <div class="landing-topics" aria-label="Start with a school topic"><% for(const cat of (it.schoolCategories||[]).slice(0,4)){ %><button type="button" data-school-submit-category="<%= cat.id %>"><%= cat.name %></button><% } %></div>
    <p class="school-welcome-help" <%= welcome?.help?'':'hidden' %>><%= welcome?.help||'' %></p>
    <nav class="school-welcome-links" aria-label="Official school links" <%= welcome?.links?.length?'':'hidden' %>><% for(const link of welcome?.links||[]){ %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %> ↗</a><% } %></nav>
   </div>
   <div class="landing-companion"><% if(it.user){ %><%~ include('partials/student-home-brief',it) %><% }else{ %><%~ include('partials/home-journey',it) %><% } %></div>
  </div>
 </section>
 <section class="sf-workspace-section landing-tracking" id="action-hub" aria-label="Track a private submission">
  <div class="sf-workspace-wrapper"><details class="landing-track-disclosure" id="home-tracking"><summary><svg class="workspace-svg" aria-hidden="true"><use href="#ws-shield"/></svg><span><strong>Already shared an idea?</strong><span>Check its status with your private tracking code.</span></span><svg class="workspace-svg" aria-hidden="true"><use href="#ws-chevron-down"/></svg></summary><div class="landing-track-body"><form id="panel-track" class="sf-track-panel" aria-labelledby="home-track-title" tabindex="0" data-sf-submit="action-66">
          <div class="sf-track-header">
            <h2 class="sf-track-title-head" id="home-track-title">Check idea status</h2>
            <p class="sf-track-desc-head">
              Enter your private tracking code (starts with <code>CV-</code>) to view status updates and staff replies.
            </p>
          </div>

          <div class="sf-track-input-group">
            <div class="sf-track-input-wrap">
              <svg class="sf-track-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input
                id="tracking-input"
                name="code"
                placeholder="Enter code (e.g. CV-A1B2C3D4…)"
                autocomplete="off"
                autoCapitalize="characters"
                required
                class="sf-track-input"
                aria-label="Tracking code"
                data-sf-input="action-67"
              />
              <button type="button" id="tracking-clear" class="sf-track-clear-btn" data-sf-click="action-68" aria-label="Clear code" hidden>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </div>
            <button class="sf-btn-track-submit" type="submit" id="track-submit-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              Check status
            </button>
          </div>

          <!-- Recent Codes on This Device -->
          <div id="sf-recent-codes-wrap" class="sf-recent-codes" hidden>
            <span class="sf-recent-codes-label">Saved on this device:</span>
            <div id="sf-recent-codes-list" class="sf-recent-codes-list"></div>
          </div>

          <!-- Error box -->
          <div id="track-error" class="sf-track-error-box" role="alert" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span id="track-error-msg">Tracking code not found.</span>
          </div>

          <!-- Result Card -->
          <div id="track-result" class="sf-track-result-box" role="status" aria-live="polite" hidden>
            <div class="sf-track-result-top">
              <div class="sf-track-result-pills">
                <span id="tr-category" class="sf-pill-cat">Category</span>
                <span id="tr-status" class="status-badge sf-pill-status">Status</span>
              </div>
              <span id="tr-date" class="sf-track-result-date"></span>
            </div>
            <p id="tr-state-detail" class="student-status-explanation"></p><h3 id="tr-title" class="sf-track-result-heading"></h3>
            <p id="tr-desc" class="sf-track-result-body"></p>
            <div id="tr-note-wrap" class="sf-track-note-box" hidden>
              <div class="sf-track-note-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Staff Review Note:
              </div>
              <div id="tr-note" class="sf-track-note-text"></div>
            </div>
          </div>
        </form></div></details></div>
 </section>
 <section class="sf-feed-section landing-highlights" id="feed" aria-labelledby="highlights-title">
  <header class="landing-section-heading"><div><p class="student-eyebrow">THE COMMUNITY BOARD</p><h2 id="highlights-title">Ideas from your community</h2><p>Good ideas grow when we build on each other.</p></div><a class="student-text-link" href="/feed">View all ideas →</a></header>
  <div id="feed-posts-container" class="landing-ideas-grid"><% for(const item of highlights){ %><%~ include('partials/feed-card',{...it,item,compact:true}) %><% } %></div>
  <% if(!highlights.length){ %><%~ include('partials/empty-state',{icon:'message',heading:'Great changes start with one idea',description:'Published suggestions will appear here after school review. Share a constructive improvement to start the conversation.',actions:[{label:'Share an idea',event:'action-60'}]}) %><% } %>
 </section>
 <% if(progress.length&&it.schoolCustomization?.features.roadmap!==false){ %><section class="landing-progress" aria-labelledby="home-progress-title"><header class="landing-section-heading"><div><p class="student-eyebrow">FROM FEEDBACK TO ACTION</p><h2 id="home-progress-title">See what’s moving forward</h2><p>Explore ideas with work underway or a recorded outcome.</p></div><a class="student-text-link" href="/roadmap">Explore progress →</a></header><div class="landing-progress-grid"><% for(const item of progress){ %><a href="/idea/<%= item.id %>" class="landing-outcome"><span class="student-state" data-tone="<%= item.status==='resolved'?'success':'progress' %>"><%= it.schoolCustomization?.labels?.[item.status]||(item.status==='resolved'?'Completed':'In progress') %></span><h3><%= item.title %></h3><p><%= item.staff_note||'Open this idea to read the school’s published progress.' %></p><span class="student-text-link">Read progress →</span></a><% } %></div></section><% } %>
 <section class="landing-guide"><% if(it.user){ %><details class="student-home-guide"><summary>How SuggFeed works</summary><%~ include('partials/home-story',it) %></details><% }else{ %><%~ include('partials/home-story',it) %><% } %><p class="landing-review-note">Every submission is reviewed. A receipt confirms delivery, not approval.</p></section>
  <!-- Modern Footer -->
  <footer class="sf-footer">
    <div class="sf-footer-content">
      <div class="sf-footer-brand">
        <span class="sf-footer-logo-dot"></span>
        <span class="sf-footer-brand-name">SuggFeed</span>
        <span class="sf-footer-tagline">Campus feedback and suggestions</span>
      </div>
      <div class="sf-footer-links">
        <a href="/privacy" class="sf-footer-link">Privacy</a>
        <span class="sf-footer-sep">•</span>
        <a href="/terms" class="sf-footer-link">Terms</a>
        <span class="sf-footer-sep">•</span>
        <a href="/roadmap" class="sf-footer-link">Progress</a>
        <span class="sf-footer-sep">•</span>
        <a href="/admin" class="sf-footer-link">Staff Portal</a>
      </div>
    </div>
  </footer>
<div id="sf-feed-config" hidden data-highlights="true" data-sort="all" data-category="All" data-search="" data-page="1" data-has-more="false" data-votes="<%= JSON.stringify(it.votedIds||[]) %>" data-vote-state="<%= it.voteStateKnown!==false %>"></div>
</main>
<%~ include('partials/assistant-widget',it) %>

<script defer src="/js/home.js?v=20261025-landing-ideas"></script>

<script defer src="/js/feed.js?v=20261026-audit-remediation"></script>
