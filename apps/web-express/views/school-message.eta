<% layout('layout') %>
<main class="<%= it.platformDashboard ? 'platform-message' : 'sf-legal-page' %>"><div class="<%= it.platformDashboard ? '' : 'sf-legal-container' %>"><% if (it.platformDashboard) { %><p class="eyebrow">Super admin workspace</p><% } %><h1><%= it.title %></h1><p role="status"><%= it.message %></p><% if (it.invitationUrl) { %><label for="invitation-url">One-time invitation path</label><input id="invitation-url" readonly value="<%= it.invitationUrl %>" size="80" /><p><a href="<%= it.invitationUrl %>">Open invitation</a></p><% } %><p><a href="<%= it.platformDashboard ? '/platform/schools' : '/schools' %>"><%= it.platformDashboard ? 'Back to super admin dashboard' : 'Your schools' %></a></p></div></main>
