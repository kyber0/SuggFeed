<% layout('layout') %>
<main class="sf-legal-page"><div class="sf-legal-container"><h1><%= it.title %></h1><p role="status"><%= it.message %></p><% if (it.invitationUrl) { %><label for="invitation-url">One-time invitation path</label><input id="invitation-url" readonly value="<%= it.invitationUrl %>" size="80" /><p><a href="<%= it.invitationUrl %>">Open invitation</a></p><% } %><p><a href="/schools">Your schools</a></p></div></main>
