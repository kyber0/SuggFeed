<% layout('layout') %>
<main class="campus-roadmap notifications-page">
 <header class="workspace-heading">
  <div><p class="workspace-kicker">STAY IN THE LOOP</p><h1>Your school updates</h1><p class="roadmap-subtitle">Milestones, blockers and completed improvements from ideas you follow.</p></div>
  <a class="workspace-button" href="/roadmap">Explore the roadmap →</a>
 </header>
 <% if (!it.signedIn) { %>
  <%~ include('partials/empty-state',{hero:true,icon:'bell',heading:'Keep up with ideas you care about',description:'Sign in and follow an idea to see your school’s progress updates here.',actions:[{label:'Sign in',event:'action-94'},{label:'Explore the roadmap',href:'/roadmap',secondary:true}],hint:'Following an idea enables in-app updates. Email preferences are managed separately.'}) %>
 <% } else { %>
  <div class="notification-layout">
  <section class="notification-stream" aria-labelledby="notification-stream-title">
   <h2 id="notification-stream-title">Latest updates</h2>
   <p id="notification-summary" role="status"><%= it.renderMode==='studio'?'Fictional school updates for this preview.':'Loading your updates…' %></p>
   <p id="notification-error" class="workspace-message" role="alert" hidden></p>
   <ol class="notification-list" id="notification-list"><% if(it.renderMode==='studio') { %><%~ include('partials/school-studio-examples',{...it,kind:'notifications'}) %><% } %></ol>
   <div class="notification-actions"><button type="button" class="workspace-button" id="notification-retry" hidden>Try again</button><button type="button" class="workspace-button" id="notification-more" hidden>Load older updates</button></div>
  </section>
  <details class="care-card notification-settings">
   <summary>Notification preferences</summary>
   <form id="notification-preferences" class="care-form">
    <label>In-app updates<select name="update_mode" class="workspace-input"><option value="all">All school updates</option><option value="milestones">Milestones, starts, blockers, completion and corrections</option></select></label>
    <label><span><input type="checkbox" name="weekly_digest" data-sf-switch role="switch" disabled/> Optional weekly email digest</span></label>
    <label><span><input type="checkbox" name="digest_paused" data-sf-switch role="switch"/> Pause weekly email until I resume it</span></label>
    <fieldset class="digest-kinds"><legend>Include these public notification types in weekly email</legend>
     <% for(const [kind,label] of [['started','Work started'],['update','Progress updates'],['milestone','Milestones'],['blocked','Blockers'],['completed','Completed work'],['correction','Corrections'],['resumed','Work resumed'],['reopened','Work reopened'],['withdrawn','Withdrawals']]) { %>
      <label><input type="checkbox" name="digest_kinds" value="<%= kind %>" checked/> <%= label %></label>
     <% } %>
    </fieldset>
    <p>Weekly email summarizes eligible in-app notifications on ideas you currently follow. Your in-app mode also affects which updates are available to summarize.</p><p id="digest-window"></p>
    <p id="digest-availability">Checking email availability…</p>
    <button class="workspace-button" type="submit" disabled>Save preferences</button><p id="preferences-status" role="status"></p>
   </form>
   <div class="workspace-actions"><a href="/feed?scope=following">Browse ideas you follow →</a><a href="/inbox">Private school messages →</a></div>
  </details>
  </div>
  <script defer src="/js/notifications.js?v=20261018-empty-states"></script>
 <% } %>
</main>
