<% layout('layout') %><main class="platform-page"><header class="platform-heading"><div><a href="/platform/schools">← Platform dashboard</a><h1>School customization</h1><p>Roll out editing and review collection changes. These controls do not enter a school’s client workspace.</p></div></header><% if(it.saved) { %><p class="school-settings-feedback" role="status">Saved.</p><% } %><% if(!it.rows.length) { %><section class="platform-panel"><h2>No customization drafts yet</h2><p>The demo school can begin editing from School settings. Other schools can be enabled below from their platform directory entry.</p></section><% } %><% for(const row of it.rows) { %><section class="platform-panel"><header><h2><%= row.schools?.name || row.school_id %></h2></header><div class="school-settings-card-body"><form method="post" action="/platform/schools/<%= row.school_id %>/customization-rollout"><input type="hidden" name="enabled" value="<%= row.editing_enabled?'false':'true' %>"/><p>Editor: <strong><%= row.editing_enabled?'enabled':'disabled' %></strong>. Published appearance stays available when editing is disabled.</p><% if(row.grantEvent) { %><p>Last grant change: <%= row.grantEvent.profiles?.display_name || row.grantEvent.actor_id %> · <%= new Date(row.grantEvent.created_at).toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %></p><% } %><button class="workspace-button" type="submit"><%= row.editing_enabled?'Pause editing':'Enable editing' %></button></form><% if(row.review_requested_at && row.draft) { %><h3>Requested form review · revision <%= row.revision %></h3><p>Confirm the school’s approved privacy notice covers the questions and image collection below. This review does not certify legal compliance.</p><p><strong>Image attachments:</strong> <%= row.draft.form.attachments %></p><p><%= row.draft.form.instructions %></p><ol><% for(const q of row.draft.form.questions) { %><li><strong><%= q.label %></strong> · <%= q.type %> · <%= q.required?'required':'optional' %><p><%= q.help %></p><% if(q.options.length) { %><p>Choices: <%= q.options.join(', ') %></p><% } %></li><% } %></ol><form method="post" action="/platform/schools/<%= row.school_id %>/customization-review" class="care-form"><input type="hidden" name="revision" value="<%= row.revision %>"/><label>Policy and form review reference<textarea class="workspace-input" name="reference" minlength="10" maxlength="2000" rows="3" required></textarea></label><button class="school-settings-primary" type="submit">Approve this form against current policy</button></form><% } else { %><p>No form review requested.</p><% } %></div></section><% } %><nav class="platform-pagination" aria-label="Customization pages"><% if(it.page>0) { %><a href="?page=<%= it.page-1 %>">Previous</a><% } %><% if(it.nextPage) { %><a href="?page=<%= it.page+1 %>">Next</a><% } %></nav></main>
