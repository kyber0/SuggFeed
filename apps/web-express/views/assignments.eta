<% layout('layout');const admin=it.isAssignmentAdmin,state=it.state||{},settings=state.settings||{},staff=state.staff||[],teams=state.teams||[],categories=state.categories||[];const personName=id=>staff.find(p=>p.user_id===id)?.display_name||'Staff member';const fields=[['ackMinutes','Acknowledge within'],['resolveMinutes','Resolve within'],['remindAfterMinutes','Reminder after deadline'],['supervisorAfterMinutes','Notify supervisor after deadline'],['reassignAfterMinutes','Reassign after deadline']];const dt=value=>value&&Number.isFinite(Date.parse(value))?new Date(value).toLocaleString('en-PH',{timeZone:'Asia/Manila',dateStyle:'medium',timeStyle:'short'})+' PHT':'Not set';const members=state.members||[];const isAway=p=>p.away&&(!p.away_until||new Date(p.away_until).getTime()>Date.now()); %>
<main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main assignment-page">
<header class="workspace-heading"><div><p class="workspace-kicker"><%= it.routing?'SCHOOL MANAGEMENT':'DAILY WORK' %></p><h1><%= it.routing?'Routing & teams':'My work' %></h1><p><%= it.routing?'Configure ownership, capacity and escalation once. Daily tasks stay in My work.':'Acknowledge ownership, make decisions and keep approved work moving.' %></p></div></header>
<% if(it.routing&&!settings.enabled) { %><p class="assignment-notice">Automatic routing is disabled. Configure your real teams, staff and SLA durations before enabling it. Urgent items still fall back to an active school administrator; no deadlines are invented.</p><% } %>
<nav class="assignment-tabs portal-section-tabs" aria-label="<%= it.routing?'Routing configuration':'Assigned work views' %>"><% for(const [key,label] of (it.routing?[['teams','Teams & availability'],['rules','Routing rules'],['workload','Capacity'],['settings','Escalations & settings']]:admin?[['mine','My items'],['triage','Needs an owner'],['all','All open'],['overdue','Overdue']]:[['mine','My items']])) { %><a href="<%= it.assignmentBase %>?view=<%= key %>" aria-current="<%= it.view===key?'page':'false' %>"><%= label %></a><% } %></nav>
<% if(it.pageChanged) { %><p class="assignment-notice" role="status">The previous page no longer has matching work. Showing the first page.</p><% } %><noscript><p class="assignment-notice">Enable JavaScript to save assignment changes. Current assignments and settings remain readable.</p></noscript><p class="workspace-message" id="assignment-message" role="status" aria-live="polite"></p><% if(it.view==='history') { %><section class="assignment-card"><h2>Assignment history</h2><p>Ownership, acknowledgements and escalations remain recorded after work closes.</p><ol class="assignment-history"><% for(const event of it.history?.events||[]) { %><li><strong><%= event.action %> · <%= dt(event.created_at) %></strong><p><%= event.reason %></p><% if(event.previous?.person||event.new_value?.person) { %><p><%= event.previous?.person?personName(event.previous.person):'Unassigned' %> → <%= event.new_value?.person?personName(event.new_value.person):'Unassigned' %></p><% } %></li><% } %></ol><% if(!it.history?.events?.length) { %><p>No assignment events recorded yet.</p><% } %></section><% } %>
<% if(['mine','triage','all','overdue'].includes(it.view)) { const availability=it.list.availability||{}; %>
<details class="assignment-card"><summary>Your availability <span><%= isAway(availability)?'Away':'Available' %></span></summary><form method="post" action="/admin/assignments/action" data-assignment-form="availability" class="assignment-form"><label class="assignment-check"><input type="checkbox" name="away" <%= isAway(availability)?'checked':'' %>/> I am away</label><label>Return date · optional<input class="workspace-input" type="datetime-local" name="awayUntil" data-away-until="<%= availability.away_until||'' %>"/></label><button class="workspace-button" type="submit">Save availability</button><p>Opening an item does not acknowledge it. Use Acknowledge when you take ownership.</p></form><form method="post" action="/admin/assignments/action" data-assignment-form="preferences" class="assignment-form"><label class="assignment-check"><input type="checkbox" name="notifications" <%= availability.notifications!==false?'checked':'' %>/> Ordinary assignment notifications</label><button class="workspace-button" type="submit">Save preference</button><p>Urgent assignment notices always remain on.</p></form></details>
<% const records=it.list.items||[];const groups=[['acknowledge','Acknowledge ownership',records.filter(i=>(i.assignee_id===it.user.id||i.can_acknowledge)&&!i.acknowledged_at)],['review','Review & safety',records.filter(i=>!((i.assignee_id===it.user.id||i.can_acknowledge)&&!i.acknowledged_at)&&(i.item_kind==='report'||i.status==='pending'))],['delivery','Delivery & follow-through',records.filter(i=>!((i.assignee_id===it.user.id||i.can_acknowledge)&&!i.acknowledged_at)&&i.item_kind!=='report'&&i.status!=='pending')]]; %>
<nav class="portal-task-summary" aria-label="Tasks on this page"><% for(const [key,label,items] of groups) { %><% if(items.length) { %><a href="#work-<%= key %>"><% } else { %><div class="portal-task-empty"><% } %><strong><%= items.length %></strong><span><%= label %></span><% if(items.length) { %></a><% } else { %></div><% } %><% } %></nav><p class="staff-footnote">Your authorized items · counts on this page only · up to 50 per page. Opening an item does not acknowledge it.</p>
<% for(const [key,label,items] of groups) { if(!items.length)continue; %><section class="portal-work-group" id="work-<%= key %>"><header><h2><%= label %></h2><span><%= items.length %> on this page</span></header><div class="assignment-items"><% for(const item of items) { %><%~ include('partials/staff-assignment-item',{...it,item}) %><% } %><% if(!items.length) { %><p class="portal-quiet-state">No matching items in this group on this page.</p><% } %></div></section><% } %>
<% if(!records.length) { %><%~ include('partials/empty-state',{icon:'check',heading:'No open work in this view',description:'New eligible assignments appear here. Choose another view to see other authorized work.'}) %><% } %>
<nav class="assignment-pagination" aria-label="Assignment pages"><% if(it.list.page>1) { %><a class="workspace-button" href="<%= it.assignmentBase %>?view=<%= it.view %>&page=<%= it.list.page-1 %>">← Previous</a><% } %><span>Page <%= it.list.page %></span><% if(it.list.items?.length===50) { %><a class="workspace-button" href="<%= it.assignmentBase %>?view=<%= it.view %>&page=<%= it.list.page+1 %>">Next →</a><% } %></nav>
<% } %>
<% if(admin&&it.view==='teams') { %><section class="assignment-card"><h2>Teams</h2><p>Supervisors and backups must be active school administrators. Teams without eligible, available members cannot receive ordinary automatic assignments.</p><% for(const team of [...teams,{id:'',name:'',active:true}]) { %><details <%= !team.id?'open':'' %>><summary><%= team.name||'Add a team' %><span><%= team.id&&!team.active?'Inactive':'' %></span></summary><form method="post" action="/admin/assignments/action" class="assignment-form" data-assignment-form="team"><input type="hidden" name="id" value="<%= team.id %>"/><label>Team name<input class="workspace-input" name="name" value="<%= team.name %>" required maxlength="80"/></label><label>Supervisor<select class="workspace-input" name="supervisor" required><option value="">Choose an administrator</option><% for(const p of staff.filter(p=>p.role==='admin')) { %><option value="<%= p.user_id %>" <%= team.supervisor_id===p.user_id?'selected':'' %>><%= p.display_name||'Administrator' %></option><% } %></select></label><label>Backup<select class="workspace-input" name="backup"><option value="">Not configured</option><% for(const p of staff.filter(p=>p.role==='admin')) { %><option value="<%= p.user_id %>" <%= team.backup_id===p.user_id?'selected':'' %>><%= p.display_name||'Administrator' %></option><% } %></select></label><label class="assignment-check"><input type="checkbox" name="active" <%= team.active?'checked':'' %>/> Active team</label><button class="workspace-button" type="submit">Save team</button></form></details><% } %></section>
<section class="assignment-card"><h2>Staff eligibility &amp; availability</h2><% for(const person of staff) { %><details><summary><%= person.display_name||'Staff member' %><span><%= person.role %><%= isAway(person)?' · Away':'' %></span></summary><form method="post" action="/admin/assignments/action" class="assignment-form" data-assignment-form="assignee"><input type="hidden" name="userId" value="<%= person.user_id %>"/><label class="assignment-check"><input type="checkbox" name="active" <%= person.active?'checked':'' %>/> Eligible for automatic assignment</label><label>Maximum open items · optional<input class="workspace-input" type="number" min="1" max="10000" name="maxOpen" value="<%= person.max_open||'' %>" placeholder="Use the school limit"/></label><label class="assignment-check"><input type="checkbox" name="notifications" <%= person.notifications!==false?'checked':'' %>/> Assignment notifications · urgent notices always remain on</label><fieldset class="assignment-wide"><legend>Teams</legend><% for(const team of teams) { %><label class="assignment-check"><input type="checkbox" name="teams" value="<%= team.id %>" <%= members.some(m=>m.team_id===team.id&&m.user_id===person.user_id)?'checked':'' %>/><%= team.name %></label><% } %></fieldset><button class="workspace-button" type="submit">Save eligibility</button></form><form method="post" action="/admin/assignments/action" class="assignment-form" data-assignment-form="availability"><input type="hidden" name="userId" value="<%= person.user_id %>"/><label class="assignment-check"><input type="checkbox" name="away" <%= isAway(person)?'checked':'' %>/> Away</label><label>Return date · optional<input class="workspace-input" type="datetime-local" name="awayUntil" data-away-until="<%= person.away_until||'' %>"/></label><button class="workspace-button" type="submit">Save availability</button></form></details><% } %></section><% } %>
<% if(admin&&it.view==='rules') { %><section class="assignment-card"><h2>Category routing rules</h2><p>Lower order numbers are checked first. An empty category is a fallback for that item type. Reports and private safety items can be assigned only to administrators.</p><% for(const rule of [...(state.rules||[]),{id:'',active:true,item_kind:'suggestion'}]) { %><details <%= !rule.id?'open':'' %>><summary><%= rule.id?(categories.find(c=>c.id===rule.category_id)?.name||'All categories')+' → '+(teams.find(t=>t.id===rule.team_id)?.name||'Unavailable team'):'Add a rule' %></summary><form method="post" action="/admin/assignments/action" class="assignment-form" data-assignment-form="rule"><input type="hidden" name="id" value="<%= rule.id %>"/><label>Item type<select class="workspace-input" name="kind"><option value="suggestion">Suggestion</option><option value="report" <%= rule.item_kind==='report'?'selected':'' %>>Safety report</option></select></label><label>Category<select class="workspace-input" name="category"><option value="">All categories · fallback</option><% for(const category of categories) { %><option value="<%= category.id %>" <%= rule.category_id===category.id?'selected':'' %>><%= category.name %></option><% } %></select></label><label>Team<select class="workspace-input" name="team" required><option value="">Choose a team</option><% for(const team of teams.filter(t=>t.active)) { %><option value="<%= team.id %>" <%= rule.team_id===team.id?'selected':'' %>><%= team.name %><%= !members.some(m=>m.team_id===team.id&&staff.some(p=>p.user_id===m.user_id&&p.active&&!isAway(p)&&(rule.item_kind!=='report'||p.role==='admin')))?' · no available eligible members':'' %></option><% } %></select></label><label>Rule order<input class="workspace-input" type="number" name="order" value="<%= rule.priority_order??'' %>" min="0" max="10000" required/></label><label class="assignment-check"><input type="checkbox" name="active" <%= rule.active?'checked':'' %>/> Rule enabled</label><fieldset class="assignment-wide" data-rule-sla><legend>Category SLA override · optional</legend><p>Leave all fields empty to use the school priority settings.</p><div class="assignment-form"><% for(const [key,label] of fields) { %><label><%= label %> · minutes<input class="workspace-input" type="number" data-sla-key="<%= key %>" value="<%= rule.sla_override?.[key]||'' %>" min="1" max="525600"/></label><% } %></div></fieldset><button class="workspace-button" type="submit">Save rule</button></form></details><% } %></section><% } %>
<% if(admin&&it.view==='workload') { %><section class="assignment-card"><h2>Current workload</h2><div class="assignment-workload"><% for(const row of state.workload||[]) { %><article><h3><%= row.display_name||'Staff member' %></h3><dl class="assignment-facts"><div><dt>Open items</dt><dd><%= row.open_items %></dd></div><div><dt>Overdue</dt><dd><%= row.overdue_items %></dd></div><div><dt>Average acknowledgement</dt><dd><%= row.avg_ack_minutes==null?'No acknowledgements yet':Math.round(Number(row.avg_ack_minutes))+' min' %></dd></div></dl></article><% } %></div></section><% } %>
<% if(admin&&it.view==='settings') { %><section class="assignment-card"><h2>Assignment settings</h2><p>Enter durations approved by your school. Values are elapsed minutes, including nights and weekends. Urgent deadlines must be shorter than normal deadlines. Updating these settings applies to future assignments; existing deadlines are preserved.</p><form method="post" action="/admin/assignments/action" class="assignment-form" data-assignment-form="settings"><input type="hidden" name="revision" value="<%= settings.revision||0 %>"/><label class="assignment-check"><input type="checkbox" name="enabled" <%= settings.enabled?'checked':'' %>/> Enable automatic routing</label><label>Default maximum open items<input class="workspace-input" type="number" min="1" max="10000" name="maxOpen" value="<%= settings.default_max_open||'' %>"/></label><label>Escalation check interval · minutes<input class="workspace-input" type="number" min="1" max="1440" name="intervalMinutes" value="<%= settings.interval_minutes||'' %>"/></label><label>Urgent-response team<select class="workspace-input" name="urgentTeam"><option value="">Not configured</option><% for(const team of teams.filter(t=>t.active)) { %><option value="<%= team.id %>" <%= settings.urgent_team_id===team.id?'selected':'' %>><%= team.name %></option><% } %></select></label><label class="assignment-check"><input type="checkbox" name="autoReassignAway" <%= settings.auto_reassign_away?'checked':'' %>/> Automatically reassign when staff go away</label><label class="assignment-check"><input type="checkbox" name="autoReassignOverdue" <%= settings.auto_reassign_overdue?'checked':'' %>/> Automatically reassign after final escalation</label><div class="assignment-slas assignment-wide"><% for(const priority of ['low','normal','high','urgent']) { %><fieldset data-assignment-priority="<%= priority %>"><legend><%= priority %></legend><% for(const [key,label] of fields) { %><label><%= label %> · minutes<input class="workspace-input" type="number" min="1" max="525600" data-sla-key="<%= key %>" value="<%= settings.slas?.[priority]?.[key]||'' %>"/></label><% } %></fieldset><% } %></div><p class="assignment-wide">Urgent items notify school administrators even when ordinary notifications are disabled. If team coverage is unavailable, an active school administrator becomes the fallback owner. Configure a working scheduler before relying on timed escalations.</p><button class="workspace-button workspace-button--primary" type="submit">Save settings</button></form></section><% } %>
</div></main><script defer src="/js/assignments.js?v=20261025-portal"></script>
