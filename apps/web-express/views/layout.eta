<% const motionTransitionPage = !/^\/(auth|digest|account\/security|staff-login)(\/|$)/.test(it.currentPath || '') && !/customization/.test(it.currentPath || ''); %>
<!DOCTYPE html>
<html lang="en" data-theme="light"<% if(motionTransitionPage) { %> data-sf-transitions<% } %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= it.description ?? 'Share campus feedback and follow submission progress on SuggFeed.' %>" />
  <title><%= it.title ?? 'SuggFeed' %></title>

  <meta name="school-base" content="<%= it.schoolBase || '' %>" />
  <meta name="school-id" content="<%= it.schoolId || '' %>" />
  <meta name="school-actor" content="<%= it.user?.id || '' %>" />
  <script src="/js/school-context.js?v=20261016-school-isolation"></script>

  <!-- PWA / Icons -->
  <link rel="icon" href="/branding/favicon.ico" sizes="any" />
  <link rel="icon" href="/branding/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/branding/icon-180.png" />
  <link rel="manifest" href="/manifest.json?v=20261013-sf" />
  <meta name="theme-color" content="#0b3857" />

  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/base.bundle.css?v=20261018-action-audit" />
  <% if ((it.currentPath || '').startsWith('/profile')) { %><link rel="stylesheet" href="/css/profile.bundle.css?v=20261014-profile-mobile" /><% } %>
  <% if (/^\/(admin|staff)/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/staff.bundle.css?v=20261014-open-workspace" /><% } %>
  <link rel="stylesheet" href="/css/enhancements.bundle.css?v=20261020-workspace-shell" />
  <% if (it.platformDashboard || it.accountArea || it.currentPath === '/schools' || /\/admin\/school-settings$/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/platform.bundle.css?v=20261020-review-layout" /><% } %>
  <% if(it.schoolBase || /customization/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/customization.bundle.css?v=20261018-customization"/><% } %>
  <% if(motionTransitionPage) { %><link rel="stylesheet" href="/css/motion-transitions.css?v=20261020-motion"/><% } %>
  <script defer src="/js/events.js?v=20261018-customization"></script>

  <script src="/js/preferences.js?v=20261016-school-isolation"></script>
  <!-- Theme init (before render to prevent flash) -->
  <script src="/js/theme-init.js?v=20261016-school-isolation"></script>

  <!-- Supabase (client-side auth) -->
  <script defer src="/js/vendor/supabase.js?v=20261016-school-isolation"></script>
</head>
<body class="<%= it.schoolCustomization ? 'school-palette-'+it.schoolCustomization.palette : '' %> <%= it.schoolCustomization ? Object.entries(it.schoolCustomization.features).filter(([key,value])=>!value).map(([key])=>'school-'+key+'-off').join(' ') : '' %>">
<% if(it.schoolCustomization) { %><script type="application/json" id="school-presentation-data"><%~ JSON.stringify(it.schoolCustomization).replace(/</g,'\\u003c') %></script><script defer src="/js/school-ui.js?v=20261018-customization"></script><script defer src="/js/school-submission.js?v=20261018-customization"></script><% } %>
<a class="system-skip-link" href="#page-content">Skip to page content</a>
<%~ include('partials/workspace-icons', it) %>
<div id="sf-auth-config" hidden data-url="<%= it.supabaseUrl || '' %>" data-key="<%= it.supabaseAnonKey || '' %>" data-user="<%= it.user?.id || '' %>"></div>

<%~ include('partials/toast', it) %>
<%~ include('partials/confirmation', it) %>
<script defer src="/js/empty-state.js?v=20261018-empty-states"></script>
<script defer src="/js/activity.js?v=20261016-school-isolation"></script>
<%~ include('partials/header', it) %>
<% if (it.schoolBase && !it.accountArea) { %>
<nav class="workspace-actions school-context-bar" aria-label="Current school">
  <div class="school-context-info">
    <span class="school-context-identity"><% if(it.schoolCustomization?.logo) { %><img class="school-context-logo" src="<%= it.schoolBase %>/branding/<%= it.schoolCustomization.logo %>" alt="" width="28" height="28"/><% } %><strong><%= it.schoolCustomization?.displayName || it.schoolName || 'Your school' %></strong></span>
    <% if (it.demoWorkspace) { %><details class="school-context-demo"><summary>Fictional demo</summary><p>Use invented content only. Sample contact emails are not monitored.</p></details><% } %>
  </div>
  <div class="school-context-actions"><a class="workspace-button" href="/schools">Switch school</a><% if (it.user?.role === 'admin') { %><a class="workspace-button" href="<%= it.schoolBase %>/admin/school-settings">School settings</a><% } %></div>
</nav>
<% } %>

<p id="connection-status" class="connection-status" role="status" aria-live="polite" hidden></p>
<script defer src="/js/system-ux.js?v=20261018-full-ux-audit"></script>
<%~ include('partials/navigation-skeleton', it) %>
<div id="page-content" tabindex="-1"><%~ it.body ?? '' %></div>

<%~ include('partials/auth-modal', it) %>
<% if (!it.accountArea && !it.platformDashboard) { %>
<%~ include('partials/submit-panel', it) %>
<% if (['/','/feed','/feed/'].includes(it.currentPath || '/')) { %><%~ include('partials/idea-detail-drawer', it) %><% } %>
<%~ include('partials/report-dialog', it) %>
<% if (!/^\/admin(?:\/|$)/.test(it.currentPath || '')) { %><%~ include('partials/mobile-nav', it) %><% } %>
<% } %>

<!-- Client-side auth state sync -->
<script defer src="/js/auth.js?v=20261017-system-navigation"></script>

<!-- Theme toggle logic -->
<script defer src="/js/theme.js?v=20261016-school-isolation"></script>
<% if (!it.accountArea && !it.platformDashboard) { %>
<script defer src="/js/engagement.js?v=20261016-school-isolation"></script>
<script defer src="/js/community.js?v=20261018-customization"></script>

<script defer src="/js/public-history.js?v=20261018-empty-states"></script>


<% } %>
<script defer src="/js/responsive.js?v=20261016-school-isolation"></script>
<script defer src="/js/animations.js?v=20261020-motion"></script>
</body>
</html>
