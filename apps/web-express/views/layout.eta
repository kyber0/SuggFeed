<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= it.description ?? 'Share campus feedback and follow submission progress on SuggFeed.' %>" />
  <title><%= it.title ?? 'SuggFeed' %></title>

  <!-- PWA / Icons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0b3857" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/styles.css?v=20261011-sticky-sidebar" />
  <script src="/js/events.js?v=20261010-workspace"></script>

  <!-- Theme init (before render to prevent flash) -->
  <script src="/js/theme-init.js?v=20261010-ts"></script>

  <!-- Supabase (client-side auth) -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
</head>
<body>
<%~ include('partials/workspace-icons', it) %>
<div id="sf-auth-config" hidden data-url="<%= it.supabaseUrl || '' %>" data-key="<%= it.supabaseAnonKey || '' %>" data-user="<%= it.user?.id || '' %>"></div>

<%~ include('partials/header', it) %>

<%~ it.body ?? '' %>

<%~ include('partials/auth-modal', it) %>
<%~ include('partials/submit-panel', it) %>
<%~ include('partials/idea-detail-drawer', it) %>
<%~ include('partials/toast', it) %>
<%~ include('partials/mobile-nav', it) %>

<!-- Client-side auth state sync -->
<script src="/js/auth.js?v=20261010-ts"></script>

<!-- Theme toggle logic -->
<script src="/js/theme.js?v=20261010-ts"></script>

</body>
</html>
