<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= it.description ?? 'Share campus feedback and follow submission progress on SuggFeed.' %>" />
  <title><%= it.title ?? 'SuggFeed' %></title>

  <meta name="school-base" content="<%= it.schoolBase || '' %>" />
  <meta name="school-id" content="<%= it.schoolId || '' %>" />
  <meta name="school-actor" content="<%= it.user?.id || '' %>" />
  <script src="/js/school-context.js?v=20261016-school-isolation"></script>

  <!-- PWA / Icons -->
  <link rel="icon" href="/branding/favicon.ico" sizes="any" />
  <link rel="icon" href="/branding/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/branding/icon-180.png" />
  <link rel="manifest" href="/manifest.json?v=20261013-sf" />
  <meta name="theme-color" content="#0b3857" />

  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/base.bundle.css?v=20261014-ui-audit" />
  <% if ((it.currentPath || '').startsWith('/profile')) { %><link rel="stylesheet" href="/css/profile.bundle.css?v=20261014-profile-mobile" /><% } %>
  <% if (/^\/(admin|staff)/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/staff.bundle.css?v=20261014-open-workspace" /><% } %>
  <link rel="stylesheet" href="/css/enhancements.bundle.css?v=20261015-hover-fix" />
  <% if (it.platformDashboard || it.accountArea || it.currentPath === '/schools' || /\/admin\/school-settings$/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/platform.bundle.css?v=20261017-system-navigation" /><% } %>
  <script defer src="/js/events.js?v=20261016-school-isolation"></script>

  <script src="/js/preferences.js?v=20261016-school-isolation"></script>
  <!-- Theme init (before render to prevent flash) -->
  <script src="/js/theme-init.js?v=20261016-school-isolation"></script>

  <!-- Supabase (client-side auth) -->
  <script defer src="/js/vendor/supabase.js?v=20261016-school-isolation"></script>
</head>
<body>
<a class="system-skip-link" href="#page-content">Skip to page content</a>
<%~ include('partials/workspace-icons', it) %>
<div id="sf-auth-config" hidden data-url="<%= it.supabaseUrl || '' %>" data-key="<%= it.supabaseAnonKey || '' %>" data-user="<%= it.user?.id || '' %>"></div>

<%~ include('partials/toast', it) %>
<%~ include('partials/confirmation', it) %>
<script defer src="/js/activity.js?v=20261016-school-isolation"></script>
<%~ include('partials/header', it) %>
<% if (it.schoolBase && !it.accountArea) { %>
<nav class="workspace-actions care-card" aria-label="Current school">
  <% if (it.demoWorkspace) { %><span><strong>Fictional demo</strong> · Use invented content only. Sample contact emails are not monitored.</span><% } %>
  <strong><%= it.schoolName || 'Your school' %></strong>
  <a class="workspace-button" href="/schools">Switch school</a>
  <% if (it.user?.role === 'admin') { %><a class="workspace-button" href="<%= it.schoolBase %>/admin/school-settings">School settings</a><% } %>
</nav>
<% } %>

<%~ include('partials/navigation-skeleton', it) %>
<div id="page-content" tabindex="-1"><%~ it.body ?? '' %></div>

<%~ include('partials/auth-modal', it) %>
<% if (!it.accountArea && !it.platformDashboard) { %>
<%~ include('partials/submit-panel', it) %>
<% if (['/','/feed','/feed/'].includes(it.currentPath || '/')) { %><%~ include('partials/idea-detail-drawer', it) %><% } %>
<%~ include('partials/report-dialog', it) %>
<% if (!/^\/admin(?:\/|$)/.test(it.currentPath || '')) { %><%~ include('partials/mobile-nav', it) %><% } %>
<% } %>

<!-- Client-side auth state sync -->
<script defer src="/js/auth.js?v=20261017-system-navigation"></script>

<!-- Theme toggle logic -->
<script defer src="/js/theme.js?v=20261016-school-isolation"></script>
<% if (!it.accountArea && !it.platformDashboard) { %>
<script defer src="/js/engagement.js?v=20261016-school-isolation"></script>
<script defer src="/js/community.js?v=20261016-school-isolation"></script>

<script defer src="/js/public-history.js?v=20261016-school-isolation"></script>

<script defer src="/js/scroll-reveal.js?v=20261016-school-isolation"></script>
<% } %>
<script defer src="/js/responsive.js?v=20261016-school-isolation"></script>
</body>
</html>
