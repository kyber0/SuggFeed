<% const motionTransitionPage = !/^\/(auth|digest|account\/security|staff-login)(\/|$)/.test(it.currentPath || '') && !/customization/.test(it.currentPath || ''); %>
<!DOCTYPE html>
<html lang="en" data-theme="light"<% if(motionTransitionPage) { %> data-sf-transitions<% } %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
  <meta name="description" content="<%= it.description ?? 'Share campus feedback and follow submission progress on SuggFeed.' %>" />
  <title><%= it.title ?? 'SuggFeed' %></title>

  <meta name="school-base" content="<%= it.schoolBase || '' %>" />
  <meta name="school-id" content="<%= it.schoolId || '' %>" />
  <meta name="school-actor" content="<%= it.user?.id || '' %>" />
  <script src="/js/school-context.js?v=20261025-help-scope"></script>

  <!-- PWA / Icons -->
  <link rel="icon" href="/branding/favicon.ico" sizes="any" />
  <link rel="icon" href="/branding/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/branding/icon-180.png" />
  <link rel="manifest" href="/manifest.json?v=20261013-sf" />
  <meta name="theme-color" content="#0b3857" />

  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/base.bundle.css?v=20261022-continuous-thread" />
  <% if ((it.currentPath || '').startsWith('/profile')&&!it.supportPage) { %><link rel="stylesheet" href="/css/profile.bundle.css?v=20261025-support" /><% } %>
  <% if (/^(?:\/s\/[^/]+)?\/(admin|staff)/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/staff.bundle.css?v=20261025-portal" /><% } %>
  <link rel="stylesheet" href="/css/enhancements.bundle.css?v=20261025-comment-review" />
  <% if (it.platformDashboard || it.accountArea || it.currentPath === '/schools' || /\/admin\/school-settings$/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/platform.bundle.css?v=20261021-platform-insights" /><% } %>
  <% if(it.schoolBase || /customization/.test(it.currentPath || '')) { %><link rel="stylesheet" href="/css/customization.bundle.css?v=20261021-mobile-audit"/><% } %>
  <% if(motionTransitionPage) { %><link rel="stylesheet" href="/css/motion-transitions.css?v=20261020-motion"/><% } %>
  <link rel="stylesheet" href="/css/modules/interaction-feedback.css?v=20261022-compact-group"/>
  <script defer src="/js/interaction-feedback.js?v=20261022-pending-reset"></script>
  <script defer src="/js/events.js?v=20261018-customization"></script>

  <script src="/js/preferences.js?v=20261016-school-isolation"></script>
  <script defer src="/js/school-colors.js?v=20261020-studio-colors"></script>
  <!-- Theme init (before render to prevent flash) -->
  <script src="/js/theme-init.js?v=20261016-school-isolation"></script>

  <!-- Supabase (client-side auth) -->
  <script defer src="/js/vendor/supabase.js?v=20261016-school-isolation"></script>
  <link rel="stylesheet" href="/css/modules/controls.css?v=20261024-controls"/>
  <script defer src="/js/controls.js?v=20261024-controls"></script>
  <link rel="stylesheet" href="/css/submission-safety.css?v=20261024"/>
<% if(it.supportPage||it.currentPath==='/help'||it.assistantKnowledge||/assistant/.test(it.currentPath||'')||it.platformDashboard) { %><link rel="stylesheet" href="/css/modules/assistant.css?v=20261025-support"/><% } %>
</head>
<body<% if(it.schoolCustomization?.design) { const pd=it.schoolCustomization.design.pages[it.schoolDesignPage]||{layout:"default",spacing:"comfortable",cards:"outlined"}; %> data-school-design data-school-page="<%= it.schoolDesignPage || '' %>" data-school-layout="<%= pd.layout %>" data-school-spacing="<%= pd.spacing %>" data-school-cards="<%= pd.cards %>"<% } %><% if(it.schoolCustomization) { %> data-school-colors style="<%= it.schoolColorStyle || '' %>"<% } %> class="<%= /^\/feed\/?$/.test(it.currentPath || '') ? 'sf-feed-workspace ' : '' %><%= it.schoolCustomization ? 'school-palette-'+it.schoolCustomization.palette : '' %> <%= it.schoolCustomization ? Object.entries(it.schoolCustomization.features).filter(([key,value])=>!value).map(([key])=>'school-'+key+'-off').join(' ') : '' %>">
<% if(it.schoolCustomization) { %><script type="application/json" id="school-presentation-data"><%~ JSON.stringify(it.schoolCustomization).replace(/</g,'\\u003c') %></script><script defer src="/js/school-design.js?v=20261022-brand-cursor"></script><script defer src="/js/school-ui.js?v=20261021-design"></script><script defer src="/js/school-submission.js?v=20261021-category-icons"></script><% } %>
<a class="system-skip-link" href="#page-content">Skip to page content</a>
<%~ include('partials/workspace-icons', it) %>
<div id="sf-auth-config" hidden data-url="<%= it.supabaseUrl || '' %>" data-key="<%= it.supabaseAnonKey || '' %>" data-user="<%= it.user?.id || '' %>"></div>

<%~ include('partials/toast', it) %>
<%~ include('partials/confirmation', it) %>
<script defer src="/js/empty-state.js?v=20261018-empty-states"></script>
<script defer src="/js/activity.js?v=20261016-school-isolation"></script>
<%~ include('partials/header', it) %>


<p id="connection-status" class="connection-status" role="status" aria-live="polite" hidden></p>
<script defer src="/js/system-ux.js?v=20261021-admin-sections"></script>
<%~ include('partials/navigation-skeleton', it) %>
<div id="page-content" tabindex="-1"><%~ it.body ?? '' %></div>

<%~ include('partials/auth-modal', it) %>
<% if (!it.accountArea && !it.platformDashboard) { %>
<%~ include('partials/submit-panel', it) %>
<% if (['/','/feed','/feed/'].includes(it.currentPath || '/')) { %><%~ include('partials/idea-detail-drawer', it) %><% } %>
<%~ include('partials/report-dialog', it) %>
<% if (!it.accountArea && !it.platformDashboard && it.currentPath!=='/schools' && !/^\/(?:admin|account)(?:\/|$)/.test(it.currentPath || '')) { %><%~ include('partials/mobile-nav', it) %><% } %>
<% } %>

<!-- Client-side auth state sync -->
<script defer src="/js/auth.js?v=20261022-student-journey"></script>

<!-- Theme toggle logic -->
<script defer src="/js/theme.js?v=20261016-school-isolation"></script>
<% if (!it.accountArea && !it.platformDashboard) { %>
<script defer src="/js/engagement.js?v=20261021-toggle-votes"></script>
<script defer src="/js/community.js?v=20261025-portal"></script>

<script defer src="/js/public-history.js?v=20261018-empty-states"></script>


<% } %>
<script defer src="/js/file-upload.js?v=20261021-upload"></script>
<script defer src="/js/responsive.js?v=20261025-portal"></script>
<% if(/^(?:\/s\/[^/]+)?\/(admin|staff)/.test(it.currentPath||'')) { %><script defer src="/js/staff-portal.js?v=20261025-portal"></script><% } %>
<script defer src="/js/animations.js?v=20261022-home-polish"></script>


<% if (/(?:school-settings|settings|student-access)$/.test(it.currentPath || '')) { %><script defer src="/js/student-access.js?v=20261021-student-joining"></script><% } %>
<script defer src="/js/comment-edit.js?v=20261025-comment-review"></script>
<script defer src="/js/submission-safety.js?v=20261024-safety"></script>
<% if(it.supportPage||it.currentPath==='/help'||it.assistantKnowledge) { %><script defer src="/js/assistant.js?v=20261025-support"></script><% } %><% if(/assistant/.test(it.currentPath||'')||it.platformDashboard) { %><script defer src="/js/assistant-admin.js?v=20261024-grounded"></script><% if(it.schoolEditor) { %><script defer src="/js/assistant-knowledge.js?v=20261024-grounded"></script><script defer src="/js/assistant-documents.js?v=20261024-grounded"></script><% } %><% } %>
</body>
</html>
