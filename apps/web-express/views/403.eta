<% layout('layout') %>

<main class="sf-main error-page-container">
  <div class="error-page-code">403</div>
  <h1 class="error-page-title">Staff access required</h1>
  <p class="error-page-desc">You are signed in, but this account does not have a staff, moderator, or admin role.</p>
  <a href="/" class="btn-primary error-page-btn">Return to community</a>
</main>
