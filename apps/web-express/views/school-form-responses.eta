<% layout('layout') %><main class="sf-main sf-page-container"><header class="school-settings-header"><div><a href="<%= it.authorView?'/profile':'/admin' %>">← <%= it.authorView?'Your activity':'School administration' %></a><h1><%= it.details?it.details.title:'School form responses' %></h1><p>Private details for authorized school staff and the submitting account. These answers and files never appear in the public feed.</p></div></header><% if(it.details) { %><section class="care-card submission-extra-details"><h2>Submitted school questions</h2><dl><% for(const q of it.details.questions) { %><dt><%= q.label %></dt><dd><%= q.answer %></dd><% } %></dl><% if(!it.details.questions.length) { %><p>No additional question answers.</p><% } %><h2>Supporting images</h2><div class="submission-file-list"><% for(const [index,file] of it.details.files.entries()) { %><a href="<%= file.url %>" target="_blank" rel="noopener">Open image <%= index+1 %></a><% } %></div><% if(!it.details.files.length) { %><p>No supporting images.</p><% } %><p><a href="<%= it.authorView?'/profile':'/admin/form-responses' %>"><%= it.authorView?'Back to your activity':'Back to responses' %></a></p></section><% } else { %><section class="care-card"><h2>Recent customized-form submissions</h2><% if(!it.rows.length) { %><p>No submissions with a school form version yet.</p><% } %><ul><% for(const row of it.rows) { %><li><a href="/admin/form-responses/<%= row.id %>"><%= row.title %></a> · <%= new Date(row.created_at).toLocaleDateString('en-PH',{timeZone:'Asia/Manila'}) %></li><% } %></ul></section><% } %></main>

<% if(it.authorView && it.details?.id) { %><a class="workspace-button" href="/submission/<%= it.details.id %>/edit">Review or edit submission</a><% } %>
