<% layout('layout') %><% if(it.platformDashboard) { %><main class="sugi-page"><a href="/platform/schools#assistant">← Platform dashboard</a><%~ include('partials/assistant-admin-panel',it) %></main><% } else { %><main class="staff-workspace"><%~ include('partials/staff-sidebar',it) %><div class="staff-main sugi-admin-main"><nav class="sugi-compose-actions" aria-label="Sugi administration"><a class="workspace-button" href="#school-knowledge">School knowledge</a><a class="workspace-button" href="#sugi-review">Feedback &amp; usage</a></nav><% if(it.schoolEditor) { %><%~ include('partials/assistant-documents',it) %><details class="sugi-card sugi-optional-faqs"><summary>Optional exact-answer FAQs</summary><p>Use these only when a question needs fixed wording. General school information belongs above.</p><%~ include('partials/assistant-school-editor',it) %></details><% } %><%~ include('partials/assistant-admin-panel',it) %></div></main><% } %>