<% layout('layout') %><main class="campus-roadmap"><section class="care-card"><h1><%= it.done ? 'Weekly emails stopped' : 'Stop weekly emails' %></h1><% if(it.done) { %><p>Your in-app notifications are unchanged. You can opt back in from School updates.</p><% } else if(it.valid) { %><p>Stop the weekly digest for the account that received this link?</p><form method="post" action="/digest/unsubscribe"><input type="hidden" name="token" value="<%= it.token %>"/><button class="workspace-button" type="submit">Stop weekly emails</button></form><% } else { %><p>This link is invalid. Sign in and update your notification preferences instead.</p><% } %><a href="/notifications">School updates →</a></section></main>
