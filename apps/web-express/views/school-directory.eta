<% layout('layout') %>
<main class="school-directory">
  <header class="school-directory-header"><p class="eyebrow">Your SuggFeed account</p><h1>Your schools</h1><p>Choose a school workspace or manage your platform access.</p></header>
  <% if (it.saved) { %><p class="school-directory-notice" role="status">Your change was saved.</p><% } %>
  <% if (!it.user) { %><section class="school-directory-section"><h2>Welcome to SuggFeed</h2><p>Sign in to choose a school, accept an invitation or apply for a workspace.</p></section><% } else { %>
    <% if (it.isPlatformOperator) { %><section class="school-directory-admin" aria-labelledby="super-admin-title"><div><p class="eyebrow">Super admin</p><h2 id="super-admin-title">Your platform dashboard</h2><p>Platform school review, applications, and service setup.</p></div><a href="/platform/schools">Open super admin dashboard</a></section><% } %>
    <section class="school-directory-section" aria-labelledby="memberships-title"><h2 id="memberships-title">School memberships</h2>
      <% if (!it.schools.length) { %><p>No school memberships yet. Request an invitation from your school administrator.</p><% } %>
      <ul class="school-directory-memberships"><% for (const membership of it.schools) { const school=membership.schools; if (!school) continue; %><li><div><strong><%= school.name %></strong><p><%= membership.role==='admin' ? 'School administrator' : membership.role==='moderator' ? 'School moderator' : 'School member' %> · <span class="platform-badge platform-badge--<%= school.status %>"><%= school.status %></span></p><% if (school.status==='pending') { %><p>This workspace is waiting for policy review and activation.</p><% } %></div><div class="school-directory-links"><% if (school.status==='active') { %><a class="school-directory-action" href="/s/<%= school.slug %>/">Open school</a><% } %><% if (membership.role==='admin') { %><a class="school-directory-action" href="/s/<%= school.slug %>/admin/school-settings">School settings</a><% } %></div></li><% } %></ul>
    </section>
    <section class="school-directory-section" aria-labelledby="applications-title"><h2 id="applications-title">Your applications</h2><% if (!it.applications.length) { %><p>No applications submitted yet.</p><% } %><ul class="school-directory-memberships"><% for (const application of it.applications) { %><li><strong><%= application.name %></strong><span class="platform-badge platform-badge--<%= application.status==='approved'?'active':'pending' %>"><%= application.status %></span></li><% } %></ul></section>
    <section class="school-directory-section" aria-labelledby="apply-title"><h2 id="apply-title">Apply for a school workspace</h2><p>Applications require a confirmed account email and verification of institutional authority. School access opens after its policies and isolation checks are complete.</p>
      <% if (!it.applicationEnabled) { %><p class="school-directory-notice" role="status">Applications are unavailable until the service business identity and monitored privacy contact are configured.</p><% } else { %>
        <p>Service provider: <%= it.legal.operatorName %>. Privacy contact: <%= it.legal.privacyEmail %>. See the <a href="/privacy">service privacy notice</a>.</p>
        <form action="/schools/apply" method="post"><p><label for="school-name">School name</label><input id="school-name" name="name" required minlength="2" maxlength="200" /></p><p><label for="school-slug">School address</label><input id="school-slug" name="slug" required minlength="3" maxlength="63" pattern="[a-z0-9]+(-[a-z0-9]+)*" /><small>Use 3–63 lowercase letters, numbers, or hyphens.</small></p><p><label for="contact-name">Authorized contact name</label><input id="contact-name" name="contact_name" required minlength="2" maxlength="200" autocomplete="name" /></p><p><label for="authority">Your institutional role and how authority can be verified</label><textarea id="authority" name="authority_statement" required minlength="20" maxlength="2000" rows="5"></textarea><small>Exclude sensitive student information.</small></p><p><label><input type="checkbox" name="authority_confirmed" value="yes" required /> I am authorized to request this workspace and understand that my authority will be verified.</label></p><button type="submit">Submit for review</button></form>
      <% } %>
    </section>
  <% } %>
</main>
