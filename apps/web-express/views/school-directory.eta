<% layout('layout') %>
<main class="sf-legal-page"><div class="sf-legal-container"><h1>Your schools</h1><% if (it.saved) { %><p role="status">Your change was saved.</p><% } %><% if (!it.user) { %><p>Sign in to choose a school, accept an invitation or apply for a workspace.</p><% } else { %>
<% if(it.isPlatformOperator) { %><p><a href="/platform/schools">Platform school review</a></p><% } %><h2>Memberships</h2><% if (!it.schools.length) { %><p>No school memberships. Request an invitation from your administrator.</p><% } %><ul><% for (const membership of it.schools) { const school=membership.schools; if (!school) continue; %><li><strong><%= school.name %></strong>: <%= membership.role %>; <%= school.status %> <% if (school.status==='active') { %><a href="/s/<%= school.slug %>/">Open school</a><% } %> <% if (membership.role==='admin' && school.status!=='closed') { %><a href="/s/<%= school.slug %>/admin/school-settings">Policies and invitations</a><% } %></li><% } %></ul>
<h2>Applications</h2><% if (!it.applications.length) { %><p>No applications.</p><% } %><ul><% for(const application of it.applications) { %><li><%= application.name %>: <%= application.status %></li><% } %></ul>
<h2>Apply for a school workspace</h2><p>Applications require a confirmed account email and manual verification of institutional authority. Approval creates a pending workspace. School access requires reviewed policies and service isolation checks.</p>
<% if (!it.applicationEnabled) { %><p role="status">Applications are unavailable until the service business identity and monitored privacy contact are configured.</p><% } else { %>
<p>Service provider: <%= it.legal.operatorName %>. Privacy contact: <%= it.legal.privacyEmail %>. Application details verify institutional authority. See the <a href="/privacy">service privacy notice</a>.</p>
<form action="/schools/apply" method="post"><p><label for="school-name">School name</label><input id="school-name" name="name" required minlength="2" maxlength="200" /></p><p><label for="school-slug">School address (3–63 lowercase letters, numbers and hyphens)</label><input id="school-slug" name="slug" required minlength="3" maxlength="63" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></p><p><label for="contact-name">Authorized contact name</label><input id="contact-name" name="contact_name" required minlength="2" maxlength="200" autocomplete="name" /></p><p><label for="authority">Your institutional role and how authority can be verified (exclude sensitive student information)</label><textarea id="authority" name="authority_statement" required minlength="20" maxlength="2000" rows="5"></textarea></p><p><label><input type="checkbox" name="authority_confirmed" value="yes" required /> I am authorized to request this workspace and understand that my authority will be verified.</label></p><button type="submit">Submit for review</button></form><% } %><% } %></div></main>
