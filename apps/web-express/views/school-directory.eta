<% layout('layout') %>
<main class="school-directory">
  <header class="school-directory-header"><p class="eyebrow">Your SuggFeed account</p><h1>Your schools</h1><p>Choose where you want to work. Your access is shown on each school card.</p></header>
  <% if (it.saved) { %><p class="school-directory-notice" role="status">Your change was saved.</p><% } %>
  <% if (!it.user) { %><section aria-label="Get started"><%~ include('partials/empty-state',{hero:true,icon:'users',eyebrow:'Your community starts here',heading:'A place for your school’s ideas',description:'Sign in to find your school workspace, follow improvements, and make your voice heard.',actions:[{label:'Sign in',event:'action-94'},{label:'Create an account',event:'action-135',secondary:true}],hint:'Already invited? Open the link in your invitation email. We’ll help you join the right school.'}) %></section><% } else { %>

    <section class="school-directory-section" aria-labelledby="memberships-title"><h2 id="memberships-title">School memberships</h2>
      <% if (!it.schools.length) { %><%~ include('partials/empty-state',{icon:'users',heading:'Your school is one invitation away',description:'Ask your school administrator to invite the email address on your account. Once you accept, your school will appear here.',hint:'Have an invitation already? Open its link to review your access and join.'}) %><% } %>
      <ul class="school-directory-memberships"><% for (const membership of it.schools) { const school=membership.schools; if (!school) continue; %><li><div><strong><%= school.name %></strong><p><%= membership.role==='admin' ? 'School administrator' : membership.role==='moderator' ? 'School moderator' : 'School member' %> · <span class="platform-badge platform-badge--<%= school.status %>"><%= school.status %></span></p><% if (school.status==='pending') { %><p><%= membership.role==='admin' ? 'Continue school setup to prepare this workspace for review.' : 'Your school administrator is preparing this workspace.' %></p><% } %></div><div class="school-directory-links"><% if (school.status==='active' && membership.role!=='admin') { %><a class="school-directory-action" href="/s/<%= school.slug %>/<%= membership.role==='moderator' ? 'admin' : '' %>"><%= membership.role==='moderator' ? 'Open review queue' : 'Open school' %></a><% } %><% if (membership.role==='admin' && school.status!=='closed') { %><a class="school-directory-action" href="/s/<%= school.slug %>/admin<%= school.status==='active' ? '' : '/school-settings' %>"> <%= school.status==='pending' ? 'Continue setup' : 'School administration' %></a><% } %></div></li><% } %></ul>
    </section>
    <details class="school-directory-section school-directory-secondary"><summary>Request a school workspace</summary><div class="school-directory-secondary-body"><section aria-labelledby="applications-title"><h2 id="applications-title">Your applications</h2><% if (!it.applications.length) { %><%~ include('partials/empty-state',{compact:true,icon:'list',heading:'No workspace requests yet',description:it.applicationEnabled?'Representing a school? Complete the application below to request a workspace.':'Workspace applications are currently unavailable. Existing members can still join through their school’s invitation.'}) %><% } %><ul class="school-directory-memberships"><% for (const application of it.applications) { %><li><strong><%= application.name %></strong><span class="platform-badge platform-badge--<%= application.status==='approved'?'active':'pending' %>"><%= application.status %></span></li><% } %></ul></section>
    <section class="school-directory-section" aria-labelledby="apply-title"><h2 id="apply-title">Apply for a school workspace</h2><p>Applications require a confirmed account email and verification of institutional authority. School access opens after its policies and isolation checks are complete.</p>
      <% if (!it.applicationEnabled) { %><p class="school-directory-notice" role="status">Applications are unavailable until the service business identity and monitored privacy contact are configured.</p><% } else { %>
        <p>Service provider: <%= it.legal.operatorName %>. Privacy contact: <%= it.legal.privacyEmail %>. See the <a href="/privacy">service privacy notice</a>.</p>
        <form action="/schools/apply" method="post"><p><label for="school-name">School name</label><input id="school-name" name="name" required minlength="2" maxlength="200" /></p><p><label for="school-slug">School address</label><input id="school-slug" name="slug" required minlength="3" maxlength="63" pattern="[a-z0-9]+(-[a-z0-9]+)*" /><small>Use 3–63 lowercase letters, numbers, or hyphens.</small></p><p><label for="contact-name">Authorized contact name</label><input id="contact-name" name="contact_name" required minlength="2" maxlength="200" autocomplete="name" /></p><p><label for="authority">Your institutional role and how authority can be verified</label><textarea id="authority" name="authority_statement" required minlength="20" maxlength="2000" rows="5"></textarea><small>Exclude sensitive student information.</small></p><p><label><input type="checkbox" name="authority_confirmed" value="yes" required /> I am authorized to request this workspace and understand that my authority will be verified.</label></p><button type="submit">Submit for review</button></form>
      <% } %>
    </section></div></details>
  <% } %>
</main>
