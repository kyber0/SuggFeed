<% layout('layout') %>
<main class="sugi-page"><header class="sugi-heading"><div><p class="workspace-kicker">SUGGFEED HELP</p><h1 class="sugi-brand-title"><img src="/branding/sugi/mark-160.webp" width="56" height="56" alt=""/>Meet Sugi</h1><p>Find your next step, with answers from reviewed FAQs.</p></div><a class="workspace-button" href="<%= it.schoolBase?'/':'/schools' %>"><%= it.schoolBase?'Back to your school':'Your schools' %></a></header>
<div class="sugi-grid"><%~ include('partials/assistant-chat',it) %>
<aside class="sugi-card sugi-faq" aria-labelledby="sugi-faq-title"><div class="sugi-card-heading"><h2 id="sugi-faq-title">Reviewed FAQs</h2><label>Language<select class="workspace-input" data-sf-select data-sugi-language><option value="en">English</option><option value="fil">Filipino</option><option value="taglish">Taglish</option></select></label></div><p>Available even when AI is unavailable. These are general instructions; school options can differ.</p><% for(const entry of it.knowledge.entries) { %><details data-sugi-faq="<%= entry.id %>"><summary><%= entry.questions.en %></summary><p><%= entry.answers.en %></p></details><% } %><p class="sugi-version">Knowledge version: <%= it.knowledge.version.replace(/-[a-f0-9]{16}/g,'').replace(':',' · ') %></p><a href="/help-faq.html">Public FAQ for offline use</a></aside></div>
<script type="application/json" id="sugi-knowledge"><%~ JSON.stringify(it.knowledge).replace(/</g,'\u003c') %></script></main>
