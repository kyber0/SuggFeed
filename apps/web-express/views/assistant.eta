<% layout('layout') %>
<main class="sugi-page"><header class="sugi-heading"><div><p class="workspace-kicker">SUGGFEED HELP</p><h1 class="sugi-brand-title"><img src="/branding/sugi/mark-160.webp" width="56" height="56" alt=""/>Meet Sugi</h1><p>Ask naturally about SuggFeed or your current school. Answers use approved sources.</p></div><a class="workspace-button" href="<%= it.schoolBase?'/':'/schools' %>"><%= it.schoolBase?'Back to your school':'Your schools' %></a></header>
<div class="sugi-grid"><%~ include('partials/assistant-chat',it) %>
<aside class="sugi-card sugi-faq" aria-labelledby="sugi-faq-title"><div class="sugi-card-heading"><h2 id="sugi-faq-title">Reviewed FAQs</h2><label>Language<select class="workspace-input" data-sf-select data-sugi-language><option value="en">English</option><option value="fil">Filipino</option><option value="taglish">Taglish</option></select></label></div><label class="sugi-topic-filter">Topic<select class="workspace-input" data-sf-select data-sugi-category><option value="">All topics</option><% for(const [key,label] of Object.entries(it.topics||{})) {if(it.knowledge.entries.some(e=>e.category===key)) { %><option value="<%= key %>"><%= label %></option><% }} %></select></label><% if(it.schoolBase&&!it.knowledge.entries.some(e=>e.scope==='school')&&!(it.sources||[]).some(s=>s.scope==='school')) { %><p class="sugi-notice"><%= it.schoolDocumentsStatus==='unavailable'?'School sources are temporarily unavailable. App help still works.':'Your school has not published additional institutional information yet. Ask your school administrator to add it under School knowledge.' %></p><% } %><p>Available even when AI is unavailable. These are general instructions; school options can differ.</p><% for(const entry of it.knowledge.entries) { %><details id="faq-<%= entry.id %>" data-sugi-faq="<%= entry.id %>"><summary><span data-sugi-faq-question><%= entry.questions.en %></span><small class="sugi-topic-label"><%= (it.topics||{})[entry.category] || (entry.scope==='school'?'School information':'App help') %></small></summary><p><%= entry.answers.en %></p></details><% } %><p class="sugi-version">Knowledge version: <%= it.knowledge.version.replace(/-[a-f0-9]{16}/g,'').replace(':',' · ') %></p><a href="/help-faq.html">Public FAQ for offline use</a></aside></div>
<section class="sugi-card sugi-sources" aria-labelledby="sugi-sources-title"><h2 id="sugi-sources-title">Approved sources</h2><p>Sugi may summarize these sources using AI. Check the cited information for official matters. It cannot answer unpublished facts.</p><% if(it.schoolDocumentsStatus==='unavailable') { %><p class="sugi-notice">School documents are temporarily unavailable. Shared app help remains available.</p><% } %><% for(const source of it.sources||[]) { %><details id="<%= source.id %>"><summary><%= source.title %><small><%= source.scope==='school'?'Current school':'SuggFeed guide' %></small></summary><p><%= source.text %></p></details><% } %></section><script type="application/json" id="sugi-knowledge"><%~ JSON.stringify(it.knowledge).replace(/</g,'\u003c') %></script></main>
