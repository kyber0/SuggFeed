<% layout('layout') %>
<main class="sugi-page sugi-support" data-help-hub>
 <nav class="support-breadcrumb" aria-label="Breadcrumb"><a href="<%= it.helpProfilePath||'/profile' %>"><%= it.helpProfileLabel||'Profile' %></a><span aria-hidden="true">/</span><span aria-current="page">Help &amp; support</span></nav>
 <header class="support-heading"><div><p class="workspace-kicker">HERE TO HELP</p><h1>Help &amp; support</h1><p>Find a clear answer and your next step.</p></div><span class="support-workspace"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m3 10 9-6 9 6-9 6-9-6Z"/><path d="M6 12v6c4 3 8 3 12 0v-6"/></svg><%= it.schoolName||'SuggFeed app help' %></span></header>
 <div class="support-tabs" role="tablist" aria-label="Help sections"><button type="button" role="tab" id="support-tab-faq" aria-selected="true" aria-controls="support-panel-faq" data-help-tab="faq">Help center</button><button type="button" role="tab" id="support-tab-chat" aria-selected="false" aria-controls="support-panel-chat" tabindex="-1" data-help-tab="chat"><img src="/branding/sugi/mark-160.webp" width="24" height="24" alt=""/>Chat with Sugi</button><button type="button" role="tab" id="support-tab-sources" aria-selected="false" aria-controls="support-panel-sources" tabindex="-1" data-help-tab="sources"><%= it.schoolBase?'School information':'Guides & sources' %></button></div>
 <div class="support-browse-tools" data-help-search-tools><label class="support-search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg><span class="sugi-sr-only">Search FAQs and school information</span><input type="search" data-help-search placeholder="Search help, for example joining a school" maxlength="150" autocomplete="off"/></label><div class="support-filters" data-help-faq-filters><label>Language<select class="workspace-input" data-sf-select data-sugi-language><option value="en">English</option><option value="fil">Filipino</option><option value="taglish">Taglish</option></select></label><label>Topic<select class="workspace-input" data-sf-select data-sugi-category><option value="">All topics</option><% for(const [key,label] of Object.entries(it.topics||{})) {if(it.knowledge.entries.some(e=>e.category===key)) { %><option value="<%= key %>"><%= label %></option><% }} %></select></label></div></div>
 <p class="support-results" data-help-results role="status" aria-live="polite">Browse answers from approved information.</p>
 <section class="support-panel" id="support-panel-faq" data-help-panel="faq" role="tabpanel" aria-labelledby="support-tab-faq" tabindex="0">
  <div class="support-topics" aria-label="Quick topics"><button type="button" data-help-topic="accounts">Joining &amp; accounts <span aria-hidden="true">↗</span></button><button type="button" data-help-topic="submissions">Sharing an idea <span aria-hidden="true">↗</span></button><button type="button" data-help-topic="tracking">Tracking progress <span aria-hidden="true">↗</span></button><button type="button" data-help-topic="privacy">Privacy &amp; safety <span aria-hidden="true">↗</span></button></div>
  <div class="sugi-card sugi-faq support-answer-list" aria-labelledby="sugi-faq-title"><div class="support-section-heading"><div><h2 id="sugi-faq-title">Frequently asked questions</h2><p>Quick answers you can read without asking the AI.</p></div><a class="support-offline" href="/help-faq.html">Offline app guide ↗</a></div><% for(const entry of it.knowledge.entries) { %><details id="faq-<%= entry.id %>" data-sugi-faq="<%= entry.id %>" data-help-item="faq"><summary><span><span data-sugi-faq-question><%= entry.questions.en %></span><small class="sugi-topic-label"><%= (it.topics||{})[entry.category]||(entry.scope==='school'?'Your school':'SuggFeed') %></small></span><span class="support-chevron" aria-hidden="true">⌄</span></summary><p><%= entry.answers.en %></p></details><% } %><div class="support-empty" data-help-empty="faq" hidden><span aria-hidden="true">⌕</span><h3>No matching answers yet</h3><p>Try fewer words, browse school information, or ask Sugi.</p><div><button type="button" class="workspace-button" data-help-clear>Clear search</button><button type="button" class="workspace-button" data-help-ask-query>Ask Sugi</button></div></div></div>
 </section>
 <section class="support-panel support-chat-panel" id="support-panel-chat" data-help-panel="chat" role="tabpanel" aria-labelledby="support-tab-chat" tabindex="0"><%~ include('partials/assistant-chat',it) %></section>
 <section class="support-panel" id="support-panel-sources" data-help-panel="sources" role="tabpanel" aria-labelledby="support-tab-sources" tabindex="0"><div class="support-section-heading"><div><h2>Information you can rely on</h2><p>Published school information and SuggFeed guides. Sugi links to these sources in its answers.</p></div></div><% if(it.schoolDocumentsStatus==='unavailable') { %><p class="sugi-notice" role="status">School information is temporarily unavailable. The app guides below are still available.</p><% } %><div class="support-source-list sugi-sources"><% for(const source of it.sources||[]) { %><details class="sugi-card" id="<%= source.id %>" data-help-item="sources"><summary><span><small><%= source.scope==='school'?'YOUR SCHOOL':'SUGGFEED GUIDE' %></small><strong><%= source.title %></strong></span><span class="support-chevron" aria-hidden="true">⌄</span></summary><p><%= source.text %></p></details><% } %><div class="support-empty sugi-card" data-help-empty="sources" hidden><h3>No matching information</h3><p>Try a different search or ask your school office for information that has not been published.</p><button type="button" class="workspace-button" data-help-clear>Clear search</button></div></div></section>
 <aside class="support-contact" data-help-contact><div class="support-contact-mark" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></div><div><h2>Need an official answer?</h2><p><%= it.demoWorkspace?'This is a fictional demo. Use invented questions; sample contacts are not monitored.':it.contact|| (it.schoolBase?'Your school office can help with enrollment, private matters and information not listed here.':'Choose your school to find its published contacts and school-specific information.') %></p></div><a class="workspace-button" href="<%= it.schoolBase?'/privacy':'/schools' %>"><%= it.demoWorkspace?'Demo notices':it.schoolBase?'School contacts':'Find your school' %> <span aria-hidden="true">→</span></a></aside>
 <script type="application/json" id="sugi-knowledge"><%~ JSON.stringify(it.knowledge).replace(/</g,'\u003c') %></script>
</main>
