<% layout('layout') %>
<main class="sf-legal-page"><div class="sf-legal-container"><nav><a href="/s/<%= it.school.slug %>/"><%= it.school.name %></a></nav><h1><%= it.title %></h1><p>School policy version <%= it.settings.version %>; reviewed <%= new Date(it.settings.approved_at).toISOString().slice(0,10) %>.</p><article style="white-space:pre-wrap"><%= it.notice %></article><h2>School contacts and rules</h2><p>Institutional contact: <%= it.settings.school_contact %>. Privacy / DPO contact: <%= it.settings.privacy_contact %>.</p><p><%= it.settings.age_policy %></p><p>Publication: <%= it.settings.publication_policy %>. Records retention: <%= it.settings.retention_days %> days, subject to approved holds and applicable records duties.</p><h2>Service provider</h2><p><%= it.legal.operatorName || 'Service business identity is not configured.' %></p><p>Provider privacy contact: <%= it.legal.privacyEmail || 'Not configured' %>. See the <a href="/platform/privacy">service privacy notice</a> and <a href="/platform/terms">service terms</a>.</p></div></main>
