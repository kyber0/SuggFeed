<% layout('layout') %>
<main class="student-page"><%~ include('partials/idea-navigation',it) %><section class="student-status-card student-signin-card"><span class="student-action-symbol" aria-hidden="true"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><use href="#ws-bookmark"/></svg></span><p class="student-eyebrow">YOUR FOLLOWING FEED</p><h1>Keep up with ideas that matter</h1><p>Sign in to see the ideas you follow in this school. Your school’s published updates will stay together here.</p><div class="student-action-group"><button class="workspace-button workspace-button--primary" type="button" data-student-signin>Sign in to continue</button><a class="workspace-button" href="/feed">Browse community ideas</a></div></section></main>
