<% layout('layout') %><main class="student-status-page student-page"><header class="student-page-heading"><div><p class="student-eyebrow">PRIVATE SUBMISSION STATUS</p><h1>Your idea</h1><p><%= it.schoolName || 'Your school' %> · visible only with authorized owner access.</p></div><a class="workspace-button" href="/profile">My ideas →</a></header><section class="student-status-card"><span class="student-state" data-tone="<%= it.state.tone %>"><%= it.state.label %></span><h2><%= it.item.title %></h2><p class="student-status-explanation"><%= it.state.detail %></p><details open><summary>Your original suggestion</summary><p class="student-original-text"><%= it.item.description %></p></details><div class="student-action-group"><% if(it.item.editable) { %><a class="workspace-button workspace-button--primary" href="/submission/<%= it.item.id %>/edit">Edit before staff review</a><% } %><% if(it.item.safety_state==='clear'&&['approved','in_progress','resolved'].includes(it.item.status)) { %><a class="workspace-button workspace-button--primary" href="/idea/<%= it.item.id %>">Open community idea →</a><% } %><a class="workspace-button" href="/inbox?view=needs-reply">Private school questions</a><a class="workspace-button" href="/notifications?view=decisions">Review decisions</a><a class="workspace-text-link" href="/submission-details/<%= it.item.id %>">Your private answers &amp; images →</a></div><p class="student-privacy-note">Sharing this address does not grant another person access. Anonymous submissions still need the original authorized browser or your private tracking code.</p></section></main>