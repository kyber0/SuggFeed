<% layout('layout') %><main class="staff-workspace"><%~ include('partials/staff-sidebar',{...it,activeSection:'safety'}) %><div class="staff-main community-care-page"><header class="workspace-heading"><div><p class="workspace-kicker">ADMIN-ONLY REVIEW</p><h1>Safety review</h1><p>Review content privately. Safety decisions remain separate from progress decisions.</p></div></header><%~ include('partials/staff-safety-tabs',it) %><p id="care-message" role="status" aria-live="polite"></p><%~ include('partials/staff-comment-review',it) %><nav class="care-pagination" aria-label="Comment review pages"><% if(it.commentQueue.page>1) { %><a href="/admin/safety?section=comments&amp;commentView=<%= it.commentQueue.view %>&amp;commentsPage=<%= it.commentQueue.page-1 %>">Previous</a><% } %><span>Page <%= it.commentQueue.page %> of <%= Math.max(1,Math.ceil(it.commentQueue.count/25)) %> · <%= it.commentQueue.count %> matching comments</span><% if(it.commentQueue.page*25<it.commentQueue.count) { %><a href="/admin/safety?section=comments&amp;commentView=<%= it.commentQueue.view %>&amp;commentsPage=<%= it.commentQueue.page+1 %>">Next</a><% } %></nav><%~ include('partials/staff-detail',{...it,staffMembers:it.members}) %></div></main><script defer src="/js/staff-progress.js?v=20261025-detail-polish"></script><script defer src="/js/staff-review.js?v=20261025-unified-work"></script>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
