<% layout('layout') %>
<%
  const labels = { all:'Review history', pending:'Needs review', approved:'Planned', in_progress:'In progress', resolved:'Completed', rejected:'Declined' };
  const counts = it.counts;
  const status = it.status;
  const filters = it.filters || { status, search:it.search, assignment:'all', priority:'all', overdue:'false' };
  const urlFor = (s, p=1) => '/admin/reviews?' + new URLSearchParams({...filters,status:s,page:String(p)}).toString();
  const viewUrl = f => '/admin/reviews?' + new URLSearchParams(f).toString();
  const without = key => viewUrl({...filters,[key]:key==='search'?'':key==='overdue'?'false':'all'});
  const sameView = f => Object.keys(filters).every(k => (f[k] ?? (k==='search'?'':k==='overdue'?'false':k==='status'?'pending':'all')) === filters[k]);
  const isFiltered = !!filters.search || filters.assignment!=='all' || filters.priority!=='all' || filters.overdue==='true';
  const today = new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Manila',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  const dateLabel = date => new Date(date+'T12:00:00Z').toLocaleDateString('en-PH',{month:'short',day:'numeric'});
  const icon = name => '<svg class="workspace-svg" aria-hidden="true"><use href="#ws-'+name+'"></use></svg>';
%>
<a class="workspace-skip" href="#staff-queue-title">Skip to review queue</a>
<main class="staff-workspace">
  <%~ include('partials/staff-sidebar', it) %>
  <div class="staff-main">
    <header class="workspace-heading">
      <div><p class="workspace-kicker">WORKSPACE / <%= it.user?.role==='admin'?'ADMINISTRATION':'REVIEW' %></p><h1>Review ideas<span class="workspace-title-dot" aria-hidden="true">.</span></h1><p>Decide which new ideas should proceed. Approved ideas move to the <a href="/admin/work?presentation=board">Work board</a>.</p></div>
      <div class="workspace-actions" ><button class="workspace-button" id="staff-refresh" type="button"><%~ icon('refresh') %> Refresh</button><button class="workspace-button" id="staff-export" type="button" <%= it.submissions.length ? '' : 'disabled' %>><%~ icon('export') %> Export page</button></div>
    </header>
    <div id="review-workspace" data-workspace-panel>
    <div class="staff-flow-guide" aria-label="Idea workflow"><strong class="is-current">1 · Review</strong><span aria-hidden="true">→</span><a href="/admin/work?presentation=board">2 · Deliver</a><span aria-hidden="true">→</span><span>3 · Share results</span></div>
    <p id="staff-page-message" class="workspace-message" role="status" aria-live="polite"></p>
    <section class="staff-queue" aria-labelledby="staff-queue-title">
      <div class="staff-queue-heading"><div><h2 id="staff-queue-title" tabindex="-1"><%= labels[status] %></h2><p><%= status==='pending' ? 'Read the oldest ideas first, then record a decision.' : status==='all'?'Past decisions. Open approved ideas in the Work board.':'Declined ideas and their recorded explanations.' %></p></div><span class="workspace-tag" id="staff-result-count"><%= it.totalCount %> matching submissions</span></div>
      <nav class="staff-status-tabs" aria-label="Filter submissions by status">
        <% for(const key of ['pending','rejected','all']) { %><a href="<%= urlFor(key) %>" class="<%= status===key ? 'is-active' : '' %>" aria-current="<%= status===key ? 'page' : 'false' %>"><%= labels[key] %><span><%= counts[key] %></span></a><% } %>
      </nav>
      <form action="/admin/reviews" method="get" class="staff-search-form" role="search">
        <input type="hidden" name="status" value="<%= status %>"/>
        <label class="workspace-search"><%~ icon('search') %><input class="workspace-search-input" type="search" name="search" maxlength="120" value="<%= filters.search %>" placeholder="Search suggestions…" aria-label="Search titles and descriptions"/></label>
        <label class="staff-filter-label"><span>Assignment</span><select class="workspace-input" name="assignment"><% for(const [key,name] of [['all','Anyone'],['mine','Assigned to me'],['unassigned','Unassigned']]) { %><option value="<%= key %>" <%= filters.assignment===key ? 'selected' : '' %>><%= name %></option><% } %></select></label>
        <label class="staff-filter-label"><span>Priority</span><select class="workspace-input" name="priority"><% for(const key of ['all','low','normal','high','urgent']) { %><option value="<%= key %>" <%= filters.priority===key ? 'selected' : '' %>><%= key==='all' ? 'Any priority' : key.charAt(0).toUpperCase()+key.slice(1) %></option><% } %></select></label>

        <button class="workspace-button workspace-button--primary" type="submit">Apply</button>
      </form>
      <div class="staff-filter-summary">
        <div class="staff-filter-chips" aria-label="Applied filters">
          <% if(filters.search) { %><a href="<%= without('search') %>" class="staff-filter-chip" aria-label="Clear search"><span>“<%= filters.search %>”</span><span aria-hidden="true">×</span></a><% } %>
          <% if(filters.assignment!=='all') { %><a href="<%= without('assignment') %>" class="staff-filter-chip" aria-label="Remove assignment filter"><%= filters.assignment==='mine' ? 'Assigned to me' : 'Unassigned' %> <span aria-hidden="true">×</span></a><% } %>
          <% if(filters.priority!=='all') { %><a href="<%= without('priority') %>" class="staff-filter-chip" aria-label="Remove priority filter"><%= filters.priority %> priority <span aria-hidden="true">×</span></a><% } %>
          <% if(filters.overdue==='true') { %><a href="<%= without('overdue') %>" class="staff-filter-chip" aria-label="Remove overdue filter">Past target date <span aria-hidden="true">×</span></a><% } %>
          <% if(!isFiltered) { %><span class="staff-filter-hint">Showing everyone, at every priority</span><% } else { %><a href="/admin/reviews?status=<%= status %>" class="workspace-text-link">Clear all filters</a><% } %>
        </div>
        <button type="button" class="workspace-text-link" id="staff-open-save-view">Save applied view</button>
      </div>
      <div class="staff-table-labels" aria-hidden="true"><span>SUGGESTION</span><span>STATUS</span><span>ASSIGNED TO</span><span>PRIORITY</span><span>TARGET DATE</span></div>
      <div class="staff-rows">
        <% for(const item of it.submissions) { const overdue=item.target_date && item.target_date<today && !['resolved','rejected'].includes(item.status); %>
          <article class="staff-row" data-id="<%= item.id %>">
            <div class="staff-row-content"><div class="staff-row-title"><span class="workspace-tag"><%= item.category || item.categories?.name || 'Other' %></span><h3><button class="staff-title-button" type="button" data-review="<%= item.id %>" aria-haspopup="dialog"><span class="staff-row-title-text"><%= item.title %></span></button></h3></div><p><%= item.description %></p><small><time datetime="<%= item.created_at %>"><%= new Date(item.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric'}) %></time><span aria-hidden="true">·</span><%= item.vote_count || 0 %> votes<span aria-hidden="true">·</span><%= item.comment_count || 0 %> comments</small></div>
            <div class="staff-row-status"><span class="workspace-status" data-status="<%= item.status %>"><%= labels[item.status] %></span></div>
            <div class="staff-row-assignee"><span class="staff-assignee-avatar" aria-hidden="true"><%= item.assignee_id ? (item.assignee_name || 'S').slice(0,1).toUpperCase() : '–' %></span><span><%= item.assignee_name || (item.assignee_id ? 'Assigned staff' : 'Unassigned') %></span></div>
            <div class="staff-row-priority"><span class="staff-priority" data-priority="<%= item.priority || 'normal' %>"><%= item.priority || 'normal' %></span></div>
            <div class="staff-row-target"><% if(item.target_date) { %><time datetime="<%= item.target_date %>"><%= dateLabel(item.target_date) %></time><% if(overdue) { %><span class="staff-overdue-badge">Overdue</span><% } %><% } else { %><span class="staff-unset">No date</span><% } %></div>

          </article>
        <% } %>
        <% if(!it.submissions.length) { %><div class="workspace-empty"><span class="workspace-empty-symbol" aria-hidden="true"><%~ icon(isFiltered?'search':'inbox') %></span><h3><%= isFiltered ? 'No matching submissions' : status==='pending' ? 'You’re all caught up' : 'No submissions here yet' %></h3><p><%= isFiltered ? 'Adjust the filters to find the suggestions you need.' : 'Choose another status to explore the queue.' %></p><a class="workspace-button" href="/admin/reviews?status=all">View review history</a></div><% } %>
      </div>
      <footer class="staff-pagination"><span><%= it.totalCount ? (it.page-1)*it.perPage+1 : 0 %>–<%= Math.min(it.page*it.perPage,it.totalCount) %> of <%= it.totalCount %> matching submissions</span><nav aria-label="Submission pages"><% if(it.page>1) { %><a class="workspace-button" href="<%= urlFor(status,it.page-1) %>">← Previous</a><% } %><span>Page <%= it.page %> of <%= it.pageCount %></span><% if(it.page<it.pageCount) { %><a class="workspace-button" href="<%= urlFor(status,it.page+1) %>">Next →</a><% } %></nav></footer>
    </section>
    <details class="care-card"><summary>Queue presets and keyboard help</summary>
      <nav class="workspace-actions" aria-label="Review queue presets"><a class="workspace-button" href="/admin/reviews?status=pending&assignment=mine">My pending reviews</a><a class="workspace-button" href="/admin/reviews?status=pending&assignment=unassigned">Unassigned reviews</a><a class="workspace-button" href="/admin/reviews?status=all&priority=high">High priority</a></nav>
      <p>Press / to search, J for the next idea, K for the previous one, and Escape to close a dialog. Shortcuts are inactive while typing. Save your configured filters as a personal view using the existing view controls.</p>
      <p>Private notes stay private. Conflicting edits retain your draft. Review the audit history before correcting a saved change.</p>
    </details>
    <p class="staff-footnote">Only planned, in-progress, and completed ideas appear publicly. Check for private details before publishing. Keyboard: / searches, J and K move between ideas. Open private clarifications from a selected suggestion, or use the title picker in <a href="/admin/community">Follow-ups</a>.</p>
    </div>
  </div>
  <%~ include('partials/staff-review',it) %>
  <dialog class="staff-save-view-dialog" id="staff-save-view-dialog" aria-labelledby="staff-save-view-title"><form id="staff-save-view"><header><h2 id="staff-save-view-title">Save this queue view</h2><button type="button" class="workspace-icon-button" id="staff-close-save-view" aria-label="Close save view">×</button></header><p>Save the currently applied filters. This view is private to you.</p><label class="workspace-field-label" for="staff-view-name">View name</label><input id="staff-view-name" class="workspace-input" required maxlength="60" placeholder="e.g. Urgent facilities"/><p id="staff-view-message" class="workspace-message" role="status"></p><div class="workspace-dialog-actions"><button class="workspace-button workspace-button--primary" type="submit">Save view</button></div></form></dialog>
</main>
<script id="staff-queue-data" type="application/json"><%~ JSON.stringify(it.submissions.map(s=>({id:s.id,title:s.title,description:s.description,status:s.status,category:s.category || s.categories?.name || 'Other',created_at:s.created_at,updated_at:s.updated_at,staff_note:s.staff_note || '',assignee_id:s.assignee_id || '',priority:s.priority || 'normal',target_date:s.target_date || ''}))).replace(/</g,'\\u003c') %></script>
<script id="staff-filter-data" type="application/json"><%~ JSON.stringify(filters).replace(/</g,'\\u003c') %></script>
<script id="staff-current-user" type="application/json"><%~ JSON.stringify({id:it.user?.id || ''}).replace(/</g,'\\u003c') %></script>
<script defer src="/js/staff-progress.js?v=20261025-detail-polish"></script>
<script defer src="/js/staff-review.js?v=20261026-work-board"></script>
<script defer src="/js/staff-tools.js?v=20261026-work-board"></script>
