{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "src/client",
    "outDir": "public/js",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/client/**/*.ts"]
}
