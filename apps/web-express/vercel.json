{
  "version": 2,
  "installCommand": "npm ci --workspaces=false --include=dev",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{views/**,dist/**,public/**}"
    }
  },
  "regions": [
    "icn1"
  ]
}
