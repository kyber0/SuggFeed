{
  "version": 2,
  "installCommand": "npm ci --workspaces=false --include=dev",
  "buildCommand": "npm run build",
  "functions": {
    "src/server.ts": {
      "includeFiles": "{views/**,dist/**,public/**}",
      "maxDuration": 30
    }
  },
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/internal/security-maintenance",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/internal/school-customization-cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}
