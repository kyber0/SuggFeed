# ─── Supabase (required) ──────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — used only by Edge Functions (never expose to the browser)
# Find this in: Supabase dashboard → Project Settings → API → service_role key
# Set it in: Supabase dashboard → Edge Functions → Secrets
PROJECT_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare Turnstile (required for spam protection) ─────────────────────
# Create a site at: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEWnjeJCDceco5hZ


# ─── Archive cron (required for retention/archival) ───────────────────────────
# Generate a random secret: openssl rand -hex 32
# Set in Supabase Edge Functions secrets AND your cron scheduler
ARCHIVE_CRON_SECRET=your-random-cron-secret

# ─── Sentry (optional — error monitoring) ────────────────────────────────────
# Create a project at: https://sentry.io → Projects → New Project → Next.js
NEXT_PUBLIC_SENTRY_DSN=https://1b09061e7e089e5d25ba23c82dfb6388@o4511942796247040.ingest.us.sentry.io/4511942801227776
# Auth token for source map uploads (CI only, never commit)
SENTRY_AUTH_TOKEN=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
SENTRY_ORG=suggfeed
SENTRY_PROJECT=campus-voice

# ─── Expo mobile (required for mobile app) ────────────────────────────────────
