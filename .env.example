EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFjZWhlem55YnhodGxodXVlcnJtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcxOTczNTMsImV4cCI6MjEwMjc3MzM1M30.0jV15LJc_TRoXChRnYkEhkPfLxF9k7mTnFxvjymQGGA
