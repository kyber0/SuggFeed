{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "suggfeed-express#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "public/js/**", "public/sw.js"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "cache": false, "passThroughEnv": ["*"] },
    "test": { "dependsOn": ["^test"], "cache": false, "passThroughEnv": ["*"] }
  }
}
