          <label for="staff-progress-blocked-reason" id="staff-progress-blocked-field" hidden>What is blocking the work?<select id="staff-progress-blocked-reason" class="workspace-input"><option value="">Choose a reason</option><option value="budget">Budget</option><option value="parts">Parts or supplies</option><option value="approval">Approval</option><option value="scheduling">Scheduling</option><option value="other">Other</option></select></label>
