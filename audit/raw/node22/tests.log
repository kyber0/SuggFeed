          </div>
    
          <div class="sip-success-actions"><a class="workspace-button" id="sip-owner-status" hidden>View idea status →</a><button type="button" class="workspace-button" id="sip-download-receipt">Download private receipt</button><a class="workspace-button" href="/profile">My ideas</a><a class="workspace-button" id="sip-private-details" hidden>View your private answers & images</a>
            <button type="button" class="sip-btn-done" data-sf-click="action-129">
