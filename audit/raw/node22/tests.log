    .staff-page-input::-webkit-inner-spin-button {appearance:none;}
    .staff-page-total {font-size:12px;color:var(--muted);white-space:nowrap;}
    .staff-lane-pagination button {min-height:44px;min-width:36px;font-size:12px;border:0;border-radius:5px;background:var(--surface);color:var(--ink);cursor:pointer;padding:4px;}
    .staff-flow-lane[aria-busy=true] .staff-lane-cards {opacity:.6;}
    .staff-board-safety {margin:16px 0 0;font-size:12px;color:var(--muted);line-height:1.5;}
    /* Let the page carry vertical scrolling; the board only scrolls sideways on narrow screens. */
    @media(min-width:1200px) {
     .staff-board-main .workspace-heading {align-items:center;}
     .staff-flow-board {grid-template-columns:repeat(3,minmax(0,1fr));overflow:visible;}
     .staff-lane-heading {position:sticky;top:64px;}
     .staff-lane-pagination {position:sticky;bottom:12px;z-index:3;box-shadow:0 -4px 12px rgba(16,42,67,.06);}
    }
    .staff-flow-lane {position:relative;}
    .staff-flow-card[data-dragging="true"] {opacity:.4;border-style:dashed;box-shadow:none;}
    .staff-flow-board.is-dragging .staff-flow-lane[data-drop-label] {border-style:dashed;border-color:var(--navy);}
    .staff-flow-board .staff-flow-lane.is-drop-target {border-style:solid;border-color:var(--navy);background:var(--sky);box-shadow:inset 0 0 0 2px var(--navy);}
    .staff-lane-heading::after {content:attr(data-drop-label);position:absolute;top:48px;left:12px;right:12px;padding:8px 10px;border-radius:10px;background:var(--navy-2);color:#fff;font-size:13px;font-weight:700;text-align:center;box-shadow:var(--shadow-md);opacity:0;pointer-events:none;}
    .staff-flow-lane.is-drop-target .staff-lane-heading::after {opacity:1;}
    .staff-flow-board.is-dragging .staff-flow-card {cursor:grabbing;}
    .staff-drag-preview {position:fixed;top:0;left:-10000px;width:300px;padding:18px;border:2px solid var(--navy);border-radius:12px;background:var(--surface);color:var(--ink);box-shadow:var(--shadow-lg);pointer-events:none;}
    .staff-drag-preview strong {display:block;font-size:15px;line-height:1.5;overflow-wrap:anywhere;}
    .staff-drag-preview span {display:block;margin-top:8px;font-size:12px;color:var(--muted);}
    @media(prefers-reduced-motion:no-preference) {.staff-flow-lane {transition:border-color .15s ease,background-color .15s ease,box-shadow .15s ease;}.staff-lane-heading::after {transition:opacity .15s ease;}}
    .staff-bulk-controls {display:flex;gap:16px;align-items:end;flex-wrap:wrap;margin-top:24px;}
    .staff-bulk-controls label {display:grid;gap:8px;}
    .staff-upload-thumbnail {width:160px;height:100px;object-fit:contain;border-radius:10px;background:#eef2f6;}
    .evidence-comparison {display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px;}
    .evidence-comparison img {width:100%;height:200px;object-fit:contain;background:var(--bg-2);}
    .evidence-comparison figcaption {font-size:.85rem;line-height:1.5;margin-top:8px;}
    @media(max-width:600px){.evidence-comparison{grid-template-columns:1fr;}}
    .care-section-nav {display:flex;gap:12px;flex-wrap:wrap;position:sticky;top:80px;z-index:5;background:var(--bg);padding:12px 0;}
    .care-section-nav a {padding:10px 14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;font-size:.85rem;font-weight:600;}
    @media(prefers-reduced-motion:reduce){.community-care-page *, .staff-flow-board * {animation:none!important;transition:none!important;scroll-behavior:auto!important;}}
    
