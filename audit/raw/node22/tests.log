      <form id="submit-idea-form" data-sf-submit="action-115" class="sip-form">
        <div class="sip-scroll-body" id="sip-scroll-body">
          <p id="sip-signin-draft-notice" class="care-guidance" role="status" hidden></p>
        <p class="sip-toggle-desc">Reviewed ideas may be public. Avoid personal details; read the <a href="/privacy">Privacy Notice</a> and <a href="/terms">Terms</a> before sending.</p>
        <details class="submission-recovery care-card">
          <summary>Draft recovery and queued ideas</summary>
          <p>Your idea text may become public after review. Anonymous mode hides your identity, not the content. Avoid names and personal details.</p>
          <label><input id="sip-remember-draft" data-sf-switch role="switch" type="checkbox"/> Remember idea text, school answers and image references on this device for seven days</label>
          <p>Anyone using this browser may see saved drafts and school answers. Only image references are saved here; unsubmitted images on the service expire after one day. Private replies and tracking codes are excluded. Queued ideas are sent only when you choose Send now.</p>
          <div class="workspace-actions"><button type="button" id="sip-restore-draft" class="workspace-button" hidden>Restore draft</button><button type="button" id="sip-discard-draft" class="workspace-button" hidden>Discard saved draft</button><button type="button" id="sip-check-receipt" class="workspace-button" disabled>Check previous submission</button></div>
          <p id="sip-recovery-status" role="status" aria-live="polite">Draft · device recovery is off.</p>
          <ul id="sip-queue-list" aria-label="Queued ideas"></ul>
        </details>
        <!-- Step 1: Category Selection -->
        <div id="sip-step-1" class="sip-step-content sip-step-body" role="tabpanel" aria-labelledby="step-btn-1">
          <div class="sip-step-intro">
            <h3 class="sip-section-title">Choose a category</h3>
            <p class="sip-section-sub">Select the area that best describes your idea or concern.</p>
          </div>
    
                <div class="sip-cat-grid" role="radiogroup" aria-label="Feedback category" data-default-icons="{&quot;facilities&quot;:&quot;building&quot;,&quot;learning&quot;:&quot;book&quot;,&quot;safety&quot;:&quot;shield&quot;,&quot;student life&quot;:&quot;users&quot;,&quot;other&quot;:&quot;message&quot;}">
                   <label class="sip-cat-card" id="cat-card-Facilities"><input type="radio" name="sip-category" value="Facilities" data-category-name="Facilities" class="sip-cat-radio" required data-sf-change="action-116"/><div class="sip-cat-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#ws-building"/></svg></div><div class="sip-cat-card-content"><div class="sip-cat-card-header"><span class="sip-cat-card-title">Facilities</span><span class="sip-cat-check-dot"></span></div><div class="sip-cat-card-sub">Share feedback and suggestions about this topic.</div></div></label>
                   <label class="sip-cat-card" id="cat-card-Learning"><input type="radio" name="sip-category" value="Learning" data-category-name="Learning" class="sip-cat-radio" required data-sf-change="action-116"/><div class="sip-cat-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#ws-book"/></svg></div><div class="sip-cat-card-content"><div class="sip-cat-card-header"><span class="sip-cat-card-title">Learning</span><span class="sip-cat-check-dot"></span></div><div class="sip-cat-card-sub">Share feedback and suggestions about this topic.</div></div></label>
                   <label class="sip-cat-card" id="cat-card-Safety"><input type="radio" name="sip-category" value="Safety" data-category-name="Safety" class="sip-cat-radio" required data-sf-change="action-116"/><div class="sip-cat-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#ws-shield"/></svg></div><div class="sip-cat-card-content"><div class="sip-cat-card-header"><span class="sip-cat-card-title">Safety</span><span class="sip-cat-check-dot"></span></div><div class="sip-cat-card-sub">Share feedback and suggestions about this topic.</div></div></label>
                   <label class="sip-cat-card" id="cat-card-Student life"><input type="radio" name="sip-category" value="Student life" data-category-name="Student life" class="sip-cat-radio" required data-sf-change="action-116"/><div class="sip-cat-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#ws-users"/></svg></div><div class="sip-cat-card-content"><div class="sip-cat-card-header"><span class="sip-cat-card-title">Student life</span><span class="sip-cat-check-dot"></span></div><div class="sip-cat-card-sub">Share feedback and suggestions about this topic.</div></div></label>
                   <label class="sip-cat-card" id="cat-card-Other"><input type="radio" name="sip-category" value="Other" data-category-name="Other" class="sip-cat-radio" required data-sf-change="action-116"/><div class="sip-cat-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#ws-message"/></svg></div><div class="sip-cat-card-content"><div class="sip-cat-card-header"><span class="sip-cat-card-title">Other</span><span class="sip-cat-check-dot"></span></div><div class="sip-cat-card-sub">Share feedback and suggestions about this topic.</div></div></label>
                 </div>
        </div>
    
        <!-- Step 2: Details -->
        <div id="sip-step-2" class="sip-step-content sip-step-body" role="tabpanel" aria-labelledby="step-btn-2" hidden>
          <div class="sip-step-intro">
            <h3 class="sip-section-title">Idea details</h3>
            <p class="sip-section-sub">Be clear and descriptive so peers and administrators can evaluate it.</p>
          </div>
    
          <!-- Title Field -->
          <div class="sip-field">
            <div class="sip-field-label-row">
              <label for="sip-title" class="sip-label">
                Title <span class="sip-required">*</span>
              </label>
              <div class="sip-char-wrap">
                <span id="sip-title-req" class="sip-validation-badge">Min 10 chars</span>
                <span id="sip-title-count" class="sip-char-counter">0 / 100</span>
              </div>
            </div>
            <div class="sip-input-container">
              <input
                type="text"
                id="sip-title"
                class="form-input sip-input-full"
                placeholder="Brief, specific summary (e.g. Add water refill stations in Library)"
                maxlength="100"
                autocomplete="off"
                data-sf-input="action-121"
              />
            </div>
          </div>
    
          <div id="similar-public-ideas" aria-live="polite"></div>
          <p class="care-guidance">Describe the place, the impact, and one practical change. Avoid names, student numbers and contact details. Example: “Add shaded seating near the science building so students can wait out of the sun.” Anonymous submissions are not attached to your account; keep your private tracking code to receive clarification requests.</p>
          <!-- Description Field -->
          <div class="sip-field">
            <div class="sip-field-label-row">
              <label for="sip-description" class="sip-label">
                Description <span class="sip-required">*</span>
              </label>
              <div class="sip-char-wrap">
                <span id="sip-desc-req" class="sip-validation-badge">Min 20 chars</span>
                <span id="sip-desc-count" class="sip-char-counter">0 / 1500</span>
              </div>
            </div>
            <div class="sip-input-container">
              <textarea
                id="sip-description"
                class="form-input sip-input-full sip-textarea"
                rows="5"
                placeholder="Describe what needs improvement, why it matters, and any suggested solutions or next steps."
                maxlength="1500"
                data-sf-input="action-122"
              ></textarea>
            </div>
          </div>
    
          <!-- Anonymous Submission Toggle -->
          <div class="sip-anon-card">
            <label class="sip-toggle-row" for="sip-anon">
              <div class="sip-toggle-info">
                <div class="sip-toggle-title-wrap">
                  <span class="sip-toggle-title">Submit anonymously</span>
                  <span id="sip-anon-status-pill" class="sip-badge-anon-state">Identity Hidden</span>
                </div>
                <div class="sip-toggle-sub">
                  Your account will not be attached to this submission. Service logs may still record connection details; see the privacy notice.
                </div>
              </div>
              <div class="sip-switch">
                <input type="checkbox" id="sip-anon" data-sf-switch role="switch" checked class="sip-switch-input" data-sf-change="action-123" />
                <span class="sip-switch-slider"></span>
              </div>
            </label>
          </div>
                    </div>
    
        <!-- Step 3: Review -->
        <div id="sip-step-3" class="sip-step-content sip-step-body" role="tabpanel" aria-labelledby="step-btn-3" hidden>
          <div class="sip-step-intro">
            <h3 class="sip-section-title">Review your submission</h3>
            <p class="sip-section-sub">Confirm details before publishing to the community queue.</p>
