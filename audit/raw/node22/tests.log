                <div class="sip-cat-grid" role="radiogroup" aria-label="Feedback category" data-default-icons="{&quot;facilities&quot;:&quot;building&quot;,&quot;learning&quot;:&quot;book&quot;,&quot;safety&quot;:&quot;shield&quot;,&quot;student life&quot;:&quot;users&quot;,&quot;other&quot;:&quot;message&quot;}">
