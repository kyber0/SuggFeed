{
  "name": "suggfeed",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm dev:express",
    "dev:express": "pnpm --filter suggfeed-express dev",
    "dev:client": "pnpm --filter suggfeed-express dev:client",
    "build": "pnpm --filter suggfeed-express build",
    "build:all": "pnpm run build",
    "start": "pnpm --filter suggfeed-express start",
    "typecheck": "pnpm --filter suggfeed-express typecheck",
    "test": "pnpm --filter suggfeed-express test",
    "test:all": "pnpm run test"
  },
  "workspaces": [
    "apps/web-express"
  ]
}
