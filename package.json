{
  "name": "suggfeed",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "pnpm dev:express",
    "dev:express": "pnpm --filter suggfeed-express dev",
    "dev:client": "pnpm --filter suggfeed-express dev:client",
    "dev:next": "pnpm --filter web dev",
    "build": "turbo run build --filter=suggfeed-express",
    "build:next": "turbo run build --filter=web",
    "build:all": "turbo run build",
    "start": "pnpm --filter suggfeed-express start",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter suggfeed-express test",
    "test:next": "pnpm --filter web test",
    "test:all": "turbo run test",
    "test:coverage:next": "pnpm --filter web test:coverage"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/web",
    "apps/web-express",
    "packages/*"
  ]
}
