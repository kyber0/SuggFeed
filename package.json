{
  "name": "suggfeed",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter web exec vitest run",
    "test:coverage": "pnpm --filter web exec vitest run --coverage",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:ios": "pnpm --filter mobile ios"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "dependencies": {
    "@sentry/nextjs": "10"
  }
}
